# build output
dist/
preview/dist/

# generated types
.astro/
preview/.astro/

# wrangler local state / cache — never commit
.wrangler/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production
preview/.dev.vars
preview/.env

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# agent skills installed from skills-lock.json (the Sanity add-on ships one)
.agents/
# Ignore lock-managed/local skills, but DO commit the hand-authored gsap-* and
# setup skills (no external source to reinstall from — they must live in the
# repo so Claude Code web sessions get them).
.claude/skills/*
!.claude/skills/gsap-*
!.claude/skills/setup
!.claude/skills/component-api
!.claude/skills/styling-reference
!.claude/skills/seo-discoverability
!.claude/skills/content-files

# Playwright MCP scratch dir — screenshots, console logs, and anything the
# browser downloads while driving the site. Never source.
.playwright-mcp/

# transient plan-mode artifact (personal, machine-generated)
.claude/plan.md


# ShipStudio metadata
.shipstudio/

# Local parity baselines (scripts/compare-dist.mjs) — never commit
.parity/
