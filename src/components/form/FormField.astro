---
import type { HTMLAttributes } from "astro/types";
/**
 * FormField — label + input for standard form fields.
 *
 * Supports text, email, tel, url, password, number, date, and other
 * native input types. The field border transitions to --text on :focus-within.
 *
 * @example
 * ```astro
 * <!-- Semantic variant settles type + keyboard + autofill together -->
 * <FormField label="Email" name="email" variant="email" required
 *   placeholder="you@company.com" />
 *
 * <FormField label="First Name" name="first-name" variant="first-name" />
 * <FormField label="Zip" name="zip" variant="zip-code" />
 *
 * <!-- Hidden label (screen-reader only) -->
 * <FormField label="Phone" name="phone" variant="phone"
 *   labelVariant="hidden" placeholder="000-000-0000" />
 *
 * <!-- Floating label (sits inside field, floats up on focus/value) -->
 * <FormField label="Email Address" name="email" variant="email"
 *   labelVariant="floating" />
 * ```
 */

type InputType =
  | "text"
  | "email"
  | "password"
  | "tel"
  | "url"
  | "number"
  | "date"
  | "datetime-local"
  | "search"
  | "hidden";

type FieldVariant =
  /** Anything else, with no assumptions (default) */
  | "text"
  /** Autofilled from an address book entry */
  | "first-name"
  /** Autofilled from an address book entry */
  | "last-name"
  /** Email keyboard, validation, and autofill */
  | "email"
  /** Telephone keyboard and autofill */
  | "phone"
  /** Native date picker */
  | "date"
  /** Numeric keyboard, postal-code autofill */
  | "zip-code"
  /** Number input, no autofill */
  | "number"
  /** The browser's own search handling */
  | "search"
  /** The browser's own password handling */
  | "password"
  /** URL keyboard and validation */
  | "url";

interface Props extends HTMLAttributes<"input"> {
  /** Label text for the field. Always rendered for accessibility. */
  label: string;

  /** HTML `name` attribute on the input. Required for form submission. */
  name: string;

  /**
   * What the field is for. Settles the input's `type`, `inputmode` keyboard,
   * and `autocomplete` autofill together, so a field only has to say which
   * one it is. Explicit `type` / `autocomplete` / `inputmode` props override
   * individual pieces.
   *
   * @default 'text'
   * @example variant="email"
   */
  variant?: FieldVariant;

  /**
   * Input type. Overrides the `variant` mapping — prefer `variant` alone.
   * @default 'text'
   */
  type?: InputType;

  /** Placeholder text. */
  placeholder?: string;

  /**
   * Whether the field is required.
   * @default false
   */
  required?: boolean;

  /**
   * Disabled state.
   * @default false
   */
  disabled?: boolean;

  /**
   * Label display variant.
   * - `'default'` — Label shows above the input field
   * - `'hidden'` — Label is visually hidden (still accessible to screen readers)
   * - `'floating'` — Label sits inside the field as a placeholder, then floats
   *   up above the border when the field is focused or contains a value
   * @default 'default'
   */
  labelVariant?: "default" | "hidden" | "floating";

  /** Default value for the input. */
  value?: string;

  /** HTML `autocomplete` attribute (e.g. `'given-name'`, `'email'`). */
  autocomplete?: string;

  /** HTML `inputmode` attribute (e.g. `'numeric'`, `'tel'`). */
  inputmode?:
    | "none"
    | "text"
    | "tel"
    | "url"
    | "email"
    | "numeric"
    | "decimal"
    | "search";

  /** HTML `id` attribute. Auto-generated if not provided. */
  id?: string;

  /** Helper text displayed below the input. */
  helperText?: string;

  /** Error text displayed below the input (overrides helperText visually). */
  errorText?: string;

  /** Extra classes on the outer `.form_label_wrap` element. */
  class?: string;
}

const {
  label,
  name,
  variant = "text",
  type,
  placeholder,
  required = false,
  disabled = false,
  labelVariant = "default",
  value,
  autocomplete,
  inputmode,
  id,
  helperText,
  errorText,
  class: className,
  ...rest
} = Astro.props;

/* Each variant settles type + keyboard + autofill together; explicit props
   override piece by piece. */
const KINDS: Record<
  FieldVariant,
  {
    type: InputType;
    mode: NonNullable<Props["inputmode"]>;
    fill: string;
  }
> = {
  text: { type: "text", mode: "text", fill: "on" },
  "first-name": { type: "text", mode: "text", fill: "given-name" },
  "last-name": { type: "text", mode: "text", fill: "family-name" },
  email: { type: "email", mode: "email", fill: "email" },
  phone: { type: "tel", mode: "tel", fill: "tel" },
  date: { type: "date", mode: "text", fill: "bday" },
  "zip-code": { type: "text", mode: "numeric", fill: "postal-code" },
  number: { type: "number", mode: "numeric", fill: "off" },
  search: { type: "search", mode: "search", fill: "off" },
  password: { type: "password", mode: "text", fill: "current-password" },
  url: { type: "url", mode: "url", fill: "url" },
};

const kind = KINDS[variant];
const resolvedType = type ?? kind.type;
const resolvedAutocomplete = autocomplete ?? kind.fill;
const resolvedInputmode = inputmode ?? kind.mode;

if (
  import.meta.env.DEV &&
  variant !== "text" &&
  type !== undefined &&
  type !== kind.type
) {
  console.warn(
    `\n[FormField] variant="${variant}" implies type="${kind.type}" but ` +
      `type="${type}" was also passed — the explicit type wins. Drop one ` +
      "so the field has a single source of truth.\n",
  );
}

const fieldId = id || `field-${name}`;
const describedById = helperText || errorText ? `${fieldId}-hint` : undefined;
const isFloating = labelVariant === "floating";
const resolvedPlaceholder = isFloating ? placeholder || " " : placeholder;
---

{
  resolvedType === "hidden" ? (
    <input type="hidden" name={name} value={value} id={fieldId} />
  ) : (
    <div
      class:list={["form_label_wrap", isFloating && "is-floating", className]}
    >
      <label
        class:list={[
          "form_label_text",
          labelVariant === "hidden" && "u-sr-only",
        ]}
        for={fieldId}
      >
        {label}
        {required && (
          <span class="form_required" aria-hidden="true">
            *
          </span>
        )}
      </label>

      <input
        class="form_field"
        type={resolvedType}
        name={name}
        id={fieldId}
        placeholder={resolvedPlaceholder}
        required={required}
        disabled={disabled}
        value={value}
        autocomplete={resolvedAutocomplete}
        inputmode={resolvedInputmode}
        aria-describedby={describedById}
        aria-invalid={errorText ? "true" : undefined}
        {...rest}
      />

      {(helperText || errorText) && (
        <p
          class:list={["form_helper_text", errorText && "is-error"]}
          id={describedById}
        >
          {errorText || helperText}
        </p>
      )}
    </div>
  )
}
