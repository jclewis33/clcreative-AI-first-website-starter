---
import type { HTMLAttributes } from "astro/types";
/**
 * FormSelect — label + styled `<select>` with a custom dropdown arrow.
 *
 * Options can be provided via the `options` prop (simple cases) or via
 * the default slot for complex `<optgroup>` structures.
 *
 * @example
 * ```astro
 * <!-- Via options prop -->
 * <FormSelect label="Subject" name="subject"
 *   placeholderOption="Select one..."
 *   options={[
 *     { label: 'General', value: 'general' },
 *     { label: 'Support', value: 'support' },
 *   ]}
 * />
 *
 * <!-- Floating label variant -->
 * <FormSelect label="Subject" name="subject" labelVariant="floating"
 *   placeholderOption="Select one..."
 *   options={[
 *     { label: 'General', value: 'general' },
 *     { label: 'Support', value: 'support' },
 *   ]}
 * />
 *
 * <!-- Via slot for optgroups -->
 * <FormSelect label="Country" name="country" placeholderOption="Choose...">
 *   <optgroup label="North America">
 *     <option value="us">United States</option>
 *     <option value="ca">Canada</option>
 *   </optgroup>
 * </FormSelect>
 * ```
 */

interface SelectOption {
  /** Display text. */
  label: string;
  /** Form value. */
  value: string;
  /** Disabled option. @default false */
  disabled?: boolean;
}

type SelectVariant =
  /** Options you supply via `options` or the slot (default) */
  | "list"
  /** Built-in 01–12 */
  | "month"
  /** Built-in 01–31 */
  | "day"
  /** Built-in year range — set with `from` and `to` */
  | "year"
  /** Built-in US states (this starter's client base is US) */
  | "state";

interface Props extends HTMLAttributes<"select"> {
  /** Label text. */
  label: string;

  /** HTML `name` attribute. */
  name: string;

  /**
   * What the field offers.
   * - `list` — options you supply (default)
   * - `month`, `day`, `state` — a built-in list (states are US-specific)
   * - `year` — a range, set with `from` and `to`
   *
   * @default 'list'
   * @example variant="state"
   */
  variant?: SelectVariant;

  /**
   * The earliest year offered (`variant="year"` only). Defaults to a hundred
   * before `to`.
   * @example from={1950}
   */
  from?: number;

  /**
   * The latest year offered (`variant="year"` only). Defaults to the year
   * the site was built.
   * @example to={2030}
   */
  to?: number;

  /**
   * Select options — array of `{ label, value, disabled? }`.
   * Alternatively, use the default slot for `<option>` / `<optgroup>`.
   * Ignored when a built-in `variant` supplies the list.
   */
  options?: SelectOption[];

  /** Placeholder option text (first option, disabled, `value=""`). */
  placeholderOption?: string;

  /**
   * Whether the field is required.
   * @default false
   */
  required?: boolean;

  /**
   * Disabled state.
   * @default false
   */
  disabled?: boolean;

  /** Default selected value. */
  value?: string;

  /**
   * Label display variant.
   * - `'default'` — Label shows above the select field
   * - `'hidden'` — Label is visually hidden (still accessible to screen readers)
   * - `'floating'` — Label sits inside the field as a placeholder, then floats
   *   up above the border when the field is focused or has a selected value
   * @default 'default'
   */
  labelVariant?: "default" | "hidden" | "floating";

  /** Helper text displayed below the select. */
  helperText?: string;

  /** Error text displayed below the select. */
  errorText?: string;

  /** HTML `id` attribute. Auto-generated if not provided. */
  id?: string;

  /** Extra classes on the outer `.form_label_wrap` element. */
  class?: string;
}

const {
  label,
  name,
  variant = "list",
  from,
  to,
  options,
  placeholderOption,
  required = false,
  disabled = false,
  value,
  labelVariant = "default",
  helperText,
  errorText,
  id,
  class: className,
  ...rest
} = Astro.props;

/* Built-in option sets. `new Date()` runs at build time for prerendered
   pages, so the year default refreshes on every rebuild. */
const STATES: SelectOption[] = [
  { value: "AL", label: "Alabama" },
  { value: "AK", label: "Alaska" },
  { value: "AZ", label: "Arizona" },
  { value: "AR", label: "Arkansas" },
  { value: "CA", label: "California" },
  { value: "CO", label: "Colorado" },
  { value: "CT", label: "Connecticut" },
  { value: "DE", label: "Delaware" },
  { value: "FL", label: "Florida" },
  { value: "GA", label: "Georgia" },
  { value: "HI", label: "Hawaii" },
  { value: "ID", label: "Idaho" },
  { value: "IL", label: "Illinois" },
  { value: "IN", label: "Indiana" },
  { value: "IA", label: "Iowa" },
  { value: "KS", label: "Kansas" },
  { value: "KY", label: "Kentucky" },
  { value: "LA", label: "Louisiana" },
  { value: "ME", label: "Maine" },
  { value: "MD", label: "Maryland" },
  { value: "MA", label: "Massachusetts" },
  { value: "MI", label: "Michigan" },
  { value: "MN", label: "Minnesota" },
  { value: "MS", label: "Mississippi" },
  { value: "MO", label: "Missouri" },
  { value: "MT", label: "Montana" },
  { value: "NE", label: "Nebraska" },
  { value: "NV", label: "Nevada" },
  { value: "NH", label: "New Hampshire" },
  { value: "NJ", label: "New Jersey" },
  { value: "NM", label: "New Mexico" },
  { value: "NY", label: "New York" },
  { value: "NC", label: "North Carolina" },
  { value: "ND", label: "North Dakota" },
  { value: "OH", label: "Ohio" },
  { value: "OK", label: "Oklahoma" },
  { value: "OR", label: "Oregon" },
  { value: "PA", label: "Pennsylvania" },
  { value: "RI", label: "Rhode Island" },
  { value: "SC", label: "South Carolina" },
  { value: "SD", label: "South Dakota" },
  { value: "TN", label: "Tennessee" },
  { value: "TX", label: "Texas" },
  { value: "UT", label: "Utah" },
  { value: "VT", label: "Vermont" },
  { value: "VA", label: "Virginia" },
  { value: "WA", label: "Washington" },
  { value: "WV", label: "West Virginia" },
  { value: "WI", label: "Wisconsin" },
  { value: "WY", label: "Wyoming" },
];

const pad = (n: number) => String(n).padStart(2, "0");
const span = (start: number, end: number) =>
  Array.from({ length: end - start + 1 }, (_, i) => start + i);

const latest = to ?? new Date().getFullYear();
const earliest = from ?? latest - 100;

const builtIn: SelectOption[] | undefined =
  variant === "state"
    ? STATES
    : variant === "month"
      ? span(1, 12).map((n) => ({ value: pad(n), label: pad(n) }))
      : variant === "day"
        ? span(1, 31).map((n) => ({ value: pad(n), label: pad(n) }))
        : variant === "year"
          ? span(earliest, latest)
              .reverse()
              .map((n) => ({ value: String(n), label: String(n) }))
          : undefined;

const resolvedOptions = builtIn ?? options;

if (import.meta.env.DEV) {
  if ((from !== undefined || to !== undefined) && variant !== "year") {
    console.warn(
      '\n[FormSelect] `from` / `to` only apply to variant="year" — they ' +
        "were ignored.\n",
    );
  }
  if (builtIn && options) {
    console.warn(
      `\n[FormSelect] variant="${variant}" supplies its own options — the ` +
        "`options` prop was ignored.\n",
    );
  }
}

const fieldId = id || `field-${name}`;
const describedById = helperText || errorText ? `${fieldId}-hint` : undefined;
const isFloating = labelVariant === "floating";
---

<div class:list={["form_label_wrap", isFloating && "is-floating", className]}>
  <label
    class:list={["form_label_text", labelVariant === "hidden" && "u-sr-only"]}
    for={fieldId}
  >
    {label}
    {
      required && (
        <span class="form_required" aria-hidden="true">
          *
        </span>
      )
    }
  </label>

  <div class="form_select_wrap">
    <select
      class="form_field"
      name={name}
      id={fieldId}
      required={required}
      disabled={disabled}
      aria-describedby={describedById}
      aria-invalid={errorText ? "true" : undefined}
      {...rest}
    >
      {
        placeholderOption && (
          <option value="" disabled selected={!value}>
            {isFloating ? "" : placeholderOption}
          </option>
        )
      }

      {
        resolvedOptions ? (
          resolvedOptions.map((opt) => (
            <option
              value={opt.value}
              disabled={opt.disabled}
              selected={opt.value === value}
            >
              {opt.label}
            </option>
          ))
        ) : (
          <slot />
        )
      }
    </select>

    <svg
      class="form_select_icon"
      viewBox="0 0 6 5"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M0.5 1L3 3.5L5.5 1"
        stroke="currentColor"
        stroke-width="0.125rem"
        vector-effect="non-scaling-stroke"></path>
    </svg>
  </div>

  {
    (helperText || errorText) && (
      <p
        class:list={["form_helper_text", errorText && "is-error"]}
        id={describedById}
      >
        {errorText || helperText}
      </p>
    )
  }
</div>

<script>
  function initFloatingSelects() {
    document
      .querySelectorAll<HTMLSelectElement>(
        ".form_label_wrap.is-floating select.form_field",
      )
      .forEach((select) => {
        if ((select as any).__floatingInit) return;
        (select as any).__floatingInit = true;

        const wrap = select.closest(".form_label_wrap");
        if (!wrap) return;

        function update() {
          if (select.value) {
            wrap!.setAttribute("data-has-value", "");
          } else {
            wrap!.removeAttribute("data-has-value");
          }
        }

        select.addEventListener("change", update);
        update();
      });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFloatingSelects);
  } else {
    initFloatingSelects();
  }
</script>
