---
import type { HTMLAttributes } from "astro/types";
import Form from "@/components/form/Form.astro";
import FormField from "@/components/form/FormField.astro";
import Accordion from "@/components/ui/Accordion.astro";
import AccordionItem from "@/components/ui/AccordionItem.astro";
import FormFieldset from "@/components/form/FormFieldset.astro";
import FormSelect from "@/components/form/FormSelect.astro";
import FormCheckbox from "@/components/form/FormCheckbox.astro";
import FormTextarea from "@/components/form/FormTextarea.astro";
import SmsConsent from "@/components/form/SmsConsent.astro";
import Button from "@/components/ui/Button.astro";
import Visual from "@/components/ui/Visual.astro";
import type { ImageMetadata } from "astro";
import { FORMS, HONEYPOT_FIELD, type FormId } from "@/config/forms";
import { SITE } from "@/config/site";
import type { LeadQuestion } from "@/lib/lead-questions";

/* Named on purpose — inline unions lose their editor tooltips. */
type LeadFormFields = "contact" | "quote" | "steps" | "bid";
type LeadFormButtonWidth = "full" | "auto";
type LeadFormOption = {
  /** What the visitor sees, and what is saved. */
  label: string;
  /** A stable value. */
  value: string;
  /** Steps preset: a photo on top of this tile (an import or a URL). */
  image?: ImageMetadata | string;
  /** Alt text for `image`. @default the label */
  imageAlt?: string;
  /** Steps preset: one short line under the tile's label. */
  description?: string;
};
type LeadFormProgress =
  /** "Step 1 of 2" over a thin bar */
  | "bar"
  /** Numbered step names, "01 Your project · 02 Your details", the current one highlighted */
  | "steps";

/* name/action/method are set by LeadForm itself — not caller overridable. */
interface Props extends Omit<
  HTMLAttributes<"form">,
  "name" | "action" | "method"
> {
  /**
   * **LeadForm** — a ready-made form wired to GoHighLevel.
   *
   * Posts JSON to `/api/lead`. The server looks `formId` up in
   * `src/config/forms.ts` and creates or updates the contact, saves the
   * message as a note, and adds that form's tags — which start the GHL
   * automations. Includes a hidden bot trap and, once `SITE.smsOptIn` is
   * on, the Phone field and the A2P SMS consent box (`<SmsConsent>`) —
   * until then Email is the only way to reach them.
   * Success and failure states come from `<Form>`. Setup:
   * `docs/ghl-forms.md`.
   *
   * - `formId` — which registry entry (public forms only)
   * - `fields` — `'contact'` (name, email, phone*, message), `'quote'` (adds
   *   project type and timeline selects) or `'steps'` (a two-step quote:
   *   the project type as big tiles first, under `stepQuestion`, then the
   *   contact fields — the home-service estimate pop-up) or `'bid'` (a
   *   bid invitation from a contractor: company, name, role, email, the
   *   project and city, square feet, the scopes as checkboxes from
   *   `projectOptions`, the due date, a link to the plans, and "also send
   *   the prequal packet")
   * - `questions` — steps preset: several one-tap questions before the
   *   contact fields (who's asking, project, size, timing, budget) — a
   *   qualifying form that screens out tire kickers
   * - `projectOptions` / `timelineOptions` — the quote selects' choices;
   *   in the steps preset an option may carry an `image` (and
   *   `description`) to make photo tiles
   * - `progress` — steps preset: `'bar'` (default) or `'steps'` (numbered
   *   step names)
   * - `insuranceDetails` — adds a collapsed "Insurance-related project?"
   *   box with insurance company and claim number (both optional)
   * - `messageLabel`, `messagePlaceholder`, `submitLabel`, `successMessage`,
   *   `errorMessage` — copy
   * - `buttonWidth` — `'full'` (default) or `'auto'`
   * - `compact` — just Name, Phone (Email while texting is off) and an
   *   optional message
   *
   * *Phone only while `SITE.smsOptIn` is true.
   *
   * @example
   * ```astro
   * <LeadForm formId="contact" messageLabel="What do you need help with?" />
   * ```
   */
  docs?: string;

  /** Set `false` to skip rendering. @default true */
  render?: boolean;

  /** Which entry in `src/config/forms.ts` this form submits as. Must be a public form. */
  formId: FormId;

  /**
   * Field preset. `contact`: first/last name, email, phone (only while
   * `SITE.smsOptIn` is on), message. `quote`:
   * the same plus project-type and timeline selects (saved to the note).
   * `steps`: step 1 is the project type as big tiles, step 2 the quote
   * fields without the project select; picking a tile moves on. Without JS
   * both steps show at once.
   * @default 'contact'
   */
  fields?: LeadFormFields;

  /** Steps preset: the step-1 question over the tiles. @default 'What do you need help with?' */
  stepQuestion?: string;

  /**
   * Steps preset: the one-tap questions, one step each, before the contact
   * fields — `{ name, question, text?, options }` (src/lib/lead-questions.ts).
   * Each answer is saved as its `name` (audience, projectType, projectSize,
   * timeline, budget). Replaces the single `stepQuestion` / `projectOptions`
   * step; with a `timeline` question the details step drops its Timeline
   * select. Progress reads "Step 2 of 5".
   */
  questions?: LeadQuestion[];

  /**
   * Quote preset: project-type choices. The chosen label is saved.
   * In the steps preset, give options an `image` (and a short
   * `description`) to turn the step-1 tiles into photo cards.
   */
  projectOptions?: LeadFormOption[];

  /** Quote preset: timeline choices. The chosen label is saved. */
  timelineOptions?: LeadFormOption[];

  /** Bid preset: the "Your role" choices. @default estimator, PM, builder, property manager, owner */
  roleOptions?: LeadFormOption[];

  /**
   * Steps preset: how progress shows. `bar` is "Step 1 of 2" over a thin
   * bar; `steps` names the steps ("01 Your project · 02 Your details") and
   * highlights the current one.
   * @default 'bar'
   */
  progress?: LeadFormProgress;

  /** Steps preset, `progress="steps"`: the two step names. @default ['Your project', 'Your details'] */
  progressLabels?: [string, string];

  /**
   * Adds a collapsed "Insurance-related project? Add details" box above the
   * message, with optional Insurance company and Claim number fields
   * (saved to the note on the contact). For roofing and restoration.
   * @default false
   */
  insuranceDetails?: boolean;

  /** Label above the message box. @default 'How can we help?' */
  messageLabel?: string;

  /** Placeholder inside the message box. */
  messagePlaceholder?: string;

  /** Submit button text. @default 'Send' ('Request my estimate' for `steps`) */
  submitLabel?: string;

  /** Shown in place of the fields once sent. */
  successMessage?: string;

  /** Shown under the fields when sending fails. */
  errorMessage?: string;

  /** Submit button width. @default 'full' */
  buttonWidth?: LeadFormButtonWidth;

  /**
   * The shortest form: one Name field, Phone, and an optional message — no
   * last name, email or timeline. While `SITE.smsOptIn` is off (no phone
   * field allowed) Email takes Phone's place. The server splits the name.
   * @default false
   */
  compact?: boolean;

  /** Unique prefix for field ids — needed when one page shows the form twice. */
  id?: string;

  /** Extra classes on the outer `.form_wrap`. */
  class?: string;
}

const {
  docs,
  render = true,
  formId,
  fields = "contact",
  stepQuestion = "What do you need help with?",
  questions,
  projectOptions = [],
  progress = "bar",
  progressLabels = ["Your project", "Your details"],
  insuranceDetails = false,
  roleOptions = [
    { label: "Estimator", value: "estimator" },
    { label: "Project manager", value: "project-manager" },
    { label: "Builder or developer", value: "builder" },
    { label: "Property manager", value: "property-manager" },
    { label: "Business owner", value: "owner" },
  ],
  timelineOptions = [
    { label: "As soon as possible", value: "asap" },
    { label: "Within 1–3 months", value: "1-3-months" },
    { label: "Just planning", value: "planning" },
  ],
  messageLabel = "How can we help?",
  messagePlaceholder,
  submitLabel = fields === "steps"
    ? "Request my estimate"
    : fields === "bid"
      ? "Send bid invitation"
      : "Send",
  successMessage = "Thanks — we got your message and will be in touch shortly.",
  errorMessage = `Something went wrong. Please try again, or call us at ${SITE.phone.display}.`,
  buttonWidth = "full",
  compact = false,
  id = `lead-${formId}`,
  class: className,
  ...rest
} = Astro.props;

const form = FORMS[formId];
if (import.meta.env.DEV) {
  if (!form) console.warn(`[LeadForm] Unknown formId "${formId}".`);
  else if (form.access !== "public")
    console.warn(
      `[LeadForm] "${formId}" is a staff form — it belongs on /tools, not a public page.`,
    );
  if (
    fields !== "contact" &&
    projectOptions.length === 0 &&
    !(fields === "steps" && questions?.length)
  )
    console.warn(`[LeadForm] fields="${fields}" without projectOptions.`);
  if (questions?.length && fields !== "steps")
    console.warn(`[LeadForm] questions apply to fields="steps" only.`);
  if ((questions?.length ?? 0) > 1 && progress === "steps")
    console.warn(
      `[LeadForm] progress="steps" names two steps; with several questions use "bar".`,
    );
  if (progress !== "bar" && progress !== "steps")
    console.warn(`[LeadForm] Unknown progress "${progress}"; using "bar".`);
  if (
    fields !== "steps" &&
    (progress !== "bar" || projectOptions.some((o) => o.image))
  )
    console.warn(
      `[LeadForm] progress and option images apply to fields="steps" only.`,
    );
}
/* The one-tap steps: the caller's questions, else the single project-type
   step the steps preset has always had. */
const choiceSteps: LeadQuestion[] =
  fields !== "steps"
    ? []
    : questions?.length
      ? questions
      : projectOptions.length
        ? [
            {
              name: "projectType",
              question: stepQuestion,
              options: projectOptions,
            },
          ]
        : [];
const stepped = choiceSteps.length > 0;
const totalSteps = choiceSteps.length + 1;
const namedSteps = stepped && progress === "steps" && choiceSteps.length === 1;
const askedTimeline = choiceSteps.some((q) => q.name === "timeline");
/* Step 2 wraps the details only in the steps preset; the other presets'
   markup stays exactly as it was. */
const Details = stepped ? "div" : Fragment;
const detailsProps = stepped
  ? { class: "lead-form_step is-details", "data-step": String(totalSteps) }
  : {};
---

{
  render && form && (
    <Form
      name={formId}
      action="/api/lead"
      encoding="json"
      successMessage={successMessage}
      errorMessage={errorMessage}
      id={id}
      class={["lead-form_wrap", className].filter(Boolean).join(" ")}
      {...rest}
    >
      <input type="hidden" name="formId" value={formId} />

      {namedSteps && (
        <ol class="lead-form_steps" aria-hidden="true">
          {progressLabels.map((label, i) => (
            <li class:list={["lead-form_steps_item", `is-step-${i + 1}`]}>
              <span class="lead-form_steps_number u-text-style-tiny">
                0{i + 1}
              </span>
              {label}
            </li>
          ))}
        </ol>
      )}
      {stepped && !namedSteps && (
        <div class="lead-form_progress" aria-hidden="true">
          <span class="lead-form_progress_label">
            Step <span data-step-number>1</span> of {totalSteps}
          </span>
          <span class="lead-form_progress_bar">
            <span
              class="lead-form_progress_fill"
              style={`width: ${100 / totalSteps}%`}
            />
          </span>
        </div>
      )}
      {choiceSteps.map((q, i) => {
        const photoTiles = q.options.some((o) => o.image);
        return (
          <fieldset class="lead-form_step is-choice" data-step={String(i + 1)}>
            <legend class="lead-form_step_title">{q.question}</legend>
            {q.text && (
              <p class="lead-form_step_text u-text-style-small u-text-style-muted">
                {q.text}
              </p>
            )}
            {!photoTiles && (
              <div
                class:list={[
                  "lead-form_tiles",
                  q.options.some((o) => o.description) && "is-described",
                ]}
              >
                {q.options.map((o) => (
                  <label class="lead-form_tile">
                    <input
                      class="lead-form_tile_input"
                      type="radio"
                      name={q.name}
                      value={o.label}
                    />
                    <span class="lead-form_tile_body">
                      <span class="lead-form_tile_label">{o.label}</span>
                      {o.description && (
                        <span class="lead-form_tile_text u-text-style-small u-text-style-muted">
                          {o.description}
                        </span>
                      )}
                    </span>
                  </label>
                ))}
              </div>
            )}
            {photoTiles && (
              <div class="lead-form_tiles is-photo">
                {q.options.map((o) => (
                  <label class="lead-form_tile is-photo">
                    <input
                      class="lead-form_tile_input"
                      type="radio"
                      name={q.name}
                      value={o.label}
                    />
                    {o.image && (
                      <Visual
                        src={o.image}
                        alt={o.imageAlt ?? o.label}
                        ratio="landscape"
                        radius="none"
                        aria-hidden="true"
                        class="lead-form_tile_img u-width-full"
                      />
                    )}
                    <span class="lead-form_tile_body u-padding-4">
                      <span class="lead-form_tile_label">{o.label}</span>
                      {o.description && (
                        <span class="lead-form_tile_text u-text-style-small u-text-style-muted">
                          {o.description}
                        </span>
                      )}
                    </span>
                  </label>
                ))}
              </div>
            )}
            {i > 0 && (
              <button
                type="button"
                class="lead-form_change lead-form_back"
                data-step-prev
              >
                Back
              </button>
            )}
          </fieldset>
        );
      })}

      <Details {...detailsProps}>
        {stepped && (
          <p class="lead-form_choice" data-step-choice hidden>
            <span class="lead-form_choice_text">
              {choiceSteps.length > 1 ? "Your answers" : "Your project"}:{" "}
              <strong data-step-label />
            </span>
            <button type="button" class="lead-form_change" data-step-back>
              Change
            </button>
          </p>
        )}

        {fields === "bid" && (
          <FormFieldset columns={2}>
            <FormField
              label="Company"
              name="company"
              variant="text"
              autocomplete="organization"
              id={`${id}-company`}
              required
            />
            <FormField
              label="Your name"
              name="firstName"
              variant="text"
              autocomplete="name"
              id={`${id}-name`}
              required
            />
            <FormSelect
              label="Your role"
              name="role"
              options={roleOptions.map((o) => ({ ...o, value: o.label }))}
              placeholderOption="Choose one"
              id={`${id}-role`}
            />
            <FormField
              label="Email"
              name="email"
              variant="email"
              id={`${id}-email`}
              required
            />
            {SITE.smsOptIn && (
              <FormField
                label="Phone"
                name="phone"
                variant="phone"
                id={`${id}-phone`}
              />
            )}
            <FormField
              label="Project name and city"
              name="projectName"
              variant="text"
              autocomplete="off"
              id={`${id}-project`}
            />
            <FormField
              label="Approximate square feet"
              name="squareFeet"
              variant="text"
              autocomplete="off"
              id={`${id}-sqft`}
            />
            <FormField
              label="Bid due date"
              name="dueDate"
              variant="date"
              id={`${id}-due`}
            />
            <FormField
              label="Link to plans and specs"
              name="plansUrl"
              variant="text"
              type="url"
              autocomplete="off"
              id={`${id}-plans`}
              class={SITE.smsOptIn ? "lead-form_full" : undefined}
            />
          </FormFieldset>
        )}
        {fields === "bid" && projectOptions.length > 0 && (
          <FormFieldset legend="Scope" class="lead-form_scope">
            {projectOptions.map((o, i) => (
              <FormCheckbox
                label={o.label}
                name="scope"
                value={o.label}
                id={`${id}-scope-${i + 1}`}
              />
            ))}
          </FormFieldset>
        )}
        {fields === "bid" && (
          <FormCheckbox
            label="Also send me the prequal packet"
            name="prequalPacket"
            value="Yes"
            id={`${id}-prequal`}
          />
        )}

        {compact && fields !== "bid" && (
          <FormFieldset columns={2}>
            <FormField
              label="Name"
              name="firstName"
              variant="text"
              autocomplete="name"
              id={`${id}-name`}
              required
            />
            {SITE.smsOptIn && (
              <FormField
                label="Phone"
                name="phone"
                variant="phone"
                id={`${id}-phone`}
                required
              />
            )}
            {!SITE.smsOptIn && (
              <FormField
                label="Email"
                name="email"
                variant="email"
                id={`${id}-email`}
                required
              />
            )}
          </FormFieldset>
        )}
        {!compact && fields !== "bid" && (
          <FormFieldset columns={2}>
            <FormField
              label="First name"
              name="firstName"
              variant="first-name"
              id={`${id}-first`}
              required
            />
            <FormField
              label="Last name"
              name="lastName"
              variant="last-name"
              id={`${id}-last`}
            />
            <FormField
              label="Email"
              name="email"
              variant="email"
              id={`${id}-email`}
              class={SITE.smsOptIn ? undefined : "lead-form_full"}
              required
            />
            {SITE.smsOptIn && (
              <FormField
                label="Phone"
                name="phone"
                variant="phone"
                id={`${id}-phone`}
                required
              />
            )}
          </FormFieldset>
        )}

        {stepped && !compact && !askedTimeline && (
          <FormSelect
            label="Timeline"
            name="timeline"
            options={timelineOptions.map((o) => ({ ...o, value: o.label }))}
            placeholderOption="Choose one"
            id={`${id}-timeline`}
          />
        )}

        {fields === "quote" && (
          <FormFieldset columns={2}>
            <FormSelect
              label="Project type"
              name="projectType"
              options={projectOptions.map((o) => ({ ...o, value: o.label }))}
              placeholderOption="Choose one"
              id={`${id}-project`}
            />
            <FormSelect
              label="Timeline"
              name="timeline"
              options={timelineOptions.map((o) => ({ ...o, value: o.label }))}
              placeholderOption="Choose one"
              id={`${id}-timeline`}
            />
          </FormFieldset>
        )}

        {insuranceDetails && (
          <Accordion closePrevious={false} class="lead-form_insurance">
            <AccordionItem
              question="Insurance-related project? Add details"
              size="small"
              tag="span"
            >
              <FormFieldset columns={2}>
                <FormField
                  label="Insurance company"
                  name="insuranceCompany"
                  variant="text"
                  autocomplete="off"
                  id={`${id}-insurer`}
                />
                <FormField
                  label="Claim number"
                  name="claimNumber"
                  variant="text"
                  autocomplete="off"
                  id={`${id}-claim`}
                />
              </FormFieldset>
            </AccordionItem>
          </Accordion>
        )}

        {fields !== "bid" && (
          <FormTextarea
            label={messageLabel}
            name="message"
            placeholder={messagePlaceholder}
            id={`${id}-message`}
          />
        )}

        {/* Bot trap: off-screen, out of the tab order, hidden from assistive
          tech. People never fill it; form-filling bots do. */}
        <div class="lead-form_trap" aria-hidden="true">
          <label for={`${id}-trap`}>Company website</label>
          <input
            type="text"
            name={HONEYPOT_FIELD}
            id={`${id}-trap`}
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <SmsConsent id={`${id}-consent`} />

        <Button
          type="submit"
          fullWidth={buttonWidth === "full"}
          ariaLabel={submitLabel}
        >
          {submitLabel}
        </Button>
      </Details>
    </Form>
  )
}

<style is:global>
  @layer components {
    /* ── Steps preset ─────────────────────────────────────────
       Without JS both steps show. The script adds .is-stepped to the form,
       then .is-step-2 once a tile is picked. */
    .lead-form_progress {
      display: grid;
      gap: var(--space-2);
      font-size: var(--text-tiny-size);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .lead-form_progress_bar {
      height: 0.375rem;
      overflow: hidden;
      border-radius: var(--radius-full);
      background-color: color-mix(in srgb, var(--text) 10%, transparent);
    }

    /* Its width is set inline (one step's share) and moved by the script. */
    .lead-form_progress_fill {
      display: block;
      height: 100%;
      border-radius: inherit;
      background-color: var(--heading-accent);
      transition: width 0.3s ease;
    }

    /* progress="steps": numbered step names; the current one gets the
       accent rule and full ink. Keyed off the classes the step script
       already sets, so no script change. */
    .lead-form_steps {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: 0;
      list-style: none;
    }

    .lead-form_steps_item {
      padding-bottom: var(--space-3);
      border-bottom: var(--border-width-main) solid var(--border);
      opacity: 0.6;
    }

    .lead-form_steps_number {
      margin-inline-end: var(--space-2);
    }

    .lead-form_wrap:not(.is-step-2) .lead-form_steps_item.is-step-1,
    .lead-form_wrap.is-step-2 .lead-form_steps_item.is-step-2 {
      border-bottom-color: var(--heading-accent);
      font-weight: var(--font-weight-medium);
      opacity: 1;
    }

    /* Photo tiles: photo on top, label and line under it. Wider minimum
       than the text tiles so three fit across a form column. */
    .lead-form_tiles.is-photo {
      grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
    }

    .lead-form_tile.is-photo {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      padding: 0;
      overflow: hidden;
      text-align: start;
    }

    /* Narrow: each photo tile becomes a row (photo left, text right), so
       three choices still fit in about one screen. */
    @container (width < 35em) {
      .lead-form_tile.is-photo {
        grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
        align-items: center;
      }
    }

    .lead-form_tile_body {
      display: grid;
      gap: var(--space-1);
    }

    .lead-form_step {
      min-width: 0;
      margin: 0;
      padding: 0;
      border: 0;
    }

    .lead-form_step.is-details {
      display: grid;
      gap: inherit;
    }

    .lead-form_step.is-choice {
      display: grid;
      gap: var(--space-4);
    }

    /* The script shows one step at a time with `hidden`; without JS every
       step shows. After the display rules above, which it must beat. */
    .lead-form_step[hidden] {
      display: none;
    }

    .lead-form_step_title {
      margin-bottom: var(--space-4);
      font-family: var(--h5-font-family);
      font-size: var(--h5-size);
      font-weight: var(--h5-weight);
      text-transform: var(--h5-text-transform);
      line-height: var(--h5-line-height);
    }

    /* Without the phone field, email has the row to itself. */
    .lead-form_full {
      grid-column: 1 / -1;
    }

    .lead-form_tiles {
      display: grid;
      /* Two across even on a phone, so the choices fit in one look. */
      grid-template-columns: repeat(auto-fill, minmax(min(7.5rem, 100%), 1fr));
      gap: var(--space-3);
    }

    .lead-form_tile {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 4.5rem;
      padding: var(--space-3);
      border: var(--border-width-main) solid var(--border);
      border-radius: var(--radius-main);
      text-align: center;
      cursor: pointer;
      transition:
        border-color 0.2s ease,
        background-color 0.2s ease;
    }

    /* Tiles with a line under the label ("A project at my own home"): wider,
       and read left to right. */
    .lead-form_tiles.is-described {
      grid-template-columns: repeat(auto-fill, minmax(min(14rem, 100%), 1fr));
    }

    .lead-form_tiles.is-described .lead-form_tile {
      align-items: start;
      justify-content: start;
      text-align: start;
    }

    /* The question's own line already spaces the tiles below it. */
    .lead-form_step_text {
      margin-top: calc(var(--space-2) * -1);
    }

    /* Bid preset: the scope checkboxes in a wrapping row. */
    .lead-form_scope {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-5);
    }

    .lead-form_back {
      justify-self: start;
    }

    .lead-form_tile_input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .lead-form_tile_label {
      font-weight: var(--font-weight-medium);
      line-height: 1.2;
    }

    .lead-form_tile:has(:checked) {
      border-color: var(--heading-accent);
      background-color: color-mix(
        in srgb,
        var(--heading-accent) 10%,
        transparent
      );
    }

    .lead-form_tile:has(:focus-visible) {
      outline: var(--focus-width) solid var(--color-focus-state);
      outline-offset: var(--focus-offset-outer);
    }

    @media (hover: hover) {
      .lead-form_tile:hover {
        border-color: var(--heading-accent);
      }
    }

    .lead-form_choice {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2) var(--space-3);
      margin: 0;
      padding: var(--space-3) var(--space-4);
      border-radius: var(--radius-main);
      background-color: color-mix(in srgb, var(--text) 5%, transparent);
    }

    .lead-form_choice[hidden] {
      display: none;
    }

    .lead-form_choice_text {
      min-width: 0;
    }

    /* A text link, not a box: the base button reset leaves the browser's
       border in place. */
    .lead-form_change {
      padding: 0;
      border: 0;
      background: none;
      font: inherit;
      font-weight: var(--font-weight-medium);
      color: var(--heading-accent);
      text-decoration: underline;
      text-underline-offset: 0.15em;
    }

    .lead-form_change:focus-visible {
      border-radius: var(--radius-xsmall);
      outline: var(--focus-width) solid var(--color-focus-state);
      outline-offset: var(--focus-offset-outer);
    }

    @media (prefers-reduced-motion: reduce) {
      .lead-form_progress_fill,
      .lead-form_tile {
        transition: none;
      }
    }

    /* Off-screen rather than display:none — some bots skip fields that are
       display:none, but fill anything positioned. */
    .lead-form_trap {
      position: absolute;
      inset-inline-start: -100vw;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
    }
  }
</style>

<script>
  /* Steps preset: show one step at a time. Picking a tile moves to the next
     step; the last is the details (focusing the first field). "Back" goes
     one step back, "Change" back to the first. */
  function initLeadSteps() {
    /* .lead-form_wrap is Form's outer wrapper (not the <form>); the step
       classes go on it, which is what the CSS keys off. */
    for (const form of document.querySelectorAll<HTMLElement>(
      ".lead-form_wrap:not([data-steps-init])",
    )) {
      const choice = form.querySelector<HTMLElement>("[data-step-choice]");
      if (!choice) continue;
      form.dataset.stepsInit = "true";
      form.classList.add("is-stepped");
      const label = form.querySelector<HTMLElement>("[data-step-label]");
      const number = form.querySelector<HTMLElement>("[data-step-number]");
      const fill = form.querySelector<HTMLElement>(".lead-form_progress_fill");
      const steps = [
        ...form.querySelectorAll<HTMLElement>(".lead-form_step[data-step]"),
      ].sort((a, b) => Number(a.dataset.step) - Number(b.dataset.step));
      const total = steps.length;
      let current = 1;

      const go = (step: number, focus = true) => {
        current = step;
        steps.forEach((el, i) => (el.hidden = i + 1 !== step));
        /* is-step-2 = on the details step (the named-steps styling keys
           off it). */
        form.classList.toggle("is-step-2", step === total);
        if (number) number.textContent = String(step);
        if (fill) fill.style.width = `${(step / total) * 100}%`;
        choice.hidden = step !== total;
        if (step === total && label)
          label.textContent = [
            ...form.querySelectorAll<HTMLInputElement>(
              ".lead-form_tile_input:checked",
            ),
          ]
            .map((input) => input.value)
            .join(" · ");
        if (!focus) return;
        const here = steps[step - 1];
        if (step === total)
          here
            ?.querySelector<HTMLElement>(
              "input:not([type=hidden]), select, textarea",
            )
            ?.focus();
        else
          (
            here?.querySelector<HTMLInputElement>(
              ".lead-form_tile_input:checked",
            ) ?? here?.querySelector<HTMLInputElement>(".lead-form_tile_input")
          )?.focus();
      };
      go(1, false);

      /* A click or tap on a tile moves on; so do Enter and Space. Arrow keys
         only select (radio groups select on every arrow press), so keyboard
         users can look through the tiles before choosing. */
      let pointer = false;
      for (const input of form.querySelectorAll<HTMLInputElement>(
        ".lead-form_tile_input",
      )) {
        const step = Number(
          input.closest<HTMLElement>(".lead-form_step")?.dataset.step ?? 1,
        );
        const choose = () => go(Math.min(step + 1, total));
        /* After "Back", tapping the tile that's already picked fires no
           change event; the click still moves on. */
        let wasChecked = false;
        input
          .closest(".lead-form_tile")
          ?.addEventListener("pointerdown", () => {
            pointer = true;
            wasChecked = input.checked;
          });
        input.addEventListener("change", () => {
          if (pointer) choose();
          pointer = false;
        });
        input.addEventListener("click", () => {
          if (pointer && wasChecked) choose();
          if (wasChecked) pointer = false;
          wasChecked = false;
        });
        input.addEventListener("keydown", (event) => {
          if (event.key !== "Enter" && event.key !== " ") return;
          event.preventDefault();
          input.checked = true;
          choose();
        });
      }
      form
        .querySelector("[data-step-back]")
        ?.addEventListener("click", () => go(1));
      for (const back of form.querySelectorAll("[data-step-prev]"))
        back.addEventListener("click", () => go(Math.max(current - 1, 1)));
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initLeadSteps);
  } else {
    initLeadSteps();
  }
</script>
