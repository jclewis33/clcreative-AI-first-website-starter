---
import type { HTMLAttributes } from "astro/types";
/**
 * Form — wrapper component for the `<form>` element, with async submit.
 *
 * Renders `.form_wrap` > `<form class="form_element">` with an open slot for
 * field components. Submission is handled by a small script driving a
 * `data-state` machine on the wrapper — `idle → sending → sent | failed`:
 * the fields are validated (`checkValidity`), posted with `fetch` to
 * `action`, the submit button is disabled while sending, and the success /
 * error notes (`role="status"` / `role="alert"`) show from the state alone.
 * Without JS the form still posts natively to `action`.
 *
 * With no `action`, the form sends nothing and reports success — placeholder
 * behavior for a starter; wire `action` to a real endpoint per project.
 *
 * @example
 * ```astro
 * <Form name="contact" action="/api/contact"
 *   successMessage="Thanks!" errorMessage="Something went wrong.">
 *   <FormFieldset columns={2}>
 *     <FormField label="First Name" name="first-name" variant="first-name" required />
 *     <FormField label="Last Name" name="last-name" variant="last-name" required />
 *   </FormFieldset>
 *   <Button type="submit" ariaLabel="Send">Submit</Button>
 * </Form>
 * ```
 */

interface Props extends HTMLAttributes<"form"> {
  /**
   * Form name — used as the `name` attribute on the `<form>` element.
   */
  name?: string;

  /**
   * Where the form posts. The submit script fetches this URL with the form
   * data; without JS the form posts to it natively. Omitted, the form sends
   * nothing and reports success (placeholder mode).
   */
  action?: string;

  /**
   * HTTP method.
   * @default 'POST'
   */
  method?: "GET" | "POST";

  /**
   * Success message shown in place of the fields once the form has sent
   * (`data-state="sent"`).
   */
  successMessage?: string;

  /**
   * Error message shown beneath the fields when submission fails
   * (`data-state="failed"`).
   */
  errorMessage?: string;

  /** HTML `id` attribute on the outer wrapper. */
  id?: string;

  /** Extra classes on the outer `.form_wrap` element. */
  class?: string;
}

const {
  name,
  action,
  method = "POST",
  successMessage,
  errorMessage,
  id,
  class: className,
  ...rest
} = Astro.props;
---

<div
  class:list={["form_wrap", className]}
  id={id}
  data-state="idle"
  data-endpoint={action}
>
  <form
    class="form_element"
    name={name}
    action={action}
    method={method}
    {...rest}
  >
    <slot />
  </form>

  {
    successMessage && (
      <div class="form_success_wrap" role="status">
        <p class="form_success_text">{successMessage}</p>
      </div>
    )
  }

  {
    errorMessage && (
      <div class="form_error_wrap" role="alert">
        <p class="form_error_text">{errorMessage}</p>
      </div>
    )
  }
</div>

<script>
  /* Async submit: validate → fetch → flip data-state. The notes' visibility
     is pure CSS keyed off the state (see forms.css). With no data-endpoint
     the form "sends" nothing and reports success — placeholder mode. */
  function initForms() {
    for (const wrap of document.querySelectorAll<HTMLElement>(
      ".form_wrap[data-state]",
    )) {
      if (wrap.dataset.formInit) continue;
      wrap.dataset.formInit = "true";

      const form = wrap.querySelector<HTMLFormElement>(".form_element");
      if (!form) continue;

      const submit = form.querySelector<HTMLButtonElement | HTMLInputElement>(
        'button:not([type]), button[type="submit"], input[type="submit"]',
      );

      form.addEventListener("submit", async (event) => {
        /* Invalid → let the browser show its native validation UI. */
        if (!form.checkValidity()) return;

        event.preventDefault();
        wrap.dataset.state = "sending";
        if (submit) submit.disabled = true;

        try {
          const endpoint = wrap.dataset.endpoint;
          if (endpoint) {
            const answer = await fetch(endpoint, {
              method: form.method || "post",
              body: new FormData(form),
              headers: { Accept: "application/json" },
            });
            if (!answer.ok) throw new Error(String(answer.status));
          }
          wrap.dataset.state = "sent";
          form.reset();
        } catch {
          wrap.dataset.state = "failed";
          if (submit) submit.disabled = false;
        }
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initForms);
  } else {
    initForms();
  }
</script>
