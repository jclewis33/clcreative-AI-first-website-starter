---
import type { HTMLAttributes } from "astro/types";
/**
 * FormCheckbox — custom checkbox (native input + plain CSS).
 *
 * When the native `<input>` is `:checked`, `.form_ui_item:has(:checked)`
 * styles the border, background, and checkmark icon transitions — plain CSS, no variables.
 *
 * @example
 * ```astro
 * <FormCheckbox label="I agree to the terms" name="terms" required />
 *
 * <!-- Sliding switch -->
 * <FormCheckbox label="Email me updates" name="updates" variant="toggle" />
 *
 * <!-- Chips in a flex row: the whole control fills when chosen -->
 * <div class="u-flex u-flex-wrap u-gap-4">
 *   <FormCheckbox label="Design" name="interests" value="design" variant="chip" />
 *   <FormCheckbox label="Development" name="interests" value="dev" variant="chip" />
 * </div>
 * ```
 */

type ChoiceVariant =
  /** A box beside the text (default) */
  | "default"
  /** A switch that slides */
  | "toggle"
  /** The whole control reads as one piece and fills when chosen */
  | "chip";

interface Props extends HTMLAttributes<"input"> {
  /** Label text displayed next to the checkbox. */
  label: string;

  /**
   * How the control is drawn.
   * - `default` — a box beside the text
   * - `toggle` — a switch that slides
   * - `chip` — the whole control reads as one piece and fills when chosen
   *
   * @default 'default'
   * @example variant="chip"
   */
  variant?: ChoiceVariant;

  /** HTML `name` attribute. */
  name: string;

  /**
   * Form value when checked.
   * @default 'on'
   */
  value?: string;

  /**
   * Whether the checkbox starts checked.
   * @default false
   */
  checked?: boolean;

  /**
   * Whether the field is required.
   * @default false
   */
  required?: boolean;

  /**
   * Disabled state.
   * @default false
   */
  disabled?: boolean;

  /** HTML `id` attribute. Auto-generated if not provided. */
  id?: string;

  /** Extra classes on the outer `.form_ui_item` wrapper. */
  class?: string;
}

const {
  label,
  name,
  variant = "default",
  value = "on",
  checked = false,
  required = false,
  disabled = false,
  id,
  class: className,
  ...rest
} = Astro.props;

const fieldId = id || `field-${name}-${value}`;
---

<div
  class:list={[
    "form_ui_item",
    variant !== "default" && `is-${variant}`,
    className,
  ]}
>
  <label class="form_ui_label" for={fieldId}>
    <input
      class="form_ui_input u-sr-only"
      type="checkbox"
      name={name}
      id={fieldId}
      value={value}
      checked={checked}
      required={required}
      disabled={disabled}
      {...rest}
    />

    <span class="form_ui_visual_wrap" aria-hidden="true">
      <svg class="form_ui_visual_icon" viewBox="0 0 11 8" fill="none">
        <path
          d="M1 4L4 7L10 1"
          stroke="currentColor"
          vector-effect="non-scaling-stroke"
          stroke-width="0.125rem"></path>
      </svg>
    </span>

    <span class="form_ui_text">{label}</span>
  </label>
</div>
