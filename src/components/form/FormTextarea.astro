---
import type { HTMLAttributes } from "astro/types";
/**
 * FormTextarea — label + auto-growing textarea for multiline text input.
 *
 * The field grows with its content between `minLines` and `maxLines`
 * (CSS `field-sizing: content` where supported; elsewhere it starts at
 * `minLines` tall and can be resized by hand). The field border transitions
 * to --text on :focus-within.
 *
 * @example
 * ```astro
 * <!-- Default label above the textarea -->
 * <FormTextarea label="Message" name="message" required
 *   placeholder="Tell us about your project..." />
 *
 * <!-- Taller start, capped growth -->
 * <FormTextarea label="Brief" name="brief" minLines={5} maxLines={16} />
 *
 * <!-- Floating label (sits inside field, floats up on focus/value) -->
 * <FormTextarea label="Message" name="message" labelVariant="floating" />
 * ```
 */

interface Props extends HTMLAttributes<"textarea"> {
  /** Label text for the textarea. */
  label: string;

  /** HTML `name` attribute. */
  name: string;

  /** Placeholder text. */
  placeholder?: string;

  /**
   * Whether the field is required.
   * @default false
   */
  required?: boolean;

  /**
   * Disabled state.
   * @default false
   */
  disabled?: boolean;

  /**
   * Label display variant.
   * - `'default'` — Label shows above the textarea
   * - `'hidden'` — Label is visually hidden (still accessible to screen readers)
   * - `'floating'` — Label sits inside the field as a placeholder, then floats
   *   up above the border when the field is focused or contains a value
   * @default 'default'
   */
  labelVariant?: "default" | "hidden" | "floating";

  /** Default value. */
  value?: string;

  /**
   * How short the field may be, in lines of text. The field starts this
   * tall and grows with content.
   * @default 3
   */
  minLines?: number;

  /**
   * How tall the field grows before it scrolls, in lines of text.
   * @default 12
   */
  maxLines?: number;

  /**
   * Number of visible text rows. Legacy alias for `minLines` — prefer
   * `minLines`, which also drives the auto-grow floor.
   * @default 5
   */
  rows?: number;

  /** Helper text displayed below the textarea. */
  helperText?: string;

  /** Error text displayed below the textarea. */
  errorText?: string;

  /** HTML `id` attribute. Auto-generated if not provided. */
  id?: string;

  /** Extra classes on the outer `.form_label_wrap` element. */
  class?: string;
}

const {
  label,
  name,
  placeholder,
  required = false,
  disabled = false,
  labelVariant = "default",
  value,
  minLines,
  maxLines = 12,
  rows,
  helperText,
  errorText,
  id,
  class: className,
  ...rest
} = Astro.props;

const fieldId = id || `field-${name}`;
const describedById = helperText || errorText ? `${fieldId}-hint` : undefined;
const isFloating = labelVariant === "floating";
const resolvedPlaceholder = isFloating ? placeholder || " " : placeholder;
/* minLines wins; the legacy rows prop feeds it so old call sites keep their
   height as the growth floor. */
const resolvedMinLines = minLines ?? rows ?? 3;
const linesStyle = `--_min-lines: ${resolvedMinLines}; --_max-lines: ${maxLines};`;
---

<div class:list={["form_label_wrap", isFloating && "is-floating", className]}>
  <label
    class:list={["form_label_text", labelVariant === "hidden" && "u-sr-only"]}
    for={fieldId}
  >
    {label}
    {
      required && (
        <span class="form_required" aria-hidden="true">
          *
        </span>
      )
    }
  </label>

  <textarea
    class="form_field is-textarea"
    name={name}
    id={fieldId}
    placeholder={resolvedPlaceholder}
    required={required}
    disabled={disabled}
    rows={resolvedMinLines}
    style={linesStyle}
    aria-describedby={describedById}
    aria-invalid={errorText ? "true" : undefined}
    {...rest}>{value}</textarea
  >

  {
    (helperText || errorText) && (
      <p
        class:list={["form_helper_text", errorText && "is-error"]}
        id={describedById}
      >
        {errorText || helperText}
      </p>
    )
  }
</div>
