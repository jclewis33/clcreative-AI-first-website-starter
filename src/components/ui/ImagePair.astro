---
import type { ImageMetadata } from "astro";
import Visual from "@/components/ui/Visual.astro";

/** One photo in the pair. */
type ImagePairImage = {
  /** The photo (an import or a URL). */
  src: ImageMetadata | string;
  /** Real alt text — what the photo shows. */
  alt: string;
  /** Short caption under the photo. Shown by the `polaroid` variant only. */
  caption?: string;
};

type ImagePairVariant =
  /** Two portrait photos side by side, the second dropped lower */
  | "default"
  /** Two white-framed prints, slightly tilted, the second overlapping the first's corner, captions on the frames */
  | "polaroid";

interface Props {
  /**
   * **ImagePair** — two photos as a pair. Used by ServiceArea (when there's
   * no map) and IncludedList.
   *
   * - `images` — exactly two `{ src, alt, caption? }` (imported images or URLs)
   * - `variant` — `default`: two portrait photos side by side, the second
   *   dropped lower for an offset, editorial look (the offset goes away on
   *   narrow containers). `polaroid`: the photo-journal look — each photo in
   *   a print frame with its caption on the thick bottom edge, slightly
   *   tilted, the second print overlapping the first's corner. It makes
   *   phone photos of the job look intentional.
   *
   * @example
   * <ImagePair images={[{ src: deck, alt: "New cedar deck" }, { src: patio, alt: "Paver patio at dusk" }]} />
   *
   * @example
   * <ImagePair variant="polaroid" images={[{ src: crew, alt: "Crew tearing off the old roof", caption: "Tear-off day" }, { src: ridge, alt: "New ridge cap close up", caption: "A closer look" }]} />
   */
  docs?: string;

  /** Set to `false` to skip rendering. @default true */
  render?: boolean;

  /** Exactly two photos. Fewer renders nothing; extras are ignored. */
  images: ImagePairImage[];

  /** `default` (offset portraits) or `polaroid` (tilted framed prints with captions). @default 'default' */
  variant?: ImagePairVariant;

  /** Extra classes on the wrapper. */
  class?: string;
}

const {
  docs,
  render = true,
  images = [],
  variant = "default",
  class: className,
} = Astro.props;
const pair = images.slice(0, 2);
const isPolaroid = variant === "polaroid";

if (import.meta.env.DEV && render && (Astro.props.images?.length ?? 0) !== 2) {
  console.warn(
    `[ImagePair] Expects exactly 2 images, got ${Astro.props.images?.length ?? 0}.`,
  );
}
if (import.meta.env.DEV && !["default", "polaroid"].includes(variant)) {
  console.warn(`[ImagePair] Unknown variant "${variant}"; using "default".`);
}
---

{
  render && pair.length === 2 && !isPolaroid && (
    <div class:list={["image-pair_wrap", className]}>
      <div class="image-pair_layout">
        <Visual
          src={pair[0].src}
          alt={pair[0].alt}
          ratio="portrait"
          class="image-pair_img"
        />
        <Visual
          src={pair[1].src}
          alt={pair[1].alt}
          ratio="portrait"
          class="image-pair_img is-offset"
        />
      </div>
    </div>
  )
}
{
  render && pair.length === 2 && isPolaroid && (
    <div class:list={["image-pair_wrap is-polaroid", className]}>
      <div class="image-pair_layout">
        {pair.map((image, i) => (
          <figure
            class:list={[
              "image-pair_print u-background-2 u-box-shadow-large",
              i === 1 && "is-second",
            ]}
          >
            <Visual
              src={image.src}
              alt={image.alt}
              ratio={i === 0 ? "landscape" : "portrait"}
              radius="none"
              class="image-pair_img"
            />
            {image.caption && (
              <figcaption class="image-pair_caption u-text-style-small u-text-style-muted">
                {image.caption}
              </figcaption>
            )}
          </figure>
        ))}
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    .image-pair_wrap {
      container-type: inline-size;
    }

    .image-pair_layout {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
      gap: var(--space-3);
    }

    .image-pair_img.is-offset {
      margin-top: var(--space-6);
    }

    @container (max-width: 35em) {
      .image-pair_img.is-offset {
        margin-top: 0;
      }
    }

    /* ── Polaroid: two framed prints. The first is the big landscape print,
       the second a smaller portrait print laid over its lower-right corner.
       The frame is the theme's elevated surface, so it reads as white paper
       on a light section and stays legible on a dark one. ── */
    .image-pair_wrap.is-polaroid .image-pair_layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 0;
      /* Room for the rotated corners so they never clip or overflow. */
      padding: var(--space-3);
    }

    .image-pair_print {
      --_frame: 0.75em;
      grid-row: 1;
      margin: 0;
      padding: var(--_frame) var(--_frame) 0;
    }

    .image-pair_print:not(.is-second) {
      grid-column: 1 / span 10;
      rotate: -1.5deg;
    }

    .image-pair_print.is-second {
      grid-column: 8 / span 5;
      align-self: end;
      margin-bottom: calc(var(--space-8) * -1);
      rotate: 2.5deg;
      z-index: 1;
    }

    /* The thick bottom edge of the print, holding the caption. */
    .image-pair_caption {
      padding-block: 0.75em;
      margin: 0;
    }

    .image-pair_print:not(:has(.image-pair_caption)) {
      padding-bottom: calc(var(--_frame) * 3.5);
    }

    /* Leave room under the layout for the second print hanging below. */
    .image-pair_wrap.is-polaroid {
      padding-bottom: var(--space-8);
    }

    @container (max-width: 35em) {
      .image-pair_print {
        --_frame: 0.5em;
      }

      .image-pair_print:not(.is-second) {
        grid-column: 1 / span 11;
        rotate: -1deg;
      }

      .image-pair_print.is-second {
        grid-column: 7 / span 6;
        margin-bottom: calc(var(--space-6) * -1);
        rotate: 1.5deg;
      }

      .image-pair_wrap.is-polaroid {
        padding-bottom: var(--space-6);
      }
    }
  }
</style>
