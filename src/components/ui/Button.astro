---
import type { HTMLAttributes } from "astro/types";
/**
 * Button — a theme-aware button component.
 *
 * Uses the wrapper pattern: an outer wrapper sets border-radius and is
 * the hover/focus target, a clickable overlay (`<a>` or `<button>`) handles
 * interaction, and a visual element displays the label and icon.
 *
 * **Variants** control colour and shape via `data-button-variant`:
 * - `primary`   — filled button using `--button-primary-*` theme tokens (default)
 * - `secondary` — outlined / ghost using `--button-secondary-*` theme tokens
 * - `text`      — text-link style, no background, bottom-border only
 *
 * **Sizes** control padding via `data-button-size`:
 * - `default` — standard padding (no attribute emitted)
 * - `small`   — compact
 * - `large`   — prominent CTA
 *
 * Colour transitions are plain CSS — `.button_main_wrap:hover` /
 * `:focus-visible` swap the theme tokens, no JavaScript required.
 * Buttons automatically adapt to `data-theme="light|dark|brand"` on any ancestor.
 *
 * @example Primary link button (most common)
 * ```astro
 * <Button href="/contact" ariaLabel="Contact us">Contact Us</Button>
 * ```
 *
 * @example Secondary button
 * ```astro
 * <Button variant="secondary" href="/about" ariaLabel="Learn more about us">
 *   Learn More
 * </Button>
 * ```
 *
 * @example Text-link button
 * ```astro
 * <Button variant="text" href="/blog" ariaLabel="Read more articles">
 *   Read more
 * </Button>
 * ```
 *
 * @example Submit button (form)
 * ```astro
 * <Button type="submit" ariaLabel="Submit the form">Send Message</Button>
 * ```
 *
 * @example Large CTA with icon
 * ```astro
 * <Button href="/start" size="large" ariaLabel="Get started now">
 *   Get Started
 *   <svg slot="icon" aria-hidden="true" viewBox="0 0 10 10" fill="none"
 *     stroke="currentColor" stroke-width="1.5">
 *     <line x1="0" y1="5" x2="8" y2="5" />
 *     <polyline points="5,2 8,5 5,8" />
 *   </svg>
 * </Button>
 * ```
 *
 * @example Disabled button
 * ```astro
 * <Button disabled ariaLabel="Currently unavailable">Unavailable</Button>
 * ```
 *
 * @example Square (no radius) secondary button
 * ```astro
 * <Button variant="secondary" square href="/pricing" ariaLabel="View pricing">
 *   Pricing
 * </Button>
 * ```
 */

/**
 * Visual style variant.
 * - `'primary'`   — filled button with brand colours (default)
 * - `'secondary'` — outlined / ghost button
 * - `'text'`      — text-link style, no background or side borders
 */

/* ── Props contract ──────────────────────────────────────────────────────────
   Keep the JSDoc below free of STRAY angle brackets. Write comparisons in
   words ("posts.length is greater than 0"), never with the literal character.
   A stray less-than or greater-than in a frontmatter comment silently detaches
   this file's Props type AT THE CALL SITE: every prop loses its hover tooltip
   and invalid props stop erroring, with no diagnostic anywhere. Balanced
   tag-like pairs inside @example blocks are safe — it is the odd one out that
   breaks it, and the exact trigger interacts with the rest of the file, so do
   not reason about it — measure it.
   scripts/hover-probe.mjs drives the real language server and fails if any
   component's `docs` tooltip goes missing; run `npm run check:hover`.
   Plain `tsc` was never fooled, which is why src/lib/prop-contracts.test-d.ts
   pins the type rules: it imports the types from this file and a regression
   fails `astro check` outright.
   ─────────────────────────────────────────────────────────────────────────── */
type ButtonVariant = "primary" | "secondary" | "text";

/**
 * Size preset.
 * - `'default'` — standard padding (.9rem 1.5rem)
 * - `'small'`   — compact padding (.55rem 1.25rem)
 * - `'large'`   — prominent padding (1rem 2rem)
 */
type ButtonSize = "default" | "small" | "large";

/**
 * Override which theme's hover tokens the button uses.
 * Useful when a button sits inside a different-themed container
 * (e.g. a brand-coloured button on a dark card that shouldn't hover to white).
 */
type ButtonHoverTheme = "light" | "dark" | "brand";

/**
 * Button — theme-aware, trigger-driven button using the wrapper pattern.
 *
 * Renders as `<a>` when `href` is set, `<button>` otherwise.
 * Automatically adapts to `data-theme="light|dark|brand"` on any ancestor.
 *
 * **Props:**
 * - `variant` — visual style: primary (filled), secondary (outlined), text (link style) (default: `'primary'`)
 * - `size` — padding preset: default, small, large (default: `'default'`)
 * - `href` — turns into a link (`<a>` tag)
 * - `newTab` — open link in new tab (default: `false`)
 * - `disabled` — disable the button, not links (default: `false`)
 * - `ariaLabel` — accessible name for ICON-ONLY buttons (visible text is the name otherwise)
 * - `type` — native button type: button, submit, reset (default: `'button'`)
 * - `square` — remove pill radius (default: `false`)
 * - `id` — HTML id on wrapper
 * - `class` — extra classes on wrapper
 * - standard DOM attributes of the rendered element — spread onto the root `<a>`/`<button>` (e.g. `data-modal-trigger`)
 *
 * **Slots:** default (label text), `icon` (rendered after label).
 *
 * @example Button with supporting copy
 * ```astro
 * <Button href="/book-a-call" ariaLabel="Book a call" supportText="No credit card required">
 *   Get Started
 * </Button>
 * ```
 */
/* Props are a DISCRIMINATED UNION on `href`, following the Lumos pattern:
   the presence of href picks the <a> branch, its absence picks the <button>
   branch, and each branch pulls in the real DOM attributes for that element
   via HTMLAttributes. Props that only make sense on the other branch are
   typed `never`, so misuse is an editor error at the call site:

     <Button type="submit" href="/x">   ❌ type is a button-only prop
     <Button newTab>                    ❌ newTab needs an href
     <Button disabled href="/x">        ❌ links cannot be disabled

   There is deliberately NO index signature — the old `[key: string]: any`
   made every typo type-check. Arbitrary `data-*` attributes still pass
   (HTMLAttributes carries a `data-\${string}` index), and standard DOM
   attributes (`style`, `aria-*`, `id`, `class`) are inherited and CHECKED. */
interface BaseProps {
  /**
   * **Button props:**
   * - `variant` — `'primary'` | `'secondary'` | `'text'` (default `'primary'`)
   * - `size` — `'default'` | `'small'` | `'large'` (default `'default'`)
   * - `href` — link URL (renders `<a>`; without it renders `<button>`)
   * - `newTab` — open in new tab (link buttons only)
   * - `disabled` / `type` — native button behavior (non-link buttons only)
   * - `ariaLabel` — accessible name for ICON-ONLY buttons (ignored when the
   *   button has visible text — the text is the accessible name)
   * - `square` — removes pill radius
   * - `fullWidth` — stretches button to 100% width (default `false`)
   * - `hoverTheme` — `'light'` | `'dark'` | `'brand'` — hover tokens override
   * - `supportText` — small muted line under the button
   * - Also accepts the standard attributes of the element it renders
   *   (`style`, `data-*`, `aria-*`, …) — spread onto the root `<a>`/`<button>`
   *
   * **Slots:** default (label text), `icon` (after label)
   */
  docs?: string;

  /**
   * Visual style of the button.
   *
   * | Value | Description |
   * |-------|-------------|
   * | `'primary'` | Filled button — uses `--button-primary-*` theme tokens. |
   * | `'secondary'` | Outlined / ghost — uses `--button-secondary-*` theme tokens. |
   * | `'text'` | Text-link style — no background, bottom border only, draws its own chevron. Uses `--link-*` theme tokens. |
   *
   * @default 'primary'
   */
  variant?: ButtonVariant;

  /**
   * Size preset — controls padding on the button element.
   *
   * | Value | Padding |
   * |-------|---------|
   * | `'default'` | `.9rem 1.5rem` |
   * | `'small'` | `.55rem 1.25rem` |
   * | `'large'` | `1rem 2rem` |
   *
   * @default 'default'
   */
  size?: ButtonSize;

  /**
   * Accessible name override.
   *
   * - **Icon-only button** (no visible text): REQUIRED — there is nothing
   *   else to announce.
   * - **Button with visible text**: optional. Use it to disambiguate repeated
   *   labels — six "Learn more" links become "Learn more about Essentials
   *   Package", etc. WCAG 2.5.3 ("Label in Name") requires the label to
   *   CONTAIN the visible text: start it with the words on the button. A
   *   dev-only browser check warns on labels that don't.
   *
   * @example ariaLabel="Learn more about Essentials Package"
   */
  ariaLabel?: string;

  /**
   * Removes the default pill radius (sets `border-radius: 0`).
   * Applies the `button_main_wrap--no-radius` modifier.
   * @default false
   */
  square?: boolean;

  /**
   * Stretches the button to 100% width of its parent (block display).
   * By default buttons are `inline-block` and shrink-wrap their content.
   * @default false
   */
  fullWidth?: boolean;

  /**
   * Override which theme's hover tokens the button uses.
   * Useful when a button sits inside a container whose theme
   * would produce an awkward hover — e.g. a brand primary button
   * on a dark card that hovers to white by default.
   *
   * | Value | Effect |
   * |-------|--------|
   * | `'light'` | Hover uses the light theme's button tokens (hover to dark) |
   * | `'dark'`  | Hover uses the dark theme's button tokens (hover to white) |
   * | `'brand'` | Hover uses the brand theme's button tokens (subtle darken) |
   */
  hoverTheme?: ButtonHoverTheme;

  /**
   * Optional supporting copy displayed below the button.
   * When omitted, no extra element is rendered.
   * Renders as a small, muted text line beneath the button.
   *
   * @example
   * ```astro
   * <Button href="/book-a-call" ariaLabel="Book a call" supportText="No credit card required">
   *   Get Started
   * </Button>
   * ```
   */
  supportText?: string;
}

export type Props = BaseProps &
  (
    | ({
        /** Link URL — this branch renders an `<a>`. */
        href: string;
        /**
         * Opens the link in a new tab; adds `rel="noopener noreferrer"`.
         * @default false
         */
        newTab?: boolean;
        /** Button-only prop — a link has no form type. */
        type?: never;
        /** Button-only prop — a link cannot be disabled; omit the href instead. */
        disabled?: never;
      } & HTMLAttributes<"a">)
    | ({
        /** No href — this branch renders a `<button>`. */
        href?: never;
        /** Link-only prop — a `<button>` has no destination to open in a tab. */
        newTab?: never;
        /**
         * Native button type. `'submit'` submits the nearest form.
         * @default 'button'
         */
        type?: "button" | "submit" | "reset";
        /**
         * Disables the button: `opacity: 0.4`, `cursor: not-allowed` via
         * `.button_main_wrap:disabled`; a native disabled button also stops
         * receiving pointer and keyboard events on its own.
         * @default false
         */
        disabled?: boolean;
      } & HTMLAttributes<"button">)
  );

/* The strict union is for CALLERS. Inside the component TypeScript cannot
   know which branch it is in, so the implementation reads props through this
   flat, permissive shape instead — the standard companion to a discriminated
   union (Lumos does the same). */
type AllProps = BaseProps & {
  href?: string;
  newTab?: boolean;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  id?: string;
  class?: string;
};

const {
  docs,
  variant = "primary",
  size = "default",
  href,
  newTab = false,
  disabled = false,
  ariaLabel,
  type = "button",
  square = false,
  fullWidth = false,
  hoverTheme,
  supportText,
  id,
  class: className,
  ...rest
} = Astro.props as AllProps;

/* Renders as <a> when an href is provided, otherwise a plain <button> — for
   modal triggers/closes (data-modal-trigger / data-modal-close), form submits,
   or any on-page JS action. Those attributes flow through `...rest` onto the
   element below; there is no default navigation. */
const resolvedHref = href;

/* Icon-only? Then the button has no visible text and needs an aria-label.

   This asks whether a default slot EXISTS — it never renders one. Rendering a
   slot from frontmatter forces its children to render before Astro has
   finished setting up the render context, and if anything in there is an
   <Image>, the image service is not ready yet and getImage() throws
   "Cannot read properties of undefined (reading 'validateOptions')". That is a
   real crash in `astro dev`, and it only shows on the FIRST page rendered
   after the server starts — which makes it look intermittent. Never call
   Astro.slots.render() in frontmatter. */
const isIconOnly = !Astro.slots.has("default");

/* The accessible name. ariaLabel is emitted whenever it is passed:
   - Icon-only button → it is REQUIRED (there is no visible text to announce).
   - Button with visible text → it is allowed, and useful for disambiguating
     repeated labels ("Learn more" × 6 → "Learn more about Essentials
     Package"). WCAG 2.5.3 ("Label in Name") only demands that the label
     CONTAIN the visible text; a containing label passes and helps.
   The failure mode is a label that does NOT contain the visible text — voice
   control users say what they see and nothing matches. That cannot be checked
   here (reading the slot means rendering it in frontmatter, which crashes the
   image service — see the isIconOnly note above), so a dev-only script below
   checks the RENDERED DOM in the browser instead and flags real mismatches. */
const resolvedAriaLabel = ariaLabel ?? undefined;

/* Wrapper classes */
/* Array + class:list (the project's one class-merge idiom — see CLAUDE.md).
   class:list drops the falsy entries itself. */
const wrapClasses = [
  "button_main_wrap",
  square && "button_main_wrap--no-radius",
  fullWidth && "button_main_wrap--full-width",
  className,
];

/* Data attributes for variant/size (CSS selectors in buttons.css) */
const dataVariant = variant;
const dataSize = size !== "default" ? size : undefined;
const dataHoverTheme = hoverTheme || undefined;

/* Security defaults for external links */
const linkRel = newTab ? "noopener noreferrer" : undefined;
const linkTarget = newTab ? "_blank" : undefined;

/* Check if icon slot is used */
const hasIcon = Astro.slots.has("icon");
/* Element + attributes. An href renders an <a>; otherwise a <button> for modal
   triggers/closes, form submits, or JS actions. */
const Tag = resolvedHref ? "a" : "button";
const tagAttrs = resolvedHref
  ? { href: resolvedHref, target: linkTarget, rel: linkRel }
  : { type, disabled };
---

{
  supportText ? (
    <div class="button_support_wrap">
      <Tag
        class:list={wrapClasses}
        data-button-variant={dataVariant}
        data-button-size={dataSize}
        data-button-hover={dataHoverTheme}
        data-button
        id={id}
        aria-label={resolvedAriaLabel}
        {...tagAttrs}
        {...rest}
      >
        <span class="button_main_element">
          <span class="button_main_text">
            <slot />
          </span>
          {hasIcon && (
            <span class="button_main_icon">
              <slot name="icon" />
            </span>
          )}
        </span>
      </Tag>
      <p class="button_support_text u-text-style-small u-text-style-muted">
        {supportText}
      </p>
    </div>
  ) : (
    <Tag
      class:list={wrapClasses}
      data-button-variant={dataVariant}
      data-button-size={dataSize}
      data-button-hover={dataHoverTheme}
      data-button
      id={id}
      aria-label={resolvedAriaLabel}
      {...tagAttrs}
      {...rest}
    >
      <span class="button_main_element">
        <span class="button_main_text">
          <slot />
        </span>
        {hasIcon && (
          <span class="button_main_icon">
            <slot name="icon" />
          </span>
        )}
      </span>
    </Tag>
  )
}

<script>
  /* Dev-only WCAG 2.5.3 ("Label in Name") check. A button's aria-label must
     CONTAIN its visible text — voice-control users say what they see, and a
     label like "View archive" on a button reading "All Posts" leaves them with
     nothing to match. This cannot be validated in frontmatter (reading the
     slot there means rendering it, which crashes Astro's image service), so it
     runs against the rendered DOM in the browser. Vite strips the whole block
     from production builds — import.meta.env.DEV is a compile-time constant. */
  if (import.meta.env.DEV) {
    const norm = (t: string) =>
      t
        .toLowerCase()
        .replace(/[^a-z0-9 ]/gi, " ")
        .replace(/\s+/g, " ")
        .trim();
    const check = () => {
      document
        .querySelectorAll<HTMLElement>("[data-button][aria-label]")
        .forEach((el) => {
          const label = el.getAttribute("aria-label") ?? "";
          const text = norm(el.textContent ?? "");
          if (text && !norm(label).includes(text)) {
            console.warn(
              `[Button] WCAG 2.5.3: aria-label "${label}" does not contain ` +
                `the visible text "${(el.textContent ?? "").trim()}". Voice ` +
                `control users say what they see — start the label with the ` +
                `visible text, or drop it.`,
              el,
            );
          }
        });
    };
    document.readyState === "loading"
      ? document.addEventListener("DOMContentLoaded", check)
      : check();
  }
</script>
<style is:global>
  /* Global styles (is:global — classes here are used across the site and by
     child slots), moved from src/styles/components/buttons.css. The layer
     wrapper slots them into the cascade defined in styles/global.css. */
  @layer components {
    /* ==========================================================================
   BUTTON COMPONENT STYLES
   ==========================================================================
   The Button renders a REAL <a> or <button> as its root — no clickable
   overlay. The visible label is therefore the accessible name, which is why
   `aria-label` is emitted only for icon-only buttons.

   STRUCTURE
     <a class="button_main_wrap" href="…" data-button-variant="primary" data-button>
       <span class="button_main_element">          ← the painted surface (bg, border, padding)
         <span class="button_main_text">Label</span>
         <span class="button_main_icon">…</span>   ← optional icon slot
       </span>
     </a>
     …or <button class="button_main_wrap" type="button"> when there is no href.

     This replaced a wrapper → stretched-<a> → aria-hidden-visual structure
     carried over from Webflow. That shape needed a duplicate .u-sr-only copy
     of every label (which could drift from the visible text) and a
     :has(:focus-visible) hop to move focus styling onto the visual element.
     Both are gone: :focus-visible now applies to the element that is
     actually focused.

   VARIANT SELECTION
     data-button-variant="primary"     (default — lime filled)
     data-button-variant="secondary"   (outlined / ghost)
     data-button-variant="text"        (text-link style, no bg/border)

   SIZE SELECTION
     data-button-size="small"          (compact)
     data-button-size="large"          (prominent CTA)
     (no attribute = default size)

   HOVER / FOCUS
     Rest colors are declared on the element; hover/focus colors are applied
     via `[data-button-variant="…"]:hover > .button_main_element` and
     `…:focus-visible > .button_main_element`. Those descendant selectors
     (0-2-0+) out-specify the global `a:hover` (0-1-1), so the button colors
     win even though the root now renders as an <a>.
     The toggle / arrow / close controls follow the same shape: each is a
     real <button> carrying the *_wrap class, with the painted *_element and
     *_icon spans inside.
   ========================================================================== */

    /* =====================================================
   BUTTON WRAPPERS
   Set border-radius (inherited by child elements).
   All wrappers default to fully-rounded (pill / circle).
   ===================================================== */

    /* This element IS the <a> or <button> (see the STRUCTURE note above), so it
       carries the UA resets a bare wrapper div never needed. */
    .button_main_wrap {
      border-radius: var(--radius-main);
      display: inline-block;
      position: relative;
      padding: 0;
      border: 0;
      background: none;
      font: inherit;
      color: inherit;
      text-align: inherit;
      text-decoration: none;
      cursor: pointer;
      -webkit-appearance: none;
      appearance: none;
    }

    .button_main_wrap:disabled {
      cursor: not-allowed;
      opacity: 0.4;
    }

    .button_main_wrap--no-radius {
      border-radius: 0;
    }

    .button_main_wrap--full-width {
      display: block;
      width: 100%;
    }

    /* ---- Support text wrapper ---- */
    .button_support_wrap {
      display: inline-flex;
      flex-direction: column;
      align-items: inherit;
    }

    .button_support_text {
      margin-top: var(--space-1);
      margin-bottom: 0;
    }

    .button_toggle_wrap {
      border-radius: var(--radius-full);
      display: inline-block;
      position: relative;
      padding: 0;
      border: 0;
      background: none;
      font: inherit;
      color: inherit;
      text-decoration: none;
      cursor: pointer;
      -webkit-appearance: none;
      appearance: none;
    }

    .button_toggle_wrap:disabled {
      cursor: not-allowed;
      opacity: 0.4;
    }

    .button_arrow_wrap {
      border-radius: var(--radius-full);
      display: inline-block;
      position: relative;
      padding: 0;
      border: 0;
      background: none;
      font: inherit;
      color: inherit;
      text-decoration: none;
      cursor: pointer;
      -webkit-appearance: none;
      appearance: none;
    }

    .button_arrow_wrap:disabled {
      cursor: not-allowed;
      opacity: 0.4;
    }

    .button_close_wrap {
      border-radius: var(--radius-full);
      display: inline-block;
      position: relative;
      padding: 0;
      border: 0;
      background: none;
      font: inherit;
      color: inherit;
      text-decoration: none;
      cursor: pointer;
      -webkit-appearance: none;
      appearance: none;
    }

    .button_close_wrap:disabled {
      cursor: not-allowed;
      opacity: 0.4;
    }

    /* =====================================================
   BUTTON MAIN — PRIMARY (default)
   ===================================================== */

    .button_main_element {
      font-family: var(--font-tertiary);
      font-size: var(--text-small-size);
      text-transform: uppercase;
      letter-spacing: var(--letter-spacing-tight);
      gap: 0.5rem;
      text-align: center;
      vertical-align: middle;
      color: var(--button-primary-text);
      background-color: var(--button-primary-background);
      border: var(--border-width-main) solid;
      border-color: var(--button-primary-border);
      border-radius: inherit;
      justify-content: center;
      align-items: center;
      height: 100%;
      padding: 0.9rem 1.5rem;
      line-height: 1;
      transition: all 0.2s ease;
      display: flex;
      position: relative;
    }

    /* Scoped to the primary variant so the filled-background hover doesn't bleed
   onto the secondary (outlined) or text (no-background) variants. */
    [data-button-variant="primary"]:hover > .button_main_element,
    [data-button-variant="primary"]:focus-visible > .button_main_element {
      color: var(--button-primary-text-hover);
      background-color: var(--button-primary-background-hover);
      border-color: var(--button-primary-border-hover);
    }

    /* =====================================================
   BUTTON MAIN — SECONDARY VARIANT
   ===================================================== */

    [data-button-variant="secondary"] > .button_main_element {
      color: var(--button-secondary-text);
      background-color: var(--button-secondary-background);
      border-color: var(--button-secondary-border);
    }

    [data-button-variant="secondary"]:hover > .button_main_element,
    [data-button-variant="secondary"]:focus-visible > .button_main_element {
      color: var(--button-secondary-text-hover);
      background-color: var(--button-secondary-background-hover);
      border-color: var(--button-secondary-border-hover);
    }

    /* =====================================================
   BUTTON MAIN — TEXT VARIANT
   Text-link style: no background, no side borders,
   bottom border only, compact padding.
   ===================================================== */

    [data-button-variant="text"] > .button_main_element {
      color: var(--link-text);
      background-color: transparent;
      border: none;
      padding: 0.5rem 0;
      gap: var(--space-1);
      display: inline-flex;
      justify-content: flex-start;
      text-align: left;
    }

    [data-button-variant="text"]:hover > .button_main_element,
    [data-button-variant="text"]:focus-visible > .button_main_element {
      color: var(--link-text-hover);
    }

    /* Text variant wrapper: no pill radius, never full-width */
    [data-button-variant="text"].button_main_wrap {
      border-radius: 0;
      display: inline-block;
      width: auto;
    }

    /* Default chevron icon for the text variant. It IS the variant's arrow —
       do not also type one into the label, or the button reads "Read more → ›".
       A custom icon slot replaces it (rule below). */
    [data-button-variant="text"] > .button_main_element::after {
      content: "\203A"; /* single right-pointing angle quotation mark */
      font-size: 1.4em;
      line-height: 0;
      flex-shrink: 0;
      margin-top: -0.15em;
    }

