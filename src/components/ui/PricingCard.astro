---
import type { HTMLAttributes } from "astro/types";
/**
 * PricingCard — pricing tier card with name, price, description, feature
 * items slot, and CTA button.
 *
 * Composes ContentWrapper, Heading, Text, and Button internally.
 * No box-shadow is baked in — add `u-box-shadow-*` utility classes yourself.
 *
 * Three variants:
 * - `default` — full card with name, price, description, feature items, and CTA
 * - `compact` — tighter spacing for quick-view / à la carte cards. Price is optional.
 * - `general` — price-first header (priceLabel + price spread across), 2-column items grid, no package name
 *
 * @example Detailed card with feature items and label badge
 * ```astro
 * <PricingCard
 *   name="Growth Package"
 *   price="$3,500"
 *   priceSuffix="/month"
 *   description="For businesses ready to scale."
 *   href="/contact"
 *   featured
 *   class="u-box-shadow-medium"
 * >
 *   <Fragment slot="label">
 *     <Text tag="span" variant="tiny" weight="bold" marginBottom={0}>Most Popular</Text>
 *   </Fragment>
 *   <PricingItem>Up to 5 team members</PricingItem>
 *   <PricingItem>Priority support</PricingItem>
 * </PricingCard>
 * ```
 *
 * @example General variant with support text below CTA
 * ```astro
 * <PricingCard
 *   theme="light"
 *   variant="general"
 *   price="$5,000"
 *   priceLabel="Starting at"
 *   description="Typical projects range from $7K–$15K+."
 *   href="/contact"
 *   buttonText="Let's Fix Your Site"
 *   buttonSupportText="One call. We'll confirm fit and give you a real number."
 *   itemsLabel="Your Investment Includes:"
 *   class="u-box-shadow-small"
 * >
 *   <PricingItem>Custom design and development</PricingItem>
 * </PricingCard>
 * ```
 *
 * @example Compact card without price, text-link CTA
 * ```astro
 * <PricingCard
 *   variant="compact"
 *   name="Starter"
 *   description="Everything you need to get going."
 *   href="/pricing"
 *   buttonText="Explore plan"
 *   buttonVariant="text"
 *   class="u-box-shadow-medium"
 * />
 * ```
 *
 * @example Card inside a dark section (theme override)
 * ```astro
 * <PricingCard
 *   theme="light"
 *   name="Pro"
 *   price="$5,000"
 *   priceLabel="Starting at"
 *   href="/contact"
 * >
 *   <PricingItem>Custom design and development</PricingItem>
 * </PricingCard>
 * ```
 */

import ContentWrapper from "./ContentWrapper.astro";
import Heading from "./Heading.astro";
import Text from "./Text.astro";
import Button from "./Button.astro";

type PricingCardVariant =
  /** Full card with room for feature items */
  | "default"
  /** Compact quick-view card with tighter spacing */
  | "compact"
  /** General pricing card — price-first header, 2-column items grid, no package name */
  | "general";

type ContentAlign = "inherit" | "center" | "left";
type ButtonVariant = "primary" | "secondary" | "text";

/**
 * PricingCard — pricing tier card with name, price, description, items slot, and CTA.
 *
 * **Slots:** `label` (badge above name), `default` (PricingItems), `footer` (below button), `icon` (compact only)
 */
interface Props extends HTMLAttributes<"div"> {
  /**
   * **PricingCard props:**
   * - `name` — package name (optional for general variant)
   * - `price` — price string (optional — omit for compact cards without pricing)
   * - `priceSuffix` — suffix after price (e.g. "/month")
   * - `priceLabel` — text above price
   * - `description` — tagline below price
   * - `descriptionMuted` — muted description text (default: true)
   * - `href` — CTA link
   * - `buttonText` — button label
   * - `buttonSupportText` — small text below the CTA button
   * - `ariaLabel` — button accessible label
   * - `buttonVariant` — primary, secondary, or text
   * - `variant` — default, compact, or general
   * - `itemsLabel` — label above items (e.g. "Your Investment Includes:")
   * - `featured` — accent border highlight
   * - `theme` — override card's internal color theme ('light' | 'dark' | 'brand'). Use 'light' inside dark sections.
   * - `align` — content alignment
   * - `class` — extra classes
   * - Also accepts any HTML attribute — forwarded to root element
   *
   * **Slots:** `label` (badge), `default` (items), `footer` (below button), `icon` (compact only)
   */
  docs?: string;

  /** Package name — rendered as a heading. Optional for general variant. */
  name?: string;

  /**
   * Price display string (the main number).
   * @example price="$5,000"
   * @example price="$3,500"
   */
  price?: string;

  /**
   * Suffix displayed after the price in smaller text (e.g. "/month", "/link").
   * @example priceSuffix="/month"
   */
  priceSuffix?: string;

  /**
   * Small text displayed above the price.
   * @example priceLabel="Starting at"
   */
  priceLabel?: string;

  /** Short tagline or description below the price. */
  description?: string;

  /**
   * Apply muted styling (reduced opacity) to the description text.
   * @default true
   */
  descriptionMuted?: boolean;

  /** CTA button link. Omit to hide the button. */
  href?: string;

  /**
   * CTA button label text.
   * @default 'Get started'
   */
  buttonText?: string;

  /**
   * Accessible label for the CTA button.
   * Falls back to `"Learn more about {name}"`.
   */
  ariaLabel?: string;

  /**
   * Small supporting text rendered below the CTA button.
   * @example buttonSupportText="No commitment — just a conversation."
   */
  buttonSupportText?: string;

  /**
   * Button visual style.
   * @default 'primary'
   */
  buttonVariant?: ButtonVariant;

  /**
   * Card layout variant.
   * - `default` — full card with room for feature items
   * - `compact` — tighter spacing for quick-view cards
   * - `general` — price-first header, 2-column items grid, no package name
   * @default 'default'
   */
  variant?: PricingCardVariant;

  /**
   * Label text above the items list (e.g. "Your Investment Includes:").
   * Typically used with the general variant.
   */
  itemsLabel?: string;

  /**
   * Highlight this card with an accent-colored border.
   * @default false
   */
  featured?: boolean;

  /**
   * Content alignment via ContentWrapper.
   * @default 'inherit'
   */
  align?: ContentAlign;

  /**
   * Override the card's internal color theme. Sets `data-theme` on the card
   * element so text, borders, and buttons resolve against the card's own
   * background instead of inheriting from the section.
   *
   * Use `'light'` when placing a card inside a dark section — the card's
   * `--background-2` surface is light, so text needs to flip to dark.
   */
  theme?: "light" | "dark" | "brand";

  /** Extra classes on the outer `.pricing_card_wrap` element. */
  class?: string;
}

const {
  docs,
  name,
  price,
  priceSuffix,
  priceLabel,
  description,
  descriptionMuted = true,
  href,
  buttonText = "Get started",
  buttonSupportText,
  ariaLabel,
  buttonVariant = "primary",
  variant = "default",
  itemsLabel,
  featured = false,
  align = "inherit",
  theme,
  class: className,
  ...rest
} = Astro.props;

const buttonLabel =
  ariaLabel ?? (name ? `Learn more about ${name}` : "Learn more");
const hasItems = Astro.slots.has("default");
const hasLabel = Astro.slots.has("label");
const hasFooter = Astro.slots.has("footer");
const hasIcon = Astro.slots.has("icon");
const isCompact = variant === "compact";
const isGeneral = variant === "general";
---

<div
  class:list={["pricing_card_wrap", featured && "is-featured", className]}
  data-pricing-variant={variant}
  {...rest}
>
  <div class="pricing_card_element" {...theme ? { "data-theme": theme } : {}}>
    {
      /* Label banner — full-width callout at top of card (default variant only) */
    }
    {
      hasLabel && !isCompact && !isGeneral && (
        <div class="pricing_card_label">
          <slot name="label" />
        </div>
      )
    }

    <ContentWrapper align={align}>
      {
        /* Header — general:  price row only (priceLabel left, price right)
                   compact:  price row → name → description
                   default:  name → price → description */
      }
      <div class="pricing_card_header">
        {
          isGeneral ? (
            <>
              {/* General: price row only — priceLabel (h4) + price (h3) spread across */}
              <div class="pricing_card_price_row">
                {priceLabel && (
                  <Heading
                    tag="p"
                    variant="h4"
                    marginBottom={0}
                    maxWidth="100%"
                  >
                    {priceLabel}
                  </Heading>
                )}
                <Heading
                  tag="p"
                  variant="h3"
                  marginBottom={0}
                  maxWidth="100%"
                  class="pricing_card_price"
                >
                  {price}
                  {priceSuffix && (
                    <span class="pricing_card_price_suffix">{priceSuffix}</span>
                  )}
                </Heading>
              </div>

              {description && (
                <Text
                  variant="small"
                  muted={descriptionMuted}
                  marginBottom={0}
                  maxWidth="100%"
                >
                  {description}
                </Text>
              )}
            </>
          ) : isCompact ? (
            <>
              {/* Compact: price row on top (icon left, price right) */}
              {(price || hasIcon) && (
                <div class="pricing_card_price_row">
                  {hasIcon && (
                    <div class="pricing_card_icon">
                      <slot name="icon" />
                    </div>
                  )}
                  {price && (
                    <span class="pricing_card_price_compact">
                      {priceLabel && <>{priceLabel} </>}
                      {price}
                      {priceSuffix}
                    </span>
                  )}
                </div>
              )}

              {/* Compact: name below price */}
              <Heading tag="h3" variant="h5" marginBottom={0} maxWidth="100%">
                {name}
              </Heading>

              {description && (
                <Text variant="small" muted={descriptionMuted} marginBottom={0}>
                  {description}
                </Text>
              )}
            </>
          ) : (
            <>
              <Heading tag="h3" variant="h6" marginBottom={0} maxWidth="100%">
                {name}
              </Heading>

              {/* Default: price row */}
              <div
                class:list={[
                  "pricing_card_price_row",
                  priceLabel && "has-label",
                ]}
              >
                {priceLabel && (
                  <span class="pricing_card_price_label">{priceLabel}</span>
                )}
                <Heading
                  tag="p"
                  variant="h2"
                  marginBottom={0}
                  maxWidth="100%"
                  class="pricing_card_price"
                >
                  {price}
                  {priceSuffix && (
                    <span class="pricing_card_price_suffix">{priceSuffix}</span>
                  )}
                </Heading>
              </div>

              {description && (
                <Text variant="small" muted={descriptionMuted} marginBottom={0}>
                  {description}
                </Text>
              )}
            </>
          )
        }
      </div>

      {/* Feature items (PricingItem components) */}
      {
        (hasItems || itemsLabel) && (
          <div class="pricing_card_items_wrap">
            {itemsLabel && <p class="pricing_card_items_label">{itemsLabel}</p>}
            {hasItems && (
              <div class="pricing_card_items">
                <slot />
              </div>
            )}
          </div>
        )
      }

      {/* CTA Button */}
      {
        href && (
          <div class="pricing_card_cta u-button-wrapper">
            <Button
              href={href}
              variant={buttonVariant}
              ariaLabel={buttonLabel}
              fullWidth
              supportText={buttonSupportText}
            >
              {buttonText}
            </Button>
          </div>
        )
      }

      {/* Footer */}
      {
        hasFooter && (
          <div class="pricing_card_footer">
            <slot name="footer" />
          </div>
        )
      }
    </ContentWrapper>
  </div>
</div>

<style is:global>
  /* Global styles (is:global — classes here are used across the site and by
     child slots), moved from src/styles/components/pricing-card.css. The layer
     wrapper slots them into the cascade defined in styles/global.css. */
  @layer components {
    /* ==========================================================================
   PRICING CARD + PRICING ITEM COMPONENT STYLES
   ==========================================================================
   Usage:
     <div class="pricing_card_wrap" data-pricing-variant="default">
       <div class="pricing_card_element">
         <div class="u-content-wrapper">
           <div class="pricing_card_header">
             <div class="pricing_card_label">…label…</div>
             <Heading>…name…</Heading>
             <div class="pricing_card_price_row">…price + suffix…</div>
             …description…
           </div>
           <div class="pricing_card_items">
             <div class="pricing_item_wrap">…</div>
           </div>
           <div class="pricing_card_cta u-button-wrapper">…</div>
           <div class="pricing_card_footer">…</div>
         </div>
       </div>
     </div>

   Variants: default | compact | general
   Combo:    is-featured (accent border)
   ========================================================================== */

    /* ---- Outer wrapper ---- */

    .pricing_card_wrap {
      width: 100%;
      border-radius: var(--radius-main);
      display: flex;
    }

    /* ---- Element — inner card surface ---- */

    .pricing_card_element {
      border: var(--border-width-main) solid var(--border);
      border-radius: inherit;
      overflow: clip;
      background-color: var(--background-2);
      display: flex;
      flex-flow: column;
      width: 100%;
      padding: var(--space-6);
      transition: border-color 0.2s ease;
      container-type: inline-size;
    }

    /* Theme override — re-apply color so inherited white/dark doesn't persist */
    .pricing_card_element[data-theme] {
      color: var(--text);
      border-color: var(--border);
    }

    /* Make ContentWrapper a flex column so margin-top: auto works on CTA */
    .pricing_card_element > .u-content-wrapper {
      display: flex;
      flex-direction: column;
      flex: 1;
      gap: var(--space-3);
    }

    /* ---- Label banner — full-width callout at top of card ---- */

    .pricing_card_label {
      margin-top: calc(var(--space-6) * -1);
      margin-inline: calc(var(--space-6) * -1);
      margin-bottom: var(--space-4);
      padding: var(--space-1) var(--space-6);
      background-color: var(--heading-accent);
      color: #fff;
      text-align: center;
      font-weight: var(--font-weight-bold, 700);
      font-size: var(--text-small-size);
    }

    /* ---- Header — name, price, description ---- */

    .pricing_card_header {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-2);
      padding-bottom: var(--space-3);
      border-bottom: var(--border-width-main) solid
        color-mix(in srgb, var(--border) 50%, transparent);
    }

    /* Description — extra top spacing + constrained width */
    .pricing_card_header > .u-text:last-child {
      margin-top: var(--space-3);
      max-width: 85%;
    }

    /* ---- Price row — wraps label + price ---- */

    .pricing_card_price_row.has-label {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-3);
    }

    /* Override .u-text min-width so price shrinks inside flex row */
    .pricing_card_price_row.has-label > .u-text {
      min-width: 0;
    }

    /* ---- Price display ---- */

    .pricing_card_price {
      font-weight: var(--font-weight-bold, 700);
    }

    /* ---- Price label (e.g. "Starting at") ---- */

    .pricing_card_price_label {
      font-size: var(--text-small-size);
      font-weight: var(--font-weight-normal);
      opacity: 0.75;
      white-space: nowrap;
    }

    /* ---- Price suffix (e.g. "/month") — inline span after price ---- */

    .pricing_card_price_suffix {
      font-size: var(--h6-size);
      font-weight: var(--font-weight-medium);
    }

    /* ---- Items section wrapper (label + items) ---- */

    .pricing_card_items_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      text-align: left;
      width: 100%;
    }

    /* ---- Items label (e.g. "Your Investment Includes:") ---- */

    .pricing_card_items_label {
      font-weight: var(--font-weight-bold, 700);
      font-size: var(--text-regular-size, 1rem);
    }

    /* ---- Items list ---- */

    .pricing_card_items {
      display: flex;
      flex-direction: column;
    }

    /* ---- CTA — push to bottom ---- */

    .pricing_card_cta {
      margin-top: auto;
      width: 100%;
    }

    /* Ensure support text wrapper stretches full width inside card */
    .pricing_card_cta .button_support_wrap {
      display: flex;
      width: 100%;
      text-align: center;
    }

    /* ---- Footer ---- */

    .pricing_card_footer {
      margin-top: calc(var(--space-2) * -1);
    }

    /* ==========================================================================
   VARIANT: compact — tighter spacing, price on top, name below
   ========================================================================== */

    [data-pricing-variant="compact"] .pricing_card_element {
      padding: var(--space-5);
    }

    [data-pricing-variant="compact"]
      .pricing_card_element
      > .u-content-wrapper {
      gap: var(--space-4);
    }

    [data-pricing-variant="compact"] .pricing_card_header {
      padding-bottom: 0;
      border-bottom: none;
      align-items: start;
      text-align: left;
      gap: var(--space-1);
    }

    /* ---- Compact price row — icon left, price right ---- */

    [data-pricing-variant="compact"] .pricing_card_price_row {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      width: 100%;
    }

    /* ---- Compact icon (optional slot) ---- */

    .pricing_card_icon {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--heading-accent);
    }

    /* ---- Compact price — uniform size, pushed right ---- */

    .pricing_card_price_compact {
      margin-left: auto;
      font-size: var(--text-small-size);
      font-weight: var(--font-weight-bold);
      opacity: 0.75;
      white-space: nowrap;
    }

    /* ==========================================================================
   VARIANT: general — price-first header, 2-column items, no package name
   ========================================================================== */

    /* ---- General price row — priceLabel + price spread across ---- */

    [data-pricing-variant="general"] .pricing_card_price_row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      width: 100%;
      gap: var(--space-3);
    }

    /* Override .u-text min-width so headings shrink inside flex row */
    [data-pricing-variant="general"] .pricing_card_price_row > .u-text {
      min-width: 0;
    }

    /* General header — left-align description below price row */
    [data-pricing-variant="general"] .pricing_card_header {
      align-items: flex-start;
      text-align: left;
    }

    /* General description — tighter top spacing, full width */
    [data-pricing-variant="general"] .pricing_card_header > .u-text:last-child {
      margin-top: var(--space-1);
      max-width: 100%;
    }

    /* ---- General items — 2-column grid, no borders ---- */

    [data-pricing-variant="general"] .pricing_card_items {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-1) var(--space-5);
    }

    [data-pricing-variant="general"] .pricing_item_wrap {
      border-bottom: none;
      padding-block: var(--space-1);
    }

    /* Collapse 2-col items to 1-col when card is narrow */
    @container (max-width: 30rem) {
      [data-pricing-variant="general"] .pricing_card_items {
        grid-template-columns: 1fr;
      }
    }

    /* ---- General CTA — divider line above button ---- */

    [data-pricing-variant="general"] .pricing_card_cta {
      padding-top: var(--space-5);
      border-top: var(--border-width-main) solid
        color-mix(in srgb, var(--border) 50%, transparent);
    }

    /* ==========================================================================
   COMBO: is-featured — accent border highlight
   ========================================================================== */

    .pricing_card_wrap.is-featured .pricing_card_element {
      border-color: var(--heading-accent);
    }

    /* ==========================================================================
   PRICING ITEM — feature line item
   ========================================================================== */

    .pricing_item_wrap {
      display: flex;
      align-items: flex-start;
      gap: var(--space-3);
      padding-block: var(--space-2);
      border-bottom: var(--border-width-main) solid
        color-mix(in srgb, var(--border) 50%, transparent);
    }

    .pricing_item_wrap:last-child {
      border-bottom: none;
    }

    /* ---- Icon ---- */

    .pricing_item_icon {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--heading-accent);
    }

    /* ---- Text ---- */

    .pricing_item_text {
      flex: 1;
      font-size: var(--text-small-size);
      line-height: var(--line-height-small, 1.5);
    }
  }
</style>
