      [data-collapse="small"][data-layout-variant="breakout"]
        .u-layout-column-1,
      [data-collapse="small"][data-layout-variant="breakout"]
        .u-layout-column-2,
      [data-collapse="small"][data-layout-variant="breakout-reversed"]
        .u-layout-column-1,
      [data-collapse="small"][data-layout-variant="breakout-reversed"]
        .u-layout-column-2,
      [data-collapse="small"][data-layout-variant="full"] .u-layout-column-1,
      [data-collapse="small"][data-layout-variant="full"] .u-layout-column-2,
      [data-collapse="small"][data-layout-variant="full-reversed"]
        .u-layout-column-1,
      [data-collapse="small"][data-layout-variant="full-reversed"]
        .u-layout-column-2 {
        grid-column: auto;
        overflow: visible;
      }
    }
  }
