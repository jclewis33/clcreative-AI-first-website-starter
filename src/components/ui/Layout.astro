---
/**
 * Layout — the one component that arranges a section's content.
 *
 * Absorbed the old ContentWrapper (text alignment + measure) and replaced the
 * old Col: a section is now ONE decision instead of choosing between two
 * overlapping components and remembering a column wrapper.
 *
 * SLOTS
 *   default    — column 1. Anything placed inside <Layout> lands here; there
 *                is no slot attribute or wrapper component to remember.
 *   `column2`  — the second column, on the two-column variants.
 *
 * A single component takes `slot="column2"` directly. For several loose
 * elements in column 2, use `<Fragment slot="column2">` — it groups them
 * without emitting a box of its own.
 *
 * The column wrappers are generated here, so there is nothing to get wrong.
 * (The old  used `display: contents`, which erased the column box and let
 * a ratio'd <Visual> balloon — a hazard that needed a dev-time guardrail.
 * A generated column is a real flex box, so that failure cannot occur.)
 *
 * All two-column variants collapse to a single stacked column when the nearest
 * `.u-container` is narrower than 58em (928px). Use `collapseAt="small"` to
 * keep columns until 560px instead.
 *
 * @example Two columns — content and an image
 * ```astro
 * <Layout variant="columns" verticalAlign="center">
 *   <Heading tag="h2" variant="h2">Title</Heading>
 *   <Text>Description</Text>
 *   <Visual slot="column2" src={img} alt="Photo" ratio="landscape" />
 * </Layout>
 * ```
 *
 * @example Several elements in column 2
 * ```astro
 * <Layout variant="columns">
 *   <Heading tag="h2">Title</Heading>
 *   <Fragment slot="column2">
 *     <Visual src={img} alt="" ratio="landscape" />
 *     <Text variant="small">Caption</Text>
 *   </Fragment>
 * </Layout>
 * ```
 *
 * @example Centered single column
 * ```astro
 * <Layout variant="stack-centered">
 *   <Heading tag="h2" variant="display-sm" balance>Centered Title</Heading>
 *   <Text variant="large" align="center">Body text.</Text>
 * </Layout>
 * ```
 *
 * @example Single column with a readable measure
 * ```astro
 * <Layout variant="stack" maxWidth="48rem">
 *   <Text>Long-form copy constrained to a comfortable line length.</Text>
 * </Layout>
 * ```
 *
 * @example Breakout — image bleeds to viewport edge
 * ```astro
 * <Layout variant="breakout" contentSpan={7} bleedSpan={6}>
 *     <Heading tag="h2">Content side</Heading>
 *     <Text>Stays in the container.</Text>
 *   <Visual slot="column2" src={img} alt="" />
 * </Layout>
 * ```
 *
 * @example Centered card with background image (CTA pattern)
 * ```astro
 * <Layout variant="card">
 *     <Heading tag="h2" variant="display-sm" accent>Ready to <strong>start</strong>?</Heading>
 *     <Text size="large" align="center">Book a free strategy call.</Text>
 *     <div class="u-button-wrapper">
 *       <Button href="/book-a-call" ariaLabel="Book call">Book a Call</Button>
 *     </div>
 *   <Fragment slot="column2">
 *     <Visual src={bgImage} alt="" variant="background" />
 *     <Overlay strength={75} />
 * </Layout>
 * ```
 *
 * @example Custom column ratio
 * ```astro
 * <Layout variant="columns" ratio="5-7" verticalAlign="start">
 *   <Heading variant="eyebrow">Label</Heading>
 *   <Text slot="column2" variant="large">Body text.</Text>
 * </Layout>
 * ```
 */

import type {
  AllProps,
  BaseProps,
  BreakoutColumns,
  CollapseBreakpoint,
  GapScale,
  LayoutVariant,
  Props,
  VerticalAlign,
} from "./Layout.props";

const {
  render = true,
  docs,
  variant = "columns",
  align = "inherit",
  maxWidth,
  verticalAlign,
  collapseAt = "medium",
  contentSpan,
  bleedSpan,
  ratio,
  columnGap,
  rowGap,
  stickyOffset,
  cardPadding,
  class: className,
  ...rest
} = Astro.props as AllProps;

/* Breakout/full variants use the u-grid-breakout utility for their named-line grid */
/* Absorbed from the old ContentWrapper: text alignment and an optional
   measure. Kept as props rather than a second component so a section is one
   decision — see CLAUDE.md. */
const textAlignClassMap: Record<string, string | undefined> = {
  inherit: undefined,
  center: "is-center-align",
  left: "is-left-align",
  right: "is-right-align",
  "center-mobile": "is-center-align-mobile",
};

/* `stack-centered` centers by name, so it implies align="center" — otherwise
   a centered stack with a `maxWidth` measure would constrain the box but
   leave it (and its text) hugging the left edge. An explicit `align` still
   wins, so a caller can override the variant's implication. */
const effectiveAlign =
  align !== "inherit"
    ? align
    : variant === "stack-centered"
      ? "center"
      : "inherit";

/* The alignment classes need a host whenever there is something to align OR a
   measure to centre. */
const needsContentWrapper = effectiveAlign !== "inherit" || Boolean(maxWidth);

/* NOTE: these are `Astro.slots.has()`, not a rendered-content check.
   Rendering a slot (`Astro.slots.render()`) to find out whether it is empty
   swallows the hoisted `<script>` of every component inside it — page-wide,
   not just for that slot. Measured: one `<Slider>` in a Card `footer` slot
   left BOTH sliders on the page uninitialized, the unrelated one included.
   `.has()` only reports whether a slot was passed, which is weaker (a slot
   holding an empty `{items.map(…)}` still counts as present), and that is the
   trade we want: a rare empty wrapper beats silently dead client JS. */
const hasColumn2Slot = Astro.slots.has("column2");

const isBreakout = [
  "breakout",
  "breakout-reversed",
  "full",
  "full-reversed",
].includes(variant);

/* Vertical align → CSS class mapping */
const alignClassMap: Record<VerticalAlign, string> = {
  start: "u-align-start",
  center: "u-align-center",
  end: "u-align-end",
  stretch: "u-align-stretch",
};

const alignClass = verticalAlign ? alignClassMap[verticalAlign] : null;

/* Resolve a gap prop: a number maps to the fluid space scale
   (0 → 0px, N → var(--space-N)); a string passes through as a raw
   CSS length. Matches the pattern used in Marquee/Section. */
const resolveGap = (value: GapScale | string | undefined) =>
  value == null
    ? undefined
    : typeof value === "number"
      ? value === 0
        ? "0px"
        : `var(--space-${value})`
      : value;

const columnGapValue = resolveGap(columnGap);
const rowGapValue = resolveGap(rowGap);

/* Build inline style for custom properties */
const styleParts: string[] = [];
/* --_ prefix = internal to this component (see CLAUDE.md: Variables).
   Set inline here, consumed only by this file's CSS below. */
styleParts.push(`--_collapse: var(--flex-${collapseAt})`);
if (contentSpan) styleParts.push(`--content-span: ${contentSpan}`);
if (bleedSpan) styleParts.push(`--bleed-span: ${bleedSpan}`);

if (ratio) {
  const [left, right] = ratio.split("-").map(Number);
  if (left > 0 && right > 0) {
    styleParts.push(`--col-1: ${left}fr`);
    styleParts.push(`--col-2: ${right}fr`);
  }
}

if (columnGapValue) styleParts.push(`--_gap: ${columnGapValue}`);
if (rowGapValue) styleParts.push(`--_row-gap: ${rowGapValue}`);
if (stickyOffset) styleParts.push(`--sticky-offset: ${stickyOffset}`);
if (cardPadding) styleParts.push(`--card-padding: ${cardPadding}`);

const inlineStyle = styleParts.length ? styleParts.join("; ") : undefined;
---

{
  render && (
    <div
      class:list={["u-layout-wrapper", className]}
      data-layout-variant={variant}
      data-collapse={collapseAt}
      {...rest}
    >
      <div
        class:list={["u-layout", alignClass, { "u-grid-breakout": isBreakout }]}
        style={inlineStyle}
      >
        {/* Column 1 is the DEFAULT slot — anything placed inside <Layout> lands
            here with no wrapper component and no slot attribute to remember. The
            `u-content-wrapper` classes are the ones ContentWrapper used to apply,
            reused verbatim so alignment and measure render identically. */}
        <div
          class:list={[
            "u-layout-column-1",
            needsContentWrapper && "u-content-wrapper",
            textAlignClassMap[effectiveAlign],
          ]}
        >
          {maxWidth ? (
            <div
              class="u-content-wrapper_inner"
              style={`max-width: ${maxWidth};`}
            >
              <slot />
            </div>
          ) : (
            <slot />
          )}
        </div>

        {/* Only emitted when it renders something — a column2 holding an empty
            expression would otherwise leave a stray grid cell. */}
        {hasColumn2Slot && (
          <div class="u-layout-column-2">
            <slot name="column2" />
          </div>
        )}
      </div>
    </div>
  )
}

<style is:global>
  /* Global styles (is:global — classes here are used across the site and by
     child slots), moved from src/styles/components/layout.css. The layer
     wrapper slots them into the cascade defined in styles/global.css. */
  @layer components {
    /* ==========================================================================
   LAYOUT COMPONENT — Two-column layout variants
   ==========================================================================
   All variants use CSS Grid at large container widths and collapse to a
   single flex column when the container narrows past a configurable
   breakpoint. The Layout component sets --_collapse on .u-layout
   to either var(--flex-medium) (collapse at ~928px, default) or
   var(--flex-small) (collapse at ~560px) via the collapseAt prop.
   The data-collapse attribute on .u-layout-wrapper scopes the
   responsive reset rules to the correct container-query tier.

   Usage:
     <div class="u-layout-wrapper" data-layout-variant="columns">
       <div class="u-layout">
         <div class="u-layout-column-1">…</div>
         <div class="u-layout-column-2">…</div>
       </div>
     </div>

   Variants:
     columns           — 50 / 50 (equal halves, or custom ratio)
     columns-reversed  — 50 / 50, column order reversed (or custom ratio)
     stack             — single column, left-aligned
     stack-centered    — single column, centered
     sticky-left       — 50 / 50, left column sticky (or custom ratio)
     contain           — card layout: content left, image right (rounded, padded)
     contain-reversed  — card layout: image left, content right (rounded, padded)
     breakout          — 60 / 40, right column (image) bleeds to edge
     breakout-reversed — 40 / 60, left column (image) bleeds to edge
     full              — 50 / 50, right column bleeds to edge
     full-reversed     — 50 / 50, left column bleeds to edge
     card              — centered content card, col2 as absolute background
     auto-width        — columns size to their content; the row still fills

   Column ratio:
     Two-column variants (columns, columns-reversed, sticky-left, contain,
     contain-reversed) accept --col-1 / --col-2 custom properties to override
     the default 50/50 split. Set via the `ratio` prop on the Layout component.
   ========================================================================== */

    /* ---- Base layout shell ---- */

    .u-layout-wrapper {
      grid-column-gap: var(--_gap, var(--site-gutter));
      grid-row-gap: var(--_row-gap, var(--space-8));
      justify-content: center;
      align-items: stretch;
      width: 100%;
      display: flex;
    }

    .u-layout {
      grid-column-gap: var(--_gap, var(--site-gutter));
      grid-row-gap: var(--_row-gap, var(--space-8));
      flex-flow: column;
      grid-template-rows: auto;
      grid-auto-columns: 1fr;
      width: 100%;
      display: flex;
    }

    .u-layout-column-1,
    .u-layout-column-2 {
      align-self: center;
      width: 100%;
      position: relative;
      min-width: 0;
    }

    /* ---- columns — 50/50 equal (or custom ratio via --col-1/--col-2) ---- */

    [data-layout-variant="columns"] .u-layout,
    [data-layout-variant="columns-reversed"] .u-layout {
      display: var(--_collapse, grid);
      flex-flow: column;
      grid-template-columns: minmax(0, var(--col-1, 1fr)) minmax(
          0,
          var(--col-2, 1fr)
        );
    }

    [data-layout-variant="columns-reversed"] .u-layout-column-1 {
      order: 2;
    }
    [data-layout-variant="columns-reversed"] .u-layout-column-2 {
      order: 1;
    }

    /* ---- stack — single column ---- */

    [data-layout-variant="stack"] .u-layout,
    [data-layout-variant="stack-centered"] .u-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    [data-layout-variant="stack-centered"] .u-layout {
      text-align: center;
      justify-items: center;
    }

    /* Column stays block-level so sibling margins collapse (e.g. text
   margin-bottom + button-wrapper margin-top → max wins).  The alignment
   properties are set for INHERITANCE only — .u-text inherits
   align-items: center, .u-button-wrapper inherits justify-content: center.
   text-align: center handles any remaining inline content. */
    [data-layout-variant="stack-centered"] .u-layout-column-1 {
      text-align: center;
      align-items: center;
      justify-content: center;
    }

    /* ---- sticky-left — 50/50, left column sticks on scroll (or custom ratio) ---- */

    [data-layout-variant="sticky-left"] .u-layout {
      display: var(--_collapse, grid);
      flex-flow: column;
      grid-template-columns: minmax(0, var(--col-1, 1fr)) minmax(
          0,
          var(--col-2, 1fr)
        );
    }

    [data-layout-variant="sticky-left"] .u-layout-column-1 {
      position: sticky;
      /* Auto-clear the fixed nav (bar + outer spacing + banner) plus a small
     breathing offset. Override --sticky-offset via the `stickyOffset` prop
     on <Layout> for a custom gap below the nav. */
      top: calc(var(--nav-height-total) + var(--sticky-offset, var(--space-3)));
    }

    /* ---- contain — card layout (content + image in a rounded card) ---- */
    /* Both variants share: background, radius, overflow, zero gap.
   Content column is padded; image column clips to the card shape.
   Default 50/50 split — override with the `ratio` prop. */

    [data-layout-variant="contain"] .u-layout,
    [data-layout-variant="contain-reversed"] .u-layout {
      display: var(--_collapse, grid);
      flex-flow: column;
      grid-template-columns: minmax(0, var(--col-1, 1fr)) minmax(
          0,
          var(--col-2, 1fr)
        );
      border-radius: var(--radius-main);
      background-color: var(--background-2);
      overflow: clip;
      gap: 0;
    }

    /* contain: col1 = content (padded + centered), col2 = visual (stretched + clipped) */
    [data-layout-variant="contain"] .u-layout-column-1 {
      padding: var(--space-6);
      align-self: center;
    }

    [data-layout-variant="contain"] .u-layout-column-2 {
      align-self: stretch;
      border-radius: 0;
      width: 100%;
      height: 100%;
      position: relative;
      overflow: clip;
    }

    /* contain-reversed: col1 = visual (stretched + clipped), col2 = content (padded + centered) */
    [data-layout-variant="contain-reversed"] .u-layout-column-1 {
      align-self: stretch;
      border-radius: 0;
      width: 100%;
      height: 100%;
      position: relative;
      overflow: clip;
    }

    [data-layout-variant="contain-reversed"] .u-layout-column-2 {
      padding: var(--space-6);
      align-self: center;
    }

    /* ---- breakout & full — viewport-edge bleed via u-grid-breakout ---- */
    /* The .u-layout gets the u-grid-breakout utility class (added by Layout.astro)
   which sets grid-template-columns: var(--grid-breakout) and gaps.
   This rule only adds the viewport expansion and responsive override.
*/

    [data-layout-variant="breakout"] > .u-layout,
    [data-layout-variant="breakout-reversed"] > .u-layout,
    [data-layout-variant="full"] > .u-layout,
    [data-layout-variant="full-reversed"] > .u-layout {
      --breakout-on: var(--responsive-large, 1);
      display: var(--_collapse, grid);
      flex-flow: column;
      width: calc(100vw * var(--breakout-on) + 100% * (1 - var(--breakout-on)));
      margin-inline: calc((50% - 50vw) * var(--breakout-on));
    }

    /* Column spans are controlled by --content-span and --bleed-span CSS vars.
   Set via the contentSpan/bleedSpan props on the Layout component.
   Defaults: breakout = 7/6, full = 6/7. Must total 13 (12 content cols + 1 gutter). */

    /* breakout: content left, image right bleeds to right edge */
    [data-layout-variant="breakout"] .u-layout-column-1 {
      grid-column: content-start / span var(--content-span, 7);
    }

    [data-layout-variant="breakout"] .u-layout-column-2 {
      grid-column: span var(--bleed-span, 6) / full-end;
      overflow: hidden;
    }

    /* breakout-reversed: col2 bleeds to left edge, col1 content right */
    [data-layout-variant="breakout-reversed"] .u-layout-column-1 {
      grid-column: span var(--content-span, 7) / content-end;
      grid-row: 1;
    }

    [data-layout-variant="breakout-reversed"] .u-layout-column-2 {
      grid-column: full-start / span var(--bleed-span, 6);
      grid-row: 1;
      overflow: hidden;
    }

    /* full: content left, image right bleeds to right edge */
    [data-layout-variant="full"] .u-layout-column-1 {
      grid-column: content-start / span var(--content-span, 6);
    }

    [data-layout-variant="full"] .u-layout-column-2 {
      grid-column: span var(--bleed-span, 7) / full-end;
      overflow: hidden;
    }

    /* full-reversed: col2 bleeds to left edge, col1 content right */
    [data-layout-variant="full-reversed"] .u-layout-column-1 {
      grid-column: span var(--content-span, 6) / content-end;
      grid-row: 1;
    }

    [data-layout-variant="full-reversed"] .u-layout-column-2 {
      grid-column: full-start / span var(--bleed-span, 7);
      grid-row: 1;
      overflow: hidden;
    }

    /* ---- card — centered content card, col2 acts as background ---- */

    [data-layout-variant="card"] .u-layout {
      position: relative;
      border-radius: var(--radius-main);
      background-color: var(--background-2);
      overflow: clip;
    }

    [data-layout-variant="card"] .u-layout-column-1 {
      position: relative;
      z-index: 1;
      text-align: center;
      align-items: center;
      justify-content: center;
      padding: var(--card-padding, var(--section-space-main)) var(--space-7);
    }

    [data-layout-variant="card"] .u-layout-column-2 {
      position: absolute;
      inset: 0;
      z-index: 0;
      width: 100%;
      height: 100%;
      overflow: clip;
    }

    /* ---- auto-width — both columns size to content ---- */

    [data-layout-variant="auto-width"] .u-layout {
      display: var(--_collapse, grid);
      flex-flow: column;
      /* `auto` tracks take their size from their own content — that is the
         point of this variant. Grid then hands the leftover space to those
         same auto tracks, so the row still spans the section instead of
         clumping at the left edge.
         Do NOT add `justify-content: start` here: it opts the tracks out of
         that free-space distribution, which packed both columns against the
         left and left the right half of the section empty. */
      grid-template-columns: auto auto;
    }

    /* ---- Vertical alignment — override column base align-self ---- */
    /* The verticalAlign prop on <Layout> adds u-align-* to .u-layout.
   Since columns default to align-self: center, these rules
   target columns directly with higher specificity to override. */

    .u-layout.u-align-start .u-layout-column-1,
    .u-layout.u-align-start .u-layout-column-2 {
      align-self: start;
    }

    .u-layout.u-align-center .u-layout-column-1,
    .u-layout.u-align-center .u-layout-column-2 {
      align-self: center;
    }

    .u-layout.u-align-end .u-layout-column-1,
    .u-layout.u-align-end .u-layout-column-2 {
      align-self: end;
    }

    .u-layout.u-align-stretch .u-layout-column-1,
    .u-layout.u-align-stretch .u-layout-column-2 {
      align-self: stretch;
    }

    /* ==========================================================================
   RESPONSIVE — collapse resets
   ==========================================================================
   The display switch (grid → flex) is handled by --_collapse, which
   resolves automatically via the responsive flag system. These rules handle
   the ADDITIONAL resets that each variant needs when it collapses:
   reversed column order, sticky positioning, breakout viewport expansion,
   contain padding, and named-line column placement.

   Rules are scoped by data-collapse so they fire at the correct tier:
     data-collapse="medium"  →  @container (width < 58em)  ~928px
     data-collapse="small"   →  @container (width < 35em)  ~560px
   ========================================================================== */

    /* ---- Collapse at medium (default) ---- */

    @container (width < 58em) {
      /* Reset reversed column order */
      [data-collapse="medium"][data-layout-variant="columns-reversed"]
        .u-layout-column-1,
      [data-collapse="medium"][data-layout-variant="columns-reversed"]
        .u-layout-column-2 {
        order: unset;
      }

      /* Unstick the sticky column */
      [data-collapse="medium"][data-layout-variant="sticky-left"]
        .u-layout-column-1 {
        position: static;
      }

      /* Reset breakout/full viewport expansion */
      [data-collapse="medium"][data-layout-variant="breakout"] > .u-layout,
      [data-collapse="medium"][data-layout-variant="breakout-reversed"]
        > .u-layout,
      [data-collapse="medium"][data-layout-variant="full"] > .u-layout,
      [data-collapse="medium"][data-layout-variant="full-reversed"]
        > .u-layout {
        width: 100%;
        margin-inline: 0;
      }

      /* Contain card: adjust padding for stacked layout */
      [data-collapse="medium"][data-layout-variant="contain"]
        .u-layout-column-1,
      [data-collapse="medium"][data-layout-variant="contain-reversed"]
        .u-layout-column-2 {
        padding: var(--space-5);
      }

      [data-collapse="medium"][data-layout-variant="contain"]
        .u-layout-column-2,
      [data-collapse="medium"][data-layout-variant="contain-reversed"]
        .u-layout-column-1 {
        padding: 0;
      }

      /* Reset named-line column placement */
      [data-collapse="medium"][data-layout-variant="breakout"]
        .u-layout-column-1,
      [data-collapse="medium"][data-layout-variant="breakout"]
        .u-layout-column-2,
      [data-collapse="medium"][data-layout-variant="breakout-reversed"]
        .u-layout-column-1,
      [data-collapse="medium"][data-layout-variant="breakout-reversed"]
        .u-layout-column-2,
      [data-collapse="medium"][data-layout-variant="full"] .u-layout-column-1,
      [data-collapse="medium"][data-layout-variant="full"] .u-layout-column-2,
      [data-collapse="medium"][data-layout-variant="full-reversed"]
        .u-layout-column-1,
      [data-collapse="medium"][data-layout-variant="full-reversed"]
        .u-layout-column-2 {
        grid-column: auto;
        overflow: visible;
      }
    }

    /* ---- Collapse at small ---- */

    @container (width < 35em) {
      /* Reset reversed column order */
      [data-collapse="small"][data-layout-variant="columns-reversed"]
        .u-layout-column-1,
      [data-collapse="small"][data-layout-variant="columns-reversed"]
        .u-layout-column-2 {
        order: unset;
      }

      /* Unstick the sticky column */
      [data-collapse="small"][data-layout-variant="sticky-left"]
        .u-layout-column-1 {
        position: static;
      }

      /* Reset breakout/full viewport expansion */
      [data-collapse="small"][data-layout-variant="breakout"] > .u-layout,
      [data-collapse="small"][data-layout-variant="breakout-reversed"]
        > .u-layout,
      [data-collapse="small"][data-layout-variant="full"] > .u-layout,
      [data-collapse="small"][data-layout-variant="full-reversed"] > .u-layout {
        width: 100%;
        margin-inline: 0;
      }

      /* Contain card: adjust padding for stacked layout */
      [data-collapse="small"][data-layout-variant="contain"] .u-layout-column-1,
      [data-collapse="small"][data-layout-variant="contain-reversed"]
        .u-layout-column-2 {
        padding: var(--space-5);
      }

      [data-collapse="small"][data-layout-variant="contain"] .u-layout-column-2,
      [data-collapse="small"][data-layout-variant="contain-reversed"]
        .u-layout-column-1 {
        padding: 0;
      }

      /* Reset named-line column placement */
      [data-collapse="small"][data-layout-variant="breakout"]
        .u-layout-column-1,
      [data-collapse="small"][data-layout-variant="breakout"]
        .u-layout-column-2,
      [data-collapse="small"][data-layout-variant="breakout-reversed"]
