---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/lib/slots";
import { uid } from "@/lib/uid";
/**
 * Accordion — expand/collapse list built on native `details`/`summary`.
 *
 * Children **must** be `<AccordionItem>` components. Single-open behavior is
 * the platform's own `details name` grouping — no click handlers at all.
 * Open/close animates with `interpolate-size` + `::details-content`
 * transitions (Chromium today; other engines open instantly, everything
 * else identical).
 *
 * How grouping works: each `<AccordionItem>` renders a bare
 * `data-accordion-group` marker attribute; this component captures the
 * rendered children ONCE and replaces every marker with a shared
 * `name="accordion-N"` (deterministic counter), which is what makes opening
 * one item close the rest — server-side, no prop drilling.
 *
 * @example Basic FAQ
 * ```astro
 * <Accordion>
 *   <AccordionItem question="What is this design system?">
 *     A structured CSS and component system for building consistent UIs.
 *   </AccordionItem>
 *   <AccordionItem question="How does it work?">
 *     It uses CSS variables and native details grouping.
 *   </AccordionItem>
 * </Accordion>
 * ```
 *
 * @example First item open by default, allow multiple open
 * ```astro
 * <Accordion openByDefault={1} closePrevious={false}>
 *   <AccordionItem question="Item 1">Content 1</AccordionItem>
 *   <AccordionItem question="Item 2">Content 2</AccordionItem>
 * </Accordion>
 * ```
 */

interface Props extends HTMLAttributes<"div"> {
  /**
   * **Accordion props:**
   * - `closePrevious` — close open item when another opens (default true)
   * - `openByDefault` — 1-based index to open on load, 0 = all closed (default 0)
   * - `closeOnSecondClick` — deprecated no-op: a native details always closes on re-click
   * - `class` — extra classes
   * - Also accepts any HTML attribute (`style`, `data-*`, `aria-*`, etc.) — forwarded to root element
   *
   * **Slot:** default — `<AccordionItem>` children
   */
  docs?: string;

  /**
   * Close the currently open item when another is opened — native
   * `details name` grouping. Set to `false` to allow multiple items open
   * at once.
   * @default true
   * @example closePrevious={false}
   */
  closePrevious?: boolean;

  /**
   * Deprecated no-op: a native `details` always closes when its open
   * summary is clicked, so this behavior is permanent now. The prop is
   * kept so old call sites keep type-checking; a DEV warning fires when
   * `false` is passed.
   * @default true
   */
  closeOnSecondClick?: boolean;

  /**
   * 1-based index of the item to open by default on load.
   * `0` means all items start closed.
   * @default 0
   * @example openByDefault={1}
   */
  openByDefault?: number;

  /** Extra utility classes to add to the `.accordion_wrap` element. */
  class?: string;
}

const {
  docs,
  closePrevious = true,
  closeOnSecondClick = true,
  openByDefault = 0,
  class: className,
  ...rest
} = Astro.props;

if (import.meta.env.DEV && closeOnSecondClick === false) {
  console.warn(
    "\n[Accordion] `closeOnSecondClick={false}` no longer does anything — a " +
      "native details element always closes on re-click. Drop the prop.\n",
  );
}

/* Capture the rendered items ONCE (render-once rule, src/lib/slots.ts), then
   do the group wiring as a string pass: every item's data-accordion-group
   marker becomes the shared `name` (single-open), and the openByDefault-th
   marker also gains `open`. Deterministic uid keeps builds reproducible. */
const group = closePrevious ? `name="${uid("accordion")}"` : "";
const slot = await slotContent(Astro.slots);
let markerIndex = 0;
const items = slot.replace(/data-accordion-group/g, () => {
  markerIndex += 1;
  const openAttr = markerIndex === openByDefault ? " open" : "";
  return `${group}${openAttr}`;
});
---

<div class:list={["accordion_wrap", className]} {...rest}>
  <div class="accordion_list">
    <Fragment set:html={items} />
  </div>
</div>

<script>
  /* No open/close logic — the platform owns that. This only forwards layout
     changes to the scroll-refresh bus so scroll-linked animations further
     down the page recompute their positions. */
  function wireAccordions() {
    document
      .querySelectorAll<HTMLElement>(".accordion_wrap")
      .forEach((wrap) => {
        if (wrap.dataset.accordionWired) return;
        wrap.dataset.accordionWired = "true";

        /* `toggle` fires on every open/close (instantly in engines without
           ::details-content transitions — correct there, since the height
           changes instantly). Where the transition runs, transitionend for
           the pseudo-element fires on the details element afterwards, and a
           second refresh lands on the settled height. */
        wrap.addEventListener(
          "toggle",
          () => {
            document.dispatchEvent(new CustomEvent("scrolltrigger:refresh"));
          },
          { capture: true, passive: true },
        );

        wrap.addEventListener(
          "transitionend",
          (e) => {
            if ((e as TransitionEvent).propertyName !== "block-size") return;
            document.dispatchEvent(new CustomEvent("scrolltrigger:refresh"));
          },
          { passive: true },
        );
      });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", wireAccordions);
  } else {
    wireAccordions();
  }
</script>

<style is:global>
  @layer components {
    /* ==========================================================================
   ACCORDION COMPONENT STYLES
   ==========================================================================
   Native details/summary. Single-open comes from the shared `name`
   attribute (injected by Accordion.astro), so there is no click JS at all.

   Animation: `interpolate-size: allow-keywords` lets block-size transition
   to `auto`, and `::details-content` carries the transition. Both are
   Chromium-first — Safari/Firefox get instant open/close with identical
   behavior (details name itself is Baseline 2024).

   Example markup (after the parent's group pass):
     <div class="accordion_wrap">
       <div class="accordion_list">
         <details class="accordion_item" name="accordion-1">
           <summary class="accordion_toggle">
             <h3 class="accordion_toggle_heading">
               <span class="accordion_toggle_text">Question?</span>
             </h3>
             <span class="accordion_toggle_icon">▼</span>
           </summary>
           <div class="accordion_body">Answer.</div>
         </details>
       </div>
     </div>
   ========================================================================== */

    .accordion_wrap {
      padding-top: 1px;
      flex-flow: column;
      width: 100%;
      display: flex;
    }

    .accordion_list {
      flex-flow: column;
      width: 100%;
      margin: 0;
      padding: 0;
      display: flex;
    }

    .accordion_item {
      interpolate-size: allow-keywords;
      border-bottom: var(--border-width-main) solid var(--border);
    }

    .accordion_toggle {
      display: flex;
      align-items: start;
      justify-content: space-between;
      gap: var(--space-3);
      padding-top: var(--space-4);
      padding-bottom: var(--space-4);
      color: inherit;
      list-style: none;
      cursor: pointer;
      outline-offset: var(--focus-offset-inner);
    }

    .accordion_toggle::-webkit-details-marker {
      display: none;
    }

    .accordion_toggle_heading {
      margin: 0;
      font-weight: inherit;
    }

    .accordion_toggle_icon {
      aspect-ratio: 1;
      flex: none;
      width: 1.4rem;
      rotate: 0deg;
      transition: rotate 0.3s ease;
      display: flex;
      align-content: flex-start;
      overflow: visible !important;
    }

    .accordion_item[open] > .accordion_toggle .accordion_toggle_icon,
    .accordion_item[open] > summary .accordion_toggle_icon {
      rotate: -180deg;
    }

    .accordion_toggle_icon > svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    /* Open/close: block-size 0 ↔ auto on the details content box.
       allow-discrete on content-visibility keeps the content painted for
       the whole closing transition. Non-supporting engines ignore all of
       this and toggle instantly. */
    .accordion_item::details-content {
      block-size: 0;
      overflow: hidden;
      content-visibility: hidden;
      transition:
        block-size 0.3s ease,
        content-visibility 0.3s ease allow-discrete;
    }

    .accordion_item[open]::details-content {
      block-size: auto;
      content-visibility: visible;
    }

    .accordion_body {
      padding-bottom: var(--space-4);
    }

    @media (prefers-reduced-motion: reduce) {
      .accordion_item::details-content,
      .accordion_toggle_icon {
        transition-duration: 0.01s;
      }
    }
  }
</style>
