---
import type { HTMLAttributes } from "astro/types";
/**
 * Accordion — animated expand/collapse list.
 *
 * Children **must** be `<AccordionItem>` components.
 * Animation uses GSAP for smooth height transitions (falls back to
 * instant toggle if GSAP is unavailable).
 *
 * @example Basic FAQ
 * ```astro
 * <Accordion>
 *   <AccordionItem question="What is this design system?">
 *     A structured CSS and component system for building consistent UIs.
 *   </AccordionItem>
 *   <AccordionItem question="How does it work?">
 *     It uses CSS variables and a trigger/state system.
 *   </AccordionItem>
 * </Accordion>
 * ```
 *
 * @example First item open by default, allow multiple open
 * ```astro
 * <Accordion openByDefault={1} closePrevious={false}>
 *   <AccordionItem question="Item 1">Content 1</AccordionItem>
 *   <AccordionItem question="Item 2">Content 2</AccordionItem>
 * </Accordion>
 * ```
 */

/**
 * Accordion — animated expand/collapse list using GSAP height transitions.
 *
 * Children must be `<AccordionItem>` components.
 *
 * **Props:**
 * - `closePrevious` — close the open item when another opens (default: `true`)
 * - `closeOnSecondClick` — clicking an open item closes it (default: `true`)
 * - `openOnHover` — open items on hover instead of click (default: `false`)
 * - `openByDefault` — 1-based index of item to open on load, `0` = all closed (default: `0`)
 * - `class` — extra classes on the wrapper
 *
 * **Slot:** default — `<AccordionItem>` children.
 */
interface Props extends HTMLAttributes<"div"> {
  /**
   * **Accordion props:**
   * - `closePrevious` — close open item when another opens (default true)
   * - `closeOnSecondClick` — close on re-click (default true)
   * - `openOnHover` — open on hover (default false)
   * - `openByDefault` — 1-based index to open on load, 0 = all closed (default 0)
   * - `class` — extra classes
   * - Also accepts any HTML attribute (`style`, `data-*`, `aria-*`, etc.) — forwarded to root element
   *
   * **Slot:** default — `<AccordionItem>` children
   */
  docs?: string;

  /**
   * Close the currently open item when another is opened.
   * Set to `false` to allow multiple items to be open at once.
   * @default true
   * @example closePrevious={false}
   */
  closePrevious?: boolean;

  /**
   * Clicking an already-open item's toggle button will close it.
   * @default true
   */
  closeOnSecondClick?: boolean;

  /**
   * Open items on hover instead of (or in addition to) click.
   * Not recommended for keyboard accessibility.
   * @default false
   */
  openOnHover?: boolean;

  /**
   * 1-based index of the item to open by default on load.
   * `0` means all items start closed.
   * @default 0
   * @example openByDefault={1}
   */
  openByDefault?: number;

  /** Extra utility classes to add to the `.accordion_wrap` element. */
  class?: string;
}

const {
  docs,
  closePrevious = true,
  closeOnSecondClick = true,
  openOnHover = false,
  openByDefault = 0,
  class: className,
  ...rest
} = Astro.props;
---

<div
  class:list={["accordion_wrap", className]}
  data-close-previous={String(closePrevious)}
  data-close-on-second-click={String(closeOnSecondClick)}
  data-open-on-hover={String(openOnHover)}
  data-open-by-default={String(openByDefault)}
  {...rest}
>
  <div class="accordion_list" role="list">
    <slot />
  </div>
</div>

<script>
  /**
   * Accordion JavaScript — CSS grid-template-rows approach
   *
   * JS only toggles aria-expanded + .is-active. The animation runs on the
   * browser's native pipeline via `grid-template-rows: 0fr ↔ 1fr` on
   * .accordion_content_wrap (see accordion.css). No GSAP timeline, no
   * synchronous height measurement.
   *
   * Data attributes on .accordion_wrap:
   *   data-close-previous        — "true" | "false"
   *   data-close-on-second-click — "true" | "false"
   *   data-open-on-hover         — "true" | "false"
   *   data-open-by-default       — "0" | "1" | "2" … (1-based index)
   *
   * Open/close (plain CSS, no variables):
   *   aria-expanded on .accordion_toggle_button — JS toggles this attribute.
   *   .accordion_item:has(.accordion_toggle_button[aria-expanded="true"])
   *   expands the panel (grid-template-rows) and rotates the chevron — see
   *   accordion.css.
   */

  function initAccordions() {
    const ScrollTrigger = (window as any).ScrollTrigger;

    document
      .querySelectorAll<HTMLElement>(".accordion_wrap")
      .forEach((wrap) => {
        const closePrevious = wrap.dataset.closePrevious !== "false";
        const closeOnSecondClick = wrap.dataset.closeOnSecondClick !== "false";
        const openOnHover = wrap.dataset.openOnHover === "true";
        const openByDefault = parseInt(wrap.dataset.openByDefault ?? "0", 10);

        const items = wrap.querySelectorAll<HTMLElement>(".accordion_item");

        function getButton(item: HTMLElement) {
          return item.querySelector<HTMLButtonElement>(
            ".accordion_toggle_button",
          );
        }

        function getContent(item: HTMLElement) {
          return item.querySelector<HTMLElement>(".accordion_content_wrap");
        }

        function isOpen(item: HTMLElement) {
          return getButton(item)?.getAttribute("aria-expanded") === "true";
        }

        function openItem(item: HTMLElement) {
          const button = getButton(item);
          if (!button) return;
          button.setAttribute("aria-expanded", "true");
          item.classList.add("is-active");
        }

        function closeItem(item: HTMLElement) {
          const button = getButton(item);
          if (!button) return;
          button.setAttribute("aria-expanded", "false");
          item.classList.remove("is-active");
        }

        function toggle(item: HTMLElement) {
          if (isOpen(item)) {
            if (closeOnSecondClick) closeItem(item);
          } else {
            if (closePrevious) {
              items.forEach((other) => {
                if (other !== item && isOpen(other)) closeItem(other);
              });
            }
            openItem(item);
          }
        }

        items.forEach((item) => {
          const button = getButton(item);
          if (!button) return;

          button.addEventListener("click", () => toggle(item));

          if (openOnHover) {
            item.addEventListener("mouseenter", () => {
              if (!isOpen(item)) toggle(item);
            });
          }

          // Refresh ScrollTrigger after each open/close animation so it can
          // recompute positions for any scroll-linked effects below.
          const content = getContent(item);
          if (content) {
            content.addEventListener(
              "transitionend",
              (e) => {
                if (
                  e.target === content &&
                  (e as TransitionEvent).propertyName ===
                    "grid-template-rows" &&
                  ScrollTrigger
                ) {
                  ScrollTrigger.refresh();
                }
              },
              { passive: true },
            );
          }
        });

        // Apply openByDefault state BEFORE the .is-ready class enables
        // transitions — so the default item renders open without animating in.
        if (openByDefault > 0 && items[openByDefault - 1]) {
          openItem(items[openByDefault - 1]);
        }

        // Double rAF guarantees the initial state is painted before we
        // enable CSS transitions on grid-template-rows.
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            wrap.classList.add("is-ready");
          });
        });
      });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAccordions);
  } else {
    initAccordions();
  }
</script>

<style is:global>
  /* Global styles (is:global — classes here are used across the site and by
     child slots), moved from src/styles/components/accordion.css. The layer
     wrapper slots them into the cascade defined in styles/global.css. */
  @layer components {
    /* ==========================================================================
   ACCORDION COMPONENT STYLES
   ==========================================================================
   Animated expand/collapse list, driven entirely by the `aria-expanded`
   attribute that JS toggles on the toggle button — plain CSS, no variables.

   How it works:
     `:has(.accordion_toggle_button[aria-expanded="true"])` toggles
     grid-template-rows from 0fr to 1fr on .accordion_content_wrap, which
     animates the expand/collapse natively in CSS — no JS measurement or
     GSAP timeline required. The chevron icon rotates off the same
     attribute (see .accordion_toggle_icon below).

   Example markup:
     <div class="accordion_wrap">
       <div class="accordion_list" role="list">
         <div class="accordion_item" role="listitem">
           <div class="accordion_component">
             <h3 class="accordion_toggle_heading">
               <button class="accordion_toggle_button" aria-expanded="false">
                 <span class="accordion_toggle_text">Question?</span>
                 <span class="accordion_toggle_icon">▼</span>
               </button>
             </h3>
             <div class="accordion_content_wrap">
               <div class="accordion_content_padding">Answer.</div>
             </div>
           </div>
         </div>
       </div>
     </div>
   ========================================================================== */

    .accordion_wrap {
      padding-top: 1px;
      flex-flow: column;
      width: 100%;
      display: flex;
    }

    .accordion_list {
      flex-flow: column;
      list-style: none;
      width: 100%;
      margin-top: calc(var(--space-4) * -1);
      margin-bottom: 0;
      margin-left: 0;
      margin-right: 0;
      padding: 0;
      display: flex;
    }

    .accordion_item {
      border-bottom: var(--border-width-main) solid var(--border);
    }

    .accordion_item:first-child {
      border-top: none;
    }

    .accordion_component {
      position: relative;
    }

    .accordion_toggle_button {
      padding-top: var(--space-4);
      padding-bottom: var(--space-4);
      gap: var(--space-3);
      color: inherit;
      cursor: pointer;
      outline-offset: var(--focus-offset-inner);
      justify-content: space-between;
      align-items: start;
      width: 100%;
      list-style: none;
      display: flex;
      /* Reset browser default button styles */
      background: none;
      border: none;
      text-align: left;
    }

    /* Remove default browser disclosure arrow */
    .accordion_toggle_button::-webkit-details-marker {
      display: none;
    }

    .accordion_toggle_heading {
      margin-top: 0;
      margin-bottom: 0;
      font-weight: inherit;
    }

    .accordion_toggle_icon {
      aspect-ratio: 1;
      flex: none;
      width: 1.4rem;
      transform: rotate(0deg);
      transition: transform 0.3s ease;
      display: flex;
      align-content: flex-start;
      overflow: visible !important;
    }

    /* Flip the chevron when its toggle is expanded — keyed off the same
   aria-expanded attribute that opens the panel below. */
    .accordion_toggle_button[aria-expanded="true"] .accordion_toggle_icon {
      transform: rotate(-180deg);
    }

    .accordion_toggle_icon > svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    /* Content panel — collapses/expands via grid-template-rows: 0fr ↔ 1fr.
   `minmax(0, ...)` forces the track minimum to 0 (bare 0fr defaults to
   min-content, which lets the top of the content peek through when
   collapsed). overflow: hidden on the wrap is a belt-and-suspenders
   clip for any bleed during the transition. The inner padding element
   also gets overflow: hidden so it can shrink to 0 along with the row. */
    .accordion_content_wrap {
      width: 100%;
      display: grid;
      grid-template-rows: minmax(0, 0fr);
      overflow: hidden;
    }

    /* JS adds .is-ready to .accordion_wrap after the initial state is painted
   so the openByDefault item doesn't animate in on page load. */
    .accordion_wrap.is-ready .accordion_content_wrap {
      transition: grid-template-rows 0.3s ease;
    }

    .accordion_item:has(.accordion_toggle_button[aria-expanded="true"])
      .accordion_content_wrap {
      grid-template-rows: minmax(0, 1fr);
    }

    @media (prefers-reduced-motion: reduce) {
      .accordion_wrap.is-ready .accordion_content_wrap {
        transition: none;
      }
    }

    .accordion_content_padding {
      min-height: 0;
      overflow: hidden;
    }
  }
</style>
