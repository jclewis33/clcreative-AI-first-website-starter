---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/lib/slots";

export interface Props extends HTMLAttributes<"div"> {
  /**
   * **Dropdown props:**
   * - `label` — the text on the control that opens it (required to render)
   * - `render` — false skips the component entirely
   * - `class` — extra classes on `.dropdown_wrap`
   * - Also accepts any HTML attribute — forwarded to the `details` element
   *
   * **Slot:** default — the panel content (links, buttons, anything).
   *
   * Built on a native `details` element, so it opens and closes with no JS.
   * The script adds Escape-to-close (focus returns to the control), arrow-key
   * roving focus over the panel's links/buttons, and click-outside-closes.
   * Open/close animation uses `::details-content` transitions — Chromium
   * today; other engines get an instant open with identical behavior.
   */
  docs?: string;

  /**
   * Set to `false` to skip rendering this component and its children.
   *
   * @default true
   */
  render?: boolean;

  /**
   * The text on the control that opens the dropdown. Nothing renders
   * without it.
   *
   * @example label="Resources"
   */
  label?: string;
}

const { docs, render = true, label, class: className, ...rest } = Astro.props;

/* Capture the slot ONCE and emit the string with set:html — render-once rule,
   see src/lib/slots.ts. */
const content = await slotContent(Astro.slots);

if (import.meta.env.DEV && render && !label) {
  console.warn(
    "\n[Dropdown] Rendered without a `label`; nothing was output.\n",
  );
}
---

{
  render && label && content && (
    <details class:list={["dropdown_wrap", className]} {...rest}>
      <summary class="dropdown_toggle">
        <span class="dropdown_label">{label}</span>
        <svg
          class="dropdown_icon"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="4 6 8 10 12 6" />
        </svg>
      </summary>

      <div class="dropdown_content">
        <div class="dropdown_body u-margin-trim">
          <Fragment set:html={content} />
        </div>
      </div>
    </details>
  )
}

<script>
  /* ONE pair of document listeners for every dropdown on the page (delegated,
     not one pair per instance). Native details handles open/close; this adds
     Escape, arrow-key roving focus, and click-outside. */
  function openDropdowns(): HTMLDetailsElement[] {
    return [
      ...document.querySelectorAll<HTMLDetailsElement>(".dropdown_wrap[open]"),
    ];
  }

  document.addEventListener("keydown", (event) => {
    const open = openDropdowns();
    if (open.length === 0) return;

    if (event.key === "Escape") {
      for (const dropdown of open) {
        dropdown.open = false;
        if (dropdown.contains(document.activeElement)) {
          dropdown.querySelector<HTMLElement>(".dropdown_toggle")?.focus();
        }
      }
      return;
    }

    const forward = event.key === "ArrowDown";
    if (!forward && event.key !== "ArrowUp") return;

    const active = document.activeElement as HTMLElement | null;
    const dropdown = open.find((d) => d.contains(active));
    if (!dropdown) return;

    const content = dropdown.querySelector<HTMLElement>(".dropdown_content");
    if (!content) return;
    const items = [
      ...content.querySelectorAll<HTMLElement>(
        "a[href], button:not(:disabled)",
      ),
    ];
    if (items.length === 0) return;

    event.preventDefault();
    const from = items.indexOf(active as HTMLElement);
    const step = forward ? 1 : -1;
    const next =
      from === -1
        ? forward
          ? 0
          : items.length - 1
        : (from + step + items.length) % items.length;
    items[next].focus();
  });

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;
    for (const dropdown of openDropdowns()) {
      if (!dropdown.contains(target)) dropdown.open = false;
    }
  });
</script>

<style is:global>
  @layer components {
    /* ==========================================================================
   DROPDOWN COMPONENT
   ==========================================================================
   Native details/summary menu. The panel is absolutely positioned under the
   control; ::details-content transitions animate it where supported
   (Chromium) and degrade to instant elsewhere — behavior is identical.
   ========================================================================== */

    .dropdown_wrap {
      --_control-pad: 0.75em;
      --_open-duration: 0.3s;
      --_leaving: calc(var(--_open-duration) * 0.7);
      position: relative;
      z-index: 10;
      display: inline-block;
    }

    .dropdown_toggle {
      display: flex;
      align-items: center;
      gap: 0.5em;
      padding: var(--_control-pad) 0;
      color: inherit;
      list-style: none;
      cursor: pointer;
      transition: color 0.2s ease;
    }

    .dropdown_toggle::-webkit-details-marker {
      display: none;
    }

    @media (hover: hover) {
      .dropdown_toggle:hover {
        color: color-mix(in hsl, currentColor 60%, transparent);
      }
    }

    .dropdown_icon {
      flex-shrink: 0;
      width: 1em;
      aspect-ratio: 1 / 1;
      stroke-width: var(--border-width-main);
      transition: rotate var(--_open-duration) ease;
    }

    .dropdown_wrap[open] .dropdown_icon {
      rotate: 180deg;
    }

    .dropdown_wrap::details-content {
      opacity: 0;
      content-visibility: hidden;
      transition:
        opacity var(--_leaving) ease,
        content-visibility var(--_leaving) ease allow-discrete;
    }

    .dropdown_wrap[open]::details-content {
      opacity: 1;
      content-visibility: visible;
      transition:
        opacity var(--_open-duration) ease,
        content-visibility var(--_open-duration) ease allow-discrete;
    }

    .dropdown_content {
      position: absolute;
      top: calc(100% - var(--_control-pad) + var(--space-2));
      inset-inline-start: 0;
      width: max-content;
      min-width: 100%;
      max-width: min(22rem, calc(100vw - var(--site-margin) * 2));
      background-color: var(--background-2);
      border-radius: var(--radius-small);
      box-shadow: var(--box-shadow-medium);
      transform-origin: top left;
      translate: 0 -0.5rem;
      scale: 0.98;
      transition:
        translate var(--_leaving) ease,
        scale var(--_leaving) ease;
    }

    .dropdown_wrap[open] .dropdown_content {
      translate: 0 0;
      scale: 1;
      transition:
        translate var(--_open-duration) ease,
        scale var(--_open-duration) ease;
    }

    .dropdown_body {
      padding: var(--space-5);
    }

    @media (prefers-reduced-motion: reduce) {
      .dropdown_wrap::details-content,
      .dropdown_wrap[open]::details-content,
      .dropdown_content,
      .dropdown_wrap[open] .dropdown_content,
      .dropdown_icon {
        transition-duration: 0.01s;
      }
    }
  }
</style>
