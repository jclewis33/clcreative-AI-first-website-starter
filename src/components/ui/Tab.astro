---
/**
 * Tab component — a tabbed interface with multiple layout and transition variants.
 *
 * Compose with `<TabButton>` (in the `buttons` slot) and `<TabPanel>` (default slot):
 *
 * ```astro
 * <Tab>
 *   <TabButton slot="buttons" label="Features" />
 *   <TabButton slot="buttons" label="Pricing" />
 *
 *   <TabPanel>Features content</TabPanel>
 *   <TabPanel>Pricing content</TabPanel>
 * </Tab>
 * ```
 *
 * Variants:
 *   - `top`    — horizontal tabs, fade transition (default)
 *   - `side`   — vertical tabs in a 12-col grid, fade transition
 *   - `slider` — horizontal tabs, slide transition, autoplay + prev/next/play-pause controls
 *   - `fade`   — horizontal tabs, fade transition, no controls (alias for top)
 *
 * Slots:
 *   - `heading` — optional heading content above the button list
 *   - `buttons` — TabButton instances
 *   - default   — TabPanel instances
 *
 * Panel transitions and the autoplay progress line are pure CSS
 * (keyframes + animation-play-state) — no animation library. Autoplay
 * pauses while hovered, focused, offscreen, or under reduced motion.
 */

/**
 * Tab layout and transition variant.
 * - `'top'`    — horizontal tabs at top, fade transition (default)
 * - `'side'`   — vertical tabs on left (3-col grid), fade transition
 * - `'slider'` — horizontal tabs, slide transition, autoplay + prev/next/play-pause controls
 * - `'fade'`   — alias for `'top'` (identical behavior)
 */
type TabVariant = "top" | "side" | "slider" | "fade";

/**
 * Tab — tabbed interface with multiple layout and transition variants.
 *
 * Compose with `<TabButton>` (in the `buttons` slot) and `<TabPanel>` (default slot).
 *
 * **Props:**
 * - `variant` — layout and transition: top (horizontal, fade), side (vertical, fade), slider (horizontal, slide + autoplay), fade (alias for top) (default: `'top'`)
 * - `duration` — panel transition duration in seconds (default: `0.6`)
 * - `autoplayDuration` — autoplay interval in seconds, slider variant only (default: `6`)
 * - `pauseOnHover` — pause autoplay on hover, slider variant only (default: `true`)
 * - `loopControls` — loop arrow navigation, slider variant only (default: `true`)
 * - `activeTab` — 1-based index of initially active tab (default: `1`)
 * - `id` — id on the wrapper; also the query-param key for deep links
 * - `deepLink` — mirror the active tab in the URL query string (default: `false`)
 * - `class` — extra classes on the wrapper
 *
 * **Slots:** `heading` (above button list), `buttons` (`<TabButton>` instances), default (`<TabPanel>` instances).
 */
interface Props {
  /**
   * **Tab props:**
   * - `variant` — top (horizontal, fade), side (vertical, fade), slider (horizontal, slide + autoplay), fade (default 'top')
   * - `duration` — transition seconds (default 0.6)
   * - `autoplayDuration` — interval seconds, slider only (default 6)
   * - `pauseOnHover` — pause autoplay on hover (default true)
   * - `loopControls` — loop arrow navigation (default true)
   * - `activeTab` — 1-based initially active tab (default 1)
   * - `id` — wrapper id, doubles as the deep-link query key
   * - `deepLink` — mirror the active tab in the URL (default false)
   * - `class` — extra classes
   *
   * **Slots:** `heading` (above buttons), `buttons` (`<TabButton>`), default (`<TabPanel>`)
   */
  docs?: string;

  /**
   * Tab variant controlling layout, button style, and transition type.
   *
   * | Value | Layout | Transition | Controls |
   * |-------|--------|------------|----------|
   * | `'top'` | Horizontal tabs, content below | Fade | None |
   * | `'side'` | Vertical tabs (3-col), content right (9-col) | Fade | None |
   * | `'slider'` | Horizontal tabs, content below | Slide | Prev/Next + Play/Pause |
   * | `'fade'` | Horizontal tabs, content below | Fade | None |
   *
   * @default 'top'
   * @example variant="side"
   * @example variant="slider"
   */
  variant?: TabVariant;

  /**
   * Panel transition duration in seconds (drives the CSS keyframes).
   * @default 0.6
   */
  duration?: number;

  /**
   * Autoplay interval in seconds. Only used when `variant="slider"`.
   * Set to `0` to disable autoplay even in slider mode.
   * @default 6
   * @example autoplayDuration={10}
   */
  autoplayDuration?: number;

  /**
   * Pause autoplay when hovering over the tab component.
   * Only applies when `variant="slider"` and `autoplayDuration > 0`.
   * @default true
   */
  pauseOnHover?: boolean;

  /**
   * Loop arrow navigation: after the last tab, "next" returns to the first.
   * Only applies when `variant="slider"`.
   * @default true
   */
  loopControls?: boolean;

  /**
   * 1-based index of the tab that is active on initial load.
   * @default 1
   * @example activeTab={2}
   */
  activeTab?: number;

  /**
   * `id` on the wrapper. With `deepLink`, it is also the query-param key —
   * `?our-services=pricing` — so two tab sets on one page stay independent.
   * @example id="our-services"
   */
  id?: string;

  /**
   * Mirror the active tab in the URL query string (`history.replaceState`,
   * no scroll jump, no history entries). On load with a matching param, that
   * tab activates, scrolls into view, and autoplay stays off — the visitor
   * asked for that tab. Param key is `id`, falling back to `"tab"`; values
   * are slugs of the tab labels.
   *
   * @default false
   * @example deepLink
   */
  deepLink?: boolean;

  /** Extra utility classes on the `.tab_wrap` element. */
  class?: string;
}

const {
  variant = "top",
  duration = 0.6,
  autoplayDuration = 6,
  pauseOnHover = true,
  loopControls = true,
  activeTab = 1,
  id,
  deepLink = false,
  class: className,
} = Astro.props;

const isSlider = variant === "slider";
const isSide = variant === "side";
const hasHeading = Astro.slots.has("heading");

/* Transition mode: slider variant uses horizontal slide; everything else fades */
const transitionMode = isSlider ? "slide" : "fade";

/* Unique ID prefix for ARIA linking */
const tabId = `tab-${Math.random().toString(36).slice(2, 8)}`;
---

<div
  class:list={["tab_wrap", className]}
  id={id}
  style={`--_duration: ${duration}s; --_autoplay: ${autoplayDuration}s;`}
  data-tab-variant={variant}
  data-tab-transition={transitionMode}
  data-autoplay-duration={isSlider ? String(autoplayDuration) : ""}
  data-pause-on-hover={String(pauseOnHover)}
  data-loop-controls={String(loopControls)}
  data-active-tab={String(activeTab)}
  data-deep-link={deepLink ? "true" : undefined}
  data-tab-id={tabId}
>
  <div class="tab_left">
    {
      hasHeading && (
        <div class="tab_heading_wrap u-margin-trim">
          <slot name="heading" />
        </div>
      )
    }
    <div
      class="tab_button_list"
      role="tablist"
      aria-orientation={isSide ? "vertical" : "horizontal"}
    >
      <slot name="buttons" />
    </div>
  </div>

  <div class="tab_right">
    <div class="tab_content_wrap">
      <div class="tab_content_list">
        <slot />
      </div>
    </div>

    {/* Slider controls: prev/next arrows + play/pause toggle */}
    {
      isSlider && (
        <div class="tab_control_wrap">
          <div class="tab_arrow_wrap">
            {/* Previous arrow — reuses existing button_arrow pattern from buttons.css */}
            {/* The control IS the <button> — no stretched overlay. The
                _element/_icon spans are the painted surface. */}
            <button
              type="button"
              class="button_arrow_wrap tab_prev_btn"
              aria-label="Previous tab"
            >
              <span class="button_arrow_element button_arrow_element--secondary">
                <span aria-hidden="true" class="button_arrow_icon">
                  <svg
                    viewBox="0 0 33 26"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                  >
                    <path d="M15 24.8437L2 12.8438L15 0.843749" />
                    <path d="M2.5 13L33 13" />
                  </svg>
                </span>
              </span>
            </button>
            {/* Next arrow */}
            {/* The control IS the <button> — no stretched overlay. The
                _element/_icon spans are the painted surface. */}
            <button
              type="button"
              class="button_arrow_wrap tab_next_btn"
              aria-label="Next tab"
            >
              <span class="button_arrow_element button_arrow_element--secondary">
                <span aria-hidden="true" class="button_arrow_icon">
                  <svg
                    viewBox="0 0 33 26"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                  >
                    <path d="M18 24.8437L31 12.8438L18 0.843749" />
                    <path d="M30.5 13L0 13" />
                  </svg>
                </span>
              </span>
            </button>
          </div>

          {/* Play/Pause toggle — reuses existing button_toggle pattern from buttons.css */}
          {/* The control IS the <button> — no stretched overlay. The
                _element/_icon spans are the painted surface. */}
          <button
            type="button"
            class="button_toggle_wrap is-active tab_toggle_btn"
            aria-label="Pause automatic tab rotation"
            aria-pressed="true"
          >
            <span class="button_toggle_element button_toggle_element--secondary">
              <span aria-hidden="true" class="button_toggle_icon">
                <svg
                  class="button_toggle_play u-cover-absolute"
                  viewBox="0 0 1393 1394"
                  fill="none"
                >
                  <path
                    d="M1271 696.5L280 1393L280 -4.3318e-05L1271 696.5Z"
                    fill="currentColor"
                  />
                </svg>
                <svg
                  class="button_toggle_pause u-cover-absolute"
                  viewBox="0 0 898 1277"
                  fill="none"
                >
                  <rect x="577" width="321" height="1277" fill="currentColor" />
                  <rect width="321" height="1277" fill="currentColor" />
                </svg>
              </span>
            </span>
          </button>
        </div>
      )
    }
  </div>
</div>

<noscript>
  <style>
    /* Without JS: every panel shows stacked, controls hide. Content stays
       reachable — tabs degrade to headed sections. */
    .tab_panel_item[hidden] {
      display: block !important;
    }
    .tab_control_wrap {
      display: none !important;
    }
  </style>
</noscript>

<script>
  /**
   * Tab Component JavaScript — no animation library.
   *
   * Panel transitions are CSS keyframes selected by [data-tab-transition];
   * the autoplay progress line is a CSS animation whose `animationend`
   * advances the tab, and whose play-state is paused by "holds": hover,
   * focus inside the tabs, scrolled offscreen, or prefers-reduced-motion.
   * Holds pause (resume where it left off); the play/pause button stops.
   *
   * Data attributes on .tab_wrap:
   *   data-tab-variant        — "top" | "side" | "slider" | "fade"
   *   data-tab-transition     — "slide" | "fade"
   *   data-autoplay-duration  — autoplay interval in seconds ("" = disabled)
   *   data-pause-on-hover     — "true" | "false"
   *   data-loop-controls      — "true" | "false"
   *   data-active-tab         — 1-based index of initially active tab
   *   data-deep-link          — "true" mirrors the active tab in the URL
   *   data-tab-id             — unique prefix for ARIA id generation
   * CSS custom properties (inline): --_duration, --_autoplay
   */

  const slugify = (text: string) =>
    text
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/(^-|-$)/g, "");

  function initTabs() {
    document.querySelectorAll<HTMLElement>(".tab_wrap").forEach((wrap) => {
      // Prevent double-init
      if (wrap.dataset.tabInitialized) return;
      wrap.dataset.tabInitialized = "true";

      // --- Configuration ---
      const variant = wrap.dataset.tabVariant ?? "top";
      const autoplayDur = parseFloat(wrap.dataset.autoplayDuration || "0");
      const doPauseOnHover = wrap.dataset.pauseOnHover !== "false";
      const doLoop = wrap.dataset.loopControls !== "false";
      const initialActive = parseInt(wrap.dataset.activeTab ?? "1", 10);
      const deepLink = wrap.dataset.deepLink === "true";
      const paramKey = wrap.id || "tab";
      const tabId = wrap.dataset.tabId ?? "";
      const durationMs =
        parseFloat(getComputedStyle(wrap).getPropertyValue("--_duration")) *
          1000 || 600;

      // --- Query elements ---
      const buttons = Array.from(
        wrap.querySelectorAll<HTMLButtonElement>(".tab_button_item"),
      );
      const panels = Array.from(
        wrap.querySelectorAll<HTMLElement>(".tab_panel_item"),
      );
      const prevBtn = wrap.querySelector<HTMLButtonElement>(".tab_prev_btn");
      const nextBtn = wrap.querySelector<HTMLButtonElement>(".tab_next_btn");
      const toggleBtn =
        wrap.querySelector<HTMLButtonElement>(".tab_toggle_btn");
      const toggleWrap = toggleBtn; // the control IS the .button_toggle_wrap element now

      if (buttons.length === 0 || panels.length === 0) return;
      if (buttons.length !== panels.length) {
        console.warn(
          "Tab: button count (" +
            buttons.length +
            ") does not match panel count (" +
            panels.length +
            ").",
        );
        return;
      }

      let currentIndex = Math.max(
        0,
        Math.min(initialActive - 1, buttons.length - 1),
      );
      let isAnimating = false;
      let isPlaying = autoplayDur > 0;
      let cleanupTimer = 0;

      // --- Wire up ARIA IDs ---
      buttons.forEach((btn, i) => {
        const btnId = `${tabId}-btn-${i + 1}`;
        const panelId = `${tabId}-panel-${i + 1}`;
        btn.id = btnId;
        btn.setAttribute("aria-controls", panelId);
        panels[i].id = panelId;
        panels[i].setAttribute("aria-labelledby", btnId);
      });

      // --- Deep links: slugs derived from the visible tab labels ---
      const slugs = buttons.map(
        (btn, i) => slugify(btn.textContent ?? "") || `tab-${i + 1}`,
      );

      function writeParam(index: number) {
        if (!deepLink) return;
        const url = new URL(window.location.href);
        url.searchParams.set(paramKey, slugs[index]);
        history.replaceState(null, "", url);
      }

      // --- Set active state (no animation, used on init) ---
      function setActiveImmediate(index: number) {
        buttons.forEach((btn, i) => {
          const active = i === index;
          btn.classList.toggle("is-active", active);
          btn.setAttribute("aria-selected", String(active));
          btn.setAttribute("tabindex", active ? "0" : "-1");
        });

        panels.forEach((panel, i) => {
          const active = i === index;
          panel.classList.toggle("is-active", active);
          panel.classList.remove("is-leaving");
          panel.hidden = !active;
        });

        currentIndex = index;
      }

      // --- Animate to a new tab (CSS keyframes do the motion) ---
      function goToTab(newIndex: number, focus = false) {
        if (newIndex === currentIndex || isAnimating) return;
        if (newIndex < 0 || newIndex >= buttons.length) return;

        isAnimating = true;
        const oldIndex = currentIndex;
        const direction = newIndex > oldIndex ? 1 : -1;
        wrap.style.setProperty("--_dir", String(direction));

        // Update button states
        buttons.forEach((btn, i) => {
          const active = i === newIndex;
          btn.classList.toggle("is-active", active);
          btn.setAttribute("aria-selected", String(active));
          btn.setAttribute("tabindex", active ? "0" : "-1");
        });

        // Scroll active button into view
        const buttonList = wrap.querySelector<HTMLElement>(".tab_button_list");
        if (buttonList) {
          buttonList.scrollTo({
            left: buttons[newIndex].offsetLeft,
            behavior: "smooth",
          });
        }

        const oldPanel = panels[oldIndex];
        const newPanel = panels[newIndex];

        currentIndex = newIndex;
        writeParam(newIndex);

        if (focus) buttons[newIndex].focus();

        /* Old panel exits absolutely-positioned on top of the flow; the new
           panel enters in flow. Both run their CSS animation; cleanup fires
           on the old panel's animationend, with a timer as safety net. */
        oldPanel.classList.remove("is-active");
        oldPanel.classList.add("is-leaving");
        newPanel.hidden = false;
        newPanel.classList.add("is-active");

        const finish = () => {
          if (!oldPanel.classList.contains("is-leaving")) return;
          oldPanel.classList.remove("is-leaving");
          oldPanel.hidden = true;
          isAnimating = false;
          // Panel height changed — nudge any scroll-linked animations
          // without importing ScrollTrigger here (scroll-refresh.js).
          document.dispatchEvent(new CustomEvent("scrolltrigger:refresh"));
          if (isPlaying) startProgress();
        };

        oldPanel.addEventListener("animationend", finish, { once: true });
        clearTimeout(cleanupTimer);
        cleanupTimer = window.setTimeout(finish, durationMs + 100);
      }

      // --- Autoplay progress line (slider variant, pure CSS animation) ---
      // .is-running starts the keyframe; removing + reflow + re-adding
      // restarts it from zero. Holds pause it via animation-play-state.
      function startProgress() {
        stopProgress();
        if (!isPlaying || autoplayDur <= 0) return;
        const line =
          buttons[currentIndex]?.querySelector<HTMLElement>(".tab_button_line");
        if (!line) return;
        void line.offsetWidth;
        line.classList.add("is-running");
      }

      function stopProgress() {
        buttons.forEach((btn) => {
          btn
            .querySelector<HTMLElement>(".tab_button_line")
            ?.classList.remove("is-running");
        });
      }

      // The line's animationend IS the autoplay tick.
      wrap.addEventListener("animationend", (e) => {
        const target = e.target as HTMLElement;
        if (!target.classList.contains("tab_button_line")) return;
        if (!isPlaying) return;
        const next = doLoop
          ? (currentIndex + 1) % buttons.length
          : Math.min(currentIndex + 1, buttons.length - 1);
        if (next !== currentIndex) {
          stopProgress();
          goToTab(next);
        } else {
          stopAutoplay();
        }
      });

      function startAutoplay() {
        isPlaying = true;
        if (toggleWrap) toggleWrap.classList.add("is-active");
        if (toggleBtn) {
          toggleBtn.setAttribute("aria-label", "Pause automatic tab rotation");
          toggleBtn.setAttribute("aria-pressed", "true");
        }
        startProgress();
      }

      function stopAutoplay() {
        isPlaying = false;
        stopProgress();
        if (toggleWrap) toggleWrap.classList.remove("is-active");
        if (toggleBtn) {
          toggleBtn.setAttribute("aria-label", "Start automatic tab rotation");
          toggleBtn.setAttribute("aria-pressed", "false");
        }
      }

      // --- Holds: pause (not stop) the progress line ---
      // Hover, focus inside the tabs, offscreen, and reduced motion each
      // hold the line; it resumes where it left off when the hold lifts.
      const holds = {
        hover: false,
        focus: false,
        offscreen: false,
        motion: false,
      };

      function applyHolds() {
        const held =
          holds.hover || holds.focus || holds.offscreen || holds.motion;
        wrap.classList.toggle("is-held", held);
      }

      // --- Event: Tab button click ---
      buttons.forEach((btn, i) => {
        btn.addEventListener("click", () => {
          stopProgress();
          goToTab(i);
        });
      });

      // --- Event: Keyboard navigation ---
      wrap.addEventListener("keydown", (e) => {
        const target = e.target as HTMLElement;
        if (!target.matches('[role="tab"]')) return;

        const isVertical = variant === "side";
        const nextKey = isVertical ? "ArrowDown" : "ArrowRight";
        const prevKey = isVertical ? "ArrowUp" : "ArrowLeft";

        let newIndex = currentIndex;

        if (e.key === nextKey) {
          e.preventDefault();
          newIndex = doLoop
            ? (currentIndex + 1) % buttons.length
            : Math.min(currentIndex + 1, buttons.length - 1);
        } else if (e.key === prevKey) {
          e.preventDefault();
          newIndex = doLoop
            ? (currentIndex - 1 + buttons.length) % buttons.length
            : Math.max(currentIndex - 1, 0);
        } else if (e.key === "Home") {
          e.preventDefault();
          newIndex = 0;
        } else if (e.key === "End") {
          e.preventDefault();
          newIndex = buttons.length - 1;
        }

        if (newIndex !== currentIndex) {
          stopProgress();
          goToTab(newIndex, true);
        }
      });

      // --- Event: Prev/Next arrows ---
      prevBtn?.addEventListener("click", () => {
        const prev = doLoop
          ? (currentIndex - 1 + buttons.length) % buttons.length
          : Math.max(currentIndex - 1, 0);
        stopProgress();
        goToTab(prev);
      });

      nextBtn?.addEventListener("click", () => {
        const next = doLoop
          ? (currentIndex + 1) % buttons.length
          : Math.min(currentIndex + 1, buttons.length - 1);
        stopProgress();
        goToTab(next);
      });

      // --- Event: Play/Pause toggle ---
      toggleBtn?.addEventListener("click", () => {
        if (isPlaying) {
          stopAutoplay();
        } else {
          startAutoplay();
        }
      });

      // --- Holds wiring (autoplay only) ---
      if (autoplayDur > 0) {
        if (doPauseOnHover) {
          wrap.addEventListener("mouseenter", () => {
            holds.hover = true;
            applyHolds();
          });
          wrap.addEventListener("mouseleave", () => {
            holds.hover = false;
            applyHolds();
          });
        }

        // Focus inside the tabs holds the rotation — content should not
        // move under a keyboard user.
        wrap.addEventListener("focusin", () => {
          holds.focus = true;
          applyHolds();
        });
        wrap.addEventListener("focusout", (e) => {
          const to = (e as FocusEvent).relatedTarget as Node | null;
          if (to && wrap.contains(to)) return;
          holds.focus = false;
          applyHolds();
        });

        // Offscreen holds the rotation.
        const observer = new IntersectionObserver(
          (entries) => {
            holds.offscreen = !entries[0].isIntersecting;
            applyHolds();
          },
          { threshold: 0 },
        );
        observer.observe(wrap);

        // Reduced motion holds it permanently while the preference is on.
        const motionQuery = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        );
        const applyMotion = (e: MediaQueryListEvent | MediaQueryList) => {
          holds.motion = e.matches;
          applyHolds();
        };
        applyMotion(motionQuery);
        motionQuery.addEventListener("change", applyMotion);
      }

      // --- Deep link arrival: activate the named tab, keep autoplay off ---
      let arrivedByLink = false;
      if (deepLink) {
        const param = new URLSearchParams(window.location.search).get(paramKey);
        const linked = param ? slugs.indexOf(param) : -1;
        if (linked >= 0) {
          currentIndex = linked;
          arrivedByLink = true;
        }
      }

      // --- Initialize ---
      setActiveImmediate(currentIndex);
      if (arrivedByLink) {
        // The visitor asked for this tab: bring it on screen, don't rotate
        // away from it.
        wrap.scrollIntoView({ block: "nearest" });
        if (autoplayDur > 0) stopAutoplay();
      } else if (isPlaying && autoplayDur > 0) {
        startAutoplay();
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTabs);
  } else {
    initTabs();
  }
</script>

<style is:global>
  /* Global styles (is:global — classes here are used across the site and by
     child slots), moved from src/styles/components/tabs.css. The layer
     wrapper slots them into the cascade defined in styles/global.css. */
  @layer components {
    /* ==========================================================================
   TAB COMPONENT STYLES
   ==========================================================================
   Tab interface with four variants: top (default), side, slider, fade.
   The active tab/panel is marked with .is-active (toggled by JS); panel
   transitions are CSS keyframes selected by [data-tab-transition], and the
   autoplay progress line is a CSS animation paused via .is-held.

   STRUCTURE
     .tab_wrap[data-tab-variant]
       .tab_left
         .tab_heading_wrap          (optional heading slot)
         .tab_button_list           [role="tablist"]
           button.tab_button_item   [role="tab"]
             span.tab_button_text
             span.tab_button_line   (underline / progress indicator)
       .tab_right
         .tab_content_wrap
           .tab_content_list
             .tab_panel_item        [role="tabpanel"]
         .tab_control_wrap          (slider variant only)
           .tab_arrow_wrap
           .button_toggle_wrap

   VARIANTS
     data-tab-variant="top"     — default, horizontal tabs + fade
     data-tab-variant="side"    — vertical tabs in 12-col grid + fade
     data-tab-variant="slider"  — horizontal tabs + slide + autoplay controls
     data-tab-variant="fade"    — horizontal tabs + fade, no controls

   ACTIVE STATE
     JS toggles .is-active on the active tab_button_item / tab_panel_item.
     Active button text = full opacity + bold weight; the progress/underline
     line shows only on the active button. Styled directly off .is-active.
   ========================================================================== */

    /* =====================================================
   TAB WRAPPER — base layout
   ===================================================== */

    .tab_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--site-gutter);
      width: 100%;
      position: relative;
    }

    /* =====================================================
