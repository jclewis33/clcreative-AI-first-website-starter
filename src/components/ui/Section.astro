---
import type { PaddingSize, Props } from "@/components/ui/Section.props";
/**
 * Section — full-width page section with theming, fluid padding,
 * optional background slot, and a constrained container.
 *
 * Slots:
 *   - `background` — absolute overlay (z-index 0) for background images,
 *     videos, or gradient divs. Use `<Visual variant="background">`.
 *   - `default` — main content, rendered inside a `.u-container`.
 *
 * Padding defaults to `'main'`. Write nothing to get it — but writing
 * `padding="main"` is legal and renders identically, because the default is
 * dropped before `data-padding-*` is emitted (so the HTML is deterministic
 * regardless of authoring habit). Omit the padding props for almost every
 * section (including heroes and the first section); don't add `'large'` by
 * default.
 * `'page-top'` is ONLY for a *fixed* navbar; this project's nav is sticky, so
 * the first section does not need extra top padding to clear it.
 *
 * A section whose content renders nothing collapses to nothing — handled in
 * CSS via `:empty` (see SELF-ERASURE in the style block), so it costs no slot
 * render and cannot break client scripts. To drop the markup entirely rather
 * than just collapse it, decide from data: `render={posts.length > 0}`.
 *
 * The container (`.u-container`) is a flex column with a built-in `gap`
 * (default `--space-8`). Direct children are spaced apart automatically —
 * don't add `marginBottom` between them; retune the `gap` prop instead.
 *
 * @example Dark hero with background image (default padding — sticky nav)
 * ```astro
 * <Section theme="dark" minHeight id="hero">
 *   <Visual slot="background" src={bg} alt="" variant="background" priority />
 *   <Heading tag="h1" variant="display-xl">Page Title</Heading>
 *   <Text variant="large">Supporting text.</Text>
 * </Section>
 * ```
 *
 * @example Standard content section (default padding — no padding prop written)
 * ```astro
 * <Section theme="light">
 *   <Heading tag="h2" variant="h2">Section Title</Heading>
 *   <Text variant="regular">Body copy.</Text>
 * </Section>
 * ```
 *
 * @example Narrow prose section
 * ```astro
 * <Section container="narrow">
 *   <Text variant="large">Long-form article text…</Text>
 * </Section>
 * ```
 */

const {
  render = true,
  docs,
  theme,
  padding,
  paddingTop,
  paddingBottom,
  minHeight = false,
  container = "default",
  gap,
  id,
  class: className,
  ...rest
} = Astro.props;

/* Resolve per-side padding, falling back to the shared `padding` prop, then
   drop the default before it reaches the DOM.

   'main' is a legal prop value (a caller returning a section to the default
   should edit the value, not delete the prop), but it is never emitted: an
   omitted attribute already means 'main' via the CSS base rule below. So
   `padding="main"` and no padding prop at all produce identical HTML, and
   `data-padding-top="main"` cannot appear no matter who authored the call. */
const normalizePadding = (value?: PaddingSize) =>
  value === "main" ? undefined : value;
const topPadding = normalizePadding(paddingTop ?? padding);
const bottomPadding = normalizePadding(paddingBottom ?? padding);

/* Container modifier class */
const containerClass = {
  "u-container-narrow": container === "narrow",
  "u-container-wide": container === "wide",
  "u-container-full": container === "full",
};

/* 'inherit' means "no data-theme" — section stays transparent and picks up
   the parent context. Map it (and undefined) to undefined so Astro omits
   the attribute entirely. */
const resolvedTheme = theme === "inherit" ? undefined : theme;
---

{
  /* Gated on the `render` prop only. NEVER gate this on rendered slot content
     (`Astro.slots.render()` / a slotContent helper): doing so silently drops
     the hoisted <script> of every component inside the slot, page-wide, and a
     Section's default slot holds the whole page — it took out every slider,
     tab, accordion and modal on the site, with nothing in the console.
     Reproduced in Lumos' own repo on Astro 7 too, so it is not version-
     specific. The empty case is handled in CSS instead — see SELF-ERASURE in
     the style block. */
  render && (
      <section
        class:list={[
          "u-section",
          { "u-min-height-screen": minHeight },
          className,
        ]}
        data-theme={resolvedTheme}
        data-padding-top={topPadding}
        data-padding-bottom={bottomPadding}
        id={id}
        {...rest}
      >
        {Astro.slots.has("background") && (
          <div class="u-background-slot">
            <slot name="background" />
          </div>
        )}

        <div
          class:list={["u-container", containerClass]}
          style={
            gap !== undefined
              ? `gap: ${gap === 0 ? "0px" : `var(--space-${gap})`}`
              : undefined
          }
        >
          <slot />
        </div>
      </section>
    )
}

<style is:global>
  /* Global styles (is:global — classes here are used across the site and by
     child slots), moved from src/styles/components/section.css. The layer
     wrapper slots them into the cascade defined in styles/global.css. */
  @layer components {
    /* ==========================================================================
   SECTION COMPONENT
   ==========================================================================
   Page section. Structure:

     <section class="u-section" data-theme="dark"
              data-padding-top="large" data-padding-bottom="none">
       <div class="u-background-slot">...</div>
       <div class="u-container">...</div>
     </section>

   - .u-background-slot  → absolutely positioned, sits behind the container
   - data-padding-top /
     data-padding-bottom → override the section's top/bottom padding.
     Absent at the default ('main') — the base rule below supplies it, and
     the component strips 'main' before emitting (Section.astro).
   - .u-container        → constrains content width (defined in base/layout.css)
   ========================================================================== */

    /* Section — position: relative already set on all <section> elements in utilities.css */
    .u-section {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: stretch;
      width: 100%;
      overflow: clip;
    }

    /* Paint the section background when an explicit theme is applied.
   Without this, data-theme only reassigns CSS variables but leaves
   the section transparent — it would inherit the page background instead
   of showing its own theme colour. */
    .u-section[data-theme] {
      background-color: var(--background);
      color: var(--text);
    }

    /* Background slot — absolutely fills the section, sits behind all content */
    .u-background-slot {
      position: absolute;
      inset: 0;
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
      width: 100%;
      height: 100%;
    }

    /* Force all direct children of the background slot to fill it.
   This ensures Visual components (and any other element) placed in
   the slot stretch to cover the section without needing a variant. */
    .u-background-slot > * {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      aspect-ratio: unset !important;
    }

    /* Vertical padding — the base rule supplies the `main` default; the
   data-padding-top / data-padding-bottom attributes only exist as
   OVERRIDES. There is deliberately no [data-padding-*="main"] rule: the
   component strips 'main' before emitting the attribute, so such a rule
   would be dead code.

   Wrapped in :where() so these rules carry ZERO specificity (the selector
   collapses to 0,0,0). That lets any single page/component class — e.g.
   `.split_section { padding-block: … }` — override section padding with a
   plain (0,1,0) selector. The data-padding rules still win as
   the default because they follow the base rule in source order. */
    :where(.u-section) {
      padding-top: var(--section-space-main);
      padding-bottom: var(--section-space-main);
    }

    :where(.u-section[data-padding-top="none"]) {
      padding-top: 0;
    }
    :where(.u-section[data-padding-top="xsmall"]) {
      padding-top: var(--section-space-xsmall);
    }
    :where(.u-section[data-padding-top="small"]) {
      padding-top: var(--section-space-small);
    }
    :where(.u-section[data-padding-top="large"]) {
      padding-top: var(--section-space-large);
    }
    :where(.u-section[data-padding-top="page-top"]) {
      padding-top: var(--section-space-page-top);
    }

    :where(.u-section[data-padding-bottom="none"]) {
      padding-bottom: 0;
    }
    :where(.u-section[data-padding-bottom="xsmall"]) {
      padding-bottom: var(--section-space-xsmall);
    }
    :where(.u-section[data-padding-bottom="small"]) {
      padding-bottom: var(--section-space-small);
    }
    :where(.u-section[data-padding-bottom="large"]) {
      padding-bottom: var(--section-space-large);
    }
    :where(.u-section[data-padding-bottom="page-top"]) {
      padding-bottom: var(--section-space-page-top);
    }

    /* ==========================================================================
   SELF-ERASURE — a section that renders nothing takes up nothing
   ==========================================================================
   The empty case is detected in CSS, not by rendering the slot in JS.

   The obvious approach — render the slot, check whether the string is blank,
   and skip the <section> — is what Lumos does (Section.astro, via
   utils/slots.ts) and it is a trap: `Astro.slots.render()` makes Astro drop
   the hoisted <script> of every component inside that slot, page-wide and
   with no error. Verified in Lumos' own repo on Astro 7 as well as here on
   Astro 6, so it is not a version bug and not something to wait out.

   `:empty` gets the same result for free. When a slot renders nothing Astro
   emits `<div class="u-container"></div>` with NO whitespace between the
   tags, so `:empty` matches exactly the empty case — and a section holding a
   bare text node keeps its text node, so it is correctly left alone. The
   markup still ships (a couple of dozen bytes); what disappears is the box,
   its padding, and its slot in the flow, which is the thing that actually
   shows up on the page.

   To drop a section from the HTML entirely, decide from DATA at the call
   site: `<Section render={posts.length > 0}>`. That needs no slot render, so
   it is always safe. */
    .u-section:has(> .u-container:empty):not(
        :has(> .u-background-slot > *)
      ) {
      display: none;
    }

    /* Container — ensure content sits above the background slot */
    .u-section > .u-container,
    .u-section > .u-container-narrow,
    .u-section > .u-container-wide,
    .u-section > .u-container-full {
      position: relative;
      z-index: 1;
      flex-shrink: 0;
    }

    /* ==========================================================================
   MARGIN TRIM
   ==========================================================================
   Removes the first/last child's block margins to prevent double-spacing
   at the edges of containers and layout columns. Applied automatically
   to all content containers so text style margins don't create unwanted
   space at the top/bottom of sections.
   ========================================================================== */

    /* Native margin-trim (progressive enhancement — Safari 16.4+) */
    .u-container,
    .u-container-narrow,
    .u-container-wide,
    .u-container-full,
    .u-layout-column-1,
    .u-layout-column-2,
    .u-margin-trim {
      margin-trim: block-end;
    }

    /* The cross-browser fallback for this (zeroing the last child's
   margin-bottom) lives in overrides.css — it has to beat page-layer
   margins, which nothing in the components layer can. */
  }
</style>
