---
import type { HTMLAttributes } from "astro/types";
/**
 * Marquee — infinite horizontal scrolling ticker. Pure CSS, no JavaScript.
 *
 * Place any content in the default slot — text, logos, cards, CMS items.
 * Each direct child should have the `marquee_item` class for proper spacing
 * and flex behavior.
 *
 * The content is rendered twice (the second copy is `aria-hidden` + `inert`,
 * so assistive tech and the keyboard see it once) and the track scrolls by
 * exactly half its width, which puts copy 2 where copy 1 began — a seamless
 * loop with no measuring, cloning, or animation library. See the style block
 * for why the track must be `width: max-content` and `min-width: 200%`.
 *
 * @example Text marquee
 * ```astro
 * <Marquee>
 *   <span class="marquee_item u-text-style-h3">Design</span>
 *   <span class="marquee_item u-text-style-h3">Develop</span>
 *   <span class="marquee_item u-text-style-h3">Deploy</span>
 * </Marquee>
 * ```
 *
 * @example Logo marquee (slower, larger gap)
 * ```astro
 * <Marquee speed={30} gap={8}>
 *   <div class="marquee_item">
 *     <Image src={logo1} alt="Acme Corp" />
 *   </div>
 *   <div class="marquee_item">
 *     <Image src={logo2} alt="Globex" />
 *   </div>
 * </Marquee>
 * ```
 *
 * @example CMS-driven
 * ```astro
 * <Marquee>
 *   {clients.map(c => (
 *     <div class="marquee_item">
 *       <Image src={c.logo} alt={c.name} />
 *     </div>
 *   ))}
 * </Marquee>
 * ```
 */

/**
 * Marquee — infinite horizontal scrolling ticker (pure CSS).
 *
 * **Props:**
 * - `speed` — animation duration in seconds; higher = slower (default: `20`)
 * - `direction` — scroll direction: `'left'` or `'right'` (default: `'left'`)
 * - `pauseOnHover` — pause animation on mouse hover (default: `true`)
 * - `gap` — spacing between items, uses `--space-N` scale 0–8 (default: `6`)
 * - `class` — extra classes on the wrapper
 * - Also accepts any HTML attribute (`style`, `data-*`, `aria-*`, etc.)
 *
 * **Slot:** default — marquee items (use `.marquee_item` class on each child)
 */
interface Props extends HTMLAttributes<"div"> {
  /**
   * **Marquee props:**
   * - `speed` — duration in seconds, higher = slower (default 20)
   * - `direction` — 'left' or 'right' (default 'left')
   * - `pauseOnHover` — pause on hover (default true)
   * - `gap` — spacing scale 0–8 (default 6)
   * - `class` — extra classes
   * - Also accepts any HTML attribute (`style`, `data-*`, `aria-*`, etc.) — forwarded to root element
   *
   * **Slot:** default — items with `.marquee_item` class
   */
  docs?: string;

  /**
   * Animation duration in seconds. Higher = slower.
   * @default 20
   * @example speed={30}
   */
  speed?: number;

  /**
   * Scroll direction.
   * - `'left'` — items move right-to-left (default)
   * - `'right'` — items move left-to-right
   * @default 'left'
   */
  direction?: "left" | "right";

  /**
   * Pause the animation when the user hovers over the marquee.
   * @default true
   */
  pauseOnHover?: boolean;

  /**
   * Gap between items. Uses the `--space-N` fluid scale (0–8).
   * `0` removes all spacing between items.
   * @default 6
   * @example gap={8}
   */
  gap?: 0 | 1 | 2 | 3 | 4 | 5 | 6 | 7 | 8;

  /** Extra utility classes on the `.marquee_wrap` element. */
  class?: string;
}

const {
  docs,
  speed = 20,
  direction = "left",
  pauseOnHover = true,
  gap = 6,
  class: className,
  ...rest
} = Astro.props;

const gapValue = gap === 0 ? "0px" : `var(--space-${gap})`;

// Both are consumed by CSS only — there is no script in this component.
const trackStyle = `--marquee-gap: ${gapValue}; --marquee-duration: ${speed}s`;
---

<div
  class:list={["marquee_wrap", className]}
  data-marquee="component"
  data-marquee-direction={direction}
  data-marquee-pause={String(pauseOnHover)}
  style={trackStyle}
  {...rest}
>
  <div class="marquee_track">
    <div class="marquee_inner"><slot /></div>
    {
      /* Copies 2 and 3 are what make the loop seamless. `inert` keeps their
        links out of the tab order; `aria-hidden` keeps the text out of the
        accessibility tree, so the content is announced exactly once.
        Three copies rather than two so that content only has to be half a
        container wide before the authored `gap` is honored exactly — see the
        style block. */
    }
    <div class="marquee_inner" aria-hidden="true" inert><slot /></div>
    <div class="marquee_inner" aria-hidden="true" inert><slot /></div>
  </div>
</div>

<style is:global>
  /* Global styles (is:global — classes here are used across the site and by
     child slots), moved from src/styles/components/marquee.css. The layer
     wrapper slots them into the cascade defined in styles/global.css. */
  @layer components {
    /* ==========================================================================
   MARQUEE
   Infinite horizontal scrolling ticker — text, logos, or any content.
   Pure CSS: three copies of the content and one keyframe. No JavaScript.

   HOW THE SEAMLESS LOOP WORKS
   The track holds three identical copies, so translating it by -33.3333%
   moves it left by exactly one copy — putting copy 2 precisely where copy 1
   started. At that instant the animation restarts from 0 and the result is
   indistinguishable, so the ticker appears infinite.

   Why three copies and not two: after scrolling one copy away, the copies
   that REMAIN have to cover the visible strip. With two copies that means
   content must be a full container wide or the track gets stretched (below);
   with three, half a container is enough. Since stretching is what makes the
   authored `gap` grow, the third copy is what keeps `gap` exact for normal
   content — measured, it is the difference between a 40px gap staying 40px
   and becoming 84px on a 1344px strip.

   Two sizing rules are load-bearing, and both were established by
   measurement rather than reasoning:

   1. `width: max-content` on the track. Without it the track is an
      inline/shrink-to-fit box, which the browser CLAMPS to the wrapper width
      while its children overflow. The translation would then be a fraction
      of the WRAPPER rather than of the content, and the loop would jump.
      (The old GSAP version was immune to this only because it tweened a
      measured pixel distance instead of a percentage.)

   2. `min-width: 150%` on the track — i.e. the two copies that survive one
      cycle are together at least one wrapper wide. Without it, content
      narrower than that would leave a visible blank stretch before the next
      copy arrived. The percentage resolves against the wrapper, whose width
      does not depend on the track, so there is no circular sizing.

   `justify-content: space-between` only acts when rule 2 actually stretched
   the track — with content wider than the wrapper there is no free space, so
   the authored `gap` is honored exactly. Narrow content is spread evenly
   instead of bunching at the left with a blank tail, which means `gap`
   behaves as a MINIMUM once content is narrower than the container.

   It must be space-BETWEEN, not space-around/evenly. Those add half-slots of
   space at the two ends, which the trailing spacer participates in; the track
   is then no longer exactly three cycles wide and the translation drifts a
   few pixels every loop. Measured: space-around left a 15px blank at the seam
   on a stretched marquee. space-between distributes free space only into the
   gaps, so a third of the width stays exactly one cycle no matter how much
   stretching happened.
   ========================================================================== */

    .marquee_wrap {
      overflow: hidden;
      position: relative;
      width: 100%;
    }

    .marquee_track {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--marquee-gap, var(--space-6));
      width: max-content;
      min-width: 150%;
      white-space: nowrap;
      animation: marquee-scroll var(--marquee-duration, 20s) linear infinite;
    }

    /* Zero-width trailing flex item. The track has 3N items and therefore only
       3N-1 gaps, so its width would be a gap short of three whole cycles and
       -33.3333% would drift by that much every loop. The spacer adds the
       missing gap, making the width exactly three cycles. */
    .marquee_track::after {
      content: "";
      flex: 0 0 0px;
    }

    /* `display: contents` dissolves the copy wrappers so every item becomes a
       direct flex child of the one track. That is what keeps spacing uniform
       ACROSS the join between copies — two real flex boxes would space items
       inside each copy by `gap` but the copies themselves by something else,
       and each seam would show as a wider gap once per loop. The wrappers
       still carry aria-hidden/inert, which apply to the subtree regardless. */
    .marquee_inner {
      display: contents;
    }

    /* Direction and hover-pause are plain attribute selectors — the props are
       styling hooks now, not JS config. */
    [data-marquee-direction="right"] .marquee_track {
      animation-direction: reverse;
    }

    /* Pause for pointer users on hover, and for keyboard users whenever focus
       lands inside (a marquee holding links is otherwise impossible to use). */
    [data-marquee-pause="true"]:hover .marquee_track,
    [data-marquee-pause="true"]:focus-within .marquee_track {
      animation-play-state: paused;
    }

    @keyframes marquee-scroll {
      to {
        /* Exactly one of the three copies. */
        transform: translateX(-33.333333%);
      }
    }

    /* Reduced motion: no animation, and the duplicate copies are dropped so
       there is nothing extra to scroll past. The strip becomes a normal
       horizontally scrollable row, so all content stays reachable — the
       previous behavior left it clipped and stranded. */
    @media (prefers-reduced-motion: reduce) {
      .marquee_wrap {
        overflow-x: auto;
      }

      .marquee_track {
        animation: none;
        min-width: 0;
      }

      .marquee_track::after {
        content: none;
      }

      .marquee_inner[aria-hidden="true"] {
        display: none;
      }
    }

    /* ── Items ── */

    .marquee_item {
      display: inline-flex;
      align-items: center;
      flex-shrink: 0;
      white-space: nowrap;
    }

    /* Logo images inside marquee items */
    .marquee_item img {
      display: block;
      height: auto;
      max-height: 2.5rem;
      width: auto;
      object-fit: contain;
    }
  }
</style>
