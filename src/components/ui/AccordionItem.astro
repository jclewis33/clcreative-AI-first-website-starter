---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/lib/slots";
/**
 * AccordionItem — a single expand/collapse row inside `<Accordion>`.
 *
 * Built on a native `details`/`summary`, so it opens and closes with no JS.
 * The parent `<Accordion>` groups items via the `data-accordion-group`
 * marker attribute this renders — it replaces the marker with a shared
 * `name` attribute when `closePrevious` is on, which is what makes opening
 * one item close the others, natively.
 *
 * Slots:
 *   - `question` — rich text toggle label (alternative to the `question` prop)
 *   - `default`  — answer content (revealed on expand)
 *
 * @example Simple text question
 * ```astro
 * <AccordionItem question="What is this design system?">
 *   <Text>A structured CSS and component system.</Text>
 * </AccordionItem>
 * ```
 *
 * @example Rich text question via slot
 * ```astro
 * <AccordionItem>
 *   <span slot="question">What is this <strong>design system</strong>?</span>
 *   <Text>A structured CSS and component system.</Text>
 * </AccordionItem>
 * ```
 */

interface Props extends HTMLAttributes<"details"> {
  /**
   * **AccordionItem props:**
   * - `question` — toggle text (or use the `question` slot for rich text)
   * - `open` — start expanded (default false)
   * - `class` — extra classes
   * - Also accepts any HTML attribute (`style`, `data-*`, `aria-*`, etc.) — forwarded to the `details` element
   *
   * **Slots:** `question` (rich text toggle label), default (answer content)
   */
  docs?: string;

  /**
   * The question / label shown in the toggle.
   * If you need rich text (links, bold etc.) use the `question` slot instead.
   * @example question="What is this design system?"
   */
  question?: string;

  /**
   * Start this item open.
   * Prefer `openByDefault` on the parent Accordion for single-item control.
   * @default false
   */
  open?: boolean;

  /** Extra utility classes to add to the `.accordion_item` element. */
  class?: string;
}

const { docs, question, open = false, class: className, ...rest } = Astro.props;

/* Capture ONCE, emit with set:html — render-once rule, see src/lib/slots.ts. */
const questionContent = await slotContent(Astro.slots, "question");
const answerContent = await slotContent(Astro.slots);
---

<details
  class:list={["accordion_item", className]}
  open={open}
  data-accordion-group
  {...rest}
>
  <summary class="accordion_toggle">
    <h3 class="accordion_toggle_heading">
      <span class="accordion_toggle_text u-text-style-h5 u-margin-bottom-0">
        {questionContent ? <Fragment set:html={questionContent} /> : question}
      </span>
    </h3>
    <span class="accordion_toggle_icon" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </span>
  </summary>

  <div class="accordion_body u-margin-trim">
    <Fragment set:html={answerContent} />
  </div>
</details>
