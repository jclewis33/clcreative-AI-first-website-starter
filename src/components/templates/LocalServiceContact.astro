---
/**
 * Local-service contact page template.
 *
 * A centred hero (no breadcrumbs: a one-level page doesn't need them) with
 * a wide photo under it → the quote form beside a short sidebar
 * (call now, hours) → what happens next → "Not sure what to ask for?" as
 * photo service cards → where we work (the street map) → the FAQ.
 *
 * It promises nothing on the business's behalf: no response time, no free
 * estimate. The steps and the FAQ are the business's own (from the home
 * data) and are left out when not given; the hero line is neutral unless
 * the caller writes one. No street address: add one only when the client
 * has confirmed it.
 *
 * Used by the dev sample (/demo/local-service-contact) and by every
 * prospect demo generated with `npm run demo` (presets/local-service).
 */
import type { ImageMetadata } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/ui/Section.astro";
import Layout from "@/components/ui/Layout.astro";
import Heading from "@/components/ui/Heading.astro";
import Hero from "@/components/sections/Hero.astro";
import ProcessSteps from "@/components/sections/ProcessSteps.astro";
import ServiceCards from "@/components/sections/ServiceCards.astro";
import ServiceArea from "@/components/sections/ServiceArea.astro";
import FAQ from "@/components/sections/FAQ.astro";
import LeadForm from "@/components/form/LeadForm.astro";
import ContactCards from "@/components/ui/ContactCards.astro";
import { SITE } from "@/config/site";
import { getServices, servicePath } from "@/lib/services";
import { geoFor } from "@/lib/service-area-geo";
import type { FAQItem } from "@/data/faqs";

type ContactStep = { title: string; text: string };

interface Props {
  /**
   * **LocalServiceContact** — a local-service contact page. Needs only a
   * title and description; the rest comes from SITE and the services. The
   * optional props fill it in with the business's own material — nothing
   * here invents a promise (response times, free estimates) for them.
   *
   * @example
   * <LocalServiceContact title={`Contact | ${SITE.name}`} description="…" steps={HOME.process?.steps} faqs={HOME.faqs?.items} />
   */
  docs?: string;

  /** Page `<title>`. */
  title: string;

  /** Meta description. */
  description: string;

  /**
   * The headline — what the visitor gets, not "contact us". HTML allowed
   * (`<strong>` = accent). @default 'Get the help your <strong>home</strong> needs'
   */
  heading?: string;

  /** The hero line. @default "Send the form or call, and we'll get back to you." */
  text?: string;

  /** The wide photo under the hero. Without one the hero is text only. */
  image?: ImageMetadata | string;

  /** Alt text for the hero photo. */
  imageAlt?: string;

  /** "What happens next" — the business's own steps. Left out when empty. */
  steps?: ContactStep[];

  /** The FAQ — the business's own questions. Left out when empty. */
  faqs?: FAQItem[];

  /** Heading and line for the map section. */
  serviceArea?: { heading?: string; text?: string };
}

const {
  title,
  description,
  heading = "Get the help your <strong>home</strong> needs",
  text = "Send the form or call, and we'll get back to you.",
  image,
  imageAlt,
  steps = [],
  faqs = [],
  serviceArea,
} = Astro.props;

const services = await getServices();
const serviceItems = services.map((s) => ({
  title: s.data.title,
  text: s.data.cardText,
  image: s.data.cardImage,
  imageAlt: s.data.cardImageAlt,
  href: servicePath(s.id),
}));
const geo = geoFor(SITE.serviceAreas);
---

<BaseLayout title={title} description={description}>
  <Hero
    variant="centered"
    paddingBottom="xsmall"
    phoneVariant="primary"
    eyebrow="Contact"
    heading={heading}
    text={text}
    image={image}
    imageAlt={imageAlt}
    badge={false}
  />

  <Section paddingTop="xsmall">
    <Layout ratio="7-5" verticalAlign="start">
      <Heading tag="h2" variant="h3">Tell us what's going on</Heading>
      <LeadForm
        formId="contact"
        id="contact-page-form"
        fields="quote"
        projectOptions={services.map((s) => ({
          label: s.data.title,
          value: s.id,
        }))}
      />
      <ContactCards
        slot="column2"
        urgent={{
          heading: "Need help today?",
          text: "Call and we'll talk you through it.",
        }}
        cards={[{ heading: "Hours", body: SITE.hours }]}
      />
    </Layout>
  </Section>

  {
    steps.length > 0 && (
      <ProcessSteps
        variant="cards"
        theme="dark"
        heading="What happens next"
        steps={steps}
      />
    )
  }

  <ServiceCards
    eyebrow="Our services"
    heading="Not sure what to ask for?"
    intro="Start with the closest match. We'll sort out the details together."
    items={serviceItems}
  />

  <ServiceArea
    heading={serviceArea?.heading ?? "Where we work"}
    text={serviceArea?.text}
    geo={geo}
  />

  {faqs.length > 0 && <FAQ eyebrow="Before you reach out" items={faqs} />}
</BaseLayout>
