---
/**
 * Local-service contact page template.
 *
 * Hero, the quote form beside the contact cards (service areas and hours
 * from SITE), what happens next, a list of the services, and a short FAQ.
 * Deliberately no map or street address: add them only when the client has
 * confirmed them. Everything it shows comes from SITE and the services
 * content, so it fits any local-service site as-is.
 *
 * Used by the dev sample (/demo/local-service-contact) and by every
 * prospect demo generated with `npm run demo` (presets/local-service).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/ui/Section.astro";
import Layout from "@/components/ui/Layout.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";
import Hero from "@/components/sections/Hero.astro";
import ProcessSteps from "@/components/sections/ProcessSteps.astro";
import FAQ from "@/components/sections/FAQ.astro";
import LeadForm from "@/components/form/LeadForm.astro";
import ContactCards from "@/components/ui/ContactCards.astro";
import LinkList from "@/components/ui/LinkList.astro";
import { SITE } from "@/config/site";
import { getServices, servicePath } from "@/lib/services";

interface Props {
  /**
   * **LocalServiceContact** — a local-service contact page. Needs nothing
   * but a title and description; the rest comes from SITE and the services.
   *
   * @example
   * <LocalServiceContact title={`Contact | ${SITE.name}`} description="…" />
   */
  docs?: string;

  /** Page `<title>`. */
  title: string;

  /** Meta description. */
  description: string;
}

const { title, description } = Astro.props;

const services = await getServices();
---

<BaseLayout title={title} description={description}>
  <Hero
    variant="text"
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "Contact" }]}
    eyebrow="Contact"
    heading="Talk to a <strong>real person</strong> today"
    text="Send the form and we'll call you back within one business day, or call now."
    badge={false}
  />

  <Section>
    <Layout ratio="7-5" verticalAlign="start">
      <Heading tag="h2" variant="h3">Tell us about the project</Heading>
      <LeadForm
        formId="contact"
        id="contact-page-form"
        fields="quote"
        projectOptions={services.map((s) => ({
          label: s.data.title,
          value: s.id,
        }))}
      />
      <ContactCards
        slot="column2"
        urgent={{
          heading: "Need help today?",
          text: "Call and we'll talk you through it.",
        }}
        cards={[
          { heading: "Service areas", chips: [...SITE.serviceAreas] },
          { heading: "Hours", body: SITE.hours },
        ]}
      />
    </Layout>
  </Section>

  <ProcessSteps
    variant="cards"
    theme="dark"
    heading="What happens next"
    steps={[
      { title: "We call you back", text: "Usually the same business day." },
      {
        title: "We visit",
        text: "A free on-site estimate at a time that suits you.",
      },
      { title: "You decide", text: "A written, fixed quote with no pressure." },
    ]}
  />

  <Section>
    <Layout ratio="5-7" verticalAlign="start">
      <Heading tag="h2">Not sure what to ask for?</Heading>
      <Text muted
        >Start with the closest match. We'll sort out the details together.</Text
      >
      <LinkList
        slot="column2"
        items={services.map((s) => ({
          title: s.data.title,
          text: s.data.cardText,
          href: servicePath(s.id),
        }))}
      />
    </Layout>
  </Section>

  <FAQ
    eyebrow="Before you reach out"
    items={[
      {
        question: "Is the estimate free?",
        answer: "Yes. We visit, measure and send a written price at no cost.",
      },
      {
        question: "How soon will you call back?",
        answer: "Usually the same business day, and always within one.",
      },
    ]}
  />
</BaseLayout>
