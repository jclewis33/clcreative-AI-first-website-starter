---
/**
 * Local-service About page — the longer "who we are" page behind the home
 * page's story section, built from the same LocalServiceHomeData:
 *
 *   intro hero (breadcrumbs, the about heading and line, the estimate and
 *   phone buttons) → stats strip → the owner's story with its reasons → the
 *   team → the guarantee → how a job goes → reviews → where we work →
 *   the closing call band.
 *
 * Everything except the hero is optional and skips itself without its data,
 * so the page never shows an empty section. `home.about` sets the intro (and
 * can give the story longer paragraphs than the home page uses); without it
 * the page leads with the story's own heading.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/sections/Hero.astro";
import StatsStrip from "@/components/sections/StatsStrip.astro";
import StorySplit from "@/components/sections/StorySplit.astro";
import TeamGrid from "@/components/sections/TeamGrid.astro";
import Guarantee from "@/components/sections/Guarantee.astro";
import ProcessSteps from "@/components/sections/ProcessSteps.astro";
import Reviews from "@/components/sections/Reviews.astro";
import ServiceArea from "@/components/sections/ServiceArea.astro";
import CallBand from "@/components/sections/CallBand.astro";
import LeadFormModal from "@/components/form/LeadFormModal.astro";
import { getServices } from "@/lib/services";
import { ESTIMATE_MODAL_ID } from "@/lib/cta";
import { geoFor } from "@/lib/service-area-geo";
import { SITE } from "@/config/site";
import type { LocalServiceHomeData } from "@/lib/local-service-home";

interface Props {
  /**
   * **LocalServiceAbout** — the About page for a local-service site, from
   * the same `home` data as the home page (story, stats, team, guarantee,
   * process, reviews, service area, call band). `home.about` sets the
   * intro; every other section skips itself without its data.
   *
   * @example
   * <LocalServiceAbout home={HOME} />
   */
  docs?: string;

  /** The site's content — see LocalServiceHomeData (src/lib/local-service-home.ts). */
  home: LocalServiceHomeData;
}

const { home } = Astro.props;
const {
  about,
  story,
  team,
  guarantee,
  process,
  reviews,
  serviceArea,
  callBand,
} = home;

const services = await getServices();
const estimateCta = { label: home.estimate.label, modal: ESTIMATE_MODAL_ID };
const ownModal = !SITE.quote;
const areaGeo =
  serviceArea.geo ?? geoFor(serviceArea.areas ?? SITE.serviceAreas);
const projectOptions = home.leadForm.projectOptions ?? [
  ...services.map((s) => ({ label: s.data.title, value: s.id })),
  { label: "Something else", value: "other" },
];

const title = about?.title ?? `About | ${SITE.name}`;
const description =
  about?.description ?? `Who we are and how we work at ${SITE.name}.`;
const heading = about?.heading ?? story?.heading ?? `About ${SITE.name}`;
const crumbs = [{ label: "Home", href: "/" }, { label: "About" }];
const schemaCrumbs = [
  { name: "Home", path: "/" },
  { name: "About", path: "/about" },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${SITE.url}/about`}
  breadcrumbs={schemaCrumbs}
>
  <Hero
    variant="text"
    headingSize="h1"
    breadcrumbs={crumbs}
    eyebrow={about?.eyebrow ?? "About us"}
    heading={heading}
    text={about?.text}
    primaryCta={estimateCta}
    showPhone
  />

  {home.stats && <StatsStrip items={home.stats} />}

  {
    story && (
      <StorySplit
        eyebrow={story.eyebrow}
        heading={about?.storyHeading ?? story.heading}
        paragraphs={about?.paragraphs ?? story.paragraphs}
        image={story.image}
        imageAlt={story.imageAlt}
        reasons={story.reasons}
      />
    )
  }

  {
    team && (
      <TeamGrid
        eyebrow={team.eyebrow}
        heading={team.heading}
        intro={team.intro}
        members={team.members}
      />
    )
  }

  {
    guarantee && (
      <Guarantee
        eyebrow={guarantee.eyebrow}
        name={guarantee.name}
        text={guarantee.text}
        items={guarantee.items}
        sealLabel={guarantee.sealLabel}
      />
    )
  }

  {
    process && (
      <ProcessSteps
        eyebrow={process.eyebrow}
        heading={process.heading}
        text={process.text}
        steps={process.steps}
        image={process.image}
        imageAlt={process.imageAlt}
      />
    )
  }

  {
    reviews && (
      <Reviews
        rating={reviews.rating}
        count={reviews.count}
        reviews={reviews.items}
        layout={reviews.layout ?? "cards"}
      />
    )
  }

  <ServiceArea
    heading={serviceArea.heading}
    text={serviceArea.text}
    areas={serviceArea.areas}
    geo={areaGeo}
    map={serviceArea.map}
  />

  <CallBand
    heading={callBand.heading}
    text={callBand.text}
    variant={callBand.variant}
    image={callBand.image}
    imageAlt={callBand.imageAlt}
    ctaNote={callBand.ctaNote}
    secondaryCta={estimateCta}
  />

  {
    ownModal && (
      <LeadFormModal
        id={ESTIMATE_MODAL_ID}
        formId="contact"
        heading={home.estimate.heading}
        text={home.estimate.text}
        fields="steps"
        stepQuestion={home.estimate.question}
        projectOptions={projectOptions}
      />
    )
  }
</BaseLayout>
