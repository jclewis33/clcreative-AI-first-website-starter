---
/**
 * Local-service home page, SHOWCASE layout — the photo-led, editorial
 * cousin of LocalServiceHome (the "contractor" layout), after the Outdoor
 * Living demo. Same data (LocalServiceHomeData), same four looks; a
 * different page:
 *
 *   a cinematic full-bleed hero with a calmer h1 → a dark stats strip
 *   under it → photo service cards → where we work → recent work on dark →
 *   the process → a full-width photo band → the owner's story → the team →
 *   reviews → maintenance plans → the estimate form on dark → FAQ → a
 *   cinematic photo close.
 *
 * It sells with photography and one clear CTA, so it leaves out the
 * conversion-heavy sections the contractor layout carries (the offer seal,
 * symptom cards, the comparison table, the hero's quote panel and trust
 * row) even when the data has them. Pick it with `layout: "showcase"`
 * (demo.json → HOME.layout); it suits outdoor living, remodeling,
 * landscaping — work that's bought by looking at it.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/sections/Hero.astro";
import StatsStrip from "@/components/sections/StatsStrip.astro";
import EmergencyBand from "@/components/sections/EmergencyBand.astro";
import ServiceCards from "@/components/sections/ServiceCards.astro";
import ServiceArea from "@/components/sections/ServiceArea.astro";
import RecentWork from "@/components/sections/RecentWork.astro";
import ProcessSteps from "@/components/sections/ProcessSteps.astro";
import PhotoBand from "@/components/sections/PhotoBand.astro";
import StorySplit from "@/components/sections/StorySplit.astro";
import TeamGrid from "@/components/sections/TeamGrid.astro";
import Guarantee from "@/components/sections/Guarantee.astro";
import Reviews from "@/components/sections/Reviews.astro";
import MaintenancePlans from "@/components/sections/MaintenancePlans.astro";
import LeadFormSection from "@/components/sections/LeadFormSection.astro";
import FAQ from "@/components/sections/FAQ.astro";
import CallBand from "@/components/sections/CallBand.astro";
import LeadFormModal from "@/components/form/LeadFormModal.astro";
import { getServices, servicePath } from "@/lib/services";
import { ESTIMATE_MODAL_ID } from "@/lib/cta";
import { geoFor } from "@/lib/service-area-geo";
import { SITE } from "@/config/site";
import type { LocalServiceHomeData } from "@/lib/local-service-home";

interface Props {
  /**
   * **LocalServiceShowcase** — the showcase layout of the local-service
   * home page: photo-led, dark/light rhythm, one clear CTA. Same data as
   * LocalServiceHome; the offer, symptom cards and comparison are left out.
   *
   * @example
   * <LocalServiceShowcase home={HOME} />
   */
  docs?: string;

  /** The page's content — see LocalServiceHomeData (src/lib/local-service-home.ts). */
  home: LocalServiceHomeData;
}

const { home } = Astro.props;

const services = await getServices();
const ownModal = !SITE.quote;
const estimateCta = { label: home.estimate.label, modal: ESTIMATE_MODAL_ID };
const serviceItems = services.map((s) => ({
  title: s.data.title,
  text: s.data.cardText,
  image: s.data.cardImage,
  imageAlt: s.data.cardImageAlt,
  href: servicePath(s.id),
}));
const projectOptions = home.leadForm.projectOptions ?? [
  ...services.map((s) => ({ label: s.data.title, value: s.id })),
  { label: "Something else", value: "other" },
];
const {
  hero,
  serviceArea,
  process,
  photoBand,
  story,
  reviews,
  faqs,
  recentWork,
  guarantee,
  emergency,
  plans,
  team,
  callBand,
} = home;
const areaGeo =
  serviceArea.geo ?? geoFor(serviceArea.areas ?? SITE.serviceAreas);
/* The owner's story ends in a quiet text link to the estimate form. */
const storyCta = story
  ? { label: story.ctaLabel ?? "Talk to us", modal: ESTIMATE_MODAL_ID }
  : undefined;
/* The close is a photo; without its own, it borrows the hero's. */
const closeImage = callBand.image ?? hero.image;
const closeImageAlt = callBand.image ? callBand.imageAlt : hero.imageAlt;
---

<BaseLayout title={home.title} description={home.description}>
  <Hero
    variant="background"
    headingSize="h1"
    eyebrow={hero.eyebrow}
    heading={hero.heading}
    text={hero.text}
    image={hero.image}
    imageAlt={hero.imageAlt}
    primaryCta={estimateCta}
    proof={hero.proof}
    badge={false}
  />

  {home.stats && <StatsStrip items={home.stats} />}

  {
    emergency && (
      <EmergencyBand heading={emergency.heading} text={emergency.text} />
    )
  }

  <ServiceCards
    id="services"
    eyebrow={home.services.eyebrow}
    heading={home.services.heading}
    intro={home.services.intro}
    items={serviceItems}
  />

  <ServiceArea
    heading={serviceArea.heading}
    text={serviceArea.text}
    areas={serviceArea.areas}
    geo={areaGeo}
    map={serviceArea.map}
  />

  {
    recentWork && (
      <RecentWork
        theme="dark"
        eyebrow={recentWork.eyebrow}
        heading={recentWork.heading}
        intro={recentWork.intro}
        items={recentWork.items}
      />
    )
  }

  {
    process && (
      <ProcessSteps
        eyebrow={process.eyebrow}
        heading={process.heading}
        text={process.text}
        steps={process.steps}
        image={process.image}
        imageAlt={process.imageAlt}
      />
    )
  }

  {photoBand && <PhotoBand image={photoBand.image} alt={photoBand.alt} />}

  {
    story && (
      <StorySplit
        eyebrow={story.eyebrow}
        heading={story.heading}
        paragraphs={story.paragraphs}
        image={story.image}
        imageAlt={story.imageAlt}
        cta={storyCta}
      />
    )
  }

  {
    team && (
      <TeamGrid
        eyebrow={team.eyebrow}
        heading={team.heading}
        intro={team.intro}
        members={team.members}
      />
    )
  }

  {
    guarantee && (
      <Guarantee
        eyebrow={guarantee.eyebrow}
        name={guarantee.name}
        text={guarantee.text}
        items={guarantee.items}
        sealLabel={guarantee.sealLabel}
      />
    )
  }

  {
    reviews && (
      <Reviews
        rating={reviews.rating}
        count={reviews.count}
        reviews={reviews.items}
        layout={reviews.layout ?? "cards"}
      />
    )
  }

  {
    plans && (
      <MaintenancePlans
        eyebrow={plans.eyebrow}
        heading={plans.heading}
        intro={plans.intro}
        note={plans.note}
        plans={plans.items}
        cta={estimateCta}
      />
    )
  }

  <LeadFormSection
    eyebrow={home.leadForm.eyebrow}
    heading={home.leadForm.heading}
    text={home.leadForm.text}
    formId="contact"
    fields="quote"
    projectOptions={projectOptions}
  />

  {faqs && <FAQ eyebrow={faqs.eyebrow} items={faqs.items} />}

  <CallBand
    variant="cinematic"
    image={closeImage}
    imageAlt={closeImageAlt}
    heading={callBand.heading}
    text={callBand.text}
    secondaryCta={estimateCta}
  />

  {
    ownModal && (
      <LeadFormModal
        id={ESTIMATE_MODAL_ID}
        formId="contact"
        heading={home.estimate.heading}
        text={home.estimate.text}
        fields="steps"
        stepQuestion={home.estimate.question}
        projectOptions={projectOptions}
      />
    )
  }
</BaseLayout>
