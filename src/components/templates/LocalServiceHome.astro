---
/**
 * Local-service home page template.
 *
 * Stacks the local-service sections — hero, stats, service cards, service
 * area, process, photo band, story, reviews, lead form, FAQ, call band — into
 * a full home page from one `home` object (LocalServiceHomeData). The service
 * cards come from the services content (src/content/services), so the home
 * page and the service pages never disagree.
 *
 * Used by the dev sample (/demo/local-service) and by every prospect demo
 * generated with `npm run demo` (presets/local-service), whose index page is
 * just this template and its generated src/data/home.ts.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/sections/Hero.astro";
import StatsStrip from "@/components/sections/StatsStrip.astro";
import ServiceCards from "@/components/sections/ServiceCards.astro";
import ServiceShowcase from "@/components/sections/ServiceShowcase.astro";
import ServiceArea from "@/components/sections/ServiceArea.astro";
import ProcessSteps from "@/components/sections/ProcessSteps.astro";
import PhotoBand from "@/components/sections/PhotoBand.astro";
import StorySplit from "@/components/sections/StorySplit.astro";
import Reviews from "@/components/sections/Reviews.astro";
import LeadFormSection from "@/components/sections/LeadFormSection.astro";
import FAQ from "@/components/sections/FAQ.astro";
import CallBand from "@/components/sections/CallBand.astro";
import LeadFormModal from "@/components/form/LeadFormModal.astro";
import SymptomCards from "@/components/sections/SymptomCards.astro";
import OfferBand from "@/components/sections/OfferBand.astro";
import RecentWork from "@/components/sections/RecentWork.astro";
import Guarantee from "@/components/sections/Guarantee.astro";
import ComparisonTable from "@/components/sections/ComparisonTable.astro";
import EmergencyBand from "@/components/sections/EmergencyBand.astro";
import MaintenancePlans from "@/components/sections/MaintenancePlans.astro";
import TeamGrid from "@/components/sections/TeamGrid.astro";
import PromiseCards from "@/components/sections/PromiseCards.astro";
import ExpectTimeline from "@/components/sections/ExpectTimeline.astro";
import WhyChooseUs from "@/components/sections/WhyChooseUs.astro";
import { geoFor } from "@/lib/service-area-geo";
import { getServices, servicePath } from "@/lib/services";
import { ESTIMATE_MODAL_ID } from "@/lib/cta";
import { SITE } from "@/config/site";
import type { LocalServiceHomeData } from "@/lib/local-service-home";

interface Props {
  /**
   * **LocalServiceHome** — a full local-service home page from one data
   * object. Optional sections (`stats`, `process`, `photoBand`, `story`,
   * `reviews`, `faqs`) render only when their data is present.
   *
   * @example
   * import { HOME } from "@/data/home";
   * <LocalServiceHome home={HOME} />
   */
  docs?: string;

  /** The page's content — see LocalServiceHomeData (src/lib/local-service-home.ts). */
  home: LocalServiceHomeData;
}

const { home } = Astro.props;

const services = await getServices();
/* With SITE.quote set, BaseLayout already renders the site-wide estimate
   form; otherwise (the dev sample in the agency chrome) this page brings
   its own. Either way the buttons open ESTIMATE_MODAL_ID. */
const ownModal = !SITE.quote;
const estimateCta = { label: home.estimate.label, modal: ESTIMATE_MODAL_ID };
const serviceItems = services.map((s) => ({
  title: s.data.title,
  text: s.data.cardText,
  image: s.data.cardImage,
  imageAlt: s.data.cardImageAlt,
  href: servicePath(s.id),
}));
/* The showcase opens one service at a time, so it has room for the
   service hero's fuller line; the cards keep the short card text. */
const showcaseItems = services.map((s) => ({
  title: s.data.title,
  text: s.data.hero.text ?? s.data.cardText,
  image: s.data.cardImage,
  imageAlt: s.data.cardImageAlt,
  href: servicePath(s.id),
}));
const servicesLayout = home.services.layout ?? "cards";
const projectOptions = home.leadForm.projectOptions ?? [
  ...services.map((s) => ({ label: s.data.title, value: s.id })),
  { label: "Something else", value: "other" },
];
const {
  hero,
  serviceArea,
  process,
  photoBand,
  story,
  reviews,
  faqs,
  symptoms,
  offer,
  recentWork,
  guarantee,
  comparison,
  emergency,
  plans,
  team,
  promises,
  expect,
  why,
} = home;
/* The street map: the home data's own outlines (the dev sample's SVG map
   has none), else the generated src/data/service-area-geo.json. */
const areaGeo =
  serviceArea.geo ?? geoFor(serviceArea.areas ?? SITE.serviceAreas);
const offerCta = offer
  ? { label: offer.ctaLabel ?? home.estimate.label, modal: ESTIMATE_MODAL_ID }
  : undefined;

if (import.meta.env.DEV && !services.length)
  console.warn(
    "[LocalServiceHome] No services in src/content/services — the service cards are empty.",
  );
---

<BaseLayout title={home.title} description={home.description}>
  <Hero
    eyebrow={hero.eyebrow}
    heading={hero.heading}
    text={hero.text}
    image={hero.image}
    imageAlt={hero.imageAlt}
    variant={hero.variant}
    ctaStyle={hero.ctaStyle}
    ctaNote={hero.ctaNote}
    primaryCta={estimateCta}
    proof={hero.proof}
    trust={hero.trust}
  />

  {home.stats && <StatsStrip items={home.stats} />}

  {
    emergency && (
      <EmergencyBand heading={emergency.heading} text={emergency.text} />
    )
  }

  {
    servicesLayout === "cards" && (
      <ServiceCards
        id="services"
        eyebrow={home.services.eyebrow}
        heading={home.services.heading}
        intro={home.services.intro}
        items={serviceItems}
      />
    )
  }
  {
    servicesLayout === "showcase" && (
      <ServiceShowcase
        id="services"
        eyebrow={home.services.eyebrow}
        heading={home.services.heading}
        intro={home.services.intro}
        items={showcaseItems}
      />
    )
  }

  {
    symptoms && (
      <SymptomCards
        eyebrow={symptoms.eyebrow}
        heading={symptoms.heading}
        intro={symptoms.intro}
        items={symptoms.items}
        cta={estimateCta}
      />
    )
  }

  {
    offer && (
      <OfferBand
        seal={offer.seal}
        eyebrow={offer.eyebrow}
        heading={offer.heading}
        text={offer.text}
        items={offer.items}
        note={offer.note}
        cta={offerCta}
      />
    )
  }

  <ServiceArea
    heading={serviceArea.heading}
    text={serviceArea.text}
    areas={serviceArea.areas}
    geo={areaGeo}
    map={serviceArea.map}
  />

  {
    expect && (
      <ExpectTimeline
        eyebrow={expect.eyebrow}
        heading={expect.heading}
        text={expect.text}
        steps={expect.steps}
        proof={expect.proof}
        cta={estimateCta}
      />
    )
  }

  {
    !expect && process && (
      <ProcessSteps
        eyebrow={process.eyebrow}
        heading={process.heading}
        text={process.text}
        steps={process.steps}
        image={process.image}
        imageAlt={process.imageAlt}
      />
    )
  }

  {
    plans && (
      <MaintenancePlans
        eyebrow={plans.eyebrow}
        heading={plans.heading}
        intro={plans.intro}
        note={plans.note}
        plans={plans.items}
        cta={estimateCta}
      />
    )
  }

  {
    recentWork && (
      <RecentWork
        eyebrow={recentWork.eyebrow}
        heading={recentWork.heading}
        intro={recentWork.intro}
        items={recentWork.items}
      />
    )
  }

  {
    photoBand && (
      <PhotoBand
        image={photoBand.image}
        alt={photoBand.alt}
        position={photoBand.position}
      />
    )
  }

  {
    story && (
      <StorySplit
        eyebrow={story.eyebrow}
        heading={story.heading}
        paragraphs={story.paragraphs}
        image={story.image}
        imageAlt={story.imageAlt}
        reasons={story.reasons}
      />
    )
  }

  {
    why && (
      <WhyChooseUs
        eyebrow={why.eyebrow}
        heading={why.heading}
        intro={why.intro}
        items={why.items}
        image={why.image}
        imageAlt={why.imageAlt}
      />
    )
  }

  {
    team && (
      <TeamGrid
        eyebrow={team.eyebrow}
        heading={team.heading}
        intro={team.intro}
        members={team.members}
      />
    )
  }

  {
    guarantee && (
      <Guarantee
        eyebrow={guarantee.eyebrow}
        name={guarantee.name}
        text={guarantee.text}
        items={guarantee.items}
        sealLabel={guarantee.sealLabel}
      />
    )
  }

  {
    promises && (
      <PromiseCards
        eyebrow={promises.eyebrow}
        heading={promises.heading}
        intro={promises.intro}
        items={promises.items}
      />
    )
  }

  {
    reviews && (
      <Reviews
        rating={reviews.rating}
        count={reviews.count}
        reviews={reviews.items}
        layout={reviews.layout ?? "cards"}
      />
    )
  }

  {
    comparison && (
      <ComparisonTable
        eyebrow={comparison.eyebrow}
        heading={comparison.heading}
        intro={comparison.intro}
        themLabel={comparison.themLabel}
        rows={comparison.rows}
      />
    )
  }

  <LeadFormSection
    eyebrow={home.leadForm.eyebrow}
    heading={home.leadForm.heading}
    text={home.leadForm.text}
    formId="contact"
    fields="quote"
    projectOptions={projectOptions}
  />

  {faqs && <FAQ eyebrow={faqs.eyebrow} items={faqs.items} />}

  <CallBand
    heading={home.callBand.heading}
    text={home.callBand.text}
    variant={home.callBand.variant}
    image={home.callBand.image}
    imageAlt={home.callBand.imageAlt}
    ctaNote={home.callBand.ctaNote}
    secondaryCta={estimateCta}
  />

  {
    ownModal && (
      <LeadFormModal
        id={ESTIMATE_MODAL_ID}
        formId="contact"
        heading={home.estimate.heading}
        text={home.estimate.text}
        fields="steps"
        stepQuestion={home.estimate.question}
        projectOptions={projectOptions}
      />
    )
  }
</BaseLayout>
