---
/**
 * Case Study Template
 *
 * Renders a case study detail page from the CaseStudyPage view model
 * (getCaseStudy() in @/lib/content): the study, its "Up next" cards and the
 * resolved CTA section. Shared by the prerendered route
 * (src/pages/case-studies/[slug].astro) and its /preview twin.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentCtaSection from "@/components/sections/ContentCtaSection.astro";
import Section from "@/components/ui/Section.astro";
import Layout from "@/components/ui/Layout.astro";
import Grid from "@/components/ui/Grid.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";
import Visual from "@/components/ui/Visual.astro";
import Button from "@/components/ui/Button.astro";
import Slider from "@/components/ui/Slider.astro";
import CaseStudyCard from "@/components/ui/CaseStudyCard.astro";
import CaseStudyBlockRenderer from "@/components/case-study/CaseStudyBlockRenderer.astro";
import { caseStudyJsonLd } from "@/lib/jsonld";
import JsonLd from "@/components/global/JsonLd.astro";
import {
  imageSrc,
  imageUrl,
  plainText,
  type CaseStudyDetail,
  type CaseStudySummary,
  type CtaSectionData,
} from "@/lib/content";

import "@/styles/pages/case-study-detail.css";

interface Props {
  /**
   * **CaseStudyTemplate** — the case study detail page. Pass the fields of
   * `getCaseStudy()`'s CaseStudyPage: `study`, `upNext`, `ctaSection`.
   */
  docs?: string;

  /** The case study to render. */
  study: CaseStudyDetail;

  /** Up to two "Up next" cards (other studies with an image, newest first). */
  upNext: CaseStudySummary[];

  /** Bottom CTA section (the study's override, else the site default), or null. */
  ctaSection: CtaSectionData | null;
}

const { docs, study, upNext, ctaSection } = Astro.props;

const siteOrigin = Astro.site!.toString().replace(/\/$/, "");
const jsonLd = caseStudyJsonLd(study, siteOrigin);

const seo = study.seo;
/* Head values are plumbing: the title/description fallbacks arrive
   stega-encoded in draft mode, so clean them (seo.* is already clean). */
const metaTitle = seo?.metaTitle || plainText(study.title) || "Case Study";
const metaDescription =
  seo?.metaDescription ||
  plainText(study.description) ||
  "Preview this case study draft.";
const ogTitle = seo?.ogTitle || metaTitle;
const ogDescription = seo?.ogDescription || metaDescription;
const ogImageUrl = imageUrl(seo?.ogImage ?? study.image, {
  width: 1200,
  height: 630,
  format: "jpg",
});
---

<BaseLayout
  theme="light"
  title={`${metaTitle} | Astro Starter`}
  description={metaDescription ?? undefined}
  ogTitle={ogTitle ?? undefined}
  ogDescription={ogDescription ?? undefined}
  ogImage={ogImageUrl ?? undefined}
>
  <JsonLd data={jsonLd} />
  <Section theme="dark" class="case-study_detail_hero_wrap">
    <Layout variant="stack" verticalAlign="center">
      <a href="/case-studies" class="case-study_detail_back_link">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M15 18L9 12L15 6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        All Case Studies
      </a>

      <Heading tag="h1" variant="h6" marginBottom={2} maxWidth="50ch">
        {study.title || "Untitled Case Study"}
      </Heading>

      <Heading tag="h2" variant="h3" maxWidth="40ch">
        {study.description || "This draft does not have a description yet."}
      </Heading>

      <div class="case-study_detail_meta">
        <div class="case-study_detail_meta_item">
          <Text tag="span" variant="regular" weight="bold" marginBottom={0}>
            Client:
          </Text>
          <Text tag="span" variant="regular" weight="medium" marginBottom={0}>
            {study.client || "Not set"}
          </Text>
        </div>
        {
          study.timeline && (
            <div class="case-study_detail_meta_item">
              <Text tag="span" variant="regular" weight="bold" marginBottom={0}>
                Time:
              </Text>
              <Text
                tag="span"
                variant="regular"
                weight="medium"
                marginBottom={0}
              >
                {study.timeline}
              </Text>
            </div>
          )
        }
        {
          study.liveUrl && (
            <div class="case-study_detail_meta_item">
              <Button
                variant="text"
                href={study.liveUrl}
                newTab
                ariaLabel={`Visit ${plainText(study.client)} website`}
              >
                Visit Website
                <svg
                  slot="icon"
                  aria-hidden="true"
                  viewBox="0 0 10 10"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <line x1="0" y1="5" x2="8" y2="5" />
                  <polyline points="5,2 8,5 5,8" />
                </svg>
              </Button>
            </div>
          )
        }
      </div>

      <div class="case-study_detail_categories">
        {
          study.categories.map((cat) => (
            <span class="case-study_detail_category_tag">{cat}</span>
          ))
        }
      </div>

      <div slot="column2" class="case-study_detail_slider">
        <Slider
          slidesLg={2}
          slidesMd={2}
          slidesSm={1}
          slidesXs={1}
          showArrows
          showBullets
          loop
        >
          {
            study.gallery.map((img) => (
              <Visual
                src={imageSrc(img, { width: 1400 })}
                alt={img.alt}
                position={img.position}
              />
            ))
          }
        </Slider>
      </div>
    </Layout>
  </Section>

  {study.blocks.map((block) => <CaseStudyBlockRenderer block={block} />)}

  {ctaSection && <ContentCtaSection cta={ctaSection} />}

  {
    upNext.length > 0 && (
      <Section padding="large" class="case-study_detail_up_next_wrap">
        <Heading tag="h2" variant="h3" marginBottom={0}>
          Up Next
        </Heading>
        <Grid largeColumns={2} mediumColumns={2} smallColumns={1}>
          {upNext.map(
            (entry) =>
              entry.image && (
                <CaseStudyCard
                  title={entry.title}
                  description={entry.description}
                  categories={entry.categories}
                  href={`/case-studies/${entry.slug}`}
                  image={imageSrc(entry.image, { width: 1200 })}
                  imageAlt={entry.image.alt}
                  imagePosition={entry.image.position}
                  date={entry.date ?? undefined}
                />
              ),
          )}
        </Grid>
      </Section>
    )
  }
</BaseLayout>
