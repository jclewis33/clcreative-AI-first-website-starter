---
import type { HTMLAttributes, ComponentProps } from "astro/types";
import type { ImageMetadata } from "astro";
import Section from "@/components/ui/Section.astro";
import Layout from "@/components/ui/Layout.astro";
import Visual from "@/components/ui/Visual.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import StepList from "@/components/ui/StepList.astro";

type ProcessStep = { title: string; text: string };
type ProcessStepsVariant =
  /** Header (and optional photo) left, numbered list right */
  | "list"
  /** Header on top, numbered cards in a row */
  | "cards"
  /** Header on top, steps alternating along a vertical line (no photo) */
  | "timeline";
type ProcessStepsTheme = ComponentProps<typeof Section>["theme"];
type PaddingSize = import("@/components/ui/Section.astro").PaddingSize;

interface Props extends HTMLAttributes<"section"> {
  /**
   * **ProcessSteps** — "how it works": numbered steps from first call to
   * finished job.
   *
   * - `eyebrow`, `heading`, `text` — the intro
   * - `steps` — `{ title, text }[]` (numbers are generated)
   * - `image`, `imageAlt` — optional photo under the intro (`list` only)
   * - `variant` — `'list'` (default), `'cards'`, or `'timeline'` (steps
   *   alternating along a line; the photo isn't shown)
   *
   * @example
   * <ProcessSteps heading="How it works" steps={[{ title: "Call", text: "Tell us what you need." }]} />
   */
  docs?: string;

  /** Set to `false` to skip rendering. @default true */
  render?: boolean;

  /** Small label above the heading. */
  eyebrow?: string;

  /** Section heading. Required. */
  heading: string;

  /** Intro paragraph. */
  text?: string;

  /** The steps. Empty renders nothing. */
  steps: ProcessStep[];

  /** Optional photo under the intro (`list` variant). */
  image?: ImageMetadata | string;

  /** Alt text for the photo. */
  imageAlt?: string;

  /** Layout. @default 'list' */
  variant?: ProcessStepsVariant;

  /** Section theme. */
  theme?: ProcessStepsTheme;

  /** Section padding (top and bottom). */
  padding?: PaddingSize;

  /** Section id for anchor links. */
  id?: string;

  /** Extra classes on the section. */
  class?: string;
}

const {
  docs,
  render = true,
  eyebrow,
  heading,
  text,
  steps = [],
  image,
  imageAlt,
  variant = "list",
  theme,
  padding,
  id,
  class: className,
  ...rest
} = Astro.props;

if (import.meta.env.DEV && render) {
  if (!heading)
    console.warn("[ProcessSteps] `heading` is required; nothing renders.");
  if (!Astro.props.steps?.length)
    console.warn(
      "[ProcessSteps] `steps` is empty or missing; nothing renders.",
    );
  if (!["list", "cards", "timeline"].includes(variant))
    console.warn(`[ProcessSteps] Unknown variant "${variant}".`);
}
---

{
  render && heading && steps.length > 0 && (
    <Section
      theme={theme}
      padding={padding}
      id={id}
      class:list={["process-steps_wrap", className]}
      {...rest}
    >
      {variant === "cards" || variant === "timeline" ? (
        <>
          <SectionHeader eyebrow={eyebrow} heading={heading} intro={text} />
          <StepList steps={steps} variant={variant} />
        </>
      ) : (
        <>
          {/* The header runs full width; the photo and the steps share the
              row under it and stretch to one height, so the step rules line
              up with the photo instead of starting above it. */}
          <SectionHeader eyebrow={eyebrow} heading={heading} intro={text} />
          {image && (
            <Layout
              ratio="5-7"
              verticalAlign="stretch"
              class="process-steps_row"
            >
              <div class="process-steps_media">
                <Visual
                  src={image}
                  alt={imageAlt || heading}
                  ratio="landscape"
                />
              </div>
              <StepList
                slot="column2"
                steps={steps}
                variant="list"
                class="process-steps_list"
              />
            </Layout>
          )}
          {!image && <StepList steps={steps} variant="list" />}
        </>
      )}
    </Section>
  )
}

<style is:global>
  @layer components {
    /* The photo fills the height of the steps beside it (and the steps
       spread to the photo's), cropped by object-fit — never shorter than
       a landscape crop would be. Stacked on phones, it is a plain
       landscape photo again. */
    .process-steps_media {
      display: flex;
      height: 100%;
    }

    .process-steps_media .u-image-wrapper {
      flex: 1;
      aspect-ratio: unset;
      height: auto;
      min-height: 18rem;
    }

    .process-steps_list[data-variant="list"] {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .process-steps_list[data-variant="list"] .step-list_item {
      flex: 1;
      align-content: center;
    }

    @container (width < 58em) {
      .process-steps_media .u-image-wrapper {
        aspect-ratio: 3 / 2;
        min-height: 0;
      }
    }
  }
</style>
