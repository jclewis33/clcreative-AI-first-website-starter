---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import Section from "@/components/ui/Section.astro";
import Heading from "@/components/ui/Heading.astro";
import Visual from "@/components/ui/Visual.astro";
import { getProjects } from "@/lib/content";

type CaseStudyExtra = {
  /** A photo of more work (an import or a URL). */
  image: ImageMetadata | string;
  /** Alt text. Required. */
  alt: string;
  /** The caption under it: "Self-storage corridors". */
  caption: string;
};
type CaseStudyQuote = { text: string; name: string; meta?: string };

interface Props extends HTMLAttributes<"section"> {
  /**
   * **CaseStudyCards** — projects for a buyer who checks the details: the
   * first three as white cards (photo, title, a spec list — scope and
   * location — and "Read the case study" at the bottom), the rest as a row
   * of square photos with captions, then one client quote on a tinted
   * block. Reads the projects content (`getProjects()`), one category.
   *
   * - `category` — the projects to show ("commercial")
   * - `extras` — more photos for the row (work without its own page)
   * - `quote` — `{ text, name, meta? }`, real and attributed
   *
   * @example
   * <CaseStudyCards eyebrow="Commercial projects" heading="Commercial floors we have finished." category="commercial" quote={{ text: "…", name: "Jorge Luis Mata", meta: "Google review" }} />
   */
  docs?: string;

  /** Set to `false` to skip rendering. @default true */
  render?: boolean;

  /** Small label above the heading. */
  eyebrow?: string;

  /** The heading. */
  heading: string;

  /** Which projects (a category value from src/config/projects.ts). */
  category: string;

  /** More photos for the row under the cards. */
  extras?: CaseStudyExtra[];

  /** One client quote under it all. */
  quote?: CaseStudyQuote;

  /** Section id for anchor links. @default 'projects' */
  id?: string;

  /** Extra classes on the section. */
  class?: string;
}

const {
  docs,
  render = true,
  eyebrow,
  heading,
  category,
  extras = [],
  quote,
  id = "projects",
  class: className,
  ...rest
} = Astro.props;

const projects = (await getProjects()).filter((p) => p.category === category);
const cards = projects.slice(0, 3);
const thumbs = [
  ...projects.slice(3).map((p) => ({
    image: p.image?.src,
    alt: p.image?.alt ?? p.title,
    caption: p.title,
    href: p.href as string | undefined,
  })),
  ...extras.map((x) => ({
    image: x.image,
    alt: x.alt,
    caption: x.caption,
    href: undefined,
  })),
]
  .filter((t) => t.image)
  .slice(0, 5);
---

{
  render && cards.length > 0 && (
    <Section
      id={id}
      class:list={["case-study-cards_wrap", className]}
      {...rest}
    >
      <div class="u-margin-trim">
        {eyebrow && (
          <Heading variant="eyebrow" marginBottom={4}>
            {eyebrow}
          </Heading>
        )}
        <Heading tag="h2" variant="h2">
          {heading}
        </Heading>
      </div>
      <ul class="case-study-cards_list">
        {cards.map((project) => (
          <li class="case-study-cards_card">
            {project.image && (
              <Visual
                src={project.image.src}
                alt={project.image.alt}
                width={project.image.width}
                height={project.image.height}
                ratio="landscape"
                radius="none"
              />
            )}
            <div class="case-study-cards_body">
              <h3 class="case-study-cards_title">{project.title}</h3>
              <dl class="case-study-cards_specs">
                {project.service && (
                  <div class="case-study-cards_spec">
                    <dt>Scope</dt>
                    <dd>{project.service}</dd>
                  </div>
                )}
                {project.location && (
                  <div class="case-study-cards_spec">
                    <dt>Location</dt>
                    <dd>{project.location}</dd>
                  </div>
                )}
              </dl>
              <a class="case-study-cards_link" href={project.href}>
                Read the case study <span aria-hidden="true">→</span>
                <span class="u-sr-only">: {project.title}</span>
              </a>
            </div>
          </li>
        ))}
      </ul>
      {thumbs.length > 0 && (
        <ul class="case-study-cards_thumbs">
          {thumbs.map((t) => (
            <li class="case-study-cards_thumb">
              {t.href ? (
                <a class="case-study-cards_thumb_link" href={t.href}>
                  <Visual src={t.image!} alt={t.alt} ratio="square" />
                  <span class="case-study-cards_caption">{t.caption}</span>
                </a>
              ) : (
                <figure class="case-study-cards_figure">
                  <Visual src={t.image!} alt={t.alt} ratio="square" />
                  <figcaption class="case-study-cards_caption">
                    {t.caption}
                  </figcaption>
                </figure>
              )}
            </li>
          ))}
        </ul>
      )}
      {quote && (
        <figure class="case-study-cards_quote">
          <blockquote class="case-study-cards_quote_text">
            “{quote.text}”
          </blockquote>
          <figcaption class="case-study-cards_quote_who">
            <span class="case-study-cards_quote_name">{quote.name}</span>
            {quote.meta && <span> · {quote.meta}</span>}
          </figcaption>
        </figure>
      )}
    </Section>
  )
}

<style is:global>
  @layer components {
    .case-study-cards_list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
      gap: var(--space-5);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .case-study-cards_card {
      display: flex;
      flex-direction: column;
      overflow: hidden;
      border-radius: var(--radius-main);
      background-color: var(--color-light-100);
    }

    .case-study-cards_body {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding: var(--space-5) var(--space-5) var(--space-6);
    }

    .case-study-cards_title {
      margin: 0;
      font-family: var(--font-primary);
      font-size: var(--h5-size);
      font-weight: var(--h5-weight);
      line-height: 1.2;
    }

    .case-study-cards_specs {
      display: grid;
      gap: var(--space-2);
      margin: 0;
      font-size: var(--text-small-size);
    }

    .case-study-cards_spec {
      display: grid;
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: var(--space-3);
    }

    .case-study-cards_spec dt {
      color: color-mix(in srgb, var(--text) 70%, transparent);
    }

    .case-study-cards_spec dd {
      margin: 0;
      font-weight: var(--font-weight-medium);
    }

    .case-study-cards_link {
      margin-top: auto;
      padding-top: var(--space-2);
      font-weight: 600;
      color: var(--heading-accent);
      text-decoration: none;
    }

    .case-study-cards_thumbs {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
      gap: var(--space-3);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .case-study-cards_thumb_link,
    .case-study-cards_figure {
      display: grid;
      gap: var(--space-2);
      margin: 0;
      color: inherit;
      text-decoration: none;
    }

    .case-study-cards_caption {
      font-size: var(--text-small-size);
      color: color-mix(in srgb, var(--text) 72%, transparent);
    }

    .case-study-cards_quote {
      display: grid;
      gap: var(--space-4);
      margin: var(--space-6) 0 0;
      padding: var(--space-7);
      border-radius: var(--radius-main);
      background-color: color-mix(in srgb, var(--text) 6%, var(--background));
    }

    .case-study-cards_quote_text {
      max-width: 52rem;
      margin: 0;
      font-family: var(--font-primary);
      font-size: var(--h4-size);
      line-height: 1.3;
    }

    .case-study-cards_quote_who {
      font-size: var(--text-small-size);
      color: color-mix(in srgb, var(--text) 72%, transparent);
    }

    .case-study-cards_quote_name {
      font-weight: 600;
      color: var(--text);
    }

    @media (hover: hover) {
      .case-study-cards_link:hover,
      .case-study-cards_thumb_link:hover .case-study-cards_caption {
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }
    }
  }
</style>
