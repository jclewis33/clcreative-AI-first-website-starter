---
import type { HTMLAttributes } from "astro/types";
/**
 * ProjectImages — scrolling marquee of project screenshots.
 *
 * Displays project images in an infinite horizontal scroll, each
 * maintaining its natural aspect ratio at a consistent height.
 * Built on top of the Marquee component.
 */

import Section from "@/components/ui/Section.astro";
import Marquee from "@/components/ui/Marquee.astro";
import { Image } from "astro:assets";

import img1 from "@/assets/placeholder-images/placeholder-7.webp";
import img2 from "@/assets/placeholder-images/placeholder-12.webp";
import img3 from "@/assets/placeholder-images/placeholder-8.webp";
import img4 from "@/assets/placeholder-images/placeholder-13.webp";
import img5 from "@/assets/placeholder-images/placeholder-9.webp";

interface Props extends HTMLAttributes<"section"> {
  /**
   * **ProjectImages props:**
   * - `theme` — 'light' | 'dark' | 'brand'
   * - `padding` / `paddingTop` / `paddingBottom` — section padding
   * - `class` — extra classes
   * - Also accepts any HTML attribute
   */
  docs?: string;

  /** Color theme for the section. */
  theme?: "light" | "dark" | "brand";

  /** Section vertical padding. @default 'small' */
  /* Single source for the padding union: Section.props.ts. */
  padding?: import("@/components/ui/Section.astro").PaddingSize;
  paddingTop?: import("@/components/ui/Section.astro").PaddingSize;
  paddingBottom?: import("@/components/ui/Section.astro").PaddingSize;

  /** Extra classes on the section. */
  class?: string;
}

const {
  docs,
  theme,
  padding = "small",
  paddingTop,
  paddingBottom,
  class: className,
  ...rest
} = Astro.props;


const images = [
  { src: img1, alt: "Project screenshot 1" },
  { src: img2, alt: "Project screenshot 2" },
  { src: img3, alt: "Project screenshot 3" },
  { src: img4, alt: "Project screenshot 4" },
  { src: img5, alt: "Project screenshot 5" },
];
---

<Section
  theme={theme}
  padding={padding}
  paddingTop={paddingTop}
  paddingBottom={paddingBottom}
  container="full"
  class:list={["project-images_section", className]}
  {...rest}
>
  <Marquee speed={90} gap={4} class="project-images_marquee">
    {
      [...images, ...images].map(({ src, alt }) => (
        <div class="marquee_item project-images_item">
          <Image
            src={src}
            alt={alt}
            class="project-images_img"
            loading="eager"
            widths={[400, 600]}
            sizes="400px"
          />
        </div>
      ))
    }
  </Marquee>
</Section>

<style is:global>
  /* Global styles (is:global — classes here are used across the site and by
     child slots), moved from src/styles/components/project-images.css. The layer
     wrapper slots them into the cascade defined in styles/global.css. */
  @layer components {
    /* ==========================================================================
   PROJECT IMAGES
   Scrolling marquee of project screenshots with varying aspect ratios.
   ========================================================================== */

    .project-images_section .marquee_item img {
      max-height: none;
    }

    .project-images_section .marquee_inner {
      align-items: center;
    }

    .project-images_item {
      overflow: hidden;
      border-radius: var(--radius-small);
    }

    .project-images_img {
      display: block;
      height: clamp(10rem, 12vw + 4rem, 20rem);
      width: auto;
      border-radius: var(--radius-small);
    }
  }
</style>
