---
import type { HTMLAttributes } from "astro/types";
/**
 * WhyWorkWithUs — breakout-reversed section with numbered value props.
 *
 * Image bleeds to the left viewport edge, content on the right with
 * an eyebrow, heading, numbered list with dividers, and a CTA button.
 *
 * @example Default usage
 * ```astro
 * <WhyWorkWithUs />
 * ```
 *
 * @example Custom padding and theme
 * ```astro
 * <WhyWorkWithUs theme="dark" padding="large" />
 * ```
 */

import Section from "@/components/ui/Section.astro";
import Layout from "@/components/ui/Layout.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";
import Visual from "@/components/ui/Visual.astro";
import Button from "@/components/ui/Button.astro";

import whyImage from "@/assets/placeholder-images/placeholder-11.webp";

type PaddingValue = "none" | "small" | "main" | "large" | "page-top";

interface Props extends HTMLAttributes<"section"> {
  /**
   * **WhyWorkWithUs props:**
   * - `theme` — 'light' | 'dark' | 'brand'
   * - `padding` / `paddingTop` / `paddingBottom` — section padding
   * - `class` — extra classes
   * - Also accepts any HTML attribute
   */
  docs?: string;

  /** Color theme for the section. */
  theme?: "light" | "dark" | "brand";

  /** Section vertical padding. @default 'main' */
  padding?: PaddingValue;
  paddingTop?: PaddingValue;
  paddingBottom?: PaddingValue;

  /** Extra classes on the section. */
  class?: string;
}

const {
  docs,
  theme,
  padding = "none",
  paddingTop,
  paddingBottom,
  class: className,
  ...rest
} = Astro.props;

const items = [
  {
    number: "01",
    title: "Lorem ipsum dolor sit amet",
    text: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
  },
  {
    number: "02",
    title: "Consectetur adipiscing elit sed",
    text: "Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat duis aute irure dolor in reprehenderit in voluptate velit.",
  },
  {
    number: "03",
    title: "Excepteur sint occaecat cupidatat",
    text: "Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum sed ut perspiciatis unde omnis.",
  },
];
---

<Section
  theme={theme}
  padding={padding}
  paddingTop={paddingTop}
  paddingBottom={paddingBottom}
  class:list={["why-work_section", className]}
  {...rest}
>
  <Layout
    docs=""
    columnGap="var(--gap-8)"
    variant="full-reversed"
    verticalAlign="center"
  >
    <div class="why-work_content">
      <Heading data-fade-in variant="eyebrow"> Why Work With Us </Heading>
      <Heading data-split-text variant="h3">
        Lorem ipsum dolor sit amet consectetur adipiscing elit
      </Heading>

      <div class="why-work_list">
        {
          items.map((item) => (
            <div class="why-work_row" data-fade-in>
              <p class="why-work_number">{item.number}</p>
              <div class="why-work_item_content">
                <Heading maxWidth="none" tag="h3" variant="h5" marginBottom={0}>
                  {item.title}
                </Heading>
                <Text marginBottom={0} set:html={item.text} />
              </div>
            </div>
          ))
        }
      </div>

      <div class="u-button-wrapper">
        <Button href="/contact" ariaLabel="Get started"> Get Started </Button>
      </div>
    </div>

    <Visual
      radius="none"
      slot="column2"
      src={whyImage}
      alt="Why work with us"
      ratio="portrait"
    />
  </Layout>
</Section>

<style is:global>
  /* Global styles (is:global — classes here are used across the site and by
     child slots), moved from src/styles/components/why-work-with-us.css. The layer
     wrapper slots them into the cascade defined in styles/global.css. */
  @layer components {
    /* ==========================================================================
   WHY WORK WITH US
   Breakout-reversed section with numbered value props list.
   ========================================================================== */

    /* ── Eyebrow — mono font, accent color ──────────────────────────────────── */

    /* ── Content column — vertical padding when section padding is none ───── */

    .why-work_content {
      padding-block: var(--section-space-xsmall);
    }

    @media (width < 50em) {
      .why-work_content {
        padding-block: 0;
      }

      .why-work_section {
        padding-block: var(--section-space-small);
      }
    }

    /* ── List ────────────────────────────────────────────────────────────────── */

    .why-work_list {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      border-top: var(--border-width-main) solid var(--border);
      padding-top: var(--space-4);
    }

    .why-work_row {
      display: flex;
      gap: var(--space-5);
      align-items: flex-start;
    }

    /* ── Number — tagline style (mono, small, uppercase) ────────────────────── */

    .why-work_number {
      font-family: var(--font-tertiary);
      font-size: 1rem;
      line-height: var(--line-height-normal);
      letter-spacing: var(--letter-spacing-tight);
      text-transform: uppercase;
      white-space: nowrap;
      flex-shrink: 0;
      margin: 0;
    }

    /* ── Item content ───────────────────────────────────────────────────────── */

    .why-work_item_content {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      min-width: 0;
    }

    /* ── Responsive — collapse list rows on small ───────────────────────────── */

    @container (width < 35em) {
      .why-work_row {
        flex-direction: column;
        gap: var(--space-2);
      }
    }
  }
</style>
