---
import type { HTMLAttributes, ComponentProps } from "astro/types";
import type { ImageMetadata } from "astro";
import Section from "@/components/ui/Section.astro";
import Layout from "@/components/ui/Layout.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";
import CheckList from "@/components/ui/CheckList.astro";
import ImagePair from "@/components/ui/ImagePair.astro";

type IncludedImage = { src: ImageMetadata | string; alt: string };
type IncludedListVariant =
  /** The checklist, with an optional photo pair beside it */
  | "default"
  /** One white rounded card: heading left, round-ticked checklist right */
  | "panel";
type IncludedListTheme = ComponentProps<typeof Section>["theme"];
type PaddingSize = import("@/components/ui/Section.astro").PaddingSize;

interface Props extends HTMLAttributes<"section"> {
  /**
   * **IncludedList** — "what's included": a two-column checklist beside an
   * offset pair of photos. Made for service pages.
   *
   * - `eyebrow`, `heading`, `text` — the intro
   * - `items` — the checklist lines
   * - `images` — two `{ src, alt }` photos (optional; without them the
   *   checklist takes the full width)
   * - `variant` — `"default"`, or `"panel"`: one white rounded card, the
   *   heading (HTML, `<strong>` = accent) and text on the left, the
   *   checklist with round brand ticks on the right; no photos
   *
   * @example
   * <IncludedList heading="What's included" items={["Permits", "Demolition", "Cabinets", "Cleanup"]} images={[a, b]} />
   */
  docs?: string;

  /** Set to `false` to skip rendering. @default true */
  render?: boolean;

  /** Small label above the heading. */
  eyebrow?: string;

  /** Section heading. Required. */
  heading: string;

  /** Intro paragraph. */
  text?: string;

  /** The checklist lines. Empty renders nothing. */
  items: string[];

  /** Two photos beside the list (default variant only). */
  images?: IncludedImage[];

  /** `panel` = the checklist in one white rounded card beside the heading. @default 'default' */
  variant?: IncludedListVariant;

  /** Section theme. */
  theme?: IncludedListTheme;

  /** Section padding (top and bottom). */
  padding?: PaddingSize;

  /** Section id for anchor links. */
  id?: string;

  /** Extra classes on the section. */
  class?: string;
}

const {
  docs,
  render = true,
  eyebrow,
  heading,
  text,
  items = [],
  images = [],
  variant = "default",
  theme,
  padding,
  id,
  class: className,
  ...rest
} = Astro.props;

if (import.meta.env.DEV && render) {
  if (!heading)
    console.warn("[IncludedList] `heading` is required; nothing renders.");
  if (!Astro.props.items?.length)
    console.warn(
      "[IncludedList] `items` is empty or missing; nothing renders.",
    );
}
---

{
  render && heading && items.length > 0 && (
    <Section
      theme={theme}
      padding={padding}
      id={id}
      class:list={["included-list_wrap", className]}
      {...rest}
    >
      {variant === "panel" && (
        <div class="included-list_panel">
          <div class="included-list_panel_intro u-margin-trim">
            {eyebrow && <Heading variant="eyebrow">{eyebrow}</Heading>}
            <Heading tag="h2" accent>
              <Fragment set:html={heading} />
            </Heading>
            {text && <Text muted>{text}</Text>}
          </div>
          <ul class="included-list_panel_list">
            {items.map((item) => (
              <li class="included-list_panel_item">
                <span class="included-list_panel_tick" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="m6 12.5 4 4 8-9" />
                  </svg>
                </span>
                <span class="included-list_panel_text">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
      {variant !== "panel" && images.length === 2 && (
        <Layout ratio="6-6" verticalAlign="center">
          {eyebrow && <Heading variant="eyebrow">{eyebrow}</Heading>}
          <Heading tag="h2">{heading}</Heading>
          {text && <Text muted>{text}</Text>}
          <CheckList items={items} columns={2} />
          <ImagePair slot="column2" images={images} />
        </Layout>
      )}
      {variant !== "panel" && images.length !== 2 && (
        <Layout variant="stack">
          {eyebrow && <Heading variant="eyebrow">{eyebrow}</Heading>}
          <Heading tag="h2">{heading}</Heading>
          {text && <Text muted>{text}</Text>}
          <CheckList items={items} columns={2} />
        </Layout>
      )}
    </Section>
  )
}

<style is:global>
  @layer components {
    /* panel: one white rounded card, heading left, checklist right. */
    .included-list_panel {
      display: grid;
      grid-template-columns: var(
        --column-medium,
        minmax(0, 0.9fr) minmax(0, 1.1fr)
      );
      gap: var(--space-6) var(--space-8);
      align-items: center;
      padding: var(--space-7);
      border-radius: calc(var(--radius-main) * 1.5);
      background-color: var(--background-2);
      box-shadow:
        0 0.0625rem 0.125rem color-mix(in srgb, var(--text) 6%, transparent),
        0 1rem 2.5rem color-mix(in srgb, var(--text) 7%, transparent);
    }

    .included-list_panel_list {
      display: grid;
      grid-template-columns: var(--column-small, repeat(2, minmax(0, 1fr)));
      gap: var(--space-4) var(--space-6);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .included-list_panel_item {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .included-list_panel_text {
      min-width: 0;
      font-weight: var(--font-weight-medium);
    }

    .included-list_panel_tick {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
      width: 2rem;
      aspect-ratio: 1;
      border-radius: var(--radius-full);
      background-color: color-mix(
        in srgb,
        var(--color-brand-500) 16%,
        var(--background-2)
      );
      color: var(--heading-accent);
    }

    .included-list_panel_tick svg {
      width: 1rem;
      aspect-ratio: 1;
      stroke-width: 2.5;
    }
  }
</style>
