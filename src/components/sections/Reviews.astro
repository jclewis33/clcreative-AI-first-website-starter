---
import type { HTMLAttributes, ComponentProps } from "astro/types";
import Section from "@/components/ui/Section.astro";
import Grid from "@/components/ui/Grid.astro";
import Card from "@/components/ui/Card.astro";
import Button from "@/components/ui/Button.astro";
import Quote from "@/components/ui/Quote.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { SITE } from "@/config/site";

type Review = { text: string; name: string; meta?: string };
type ReviewsLayout =
  /** First review large on a dark card, the next two stacked beside it */
  | "featured"
  /** Three across */
  | "grid";
type ReviewsTheme = ComponentProps<typeof Section>["theme"];
type PaddingSize = import("@/components/ui/Section.astro").PaddingSize;

interface Props extends HTMLAttributes<"section"> {
  /**
   * **Reviews** — customer reviews with an optional star rating.
   *
   * - `reviews` — `{ text, name, meta? }[]`, typed in by you
   * - `rating`, `count` — the summary badge ("4.9 out of 5 · Based on 127 reviews")
   * - `layout` — `'featured'` (default with 3+ reviews; the first review
   *   sits large on a dark card) or `'grid'`
   * - `allReviewsHref` — "Read all reviews" link (default `SITE.reviewsUrl`;
   *   hidden when empty)
   *
   * Deliberately no review schema markup: self-published review stars can
   * draw a Google manual action.
   *
   * @example
   * <Reviews rating={4.9} count={127} reviews={[{ text: "…", name: "Sam R.", meta: "Kitchen remodel" }]} />
   */
  docs?: string;

  /** Set to `false` to skip rendering. @default true */
  render?: boolean;

  /** Small label above the heading. */
  eyebrow?: string;

  /** Section heading. @default 'What our customers say' */
  heading?: string;

  /** The reviews. Empty renders nothing. */
  reviews: Review[];

  /** Average star rating, e.g. 4.9. Shows the summary badge. */
  rating?: number;

  /** Number of reviews behind the rating. */
  count?: number;

  /** Layout. @default 'featured' with 3+ reviews, else 'grid' */
  layout?: ReviewsLayout;

  /** "Read all reviews" link. @default SITE.reviewsUrl (blank = hidden) */
  allReviewsHref?: string;

  /** Label for that link. @default 'Read all reviews' */
  allReviewsLabel?: string;

  /** Section theme. */
  theme?: ReviewsTheme;

  /** Section padding (top and bottom). */
  padding?: PaddingSize;

  /** Section id for anchor links. */
  id?: string;

  /** Extra classes on the section. */
  class?: string;
}

const {
  docs,
  render = true,
  eyebrow,
  heading = "What our customers say",
  reviews = [],
  rating,
  count,
  layout: layoutProp,
  allReviewsHref = SITE.reviewsUrl,
  allReviewsLabel = "Read all reviews",
  theme,
  padding,
  id,
  class: className,
  ...rest
} = Astro.props;

const layout: ReviewsLayout =
  layoutProp ?? (reviews.length >= 3 ? "featured" : "grid");
const [featured, ...others] = reviews;
const stars = rating ? Math.max(0, Math.min(5, Math.round(rating))) : 0;

if (import.meta.env.DEV && render) {
  if (!Astro.props.reviews?.length)
    console.warn("[Reviews] `reviews` is empty or missing; nothing renders.");
  if (layout === "featured" && reviews.length > 3)
    console.warn(
      `[Reviews] The featured layout shows 3 reviews; ${reviews.length - 3} more are hidden. Use layout="grid" to show them all.`,
    );
  if (layoutProp && !["featured", "grid"].includes(layoutProp))
    console.warn(`[Reviews] Unknown layout "${layoutProp}".`);
}
---

{
  render && reviews.length > 0 && (
    <Section
      theme={theme}
      padding={padding}
      id={id}
      class:list={["reviews_wrap", className]}
      {...rest}
    >
      <SectionHeader eyebrow={eyebrow} heading={heading}>
        {allReviewsHref && (
          <Button
            slot="action"
            variant="secondary"
            href={allReviewsHref}
            newTab
            ariaLabel={allReviewsLabel}
          >
            {allReviewsLabel}
          </Button>
        )}
      </SectionHeader>

      {rating ? (
        <div class="reviews_rating">
          <span class="reviews_stars" aria-hidden="true">
            {Array.from({ length: 5 }, (_, i) => (
              <svg
                class:list={["reviews_star", i >= stars && "is-empty"]}
                viewBox="0 0 24 24"
              >
                <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" />
              </svg>
            ))}
          </span>
          <span class="reviews_rating_text">
            <strong>{rating} out of 5</strong>
            {count ? ` · Based on ${count} reviews` : ""}
          </span>
        </div>
      ) : null}

      {layout === "featured" && featured ? (
        <Grid largeColumns={2} mediumColumns={1} smallColumns={1} rowGap={5}>
          <Card variant="stacked" theme="dark" class="reviews_feature">
            <Quote
              text={featured.text}
              name={featured.name}
              meta={featured.meta}
              mark="icon"
              spread
            />
          </Card>
          {others.length > 0 && (
            <div class="reviews_stack">
              {others.slice(0, 2).map((review) => (
                <Card variant="stacked" class="reviews_card">
                  <Quote
                    text={review.text}
                    name={review.name}
                    meta={review.meta}
                    size="regular"
                    mark="none"
                    spread
                  />
                </Card>
              ))}
            </div>
          )}
        </Grid>
      ) : (
        <Grid largeColumns={3} mediumColumns={2} smallColumns={1} rowGap={5}>
          {reviews.map((review) => (
            <Card variant="stacked" class="reviews_card">
              <Quote
                text={review.text}
                name={review.name}
                meta={review.meta}
                size="regular"
                mark="none"
                spread
              />
            </Card>
          ))}
        </Grid>
      )}
    </Section>
  )
}

<style is:global>
  @layer components {
    .reviews_rating {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3);
    }

    .reviews_stars {
      display: flex;
      flex-shrink: 0;
      gap: 0.125em;
    }

    .reviews_star {
      width: 1.125rem;
      aspect-ratio: 1 / 1;
      fill: var(--heading-accent);
    }

    .reviews_star.is-empty {
      fill: var(--border);
    }

    .reviews_rating_text {
      font-size: var(--text-small-size);
    }

    .reviews_stack {
      display: grid;
      grid-template-rows: repeat(2, minmax(0, 1fr));
      gap: var(--site-gutter);
    }

    .reviews_feature .card_primary_content {
      min-height: 22rem;
      padding: var(--space-7);
    }

    .reviews_card .card_primary_content {
      padding: var(--space-6);
    }

    /* The quote fills the card so the name sits on the card's floor. */
    .reviews_feature .card_primary_text,
    .reviews_card .card_primary_text {
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }
  }
</style>
