---
import type { HTMLAttributes } from "astro/types";
import Layout from "@/components/ui/Layout.astro";
/**
 * SignUpForm — centered card with heading, subtext, and a simple contact form.
 *
 * Renders a rounded card inside a section with a generic form (name, email,
 * message). Wire up submission via client-side JS or a form action.
 *
 * @example Default usage
 * ```astro
 * <SignUpForm />
 * ```
 *
 * @example With anchor id
 * ```astro
 * <SignUpForm id="signup" />
 * ```
 */

import Section from "@/components/ui/Section.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";
import Button from "@/components/ui/Button.astro";
import Form from "@/components/form/Form.astro";
import FormField from "@/components/form/FormField.astro";
import FormTextarea from "@/components/form/FormTextarea.astro";

/* Single source for the padding union: Section.props.ts. PaddingOverride
   excludes "main" — the default is expressed by omitting the prop. */
type PaddingValue = import("@/components/ui/Section.props").PaddingOverride;

interface Props extends HTMLAttributes<"section"> {
  /**
   * **SignUpForm props:**
   * - `theme` — 'light' | 'dark' | 'brand' (default 'light')
   * - `padding` / `paddingTop` / `paddingBottom` — section padding
   * - `id` — section id for anchor links
   * - `class` — extra classes
   */
  docs?: string;

  theme?: "light" | "dark" | "brand";
  padding?: PaddingValue;
  paddingTop?: PaddingValue;
  paddingBottom?: PaddingValue;
  id?: string;
  class?: string;
}

const {
  docs,
  theme = "light",
  padding,
  paddingTop = padding,
  paddingBottom = padding,
  id,
  class: className,
  ...rest
} = Astro.props;
---

<Section
  theme={theme}
  paddingTop={paddingTop}
  paddingBottom={paddingBottom}
  id={id}
  container="narrow"
  class={className}
  {...rest}
>
  <div data-fade-in class="signup_card" data-theme="dark">
    <Layout variant="stack-centered">
      <Heading variant="h3">Lorem ipsum dolor sit amet consectetur?</Heading>
      <Text align="center"
        >Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod
        tempor incididunt ut labore et dolore magna aliqua.</Text
      >
    </Layout>

    <Form name="signup" class="signup_form">
      <FormField label="Name" name="name" required />
      <FormField label="Email" name="email" type="email" required />
      <FormTextarea label="Message" name="message" rows={4} />
      <Button type="submit" ariaLabel="Submit">Submit</Button>
    </Form>
  </div>
</Section>

<style is:global>
  /* Global styles (is:global — classes here are used across the site and by
     child slots), moved from src/styles/components/signup-form.css. The layer
     wrapper slots them into the cascade defined in styles/global.css. */
  @layer components {
    /* ==========================================================================
   SIGN UP FORM
   Dark card with centered content and a form.
   ========================================================================== */

    .signup_card {
      background-color: var(--background);
      color: var(--text);
      border-radius: var(--radius-medium);
      padding: var(--space-8) var(--space-4);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-8);
    }

    .signup_form {
      width: 100%;
      max-width: 35rem;
      background-color: white;
      border-radius: var(--radius-main);
      padding: var(--space-3);
    }

    @container (max-width: 39em) {
      .signup_form {
        padding: var(--space-1);
      }
    }
  }
</style>
