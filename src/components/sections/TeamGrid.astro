---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes, ComponentProps } from "astro/types";
import Section from "@/components/ui/Section.astro";
import Grid from "@/components/ui/Grid.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import Visual from "@/components/ui/Visual.astro";
import CtaButton from "@/components/ui/CtaButton.astro";
import type { SectionCta } from "@/lib/cta";

type TeamMember = {
  name: string;
  /** "Owner · Master electrician", "Lead installer". */
  role: string;
  /** Their photo (an import or a URL). */
  image: ImageMetadata | string;
  /** Alt text. @default the name */
  imageAlt?: string;
  /** One or two sentences, in their voice or about them. */
  bio?: string;
};
type TeamHiring = { text: string; cta: SectionCta };
type TeamGridTheme = ComponentProps<typeof Section>["theme"];
type PaddingSize = import("@/components/ui/Section.astro").PaddingSize;

interface Props extends HTMLAttributes<"section"> {
  /**
   * **TeamGrid** — the people who show up at the door: a photo, name, role
   * and a line each, then an optional "We're hiring" prompt. Homeowners
   * letting someone into their house want to see who it is.
   *
   * Real people and real photos only.
   *
   * - `members` — `TeamMember[]`; empty renders nothing
   * - `hiring` — `{ text, cta }` for a hiring line under the grid
   *
   * @example
   * <TeamGrid members={[{ name: "Jeff H.", role: "Owner", image: jeff }]} hiring={{ text: "We're hiring licensed techs.", cta: { label: "See openings", href: "/careers" } }} />
   */
  docs?: string;

  /** Set to `false` to skip rendering. @default true */
  render?: boolean;

  /** Small label above the heading. */
  eyebrow?: string;

  /** Section heading. @default 'Meet the team' */
  heading?: string;

  /** Intro beside the heading. */
  intro?: string;

  /** The people. Empty renders nothing. */
  members: TeamMember[];

  /** A hiring line and button under the grid. */
  hiring?: TeamHiring;

  /** Section theme. */
  theme?: TeamGridTheme;

  /** Section padding (top and bottom). */
  padding?: PaddingSize;

  /** Section id for anchor links. */
  id?: string;

  /** Extra classes on the section. */
  class?: string;
}

const {
  docs,
  render = true,
  eyebrow,
  heading = "Meet the team",
  intro,
  members = [],
  hiring,
  theme,
  padding,
  id,
  class: className,
  ...rest
} = Astro.props;

if (import.meta.env.DEV && render && !Astro.props.members?.length) {
  console.warn("[TeamGrid] `members` is empty or missing; nothing renders.");
}
---

{
  render && members.length > 0 && (
    <Section
      theme={theme}
      padding={padding}
      id={id}
      class:list={["team-grid_wrap", className]}
      {...rest}
    >
      <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} />
      <Grid largeColumns={4} mediumColumns={2} smallColumns={1}>
        {members.map((member) => (
          <article class="team-grid_card">
            <Visual
              src={member.image}
              alt={member.imageAlt ?? member.name}
              ratio="portrait"
            />
            <div class="team-grid_body">
              <Heading tag="h3" variant="h6" class="team-grid_name">
                {member.name}
              </Heading>
              <p class="team-grid_role">{member.role}</p>
              {member.bio && (
                <Text muted class="team-grid_bio">
                  {member.bio}
                </Text>
              )}
            </div>
          </article>
        ))}
      </Grid>
      {hiring && (
        <div class="team-grid_hiring">
          <p class="team-grid_hiring_text">{hiring.text}</p>
          <CtaButton cta={hiring.cta} variant="secondary" />
        </div>
      )}
    </Section>
  )
}

<style is:global>
  @layer components {
    .team-grid_card {
      display: grid;
      gap: var(--space-4);
      align-content: start;
    }

    .team-grid_body {
      min-width: 0;
    }

    .team-grid_name {
      margin-bottom: var(--space-1);
    }

    .team-grid_role {
      margin: 0 0 var(--space-3);
      font-size: var(--text-small-size);
      font-weight: var(--font-weight-medium);
      color: var(--heading-accent);
    }

    .team-grid_bio {
      margin-bottom: 0;
      font-size: var(--text-small-size);
    }

    .team-grid_hiring {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      padding: var(--space-5) var(--space-6);
      border-radius: var(--radius-main);
      background-color: color-mix(in srgb, var(--text) 5%, transparent);
    }

    .team-grid_hiring_text {
      margin: 0;
      min-width: 0;
      font-weight: var(--font-weight-medium);
    }
  }
</style>
