---
import type { HTMLAttributes, ComponentProps } from "astro/types";
import Section from "@/components/ui/Section.astro";
import Grid from "@/components/ui/Grid.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import CheckList from "@/components/ui/CheckList.astro";
import CtaButton from "@/components/ui/CtaButton.astro";
import type { SectionCta } from "@/lib/cta";

type MaintenancePlan = {
  /** "Comfort Club", "Gold". */
  name: string;
  /** "$19" — the number only; `period` says per what. */
  price: string;
  /** "/mo", "/yr". */
  period?: string;
  /** One line: who it's for. */
  description?: string;
  /** What's included: "2 tune-ups a year", "Priority scheduling", "15% off repairs". */
  perks: string[];
  /** Highlight this one ("Most popular"). */
  featured?: boolean;
  /** Button text. @default 'Join {name}' */
  ctaLabel?: string;
};
type MaintenancePlansTheme = ComponentProps<typeof Section>["theme"];
type PaddingSize = import("@/components/ui/Section.astro").PaddingSize;

interface Props extends HTMLAttributes<"section"> {
  /**
   * **MaintenancePlans** — membership / maintenance-club cards: name, price
   * per month or year, who it's for, the perks, and a button. One card can
   * be `featured` ("Most popular"). The recurring-revenue offer HVAC,
   * plumbing, pest and pool companies live on.
   *
   * Only plans the business really sells, at its real prices.
   *
   * - `plans` — `MaintenancePlan[]`; empty renders nothing
   * - `cta` — where every card's button goes (e.g. the estimate form); the
   *   label is the plan's `ctaLabel` or "Join {name}"
   * - `note` — terms under the cards
   *
   * @example
   * <MaintenancePlans plans={[{ name: "Comfort Club", price: "$19", period: "/mo", perks: ["2 tune-ups a year", "15% off repairs"], featured: true }]} cta={{ label: "Join", modal: "estimate-modal" }} />
   */
  docs?: string;

  /** Set to `false` to skip rendering. @default true */
  render?: boolean;

  /** Small label above the heading. */
  eyebrow?: string;

  /** Section heading. @default 'Maintenance plans' */
  heading?: string;

  /** Intro beside the heading. */
  intro?: string;

  /** The plans. Empty renders nothing. */
  plans: MaintenancePlan[];

  /** Where the buttons go; each card supplies its own label. */
  cta?: SectionCta;

  /** Terms under the cards. */
  note?: string;

  /** Section theme. */
  theme?: MaintenancePlansTheme;

  /** Section padding (top and bottom). */
  padding?: PaddingSize;

  /** Section id for anchor links. */
  id?: string;

  /** Extra classes on the section. */
  class?: string;
}

const {
  docs,
  render = true,
  eyebrow,
  heading = "Maintenance plans",
  intro,
  plans = [],
  cta,
  note,
  theme,
  padding,
  id,
  class: className,
  ...rest
} = Astro.props;

if (import.meta.env.DEV && render && !Astro.props.plans?.length) {
  console.warn(
    "[MaintenancePlans] `plans` is empty or missing; nothing renders.",
  );
}
---

{
  render && plans.length > 0 && (
    <Section
      theme={theme}
      padding={padding}
      id={id}
      class:list={["plans_wrap", className]}
      {...rest}
    >
      <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} />
      <Grid
        largeColumns={Math.min(plans.length, 3) as 1 | 2 | 3}
        mediumColumns={plans.length > 1 ? 2 : 1}
        smallColumns={1}
      >
        {plans.map((plan) => (
          <div
            class:list={["plans_card", { "is-featured": plan.featured }]}
            data-theme-invert={plan.featured ? true : undefined}
          >
            {plan.featured && <p class="plans_badge">Most popular</p>}
            <Heading tag="h3" variant="h5" class="plans_name">
              {plan.name}
            </Heading>
            <p class="plans_price">
              <span class="plans_price_value">{plan.price}</span>
              {plan.period && (
                <span class="plans_price_period">{plan.period}</span>
              )}
            </p>
            {plan.description && (
              <Text muted class="plans_description">
                {plan.description}
              </Text>
            )}
            <CheckList items={plan.perks} variant="plain" class="plans_perks" />
            {cta && (
              <div class="plans_action">
                <CtaButton
                  cta={{ ...cta, label: plan.ctaLabel ?? `Join ${plan.name}` }}
                  variant={plan.featured ? "primary" : "secondary"}
                  fullWidth
                />
              </div>
            )}
          </div>
        ))}
      </Grid>
      {note && <p class="plans_note">{note}</p>}
    </Section>
  )
}

<style is:global>
  @layer components {
    .plans_card {
      display: flex;
      flex-direction: column;
      height: 100%;
      padding: var(--space-6);
      border: var(--border-width-main) solid var(--border);
      border-radius: var(--radius-main);
      background-color: var(--background-2);
      color: var(--text);
    }

    .plans_badge {
      align-self: flex-start;
      margin: 0 0 var(--space-4);
      padding: 0.3em 0.8em;
      border-radius: var(--radius-full);
      background-color: var(--button-primary-background);
      color: var(--button-primary-text);
      font-size: var(--text-tiny-size);
      font-weight: var(--font-weight-bold);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .plans_price {
      display: flex;
      align-items: baseline;
      gap: var(--space-1);
      margin: 0 0 var(--space-4);
    }

    .plans_price_value {
      font-family: var(--font-primary);
      font-size: var(--h2-size);
      font-weight: var(--h2-weight);
      line-height: 1;
      color: var(--heading-accent);
    }

    /* On the featured (inverted, dark) card the brand colour can be too
       dark to read; the card's own ink carries the price there. */
    .plans_card.is-featured .plans_price_value {
      color: var(--text);
    }

    .plans_price_period {
      font-size: var(--text-small-size);
      opacity: 0.75;
    }

    /* The button sits on the card's floor (cards in a row line up), the
       perks keep their own spacing. */
    .plans_action {
      margin-top: auto;
      padding-top: var(--space-5);
    }

    .plans_note {
      margin: 0;
      font-size: var(--text-tiny-size);
      color: color-mix(in srgb, var(--text) 65%, transparent);
    }
  }
</style>
