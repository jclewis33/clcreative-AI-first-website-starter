---
/**
 * TestimonialsGrid — a responsive grid of testimonial cards.
 *
 * Composes `<Section>` for theming/padding and `<Grid>` for responsive
 * columns. Shares the same testimonial card design as TestimonialsSlider.
 *
 * Usage:
 * ```astro
 * <TestimonialsGrid
 *   theme="light"
 *   heading="What Our Clients Say"
 *   testimonials={testimonials}
 *   limit={6}
 * />
 * ```
 *
 * Slots:
 *   heading — override the heading area with custom markup
 */

import Section from "@/components/ui/Section.astro";
import Layout from "@/components/ui/Layout.astro";
import Heading from "@/components/ui/Heading.astro";
import Grid from "@/components/ui/Grid.astro";
import TestimonialCard, {
  type Testimonial,
} from "@/components/ui/TestimonialCard.astro";

type SectionTheme = "light" | "dark" | "brand";
/* Single source for the padding union: Section.astro — never re-declare
   these values locally; the copies this replaced had all drifted. */
type PaddingSize = import("@/components/ui/Section.astro").PaddingSize;

interface Props {
  /**
   * **TestimonialsGrid props:**
   * - `testimonials` — array of { quote, name, role?, company?, avatar?, stars? }
   * - `limit` — max testimonials to display (slices after Sanity ordering)
   * - `heading` — simple heading text (or use `heading` slot for custom markup)
   * - `eyebrow` — small label above heading (e.g. "Testimonials")
   * - `theme` — 'light' | 'dark' | 'brand'
   * - `padding` — 'none' | 'xsmall' | 'small' | 'large' | 'page-top' (default: omitted → 'main')
   * - `paddingTop` / `paddingBottom` — override top/bottom padding independently
   * - `id` — section id for anchor links
   * - `columns` — grid columns at desktop: 1–4 (default 3)
   * - `columnsMd` — grid columns at medium (~800px): 0–2 (default 2, 0 = inherit)
   * - `columnsSm` — grid columns at small (~560px): 0–1 (default 1, 0 = inherit)
   * - `class` — extra classes on outer Section
   *
   * **Slots:** `heading` — override the heading area with custom markup
   *
   * **Testimonial shape:** { quote, name, role?, company?, avatar?, stars? }
   * - `avatar` accepts a URL string or Sanity image object
   * - `stars` — 1–5 (omit to hide stars)
   */
  docs?: string;

  /** Array of testimonial objects to render as grid cards */
  testimonials: Testimonial[];

  /**
   * Max number of testimonials to display.
   * Slices the array after any Sanity-side ordering.
   */
  limit?: number;

  /**
   * Simple heading text. Renders as h2 with `variant="h2"`.
   * For richer heading markup, use the `heading` slot instead.
   */
  heading?: string;

  /**
   * Eyebrow text above the heading (e.g. "Testimonials").
   * Only rendered when `heading` prop or slot is used.
   */
  eyebrow?: string;

  /** Section color theme */
  theme?: SectionTheme;

  /** Section vertical padding */
  padding?: PaddingSize;

  /** Override top padding only */
  paddingTop?: PaddingSize;

  /** Override bottom padding only */
  paddingBottom?: PaddingSize;

  /** Section id for anchor links */
  id?: string;

  /**
   * Grid columns at desktop.
   * @default 3
   */
  columns?: 1 | 2 | 3 | 4;

  /**
   * Grid columns at medium (~800px).
   * @default 2
   */
  columnsMd?: 0 | 1 | 2;

  /**
   * Grid columns at small (~560px).
   * @default 1
   */
  columnsSm?: 0 | 1;

  /** Extra classes on the outer Section element */
  class?: string;
}

const {
  docs,
  testimonials: rawTestimonials,
  limit,
  heading,
  eyebrow,
  theme,
  padding,
  paddingTop,
  paddingBottom,
  id,
  columns = 3,
  columnsMd = 2,
  columnsSm = 1,
  class: className,
} = Astro.props;

/* Cards read against the section, not with it: on a dark or brand ground they
   flip to light paper. `invert` is relative, so this is the only decision —
   the card resolves the actual colors itself (see THEME INVERT in themes.css).
   On light grounds the cards stay in the ambient theme. */
const invertCards =
  theme === "dark" || theme === "brand" ? ("invert" as const) : undefined;

const testimonials = limit ? rawTestimonials.slice(0, limit) : rawTestimonials;

/* NOTE: these are `Astro.slots.has()`, not a rendered-content check.
   Rendering a slot (`Astro.slots.render()`) to find out whether it is empty
   swallows the hoisted `<script>` of every component inside it — page-wide,
   not just for that slot. Measured: one `<Slider>` in a Card `footer` slot
   left BOTH sliders on the page uninitialized, the unrelated one included.
   `.has()` only reports whether a slot was passed, which is weaker (a slot
   holding an empty `{items.map(…)}` still counts as present), and that is the
   trade we want: a rare empty wrapper beats silently dead client JS. */
const hasHeadingSlot = Astro.slots.has("heading");
const showHeading = Astro.slots.has("heading") || heading;
---

<Section
  theme={theme}
  padding={padding}
  paddingTop={paddingTop}
  paddingBottom={paddingBottom}
  id={id}
  class={className}
>
  {/* Heading area */}
  {
    showHeading && (
      <Layout variant="stack" class="testimonials_header">
        {hasHeadingSlot ? (
          <slot name="heading" />
        ) : (
          <>
            {eyebrow && <Heading variant="eyebrow">{eyebrow}</Heading>}
            <Heading tag="h2" balance>
              {heading}
            </Heading>
          </>
        )}
      </Layout>
    )
  }

  {/* Grid */}
  <Grid
    largeColumns={columns}
    mediumColumns={columnsMd}
    smallColumns={columnsSm}
    rowGap={6}
  >
    {
      testimonials.map((testimonial) => (
        <TestimonialCard {...testimonial} theme={invertCards} />
      ))
    }
  </Grid>
</Section>
