---
import type { HTMLAttributes } from "astro/types";
import Section from "@/components/ui/Section.astro";

type PathPanel = {
  /** Small label over the title ("For homeowners"). */
  label?: string;
  /** The panel's headline. */
  title: string;
  /** One line under it. */
  text?: string;
  /** Where the whole panel links. */
  href: string;
  /** The link line at the bottom ("Explore residential"). */
  linkLabel: string;
};

interface Props extends HTMLAttributes<"section"> {
  /**
   * **PathPanels** — two (or three) ways in for different visitors, each
   * panel one big link: homeowners one way, contractors another. The last
   * panel is dark, the others light. With `overlap` (the default) the
   * panels pull up over the bottom of the section above — the hero — so
   * the choice sits right under the headline.
   *
   * - `panels` — `{ label?, title, text?, href, linkLabel }[]`, 2 or 3
   * - `overlap` — pull up over the section above. @default true
   *
   * @example
   * <PathPanels panels={[{ label: "For homeowners", title: "Patios and floors", href: "#services", linkLabel: "Explore residential" }, { label: "For contractors", title: "Commercial floors", href: "/commercial", linkLabel: "Commercial capabilities" }]} />
   */
  docs?: string;

  /** Set to `false` to skip rendering. @default true */
  render?: boolean;

  /** The panels, 2 or 3. Empty renders nothing. */
  panels: PathPanel[];

  /** Pull the panels up over the bottom of the section above (a hero with room for them). @default true */
  overlap?: boolean;

  /** Section heading for screen readers. @default 'Choose your path' */
  label?: string;

  /** Section id for anchor links. */
  id?: string;

  /** Extra classes on the section. */
  class?: string;
}

const {
  docs,
  render = true,
  panels = [],
  overlap = true,
  label = "Choose your path",
  id,
  class: className,
  ...rest
} = Astro.props;

if (import.meta.env.DEV && render && !Astro.props.panels?.length) {
  console.warn("[PathPanels] `panels` is empty or missing; nothing renders.");
}
---

{
  render && panels.length > 0 && (
    <Section
      padding="none"
      id={id}
      aria-label={label}
      class:list={["path-panels_wrap", overlap && "is-overlap", className]}
      {...rest}
    >
      <ul class="path-panels_list">
        {panels.map((panel, i) => (
          <li
            class="path-panels_item"
            data-theme={i === panels.length - 1 ? "dark" : "light"}
          >
            <a class="path-panels_link_wrap" href={panel.href}>
              {panel.label && (
                <span class="path-panels_label">{panel.label}</span>
              )}
              <span class="path-panels_title">{panel.title}</span>
              {panel.text && <span class="path-panels_text">{panel.text}</span>}
              <span class="path-panels_more">
                {panel.linkLabel} <span aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </Section>
  )
}

<style is:global>
  @layer components {
    .path-panels_wrap {
      position: relative;
      z-index: 1;
    }

    .path-panels_wrap.is-overlap {
      margin-top: calc(var(--space-8) * -1.5);
    }

    .path-panels_list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
      gap: var(--space-4);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    /* Each panel carries its own theme (light, then dark for the last), so
       it sets its own paper and ink. Light panels use the card white. */
    .path-panels_item {
      background-color: var(--background);
      color: var(--text);
      border-radius: var(--radius-main);
    }

    .path-panels_item[data-theme="light"] {
      background-color: var(--color-light-100);
      outline: var(--border-width-main) solid var(--border);
      outline-offset: calc(var(--border-width-main) * -1);
    }

    .path-panels_item[data-theme="dark"] {
      background-color: var(--color-dark-800);
    }

    .path-panels_link_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      height: 100%;
      padding: var(--space-6) var(--space-6);
      color: inherit;
      text-decoration: none;
    }

    .path-panels_label {
      font-family: var(--eyebrow-font-family, var(--font-secondary));
      font-size: var(--eyebrow-size, 0.75rem);
      font-weight: var(--eyebrow-weight, 600);
      letter-spacing: var(--eyebrow-tracking, 0.18em);
      text-transform: uppercase;
      color: var(--heading-accent);
    }

    .path-panels_title {
      font-family: var(--font-primary);
      font-size: var(--h4-size);
      font-weight: var(--h4-weight);
      line-height: 1.15;
    }

    .path-panels_text {
      color: color-mix(in srgb, var(--text) 72%, transparent);
    }

    .path-panels_more {
      margin-top: auto;
      padding-top: var(--space-1);
      font-weight: 600;
      color: var(--heading-accent);
    }

    .path-panels_link_wrap:focus-visible {
      outline: var(--focus-width) solid var(--color-focus-state);
      outline-offset: var(--focus-offset-outer);
      border-radius: var(--radius-main);
    }

    @media (hover: hover) {
      .path-panels_link_wrap:hover .path-panels_more {
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }
    }
  }
</style>
