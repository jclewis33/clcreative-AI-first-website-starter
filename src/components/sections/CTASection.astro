---
import type { HTMLAttributes } from "astro/types";
import Section from "@/components/ui/Section.astro";
import Layout from "@/components/ui/Layout.astro";
import Visual from "@/components/ui/Visual.astro";
import Overlay from "@/components/ui/Overlay.astro";
import Button from "@/components/ui/Button.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";

import defaultCtaImage from "@/assets/placeholder-images/placeholder-6.webp";

/* Single source for the padding union: Section.astro — never re-declare
   these values locally; the copies this replaced had all drifted. */
type PaddingValue = import("@/components/ui/Section.astro").PaddingSize;

interface Props extends HTMLAttributes<"section"> {
  /**
   * **CTASection props:**
   * - `heading` — Main heading text
   * - `text` — Description text below heading
   * - `buttonText` — CTA button label
   * - `buttonHref` — CTA button link
   * - `image` — Background image (defaults to cta-background.avif)
   * - `overlayStrength` — Overlay darkness (0–100)
   * - `padding` / `paddingTop` / `paddingBottom` — section padding
   */
  docs?: string;

  /** Main heading text. */
  heading?: string;

  /** Description text below heading. */
  text?: string;

  /** CTA button label. @default 'Get Started' */
  buttonText?: string;

  /** CTA button link. @default '/contact' */
  buttonHref?: string;

  /** Optional secondary button label. Renders a second button when provided. */
  secondaryButtonText?: string;

  /** Optional secondary button link. */
  secondaryButtonHref?: string;

  /** Background image source. */
  image?: ImageMetadata | string;

  /** Overlay darkness 0–100. @default 80 */
  overlayStrength?: number;

  /** Section vertical padding. @default 'small' */
  padding?: PaddingValue;
  paddingTop?: PaddingValue;
  paddingBottom?: PaddingValue;
}

const {
  docs,
  heading = "Lorem ipsum dolor sit amet consectetur adipiscing elit sed do.",
  text = "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua ut enim ad minim veniam.",
  buttonText = "Get Started",
  buttonHref = "/contact",
  secondaryButtonText = undefined,
  secondaryButtonHref = undefined,
  image = defaultCtaImage,
  overlayStrength = 80,
  padding = "small",
  paddingTop,
  paddingBottom,
  ...rest
} = Astro.props;

---

<Section
  padding={padding}
  paddingTop={paddingTop}
  paddingBottom={paddingBottom}
  {...rest}
>
  <Layout variant="card">
    <div class="u-display-contents u-theme-dark">
      <Heading data-split-text maxWidth="30ch">{heading}</Heading>
      <Text variant="large" data-fade-in data-delay="0.2">{text}</Text>
      <div data-fade-in data-delay="0.3" class="u-button-wrapper">
        <Button href={buttonHref} ariaLabel={buttonText}>{buttonText}</Button>
        {
          secondaryButtonText && (
            <Button
              variant="secondary"
              href={secondaryButtonHref}
              ariaLabel={secondaryButtonText}
            >
              {secondaryButtonText}
            </Button>
          )
        }
      </div>
    </div>
    <Fragment slot="column2">
      <Visual
        src={image}
        alt="Call to action background"
        variant="background"
      />
      <Overlay strength={overlayStrength} />
    </Fragment>
  </Layout>
</Section>
