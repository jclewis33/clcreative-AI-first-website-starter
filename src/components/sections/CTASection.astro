---
import type { HTMLAttributes } from "astro/types";
import Section from "@/components/ui/Section.astro";
import Layout from "@/components/ui/Layout.astro";
import Visual from "@/components/ui/Visual.astro";
import Overlay from "@/components/ui/Overlay.astro";
import Button from "@/components/ui/Button.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";

import defaultCtaImage from "@/assets/placeholder-images/ai-first-starter-6.webp";
import ButtonWrapper from "@/components/ui/ButtonWrapper.astro";
import CtaButton from "@/components/ui/CtaButton.astro";
import type { SectionCta } from "@/lib/cta";

/* Single source for the padding union: Section.astro — never re-declare
   these values locally; the copies this replaced had all drifted. */
type PaddingValue = import("@/components/ui/Section.astro").PaddingSize;

interface Props extends HTMLAttributes<"section"> {
  /**
   * **CTASection props:**
   * - `heading` — Main heading text (HTML allowed; `<strong>` = accent)
   * - `text` — Description text below heading
   * - `buttonText` — CTA button label
   * - `buttonHref` — CTA button link
   * - `primaryCta` / `secondaryCta` — `SectionCta` buttons (link or pop-up
   *   modal); when set they replace `buttonText`/`buttonHref` and the
   *   secondary pair
   * - `image` — Background image (defaults to cta-background.avif)
   * - `overlayStrength` — Overlay darkness (0–100)
   * - `padding` / `paddingTop` / `paddingBottom` — section padding
   */
  docs?: string;

  /** Main heading text. HTML allowed; wrap accent words in `<strong>`. */
  heading?: string;

  /** Description text below heading. */
  text?: string;

  /** CTA button label. @default 'Get Started' */
  buttonText?: string;

  /** CTA button link. @default '/contact' */
  buttonHref?: string;

  /** Optional secondary button label. Renders a second button when provided. */
  secondaryButtonText?: string;

  /** Optional secondary button link. */
  secondaryButtonHref?: string;

  /**
   * Main button as a `SectionCta` — can open a modal (e.g. the estimate
   * form). Wins over `buttonText`/`buttonHref` when set.
   */
  primaryCta?: SectionCta;

  /** Second button as a `SectionCta`. Wins over the `secondaryButton*` pair. */
  secondaryCta?: SectionCta;

  /** Background image source. */
  image?: ImageMetadata | string;

  /** Overlay darkness 0–100. @default 80 */
  overlayStrength?: number;

  /** Section vertical padding. @default 'small' */
  padding?: PaddingValue;
  paddingTop?: PaddingValue;
  paddingBottom?: PaddingValue;
}

const {
  docs,
  heading = "Lorem ipsum dolor sit amet consectetur adipiscing elit sed do.",
  text = "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua ut enim ad minim veniam.",
  buttonText = "Get Started",
  buttonHref = "/contact",
  secondaryButtonText = undefined,
  secondaryButtonHref = undefined,
  primaryCta,
  secondaryCta,
  image = defaultCtaImage,
  overlayStrength = 80,
  padding = "small",
  paddingTop,
  paddingBottom,
  ...rest
} = Astro.props;
---

<Section
  padding={padding}
  paddingTop={paddingTop}
  paddingBottom={paddingBottom}
  {...rest}
>
  <Layout variant="card">
    <div class="u-display-contents u-theme-dark">
      <Heading data-fade-in maxWidth="30ch" accent>
        <Fragment set:html={heading} />
      </Heading>
      <Text variant="large" data-fade-in data-delay="0.2">{text}</Text>
      <ButtonWrapper data-fade-in data-delay="0.3">
        {
          primaryCta ? (
            <CtaButton cta={primaryCta} />
          ) : (
            <Button href={buttonHref} ariaLabel={buttonText}>
              {buttonText}
            </Button>
          )
        }
        {
          secondaryCta ? (
            <CtaButton cta={secondaryCta} variant="secondary" />
          ) : (
            secondaryButtonText && (
              <Button
                variant="secondary"
                href={secondaryButtonHref}
                ariaLabel={secondaryButtonText}
              >
                {secondaryButtonText}
              </Button>
            )
          )
        }
      </ButtonWrapper>
    </div>
    <Fragment slot="column2">
      <Visual
        src={image}
        alt="Call to action background"
        variant="background"
      />
      <Overlay strength={overlayStrength} />
    </Fragment>
  </Layout>
</Section>
