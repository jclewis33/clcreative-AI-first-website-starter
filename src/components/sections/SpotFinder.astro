---
import type { HTMLAttributes, ComponentProps } from "astro/types";
import Section from "@/components/ui/Section.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import Tab from "@/components/ui/Tab.astro";
import TabButton from "@/components/ui/TabButton.astro";
import TabPanel from "@/components/ui/TabPanel.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";
import CtaButton from "@/components/ui/CtaButton.astro";
import type { SectionCta } from "@/lib/cta";
import BodyFront from "@/assets/figures/body-front.svg";

/** An SVG imported as a component: `import House from "@/assets/figures/house.svg"`. */
type SpotFinderFigure = (props: Record<string, unknown>) => unknown;

/**
 * Areas of the built-in body figure, each with its markers already placed:
 * one on the centre line, or a pair for the left and right side.
 */
type SpotFinderBodyArea =
  | "head"
  | "neck"
  | "shoulders"
  | "upper-back"
  | "lower-back"
  | "elbows-wrists"
  | "hips"
  | "knees"
  | "ankles-feet";

/** A marker on the figure, in percent from its top-left corner. */
type SpotFinderSpot = {
  /** From the figure's left edge, 0 to 100. */
  x: number;
  /** From the figure's top edge, 0 to 100. */
  y: number;
};

/** A labelled list in the panel: "Common causes", "How we help". */
type SpotFinderList = {
  /** The small label over the list. */
  title: string;
  /** The lines, short: "Hours at a desk or on your phone". */
  items: string[];
};

/** A "Learn more" link to a service page. */
type SpotFinderLink = {
  /** Link text: "Massage therapy". */
  label: string;
  /** The page. */
  href: string;
};

type SpotFinderItem = {
  /** The pill's text and the marker's name: "Head & migraines". */
  label: string;
  /** Where its markers sit on the built-in body figure. */
  area?: SpotFinderBodyArea;
  /** Marker positions on a custom `figure` (wins over `area`). */
  spots?: SpotFinderSpot[];
  /** The panel title. @default label */
  title?: string;
  /** One or two sentences: what this usually is. */
  text: string;
  /** One or two labelled lists side by side. */
  lists?: SpotFinderList[];
  /** Links to the services that treat it. */
  links?: SpotFinderLink[];
  /** This area's button. Falls back to the section `cta`. */
  cta?: SectionCta;
};
type SpotFinderTheme = ComponentProps<typeof Section>["theme"];
type PaddingSize = import("@/components/ui/Section.astro").PaddingSize;

interface Props extends HTMLAttributes<"section"> {
  /**
   * **SpotFinder** — "Where does it hurt?": a figure with markers on the
   * places people come in for, the same places as pill tabs, and a panel
   * for the one picked — what usually causes it, how the business helps,
   * links to the services, and the buttons. Tapping a marker and picking a
   * pill do the same thing. Built on `<Tab>`, so the pills are keyboard- and
   * screen-reader-ready; the markers are real buttons.
   *
   * - `items` — `{ label, text, area?, spots?, title?, lists?, links?, cta? }[]`; empty renders nothing
   * - `area` — a place on the built-in body figure (`head`, `neck`,
   *   `shoulders`, `upper-back`, `lower-back`, `elbows-wrists`, `hips`,
   *   `knees`, `ankles-feet`); its markers are already placed
   * - `figure` + `figureLabel` — any other SVG (a house cutaway, a car, a
   *   tooth chart) imported as a component; give each item `spots` in
   *   percent. The SVG should draw in `currentColor`.
   * - `lists` — e.g. `[{ title: "Common causes", items }, { title: "How we help", items }]`
   * - `links` — under `linksLabel` (default "Learn more")
   * - `cta` — the button for every item without its own; `showPhone` adds
   *   the call button beside it (default true)
   * - Below ~928px the figure sits above the panel, smaller; tapping a
   *   marker scrolls the panel into view.
   *
   * @example
   * <SpotFinder heading="Where does it hurt?" cta={bookCta} items={[{ label: "Neck", area: "neck", text: "…", lists: [{ title: "Common causes", items: ["Hours at a desk"] }], links: [{ label: "Chiropractic care", href: "/services/chiropractic" }] }]} />
   */
  docs?: string;

  /** Set to `false` to skip rendering. @default true */
  render?: boolean;

  /** Small label above the heading. */
  eyebrow?: string;

  /** Section heading. @default 'Where does it hurt?' */
  heading?: string;

  /** Intro beside the heading: "Tap an area to see what usually causes it." */
  intro?: string;

  /** The places, one pill and one panel each. Empty renders nothing. */
  items: SpotFinderItem[];

  /** The figure, an SVG imported as a component. @default the built-in body (front) */
  figure?: SpotFinderFigure;

  /** What the figure shows, for screen readers. @default 'Body map' */
  figureLabel?: string;

  /** Label over each panel's links. @default 'Learn more' */
  linksLabel?: string;

  /** Button for every item that has no `cta` of its own. */
  cta?: SectionCta;

  /** Show the click-to-call button beside the item's button. @default true */
  showPhone?: boolean;

  /** Section theme. */
  theme?: SpotFinderTheme;

  /** Section padding (top and bottom). */
  padding?: PaddingSize;

  /** Section id for anchor links. */
  id?: string;

  /** Extra classes on the section. */
  class?: string;
}

const {
  docs,
  render = true,
  eyebrow,
  heading = "Where does it hurt?",
  intro,
  items = [],
  figure,
  figureLabel = "Body map",
  linksLabel = "Learn more",
  cta,
  showPhone = true,
  theme,
  padding,
  id,
  class: className,
  ...rest
} = Astro.props;

/* Marker positions on body-front.svg (percent of its box), measured on a
   grid over the drawing. Pairs are the left and right side. */
const BODY_SPOTS: Record<SpotFinderBodyArea, SpotFinderSpot[]> = {
  head: [{ x: 50, y: 6 }],
  neck: [{ x: 50, y: 15 }],
  shoulders: [
    { x: 17, y: 22 },
    { x: 83, y: 22 },
  ],
  "upper-back": [{ x: 50, y: 27 }],
  "lower-back": [{ x: 50, y: 43 }],
  "elbows-wrists": [
    { x: 11, y: 39 },
    { x: 89, y: 39 },
  ],
  hips: [
    { x: 36, y: 50 },
    { x: 64, y: 50 },
  ],
  knees: [
    { x: 34, y: 72 },
    { x: 66, y: 72 },
  ],
  "ankles-feet": [
    { x: 34, y: 93 },
    { x: 66, y: 93 },
  ],
};

const Figure = figure ?? BodyFront;
const clamp = (n: number) => Math.min(100, Math.max(0, n));
const spotsFor = (item: SpotFinderItem): SpotFinderSpot[] =>
  item.spots?.length
    ? item.spots
    : !figure && item.area
      ? (BODY_SPOTS[item.area] ?? [])
      : [];

if (import.meta.env.DEV && render) {
  if (!Astro.props.items?.length) {
    console.warn("[SpotFinder] `items` is empty or missing; nothing renders.");
  }
  for (const item of items) {
    if (!spotsFor(item).length) {
      console.warn(
        `[SpotFinder] "${item.label}" has no marker: give it ${figure ? "`spots` (a custom figure has no areas)" : "an `area` or `spots`"}. Its pill still works.`,
      );
    }
  }
}
---

{
  render && items.length > 0 && (
    <Section
      theme={theme}
      padding={padding}
      id={id}
      class:list={["spot-finder_wrap", className]}
      data-spot-finder
      {...rest}
    >
      <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} />
      <div class="spot-finder_layout">
        <div class="spot-finder_figure" role="group" aria-label={figureLabel}>
          <Figure class="spot-finder_svg" aria-hidden="true" />
          {items.map((item, index) =>
            spotsFor(item).map((spot, n) => (
              <button
                type="button"
                class:list={["spot-finder_spot", { "is-active": index === 0 }]}
                data-spot-index={index}
                style={`--_x: ${clamp(spot.x)}%; --_y: ${clamp(spot.y)}%`}
                aria-label={n === 0 ? item.label : undefined}
                aria-hidden={n === 0 ? undefined : "true"}
                tabindex={n === 0 ? undefined : -1}
              >
                <span class="spot-finder_spot_dot" />
              </button>
            )),
          )}
        </div>
        <Tab variant="pills" class="spot-finder_tabs">
          {items.map((item) => (
            <TabButton slot="buttons" label={item.label} />
          ))}
          {items.map((item) => {
            const itemCta = item.cta ?? cta;
            const lists = (item.lists ?? []).filter((l) => l.items.length);
            return (
              <TabPanel>
                <div class="spot-finder_panel u-margin-trim">
                  <Heading tag="h3" variant="h4" class="spot-finder_title">
                    {item.title ?? item.label}
                  </Heading>
                  <Text muted class="spot-finder_text">
                    {item.text}
                  </Text>
                  {lists.length > 0 && (
                    <div class="spot-finder_lists">
                      {lists.map((list) => (
                        <div class="spot-finder_group u-margin-trim">
                          <Heading
                            tag="p"
                            variant="eyebrow"
                            class="spot-finder_group_title"
                          >
                            {list.title}
                          </Heading>
                          <ul class="spot-finder_list" role="list">
                            {list.items.map((line) => (
                              <li class="spot-finder_item">{line}</li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  )}
                  {item.links && item.links.length > 0 && (
                    <div class="spot-finder_more u-margin-trim">
                      <Heading
                        tag="p"
                        variant="eyebrow"
                        class="spot-finder_group_title"
                      >
                        {linksLabel}
                      </Heading>
                      <ul class="spot-finder_links" role="list">
                        {item.links.map((link) => (
                          <li class="spot-finder_links_item">
                            <a class="spot-finder_link" href={link.href}>
                              {link.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                  {(itemCta || showPhone) && (
                    <div class="spot-finder_actions">
                      {itemCta && <CtaButton cta={itemCta} />}
                      {showPhone && <CtaButton phone variant="secondary" />}
                    </div>
                  )}
                </div>
              </TabPanel>
            );
          })}
        </Tab>
      </div>
    </Section>
  )
}

<script>
  /* Markers drive the pills: a tap clicks the matching tab button, and the
     tab's aria-selected (set by Tab's own script, whichever way it was
     picked — pill, arrow keys, marker) lights the markers back up. */
  function initSpotFinders() {
    document
      .querySelectorAll<HTMLElement>("[data-spot-finder]")
      .forEach((wrap) => {
        if (wrap.dataset.spotFinderReady) return;
        wrap.dataset.spotFinderReady = "true";

        const tabs = Array.from(
          wrap.querySelectorAll<HTMLButtonElement>(".tab_button_item"),
        );
        const spots = Array.from(
          wrap.querySelectorAll<HTMLButtonElement>(".spot-finder_spot"),
        );
        const panelArea = wrap.querySelector<HTMLElement>(".spot-finder_tabs");
        if (!tabs.length) return;

        const sync = () => {
          const active = tabs.findIndex(
            (tab) => tab.getAttribute("aria-selected") === "true",
          );
          if (active < 0) return;
          spots.forEach((spot) =>
            spot.classList.toggle(
              "is-active",
              Number(spot.dataset.spotIndex) === active,
            ),
          );
        };

        spots.forEach((spot) => {
          spot.addEventListener("click", () => {
            tabs[Number(spot.dataset.spotIndex)]?.click();
            /* Stacked, the panel sits under the figure: bring it up when
               it starts low on the screen. */
            if (!panelArea) return;
            const top = panelArea.getBoundingClientRect().top;
            if (top > window.innerHeight * 0.6) {
              const reduce = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
              ).matches;
              panelArea.scrollIntoView({
                behavior: reduce ? "auto" : "smooth",
                block: "start",
              });
            }
          });
        });

        const observer = new MutationObserver(sync);
        tabs.forEach((tab) =>
          observer.observe(tab, {
            attributes: true,
            attributeFilter: ["aria-selected"],
          }),
        );
        sync();
      });
  }

  initSpotFinders();
  document.addEventListener("astro:page-load", initSpotFinders);
</script>

<style is:global>
  @layer components {
    /* ── Figure beside the panel; stacked (figure first) below ~928px ── */
    .spot-finder_layout {
      display: var(--flex-medium, grid);
      flex-direction: column;
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: start;
      gap: var(--space-8);
    }

    /* The panel's height changes with each place; pinned to the top, the
       pills never move under the pointer. */
    .spot-finder_tabs {
      padding-top: var(--space-6);
    }

    @container (width < 58em) {
      .spot-finder_tabs {
        padding-top: 0;
      }
    }

    /* The box the markers are placed in: exactly the SVG's box. */
    .spot-finder_figure {
      position: relative;
      justify-self: center;
      width: min(100%, 16rem);
      color: var(--heading-accent);
    }

    @container (width < 58em) {
      .spot-finder_figure {
        width: min(60%, 11rem);
        align-self: center;
      }
    }

    .spot-finder_svg {
      display: block;
      width: 100%;
      height: auto;
    }

    /* ── Markers: a dot in a ring; the picked one gets a soft halo ── */
    .spot-finder_spot {
      --_size: 2em;
      position: absolute;
      left: var(--_x);
      top: var(--_y);
      display: grid;
      place-items: center;
      width: var(--_size);
      aspect-ratio: 1;
      padding: 0;
      border: 0;
      border-radius: var(--radius-full);
      background: transparent;
      translate: -50% -50%;
      cursor: pointer;
    }

    .spot-finder_spot_dot {
      width: 0.875em;
      aspect-ratio: 1;
      border: 0.18em solid var(--background);
      border-radius: var(--radius-full);
      background-color: var(--heading-accent);
      box-shadow: 0 0 0 0.12em color-mix(in srgb, var(--text) 25%, transparent);
      transition: scale 0.2s ease;
    }

    .spot-finder_spot.is-active {
      background-color: color-mix(in srgb, var(--background) 30%, transparent);
      box-shadow: 0 0 0 0.6em
        color-mix(in srgb, var(--background) 18%, transparent);
    }

    .spot-finder_spot.is-active .spot-finder_spot_dot {
      scale: 1.25;
    }

    .spot-finder_spot:focus-visible {
      outline: var(--focus-width) solid var(--color-focus-state);
      outline-offset: var(--focus-offset-outer);
    }

    @media (hover: hover) {
      .spot-finder_spot:hover .spot-finder_spot_dot {
        scale: 1.3;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .spot-finder_spot_dot {
        transition: none;
      }
    }

    /* ── The pills wrap as separate chips (nine places don't fit one
       track); the picked one is filled. Scoped through the variant
       attribute to outrank Tab's own pill-track rules. ── */
    .spot-finder_tabs[data-tab-variant] .tab_button_list {
      flex-wrap: wrap;
      gap: var(--space-2);
      overflow: visible;
      padding: 0;
      border-radius: 0;
      background-color: transparent;
    }

    .spot-finder_tabs[data-tab-variant] .tab_button_item {
      padding: var(--space-2) var(--space-4);
      border: var(--border-width-main) solid var(--border);
      background-color: var(--background-2);
    }

    .spot-finder_tabs[data-tab-variant] .tab_button_item.is-active {
      border-color: var(--text);
      background-color: var(--text);
      color: var(--background);
      box-shadow: none;
    }

    /* ── The panel: a card under the pills ── */

    .spot-finder_tabs .tab_content_list {
      padding: var(--space-6);
      border: var(--border-width-main) solid var(--border);
      border-radius: var(--radius-main);
      background-color: var(--background-2);
    }

    .spot-finder_lists {
      display: var(--flex-small, grid);
      flex-direction: column;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5) var(--space-6);
      margin-top: var(--space-5);
      margin-bottom: var(--space-5);
    }

    .spot-finder_group_title {
      margin-bottom: var(--space-3);
    }

    .spot-finder_list {
      margin: 0;
      padding-left: 1.1em;
      list-style: disc;
    }

    .spot-finder_item {
      margin-bottom: var(--space-2);
      opacity: 0.75;
    }

    .spot-finder_item::marker {
      color: var(--heading-accent);
    }

    .spot-finder_more {
      margin-bottom: var(--space-6);
    }

    .spot-finder_links {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-5);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .spot-finder_link {
      color: var(--text);
      font-weight: 600;
      text-decoration: underline;
      text-decoration-color: var(--heading-accent);
      text-decoration-thickness: 0.125em;
      text-underline-offset: 0.3em;
    }

    @media (hover: hover) {
      .spot-finder_link:hover {
        text-decoration-color: currentColor;
      }
    }

    .spot-finder_actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3);
    }
  }
</style>
