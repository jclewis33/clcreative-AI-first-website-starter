---
import type { HTMLAttributes } from "astro/types";
/**
 * FAQ — two-column layout with heading left, accordion right.
 *
 * Questions come from `src/data/faqs.ts` — a plain TypeScript file, not the
 * CMS. Add or edit them there; nothing else needs touching.
 *
 * Pass `items` to control which questions appear. Defaults to `generalFaqs`.
 *
 * @example Default (generalFaqs)
 * ```astro
 * <FAQ />
 * ```
 *
 * @example A page-specific set
 * ```astro
 * // add `export const webDesignFaqs: FAQItem[] = [...]` to src/data/faqs.ts
 * import { webDesignFaqs, generalFaqs } from "@/data/faqs";
 * <FAQ items={[...webDesignFaqs, ...generalFaqs]} />
 * ```
 */

import Section from "@/components/ui/Section.astro";
import Layout from "@/components/ui/Layout.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";
import Accordion from "@/components/ui/Accordion.astro";
import AccordionItem from "@/components/ui/AccordionItem.astro";

import type { FAQItem } from "@/data/faqs";
import { generalFaqs } from "@/data/faqs";

/* Single source for the padding union: Section.astro — never re-declare
   these values locally; the copies this replaced had all drifted. */
type PaddingValue = import("@/components/ui/Section.astro").PaddingSize;
type FAQLayout =
  /** The heading on the left, the questions on the right */
  | "columns"
  /** The heading over the questions, in one narrow centred column */
  | "stacked";

interface Props extends HTMLAttributes<"section"> {
  /**
   * **FAQ props:**
   * - `items` — array of `{ question, answer }` objects (default: general FAQs). Answers support inline HTML (`<br><br>`, `<strong>`, etc.)
   * - `eyebrow` — optional small label rendered above the heading
   * - `heading` — section heading (default: "Frequently Asked Questions")
   * - `openByDefault` — 1-based index of item to open on load, `0` = all closed (default: `0`)
   * - `layout` — `columns` (default) or `stacked` (heading over the
   *   questions, one narrow column)
   * - `theme` — 'light' | 'dark' | 'brand'
   * - `padding` / `paddingTop` / `paddingBottom` — section padding
   * - `id` — section id for anchor links (default: "faq")
   * - `class` — extra classes
   * - Also accepts any HTML attribute (`style`, `data-*`, `aria-*`, etc.) — forwarded to Section
   */
  docs?: string;

  items?: FAQItem[];
  eyebrow?: string;
  heading?: string;

  /**
   * 1-based index of the accordion item to open by default on load.
   * `0` means all items start closed.
   * @default 0
   * @example openByDefault={1}
   */
  openByDefault?: number;

  /** `columns` (heading beside) or `stacked` (heading over, narrow). @default 'columns' */
  layout?: FAQLayout;
  theme?: "light" | "dark" | "brand";
  padding?: PaddingValue;
  paddingTop?: PaddingValue;
  paddingBottom?: PaddingValue;
  id?: string;
  class?: string;
}

const {
  docs,
  items = [...generalFaqs],
  eyebrow,
  heading = "Frequently Asked Questions",
  openByDefault = 0,
  layout = "columns",
  theme,
  padding,
  paddingTop = padding,
  paddingBottom = padding,
  id = "faq",
  class: className,
  ...rest
} = Astro.props;
import { linkPhones } from "@/lib/phone-links";
---

<Section
  theme={theme}
  paddingTop={paddingTop}
  paddingBottom={paddingBottom}
  id={id}
  class={className}
  {...rest}
>
  <Layout
    ratio={layout === "stacked" ? undefined : "6-7"}
    verticalAlign="start"
    variant={layout === "stacked" ? "stack" : "columns"}
    class:list={[layout === "stacked" && "faq_stack"]}
  >
    {
      eyebrow && (
        <Heading variant="eyebrow" data-prevent-flicker="true" data-fade-in>
          {eyebrow}
        </Heading>
      )
    }
    <Heading data-fade-in data-prevent-flicker="true">{heading}</Heading>

    {
      layout === "stacked" && (
        <div class="faq_list">
          <Accordion openByDefault={openByDefault} closePrevious>
            {items.map((faq) => (
              <AccordionItem data-fade-in question={faq.question}>
                <Text>
                  <Fragment set:html={linkPhones(faq.answer)} />
                </Text>
              </AccordionItem>
            ))}
          </Accordion>
        </div>
      )
    }
    {
      layout !== "stacked" && (
        <div slot="column2">
          <Accordion openByDefault={openByDefault} closePrevious>
            {items.map((faq) => (
              <AccordionItem data-fade-in question={faq.question}>
                <Text>
                  <Fragment set:html={linkPhones(faq.answer)} />
                </Text>
              </AccordionItem>
            ))}
          </Accordion>
        </div>
      )
    }
  </Layout>
</Section>

<style is:global>
  @layer components {
    /* layout="stacked": one narrow column, centred in the container. */
    .faq_stack {
      width: 100%;
      max-width: 55rem;
      margin-inline: auto;
    }
  }
</style>
