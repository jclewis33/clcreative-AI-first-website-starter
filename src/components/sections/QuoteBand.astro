---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import Section from "@/components/ui/Section.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";
import Visual from "@/components/ui/Visual.astro";
import Overlay from "@/components/ui/Overlay.astro";
import CtaButton from "@/components/ui/CtaButton.astro";
import type { SectionCta } from "@/lib/cta";
import { SITE } from "@/config/site";

type QuoteBandStep = {
  /** What happens: "We review your project details and photos." */
  text: string;
};

interface Props extends HTMLAttributes<"section"> {
  /**
   * **QuoteBand** — the closing call to action on a darkened photo: the
   * heading and a line on the left; on the right the main button, a second
   * button for another kind of buyer ("Contractor? Send a bid
   * invitation") and the phone as a text link. Under them, optionally,
   * "What happens when you reach out" as numbered steps — the page answers
   * what happens next before anyone asks.
   *
   * Only steps the business really follows, in its words.
   *
   * @example
   * <QuoteBand heading="Tell us about your project." text="A few questions…" image={deck} imageAlt="A coated rooftop deck" cta={{ label: "Start your quote", modal: "estimate-modal" }} secondaryCta={{ label: "Contractor? Send a bid invitation", href: "/commercial#bid" }} steps={[{ text: "We review your project." }]} />
   */
  docs?: string;

  /** Set to `false` to skip rendering. @default true */
  render?: boolean;

  /** The heading. HTML allowed (`<strong>` = accent). */
  heading: string;

  /** The line under it. */
  text?: string;

  /** The background photo (darkened). */
  image?: ImageMetadata | string;

  /** Alt text for the photo. */
  imageAlt?: string;

  /** The main button. */
  cta?: SectionCta;

  /** The second button (outline). */
  secondaryCta?: SectionCta;

  /** "Or call us at …" under the buttons. @default true */
  showPhone?: boolean;

  /** What happens after they reach out, in order. */
  steps?: QuoteBandStep[];

  /** The label over the steps. @default 'What happens when you reach out' */
  stepsLabel?: string;

  /** Section id for anchor links. */
  id?: string;

  /** Extra classes on the section. */
  class?: string;
}

const {
  docs,
  render = true,
  heading,
  text,
  image,
  imageAlt = "",
  cta,
  secondaryCta,
  showPhone = true,
  steps = [],
  stepsLabel = "What happens when you reach out",
  id,
  class: className,
  ...rest
} = Astro.props;
---

{
  render && heading && (
    <Section
      theme="dark"
      padding="large"
      id={id}
      class:list={["quote-band_wrap", className]}
      {...rest}
    >
      {image && (
        <Fragment slot="background">
          <Visual src={image} alt={imageAlt} variant="background" />
          <Overlay strength={82} />
        </Fragment>
      )}
      <div class="quote-band_layout">
        <div class="quote-band_text u-margin-trim">
          <Heading tag="h2" variant="h1" marginBottom={5}>
            <Fragment set:html={heading} />
          </Heading>
          {text && <Text variant="large">{text}</Text>}
        </div>
        <div class="quote-band_actions">
          {cta && <CtaButton cta={cta} size="large" fullWidth />}
          {secondaryCta && (
            <CtaButton
              cta={secondaryCta}
              variant="secondary"
              size="large"
              fullWidth
            />
          )}
          {showPhone && (
            <a class="quote-band_phone" href={`tel:${SITE.phone.tel}`}>
              Or call us at {SITE.phone.display}
            </a>
          )}
        </div>
      </div>
      {steps.length > 0 && (
        <div class="quote-band_steps_wrap">
          <Heading variant="eyebrow" tag="h3">
            {stepsLabel}
          </Heading>
          <ol class="quote-band_steps">
            {steps.map((step, i) => (
              <li class="quote-band_step">
                <span class="quote-band_step_number" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span>{step.text}</span>
              </li>
            ))}
          </ol>
        </div>
      )}
    </Section>
  )
}

<style is:global>
  @layer components {
    .quote-band_layout {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-7);
    }

    .quote-band_text {
      flex: 1 1 26rem;
      max-width: 40rem;
    }

    .quote-band_actions {
      flex: 0 1 20rem;
      display: grid;
      gap: var(--space-3);
    }

    .quote-band_phone {
      padding: var(--space-2) 0;
      text-align: center;
      color: color-mix(in srgb, var(--text) 85%, transparent);
      text-decoration: none;
    }

    .quote-band_steps_wrap {
      display: grid;
      gap: var(--space-4);
    }

    .quote-band_steps {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
      gap: var(--space-5) var(--space-7);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .quote-band_step {
      display: flex;
      gap: var(--space-4);
      padding-top: var(--space-4);
      border-top: var(--border-width-main) solid var(--border);
      color: color-mix(in srgb, var(--text) 88%, transparent);
    }

    .quote-band_step_number {
      flex-shrink: 0;
      font-family: var(--font-primary);
      font-size: var(--h6-size);
      line-height: 1.2;
      color: var(--heading-accent);
    }

    @media (hover: hover) {
      .quote-band_phone:hover {
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }
    }
  }
</style>
