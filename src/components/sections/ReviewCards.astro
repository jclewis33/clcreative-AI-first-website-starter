---
import type { HTMLAttributes, ComponentProps } from "astro/types";
import Section from "@/components/ui/Section.astro";
import Heading from "@/components/ui/Heading.astro";

type ReviewCard = {
  /** The review text (an excerpt is fine). */
  text: string;
  /** The reviewer's name as shown on the platform. */
  name: string;
  /** "Google review · Polished concrete". */
  meta?: string;
  /** 4 or 5. @default 5 */
  rating?: number;
};
type ReviewCardsTheme = ComponentProps<typeof Section>["theme"];

interface Props extends HTMLAttributes<"section"> {
  /**
   * **ReviewCards** — reviews as the cards people know from Google: an
   * initial in a circle, the name and where the review is from, the stars,
   * the words. A heading with a star line ("78 five-star reviews on
   * Google") on the left, a link to all reviews on the right, three cards
   * under them.
   *
   * One review sits at a readable width instead of running the full page;
   * three across is the usual row.
   *
   * Real, attributed reviews only.
   *
   * - `reviews` — `{ text, name, meta?, rating? }[]`; the first `limit` show
   * - `summary` — the star line under the heading
   * - `link` — `{ label, href }`, e.g. "Read all our Google reviews"
   *
   * @example
   * <ReviewCards heading="What our customers say" summary="78 five-star reviews on Google" reviews={reviews} link={{ label: "Read all our Google reviews", href: "/reviews" }} />
   */
  docs?: string;

  /** Set to `false` to skip rendering. @default true */
  render?: boolean;

  /** The heading. @default 'What our customers say' */
  heading?: string;

  /** The star line under the heading ("78 five-star reviews on Google"). */
  summary?: string;

  /** The reviews. Empty renders nothing. */
  reviews: ReviewCard[];

  /** How many cards show. @default 3 */
  limit?: number;

  /** A link to all reviews, top right. */
  link?: { label: string; href: string };

  /** Section theme. */
  theme?: ReviewCardsTheme;

  /** Section id for anchor links. */
  id?: string;

  /** Extra classes on the section. */
  class?: string;
}

const {
  docs,
  render = true,
  heading = "What our customers say",
  summary,
  reviews = [],
  limit = 3,
  link,
  theme,
  id,
  class: className,
  ...rest
} = Astro.props;

const shown = reviews.slice(0, Math.max(1, limit));
const single = shown.length === 1;
const stars = (n = 5) => Math.min(5, Math.max(0, Math.round(n)));
/* The avatar tint: one of three, from the name, so a row of cards varies. */
const tint = (name: string) =>
  [...name].reduce((sum, c) => sum + c.charCodeAt(0), 0) % 3;

if (import.meta.env.DEV && render && !Astro.props.reviews?.length) {
  console.warn("[ReviewCards] `reviews` is empty or missing; nothing renders.");
}
---

{
  render && shown.length > 0 && (
    <Section
      theme={theme}
      id={id}
      class:list={["review-cards_wrap", single && "is-single", className]}
      {...rest}
    >
      <div class="review-cards_layout">
        <div class="review-cards_header">
          <div class="review-cards_heading u-margin-trim">
            <Heading tag="h2" variant="h2" marginBottom={4}>
              {heading}
            </Heading>
            {summary && (
              <p class="review-cards_summary">
                <span
                  class="review-cards_stars is-large"
                  role="img"
                  aria-label="5 out of 5 stars"
                >
                  {Array.from({ length: 5 }, () => (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 2l3 6.6 7 .8-5.2 4.8 1.5 7L12 17.6 5.7 21.2l1.5-7L2 9.4l7-.8z" />
                    </svg>
                  ))}
                </span>
                <span>{summary}</span>
              </p>
            )}
          </div>
          {link && (
            <a class="review-cards_link" href={link.href}>
              {link.label} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
        <ul class="review-cards_list">
          {shown.map((review) => (
            <li class="review-cards_card">
              <figure class="review-cards_figure">
                <figcaption class="review-cards_who">
                  <span
                    class="review-cards_avatar"
                    data-tint={String(tint(review.name))}
                    aria-hidden="true"
                  >
                    {review.name.trim().charAt(0).toUpperCase()}
                  </span>
                  <span class="review-cards_name_wrap">
                    <span class="review-cards_name">{review.name}</span>
                    {review.meta && (
                      <span class="review-cards_meta">{review.meta}</span>
                    )}
                  </span>
                </figcaption>
                <span
                  class="review-cards_stars"
                  role="img"
                  aria-label={`${stars(review.rating)} out of 5 stars`}
                >
                  {Array.from({ length: stars(review.rating) }, () => (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 2l3 6.6 7 .8-5.2 4.8 1.5 7L12 17.6 5.7 21.2l1.5-7L2 9.4l7-.8z" />
                    </svg>
                  ))}
                </span>
                <blockquote class="review-cards_text">{review.text}</blockquote>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </Section>
  )
}

<style is:global>
  @layer components {
    .review-cards_layout {
      display: grid;
      gap: var(--space-7);
    }

    .review-cards_header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-end;
      gap: var(--space-4) var(--space-7);
    }

    .review-cards_summary {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3);
      margin: 0;
      font-weight: 600;
    }

    .review-cards_link {
      font-weight: 600;
      color: var(--heading-accent);
      text-decoration: none;
    }

    .review-cards_list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
      gap: var(--space-5);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .review-cards_card {
      display: flex;
      padding: var(--space-5);
      border: var(--border-width-main) solid var(--border);
      border-radius: 0.75rem;
      background-color: var(--color-light-100);
      color: var(--color-dark-900);
      box-shadow: 0 0.125rem 0.5rem
        color-mix(in srgb, var(--color-dark-900) 6%, transparent);
    }

    .review-cards_figure {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      margin: 0;
    }

    .review-cards_who {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .review-cards_avatar {
      flex-shrink: 0;
      display: grid;
      place-items: center;
      width: 2.75rem;
      aspect-ratio: 1 / 1;
      border-radius: var(--radius-full);
      background-color: var(--color-brand-700);
      color: var(--color-light-100);
      font-weight: 600;
      font-size: 1.125rem;
    }

    .review-cards_avatar[data-tint="1"] {
      background-color: var(--color-dark-800);
    }

    .review-cards_avatar[data-tint="2"] {
      background-color: color-mix(
        in oklab,
        var(--color-brand-500) 45%,
        var(--color-dark-800)
      );
    }

    .review-cards_name_wrap {
      display: grid;
      line-height: 1.3;
    }

    .review-cards_name {
      font-weight: 600;
    }

    .review-cards_meta {
      font-size: var(--text-tiny-size);
      color: color-mix(in srgb, var(--color-dark-900) 70%, transparent);
    }

    .review-cards_stars {
      display: inline-flex;
      gap: 0.15em;
      color: var(--rating-star);
      font-size: 1.125rem;
    }

    .review-cards_stars.is-large {
      font-size: 1.375rem;
    }

    .review-cards_stars svg {
      flex-shrink: 0;
      width: 1em;
      aspect-ratio: 1 / 1;
      fill: currentColor;
    }

    .review-cards_text {
      margin: 0;
      line-height: 1.6;
    }

    /* One review: the card at a readable width, not the full page. */
    .review-cards_wrap.is-single .review-cards_list {
      grid-template-columns: minmax(0, 1fr);
      max-width: 48rem;
    }

    @media (hover: hover) {
      .review-cards_link:hover {
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }
    }
  }
</style>
