---
import type { HTMLAttributes, ComponentProps } from "astro/types";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import Section from "@/components/ui/Section.astro";
import Layout from "@/components/ui/Layout.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";
import Visual from "@/components/ui/Visual.astro";
import Overlay from "@/components/ui/Overlay.astro";
import ButtonWrapper from "@/components/ui/ButtonWrapper.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import CtaButton from "@/components/ui/CtaButton.astro";
import CtaPanel from "@/components/ui/CtaPanel.astro";
import TrustBadges from "@/components/ui/TrustBadges.astro";
import LeadForm from "@/components/form/LeadForm.astro";
import type { FormId } from "@/config/forms";
import type { SectionCta } from "@/lib/cta";
import { SITE } from "@/config/site";

type HeroVariant =
  /** Photo fills the section behind the text, with a dark overlay */
  | "background"
  /** Text on the left, photo on the right */
  | "split"
  /** Text only — no photo */
  | "text"
  /** Everything centred, with a wide photo underneath */
  | "centered";
type HeroTheme = ComponentProps<typeof Section>["theme"];
type PaddingSize = import("@/components/ui/Section.astro").PaddingSize;
type HeroPhoneVariant = "secondary" | "primary";
type HeroSecondaryVariant =
  /** A text link with an arrow */
  | "text"
  /** An outline button beside the main one */
  | "secondary";
type HeroCrumb = { label: string; href?: string };
type HeroProof = { rating?: number; text: string };
type HeroBadge = { value: string; label: string };
type HeroFocus = { x: number; y: number };
type HeroImageFit =
  /** A photo filling its rounded box (cropped to fit) */
  | "cover"
  /** A transparent cut-out (a mascot, a person): no box, whole and anchored to the bottom, its bottom edge fading out */
  | "cutout";
type HeroOverlay =
  /** Darkens toward the bottom, evenly across (any photo) */
  | "bottom"
  /** The photo sits on the right, its left edge melting into the background behind the text; a full, evenly tinted photo on phones */
  | "side"
  /** The photo fills the hero, darkest behind the text on the left and lightest on the right */
  | "full";
type HeroCtaStyle =
  /** The buttons in a row: main, phone, then the optional third */
  | "buttons"
  /** The main button, "or", and "Call or text us" + the number on one tinted panel */
  | "panel"
  /** The estimate form itself on a card beside the text (needs `form`), the phone button under the text */
  | "form";
type HeroForm = {
  /** Which entry in src/config/forms.ts it submits as. */
  formId: FormId;
  /** @default 'Request a free estimate' */
  heading?: string;
  text?: string;
  /** @default 'What can we help with?' */
  messageLabel?: string;
  /** @default 'Get my free estimate' */
  submitLabel?: string;
  /**
   * With choices, a two-step form: one tap on a tile (the project), then
   * the contact fields. Without, the contact fields straight away.
   */
  projectOptions?: { label: string; value: string }[];
  /** The step-1 question over the tiles. @default 'What can we help with?' */
  stepQuestion?: string;
  /** Just Name, Phone and an optional note (LeadForm `compact`). @default true */
  compact?: boolean;
};
type HeroProofPosition =
  /** Under the buttons */
  | "below"
  /** A pill above the headline: proof before the pitch */
  | "above";
type HeroTrust = { label: string; image?: ImageMetadata | string };
type HeroHeadingSize =
  /** The display size — a big, punchy headline */
  | "display"
  /** The h1 size — calmer, for a photo-led (showcase) hero */
  | "h1";

interface Props extends HTMLAttributes<"section"> {
  /**
   * **Hero** — the first section of a local-service page.
   *
   * - `variant` — `'background'` (photo behind the text), `'split'` (photo
   *   on the right, as tall as the text beside it; square once the columns
   *   stack — set `imagePosition` to keep faces in both crops), `'text'`
   *   (no photo) or `'centered'` (everything
   *   centred, a wide photo underneath). Defaults to `'background'` when
   *   an `image` is given, else `'text'`.
   * - `heading` — the H1; HTML allowed, `<strong>` marks the accent words
   * - `primaryCta`, `secondaryCta` — `SectionCta` buttons (link or pop-up)
   * - `showPhone` — the `SITE.phone` call button (default `true`)
   * - `breadcrumbs` — trail in its own row at the top of the hero, just under
   *   the nav (top padding drops to xsmall). Also pass it to BaseLayout's
   *   `breadcrumbs` prop so the schema matches)
   * - `proof` — a trust line, with optional star rating
   * - `badge` — a small card, e.g. `{ value: "Since 2009", label: "Family owned" }`.
   *   Defaults to "Since {SITE.founded}" when `SITE.founded` is set; pass
   *   `false` to hide it
   * - `ctaStyle` — `'panel'` puts the main button and the phone on one tinted
   *   panel ("Get a quote | or | Call or text us"), with `ctaNote` under
   *   the button
   * - `trust` — credential badges under the buttons (TrustBadges)
   * - Wrap an offer in `<mark>` in `heading` for a highlighter accent,
   *   e.g. `Call today for <mark>$100 off</mark>`
   *
   * Renders nothing (with a dev warning) without a `heading`.
   *
   * @example
   * <Hero
   *   eyebrow="Kitchen and bath remodeling"
   *   heading="Remodels done <strong>right</strong>, on schedule"
   *   text="One local crew from design to the final walkthrough."
   *   image={heroPhoto}
   *   imageAlt="A finished kitchen with a large island"
   *   primaryCta={{ label: "Get an estimate", modal: "estimate-modal" }}
   * />
   */
  docs?: string;

  /** Set to `false` to skip rendering. @default true */
  render?: boolean;

  /** Small label above the heading. */
  eyebrow?: string;

  /** The H1. HTML allowed; wrap accent words in `<strong>`. Required. */
  heading: string;

  /** Supporting paragraph under the heading. */
  text?: string;

  /** Hero photo (imported image or URL). Needed for `background` and `split`. */
  image?: ImageMetadata | string;

  /** Alt text for the photo. */
  imageAlt?: string;

  /** Focal point of the photo, as percentages. */
  imagePosition?: HeroFocus;

  /**
   * Split only: `'cover'` (a photo filling its box) or `'cutout'` (a
   * transparent PNG shown whole with no box, sitting on the hero's
   * background, its bottom edge fading out). @default 'cover'
   */
  imageFit?: HeroImageFit;

  /**
   * Cutout only: a texture behind the subject (diamond plate, brick, wood
   * grain), drawn faint and fading out toward the text so the cut-out
   * stands in a space instead of floating on a flat colour. The cut-out
   * always gets a soft glow behind it; this adds the texture.
   */
  imageBackdrop?: ImageMetadata | string;

  /**
   * Background only: how the photo meets the text. `'side'` sets the photo
   * on the right with its left edge fading into the background, so a
   * subject there (a truck, a team) stays bright and the text sits on
   * plain colour. `'full'` keeps the whole photo, darkest behind the text
   * on the left and lightest on the right.
   * @default 'bottom'
   */
  overlay?: HeroOverlay;

  /**
   * Background only: fill most of the screen. `false` for a short hero on
   * an inner page (contact). @default true
   */
  minHeight?: boolean;

  /** Layout. @default 'background' with an image, else 'text' */
  variant?: HeroVariant;

  /**
   * How the buttons show. `'panel'` = the main button, "or", and the phone
   * on one panel (needs `primaryCta`). `'form'` = the estimate form on a
   * card beside the text (needs `form`). @default 'buttons'
   */
  ctaStyle?: HeroCtaStyle;

  /** Small line under the main button in the panel, e.g. "And claim $100 off". */
  ctaNote?: string;

  /**
   * `ctaStyle="form"` only: the form on the card beside the text. Takes the
   * photo's place in `split`; over a `background` photo it sits on the right.
   */
  form?: HeroForm;

  /** Headline size: `'display'` (big) or `'h1'` (calmer, photo-led). @default 'display' */
  headingSize?: HeroHeadingSize;

  /** Main button — links, or opens a modal (e.g. the estimate form). */
  primaryCta?: SectionCta;

  /** Show the `SITE.phone` call button. @default true */
  showPhone?: boolean;

  /**
   * The phone button's style: the outlined `secondary` beside a primary
   * CTA, or `primary` (brand fill) when it's the hero's only button.
   * @default 'secondary'
   */
  phoneVariant?: HeroPhoneVariant;

  /** Optional third button. */
  secondaryCta?: SectionCta;

  /** How `secondaryCta` looks: a text link with an arrow, or an outline button. @default 'text' */
  secondaryVariant?: HeroSecondaryVariant;

  /** Breadcrumb trail above the eyebrow (service and detail pages). */
  breadcrumbs?: HeroCrumb[];

  /** Trust line under the buttons. `rating` adds that many of 5 stars. */
  proof?: HeroProof;

  /** Where `proof` sits: `'below'` the buttons, or `'above'` the headline as a pill. @default 'below' */
  proofPosition?: HeroProofPosition;

  /** Credential badges under the buttons — only ones the business holds. */
  trust?: HeroTrust[];

  /**
   * Small card, e.g. "Since 2009 / Family owned". Defaults to
   * "Since {SITE.founded}" when that is set; `false` hides it.
   */
  badge?: HeroBadge | false;

  /** Section theme. @default 'dark' for background, else inherit */
  theme?: HeroTheme;

  /** Section padding (top and bottom). */
  padding?: PaddingSize;

  /** Section top padding. */
  paddingTop?: PaddingSize;

  /** Section bottom padding. */
  paddingBottom?: PaddingSize;

  /** Section id for anchor links. */
  id?: string;

  /** Extra classes on the section. */
  class?: string;
}

const {
  docs,
  render = true,
  eyebrow,
  heading,
  text,
  image,
  imageAlt,
  imagePosition,
  imageFit = "cover",
  imageBackdrop,
  overlay = "bottom",
  minHeight: minHeightProp = true,
  variant: variantProp,
  ctaStyle = "buttons",
  ctaNote,
  form,
  headingSize = "display",
  primaryCta,
  showPhone = true,
  phoneVariant = "secondary",
  secondaryCta,
  secondaryVariant = "text",
  breadcrumbs,
  proof,
  proofPosition = "below",
  trust,
  badge: badgeProp,
  theme: themeProp,
  padding,
  paddingTop: paddingTopProp,
  paddingBottom = padding,
  id,
  class: className,
  ...rest
} = Astro.props;

/* With breadcrumbs the trail sits in its own row right under the nav, so
   the top padding drops to xsmall and the section's gap spaces the trail
   from the content; otherwise the usual padding. */
const paddingTop =
  paddingTopProp ?? padding ?? (breadcrumbs?.length ? "xsmall" : undefined);

/* SITE.founded supplies a default "Since …" badge; a page can override or
   pass `badge={false}` to hide it. */
const badge: HeroBadge | undefined =
  badgeProp === false
    ? undefined
    : (badgeProp ??
      (SITE.founded
        ? { value: `Since ${SITE.founded}`, label: SITE.name }
        : undefined));

const variant: HeroVariant = variantProp ?? (image ? "background" : "text");
const theme: HeroTheme =
  themeProp ?? (variant === "background" ? "dark" : undefined);
const hasPhoto = variant !== "text" && Boolean(image);
/* Never alt="" (CLAUDE.md): fall back to the heading's plain text. */
const photoAlt = imageAlt || heading?.replace(/<[^>]+>/g, "") || "";
const stars = proof?.rating
  ? Math.max(0, Math.min(5, Math.round(proof.rating)))
  : 0;

if (import.meta.env.DEV && render) {
  if (!heading) console.warn("[Hero] `heading` is required; nothing renders.");
  if (
    variantProp &&
    !["background", "split", "text", "centered"].includes(variantProp)
  )
    console.warn(`[Hero] Unknown variant "${variantProp}".`);
  if (variant !== "text" && !image)
    console.warn(
      `[Hero] variant "${variant}" needs an \`image\`; showing text only.`,
    );
  if (image && !imageAlt)
    console.warn("[Hero] Give the photo real alt text (`imageAlt`).");
  if (ctaStyle === "panel" && !primaryCta)
    console.warn(
      '[Hero] ctaStyle="panel" needs a `primaryCta`; showing buttons.',
    );
}
const panel = ctaStyle === "panel" && Boolean(primaryCta);
if (import.meta.env.DEV && render && ctaStyle === "form" && !form)
  console.warn('[Hero] ctaStyle="form" needs `form`; showing buttons.');
/* The form card takes the second column; the text column keeps only the
   phone button (the form is the main call to action). */
const formCard = ctaStyle === "form" && form ? form : undefined;
const proofPill = proofPosition === "above";
/* The cut-out's texture is decoration, so it's a CSS background (no img,
   no alt), resized once here. */
const backdropUrl =
  variant === "split" && hasPhoto && imageFit === "cutout" && imageBackdrop
    ? typeof imageBackdrop === "string"
      ? imageBackdrop
      : (await getImage({ src: imageBackdrop, width: 1600, format: "webp" }))
          .src
    : undefined;
---

{
  render && heading && (
    <Section
      theme={theme}
      minHeight={
        minHeightProp && variant === "background" && hasPhoto && !formCard
      }
      paddingTop={paddingTop}
      paddingBottom={paddingBottom}
      id={id}
      class:list={[
        "hero_wrap",
        `is-${hasPhoto ? variant : "text"}`,
        { "is-form": Boolean(formCard) },
        {
          "is-side": hasPhoto && variant === "background" && overlay === "side",
        },
        className,
      ]}
      {...rest}
    >
      {variant === "background" && hasPhoto && overlay === "bottom" && (
        <Fragment slot="background">
          <Visual
            src={image!}
            alt={photoAlt}
            variant="background"
            position={imagePosition}
            priority
          />
          <Overlay variant="gradient" strengthTop={55} strengthBottom={80} />
        </Fragment>
      )}
      {variant === "background" && hasPhoto && overlay === "full" && (
        <div slot="background" class="hero_photo">
          <Visual
            src={image!}
            alt={photoAlt}
            variant="background"
            radius="none"
            position={imagePosition}
            priority
          />
          <div class="hero_scrim is-full" aria-hidden="true" />
        </div>
      )}
      {variant === "background" && hasPhoto && overlay === "side" && (
        <div slot="background" class="hero_photo">
          <Visual
            src={image!}
            alt={photoAlt}
            variant="background"
            radius="none"
            position={imagePosition}
            priority
          />
          <div class="hero_scrim" aria-hidden="true" />
        </div>
      )}

      {backdropUrl && (
        <div
          slot="background"
          class="hero_backdrop"
          style={`--_hero-backdrop: url("${backdropUrl}")`}
          aria-hidden="true"
        />
      )}

      {breadcrumbs?.length ? (
        <Breadcrumbs items={breadcrumbs} class="hero_crumbs" />
      ) : null}

      <Layout
        variant={
          formCard || (variant === "split" && hasPhoto)
            ? "columns"
            : variant === "centered"
              ? "stack-centered"
              : "stack"
        }
        ratio={formCard ? "7-5" : "6-6"}
        verticalAlign={formCard ? "start" : "center"}
        class="hero_layout u-hero-fade"
      >
        {proofPill && proof?.text && (
          <p class="hero_proof is-pill">
            {stars > 0 && (
              <span
                class="hero_stars"
                role="img"
                aria-label={`${proof.rating} out of 5 stars`}
              >
                {"★".repeat(stars)}
              </span>
            )}
            <span class="hero_proof_text">{proof.text}</span>
          </p>
        )}
        {eyebrow && <Heading variant="eyebrow">{eyebrow}</Heading>}
        <Heading
          tag="h1"
          variant={headingSize === "h1" ? "h1" : "display-lg"}
          accent
          marginBottom={4}
          class="hero_title"
        >
          <Fragment set:html={heading} />
        </Heading>
        {text && (
          <Text variant="large" class="hero_text">
            {text}
          </Text>
        )}
        {panel && <CtaPanel cta={primaryCta!} note={ctaNote} />}
        {!panel && (primaryCta || showPhone || secondaryCta) && (
          <ButtonWrapper>
            {primaryCta && !formCard && (
              <CtaButton cta={primaryCta} size="large" />
            )}
            {showPhone && (
              <CtaButton phone variant={phoneVariant} size="large" />
            )}
            {secondaryCta && (
              <CtaButton
                cta={secondaryCta}
                variant={secondaryVariant}
                size="large"
              />
            )}
          </ButtonWrapper>
        )}
        {!proofPill && proof?.text && (
          <p class="hero_proof">
            {stars > 0 && (
              <span
                class="hero_stars"
                role="img"
                aria-label={`${proof.rating} out of 5 stars`}
              >
                {"★".repeat(stars)}
              </span>
            )}
            <span class="hero_proof_text">{proof.text}</span>
          </p>
        )}
        {trust?.length ? <TrustBadges items={trust} /> : null}
        {badge && variant !== "split" && (
          <p class="hero_badge" data-theme-invert>
            <span class="hero_badge_value">{badge.value}</span>
            <span class="hero_badge_label">{badge.label}</span>
          </p>
        )}

        {variant === "centered" && hasPhoto && (
          <div class="hero_media is-wide">
            <Visual
              src={image!}
              alt={photoAlt}
              ratio="21 / 9"
              position={imagePosition}
              priority
            />
          </div>
        )}

        {formCard && (
          <div slot="column2" class="hero_form" data-theme-invert>
            <Heading tag="h2" variant="h4" marginBottom={2}>
              {formCard.heading ?? "Request a free estimate"}
            </Heading>
            {formCard.text && (
              <Text variant="small" muted>
                {formCard.text}
              </Text>
            )}
            <LeadForm
              formId={formCard.formId}
              id="hero-form"
              fields={formCard.projectOptions?.length ? "steps" : "contact"}
              projectOptions={formCard.projectOptions}
              stepQuestion={formCard.stepQuestion ?? "What can we help with?"}
              compact={formCard.compact ?? true}
              messageLabel={
                formCard.messageLabel ??
                (formCard.projectOptions?.length
                  ? "Anything we should know? (optional)"
                  : "What can we help with?")
              }
              submitLabel={formCard.submitLabel ?? "Get my free estimate"}
            />
          </div>
        )}

        {!formCard && variant === "split" && hasPhoto && (
          <div
            slot="column2"
            class:list={["hero_media", { "is-cutout": imageFit === "cutout" }]}
          >
            <Visual
              src={image!}
              alt={photoAlt}
              ratio="var(--_hero-photo-ratio)"
              position={
                imagePosition ??
                (imageFit === "cutout" ? { x: 50, y: 100 } : undefined)
              }
              fit={imageFit === "cutout" ? "contain" : "cover"}
              transparent={imageFit === "cutout"}
              priority
            />
            {badge && (
              <p class="hero_badge is-floating" data-theme-invert>
                <span class="hero_badge_value">{badge.value}</span>
                <span class="hero_badge_label">{badge.label}</span>
              </p>
            )}
          </div>
        )}
      </Layout>
    </Section>
  )
}

<style is:global>
  @layer components {
    .hero_wrap.is-background:not(.is-form) .hero_layout {
      max-width: 48rem;
    }

    /* ctaStyle="form": the form on its own contrasting card. */
    .hero_form {
      padding: var(--space-6);
      border-radius: var(--radius-main);
      background-color: var(--background);
      color: var(--text);
    }

    /* proofPosition="above": the proof as a pill over the eyebrow. */
    .hero_proof.is-pill {
      width: fit-content;
      margin: 0 0 var(--space-4);
      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius-full);
      background-color: color-mix(
        in oklab,
        var(--heading-accent) 18%,
        transparent
      );
      font-weight: 600;
    }

    /* overlay="side": on wide screens the photo starts a third of the way
       in and its left edge melts into the hero's background, so the text
       sits on plain colour and the subject on the right stays bright.
       Narrower, the text spans the photo, so it's full width under an even,
       strong tint. Below 75em the text column is too wide to leave the
       subject clear. The scrim starts a hair left of the photo so its edge
       never shows as a seam. */
    .hero_photo {
      position: absolute;
      inset: 0;
    }

    .hero_scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        color-mix(in oklab, var(--background) 74%, transparent),
        color-mix(in oklab, var(--background) 88%, transparent)
      );
    }

    /* overlay="full": the whole photo, darkest behind the text. */
    .hero_scrim.is-full {
      background: linear-gradient(
        to right,
        color-mix(in oklab, var(--background) 94%, transparent) 0%,
        color-mix(in oklab, var(--background) 78%, transparent) 50%,
        color-mix(in oklab, var(--background) 35%, transparent) 100%
      );
    }

    @media (width >= 75em) {
      /* Section's background slot stretches its children to the full
         width; this one is the right two-thirds. */
      /* The text keeps to the dark third-and-a-bit the photo leaves. */
      .hero_wrap.is-side:not(.is-form) .hero_layout {
        max-width: min(48rem, 50vw);
      }

      .hero_wrap.is-side .hero_photo {
        inset-inline: auto 0;
        width: 66%;
      }

      .hero_wrap.is-side .hero_scrim {
        inset-inline-start: -0.25rem;
        background: linear-gradient(
          to right,
          var(--background) 0%,
          color-mix(in oklab, var(--background) 80%, transparent) 22%,
          color-mix(in oklab, var(--background) 25%, transparent) 50%,
          color-mix(in oklab, var(--background) 5%, transparent) 100%
        );
      }
    }

    .hero_proof {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2);
      /* Space it off the button row the way ButtonWrapper spaces itself
         off the text above (top margin, --space-5). */
      margin: var(--space-5) 0 0;
      font-size: var(--text-small-size);
    }

    /* A look can set --hero-star (estate: the rating gold). */
    .hero_stars {
      flex-shrink: 0;
      color: var(--hero-star, var(--heading-accent));
      letter-spacing: 0.1em;
    }

    .hero_proof_text {
      min-width: 0;
    }

    /* centered: the photo spans the column under the text. */
    .hero_media.is-wide {
      width: 100%;
      margin-top: var(--space-7);
    }

    .hero_media {
      position: relative;
    }

    /* split: a square photo once the columns stack. Side by side, the photo
       column stretches to the text column's height and the photo fills it,
       so a tall headline + panel isn't paired with a short landscape strip.
       The photo is laid out absolutely there so its own size never sets the
       row height: the text does (with a floor for short heroes). 58em is
       Layout's default collapse width. */
    .hero_wrap.is-split .hero_media {
      --_hero-photo-ratio: 1 / 1;
    }

    @container (width >= 58em) {
      .hero_wrap.is-split .hero_layout .u-layout-column-2 {
        align-self: stretch;
        min-height: 32rem;
      }

      .hero_wrap.is-split .hero_media {
        --_hero-photo-ratio: auto;
        position: absolute;
        inset: 0;
      }

      .hero_wrap.is-split .hero_media .u-image-wrapper {
        height: 100%;
      }
    }

    /* cutout: the subject stands on the hero's own background (no box, no
       corners) and its bottom edge fades out, so a cut-off waist or a
       soft cut-out edge never reads as a hard line. */
    .hero_media.is-cutout .u-image-wrapper {
      border-radius: 0;
      mask-image: linear-gradient(to bottom, black 78%, transparent);
    }

    /* A soft light behind the subject's head and shoulders, so a painted
       or photographed subject reads as lit, not pasted on. */
    .hero_media.is-cutout::before {
      content: "";
      position: absolute;
      inset: 0 -10% 10%;
      background: radial-gradient(
        closest-side,
        color-mix(in oklab, var(--text) 16%, transparent),
        color-mix(in oklab, var(--heading-accent) 22%, transparent) 55%,
        transparent
      );
      pointer-events: none;
    }

    .hero_media.is-cutout .u-image-wrapper {
      position: relative;
    }

    /* The texture: faint, strongest behind the subject (right on desktop,
       bottom on phones; the bottom-right ellipse covers both) and gone
       before it reaches the text. */
    .hero_backdrop {
      position: absolute;
