---
import type { HTMLAttributes, ComponentProps } from "astro/types";
import type { ImageMetadata } from "astro";
import Section from "@/components/ui/Section.astro";
import Layout from "@/components/ui/Layout.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";
import ChipList from "@/components/ui/ChipList.astro";
import CheckList from "@/components/ui/CheckList.astro";
import ImagePair from "@/components/ui/ImagePair.astro";
import CtaButton from "@/components/ui/CtaButton.astro";
import ServiceMap from "@/components/ui/ServiceMap.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import phoneIcon from "@/assets/icons/phone.svg";
import { SERVICE_RADIUS, type ServiceRadius } from "@/lib/service-area-geo";
import type { SectionCta } from "@/lib/cta";
import { SITE } from "@/config/site";
import { TOWN_LINKS } from "@/lib/area-nav";

type ServiceAreaImage = { src: ImageMetadata | string; alt: string };
/** An SVG imported as a component: `import Map from "@/assets/maps/x.svg"`. */
type ServiceAreaMap = (props: Record<string, unknown>) => unknown;
/** A town and its real boundary (scripts/lib/service-area-geo.mjs). */
type ServiceAreaGeo = {
  name: string;
  geometry: {
    type: "Polygon" | "MultiPolygon" | "Point";
    coordinates: unknown;
  };
};
type ServiceAreaListStyle =
  /** A chip per place (links when `areaLinks` has one) */
  | "chips"
  /** A checklist of places, two columns past four (no links) */
  | "checklist";
type ServiceAreaVariant =
  /** Text and chips beside the map or photos, on the section itself */
  | "default"
  /** One big white rounded card: text, a two-column dotted list of places and a call button beside the street map, which fills its frame */
  | "card";
type ServiceAreaTheme = ComponentProps<typeof Section>["theme"];
type PaddingSize = import("@/components/ui/Section.astro").PaddingSize;

interface Props extends HTMLAttributes<"section"> {
  /**
   * **ServiceArea** — where the business works: a chip per place, beside
   * either a map or a pair of photos.
   *
   * **Map contract:** import the client's SVG as a component and pass it as
   * `map`. Every region that should light up carries `data-area="<name>"`,
   * where `<name>` equals one of `areas` exactly. Hovering or focusing a
   * chip highlights its region, and hovering a region highlights its chip.
   * See src/assets/maps/sample-service-area.svg.
   *
   * **Street map:** pass `geo` — each town's real boundary, fetched from
   * OpenStreetMap when the site is generated
   * (scripts/lib/service-area-geo.mjs) — and the column shows a street map
   * with the towns outlined (ServiceMap). It wins over `map` and `images`.
   *
   * - `paragraphs` — more writing after `text`
   * - `areas` — place names (default `SITE.serviceAreas`)
   * - `areaStyle` — `chips` (default) or `checklist` (two columns past four)
   * - `areaLinks` — chip links (default: each town's region page)
   * - `geo` — town boundaries for the street map
   * - `map`, `mapLabel` — the SVG and its accessible description
   * - `images` — two photos, shown when there's no `map`
   * - `cta` — optional button under the chips
   * - `variant` — `default`, or `card`: everything on one big white
   *   rounded card, the places as a two-column list with accent dots
   *   (hovering one lights its outline), a dark call button
   *   (`SITE.phone`; `cta` replaces it), the street map in a rounded frame
   *   drawn `filled` (tight framing, brand-tinted towns). The heading
   *   takes `<strong>` for the italic accent.
   *
   * @example
   * import Map from "@/assets/maps/client-map.svg";
   * <ServiceArea heading="Serving the whole county" map={Map} />
   *
   * @example card
   * <ServiceArea variant="card" heading="Based in Riverside, <strong>working across DFW.</strong>" text="We work in seven counties around Dallas–Fort Worth." geo={areaGeo} />
   */
  docs?: string;

  /** Set to `false` to skip rendering. @default true */
  render?: boolean;

  /** Small label above the heading. @default 'Where we work' */
  eyebrow?: string;

  /** Section heading. Required. Inline HTML is allowed: wrap the accent phrase in a strong tag. */
  heading: string;

  /** Intro paragraph. */
  text?: string;

  /** More paragraphs after `text` (a region page's local writing). */
  paragraphs?: string[];

  /** Place names, one chip each. @default SITE.serviceAreas */
  areas?: readonly string[];

  /** How the places show: chips, or a checklist. @default 'chips' */
  areaStyle?: ServiceAreaListStyle;

  /** Make chips links: `{ "Round Rock": "/service-areas/williamson-county" }`. @default each town's region page (src/content/service-areas/) */
  areaLinks?: Record<string, string>;

  /** The place this page is about: highlighted on the map. */
  currentArea?: string;

  /** Town boundaries: shows a street map with each town outlined. */
  geo?: ServiceAreaGeo[];

  /**
   * "Within N miles of home base": a circle on the street map, which frames
   * the map around it. @default SERVICE_RADIUS (src/data/service-radius.json)
   */
  radius?: ServiceRadius | null;

  /** The client's map, imported as an SVG component. */
  map?: ServiceAreaMap;

  /** Accessible description of the map. @default "Map of <areas>" */
  mapLabel?: string;

  /** Two photos, shown when there's no `map`. */
  images?: ServiceAreaImage[];

  /** Optional button under the chips. On `card`, replaces the call button. */
  cta?: SectionCta;

  /** The look. `card` puts it all on one white card with a list of places and a call button. @default 'default' */
  variant?: ServiceAreaVariant;

  /** Section theme. */
  theme?: ServiceAreaTheme;

  /** Section padding (top and bottom). */
  padding?: PaddingSize;

  /** Section id for anchor links. */
  id?: string;

  /** Extra classes on the section. */
  class?: string;
}

const {
  docs,
  render = true,
  eyebrow = "Where we work",
  heading,
  text,
  paragraphs = [],
  areas = SITE.serviceAreas,
  areaStyle = "chips",
  areaLinks = TOWN_LINKS,
  currentArea,
  geo = [],
  radius = SERVICE_RADIUS,
  map: Map,
  mapLabel,
  images = [],
  cta,
  variant = "default",
  theme,
  padding,
  id,
  class: className,
  ...rest
} = Astro.props;

const chips = areas.map((area) => ({
  label: area,
  key: area,
  href: areaLinks[area],
}));
const hasStreetMap = geo.length > 0 || Boolean(radius);
const hasMedia = hasStreetMap || Boolean(Map) || images.length === 2;
const hasContent = chips.length > 0 || hasMedia;

const isCard = variant === "card";

if (import.meta.env.DEV && render) {
  if (variant !== "default" && variant !== "card")
    console.warn(
      `[ServiceArea] Unknown variant "${variant}"; showing the default.`,
    );
  if (!heading)
    console.warn("[ServiceArea] `heading` is required; nothing renders.");
  else if (!hasContent)
    console.warn(
      "[ServiceArea] needs areas, a map, or images; nothing renders.",
    );
}
---

{
  render && heading && hasContent && !isCard && (
    <Section
      theme={theme}
      padding={padding}
      id={id}
      class:list={["service-area_wrap", className]}
      {...rest}
    >
      <Layout
        variant={hasMedia ? "columns" : "stack"}
        ratio="5-6"
        verticalAlign="center"
        rowGap={4}
      >
        {eyebrow && <Heading variant="eyebrow">{eyebrow}</Heading>}
        <Heading tag="h2">
          <Fragment set:html={heading} />
        </Heading>
        {text && <Text muted>{text}</Text>}
        {paragraphs.map((paragraph) => (
          <Text muted>{paragraph}</Text>
        ))}
        {areaStyle === "chips" && chips.length > 0 && (
          <ChipList items={chips} class="service-area_chips" />
        )}
        {areaStyle === "checklist" && areas.length > 0 && (
          <CheckList
            items={[...areas]}
            variant="plain"
            columns={areas.length > 4 ? 2 : 1}
          />
        )}
        {cta && <CtaButton cta={cta} variant="secondary" />}

        {hasStreetMap && (
          <div slot="column2" class="service-area_map is-street">
            <ServiceMap
              areas={geo}
              radius={radius}
              label={mapLabel}
              current={currentArea}
            />
          </div>
        )}
        {!hasStreetMap && Map ? (
          <div slot="column2" class="service-area_map">
            <Map
              class="service-area_svg"
              role="img"
              aria-label={mapLabel ?? `Map of ${areas.join(", ")}`}
            />
          </div>
        ) : !hasStreetMap && images.length === 2 ? (
          <ImagePair slot="column2" images={images} />
        ) : null}
      </Layout>
    </Section>
  )
}

{
  render && heading && hasContent && isCard && (
    <Section
      theme={theme}
      padding={padding}
      id={id}
      class:list={["service-area_wrap", "is-card", className]}
      {...rest}
    >
      <div class="service-area_card">
        <Layout
          variant={hasMedia ? "columns" : "stack"}
          ratio="10-11"
          verticalAlign="center"
          columnGap="3.5rem"
          rowGap={4}
        >
          {eyebrow && (
            <Heading variant="eyebrow" class="service-area_card_eyebrow">
              {eyebrow}
            </Heading>
          )}
          <Heading tag="h2" accent>
            <Fragment set:html={heading} />
          </Heading>
          {text && <Text muted>{text}</Text>}
          {paragraphs.map((paragraph) => (
            <Text muted>{paragraph}</Text>
          ))}
          {areas.length > 0 && (
            <ul class="service-area_list">
              {areas.map((area) => (
                <li class="service-area_list_item" data-key={area}>
                  {areaLinks[area] ? (
                    <a class="service-area_list_link" href={areaLinks[area]}>
                      {area}
                    </a>
                  ) : (
                    area
                  )}
                </li>
              ))}
            </ul>
          )}
          <div class="service-area_card_call">
            {cta && <CtaButton cta={cta} />}
            {!cta && (
              <Button
                href={`tel:${SITE.phone.tel}`}
                iconPosition="start"
                ariaLabel={`Call ${SITE.phone.display}`}
              >
                Call {SITE.phone.display}
                <Icon slot="icon" src={phoneIcon} variant="small" />
              </Button>
            )}
          </div>

          {hasStreetMap && (
            <div slot="column2" class="service-area_map is-street is-framed">
              <ServiceMap
                areas={geo}
                radius={radius}
                label={mapLabel}
                current={currentArea}
                variant="filled"
              />
            </div>
          )}
          {!hasStreetMap && Map && (
            <div slot="column2" class="service-area_map is-framed">
              <Map
                class="service-area_svg"
                role="img"
                aria-label={mapLabel ?? `Map of ${areas.join(", ")}`}
              />
            </div>
          )}
          {!hasStreetMap && !Map && images.length === 2 && (
            <ImagePair slot="column2" images={images} />
          )}
        </Layout>
      </div>
    </Section>
  )
}

<style is:global>
  @layer components {
    .service-area_map {
      overflow: hidden;
      border: var(--border-width-main) solid var(--border);
      border-radius: var(--radius-main);
      background-color: var(--background-2);
      color: var(--text);
    }

    .service-area_svg {
      display: block;
      width: 100%;
      height: auto;
    }

    /* Labels, roads and other artwork must not block the regions under
       them, or pointing at a place name highlights nothing. Only regions
       take the pointer. */
    .service-area_svg *:not([data-area]) {
      pointer-events: none;
    }

    .service-area_svg [data-area] {
      pointer-events: auto;
    }

    /* Regions: any [data-area] in the map. Tinted with the accent colour,
       stronger when the paired chip (or the region itself) is active. */
    .service-area_map [data-area] {
      fill: var(--heading-accent);
      fill-opacity: 0.1;
      stroke: var(--heading-accent);
      stroke-opacity: 0.4;
      stroke-width: 1.5;
      transition:
        fill-opacity 0.2s ease,
        stroke-opacity 0.2s ease;
    }

    .service-area_map [data-area].is-active,
    .service-area_map [data-area].is-current {
      fill-opacity: 0.35;
      stroke-opacity: 1;
    }

    .service-area_map [data-area].is-current {
      stroke-width: 3;
    }

    /* The chip list carries no text-rhythm margin of its own, so the CTA
       button would sit flush under the chips. Space them only when
       something (the button) follows. */
    .service-area_chips:not(:last-child) {
      margin-bottom: var(--space-5);
    }

    .service-area_wrap .chip-list_chip {
      transition:
        background-color 0.2s ease,
        border-color 0.2s ease,
        color 0.2s ease;
    }

    .service-area_wrap .chip-list_chip.is-active {
      border-color: var(--heading-accent);
      background-color: var(--heading-accent);
      color: var(--background);
    }

    /* ================= card variant ================= */

    .service-area_card {
      padding: var(--space-7);
      border-radius: calc(var(--radius-main) * 1.5);
      background-color: var(--background-2);
      color: var(--text);
      box-shadow:
        0 0.0625rem 0.125rem color-mix(in srgb, var(--text) 5%, transparent),
        0 1rem 2.5rem color-mix(in srgb, var(--text) 7%, transparent);
    }

    @container (width < 35em) {
      .service-area_card {
        padding: var(--space-4);
      }
    }

    /* The eyebrow: a short rule, then the label, in the accent. */
    .service-area_card_eyebrow {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      color: var(--heading-accent);
    }

    .service-area_card_eyebrow::before {
      content: "";
      flex-shrink: 0;
      width: 1.75rem;
      height: 0.0625rem;
      background-color: currentColor;
    }

    /* The places: two columns, a small brand dot before each. */
    .service-area_list {
      display: grid;
      grid-template-columns: repeat(var(--_list-columns, 2), minmax(0, 1fr));
      gap: 0.625rem 1.25rem;
      margin: 0;
      padding: 0;
      list-style: none;
      font-size: 0.9375rem;
      font-weight: 500;
    }

    @container (width < 20em) {
      .service-area_list {
        --_list-columns: 1;
      }
    }

    .service-area_list_item {
      display: grid;
      grid-template-columns: 0.5rem minmax(0, 1fr);
      align-items: center;
      gap: 0.625rem;
      transition: color 0.2s ease;
    }

    .service-area_list_item::before {
      content: "";
      width: 0.5rem;
      aspect-ratio: 1 / 1;
      border-radius: var(--radius-full);
      background-color: var(--color-brand-500);
    }

    .service-area_list_item.is-active {
      color: var(--heading-accent);
    }

    .service-area_list_link {
      color: inherit;
      text-decoration: none;
    }

    /* The call button: dark ink, a pill, set apart from the list. */
    .service-area_card_call {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      padding-top: 0.375rem;
      --button-primary-background: var(--text);
      --button-primary-border: var(--text);
      --button-primary-text: var(--background-2);
      --button-primary-background-hover: var(--heading-accent);
      --button-primary-border-hover: var(--heading-accent);
      --button-primary-text-hover: var(--background-2);
    }

    /* The map's frame on the card: rounded, a hairline ring, no border. */
    .service-area_map.is-framed {
      border: 0;
      border-radius: calc(var(--radius-main) * 1.125);
      box-shadow: 0 0 0 0.0625rem
        color-mix(in srgb, var(--text) 8%, transparent);
    }

    .service-area_map.is-framed .service-map_wrap {
      border-radius: inherit;
    }

    @media (hover: hover) {
      .service-area_list_link:hover {
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .service-area_map [data-area],
      .service-area_wrap .chip-list_chip,
      .service-area_list_item {
        transition: none;
      }
    }
  }
</style>

<script>
  /* Pair each chip (data-key) with its map region (data-area): pointing at
     or focusing either one highlights both. Names are matched exactly and
     escaped, so "Fort Bend" or "St. Louis" work as keys. */
  function initServiceArea() {
    for (const wrap of document.querySelectorAll<HTMLElement>(
      ".service-area_wrap",
    )) {
      if (wrap.dataset.init) continue;
      wrap.dataset.init = "true";

      const setActive = (key: string, on: boolean) => {
        const k = CSS.escape(key);
        for (const el of wrap.querySelectorAll(
          `[data-key="${k}"], [data-area="${k}"]`,
        )) {
          el.classList.toggle("is-active", on);
        }
      };

      for (const el of wrap.querySelectorAll<HTMLElement | SVGElement>(
        ".chip-list_chip[data-key], .service-area_list_item[data-key], .service-area_map [data-area]",
      )) {
        const key =
          (el as HTMLElement).dataset.key ?? (el as HTMLElement).dataset.area;
        if (!key) continue;
        el.addEventListener("pointerenter", () => setActive(key, true));
        el.addEventListener("pointerleave", () => setActive(key, false));
        el.addEventListener("focusin", () => setActive(key, true));
        el.addEventListener("focusout", () => setActive(key, false));
      }
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initServiceArea);
  } else {
    initServiceArea();
  }
</script>
