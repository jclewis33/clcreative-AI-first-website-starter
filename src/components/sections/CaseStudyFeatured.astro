---
/**
 * CaseStudyFeatured — showcase section with an interactive flex layout.
 *
 * Displays 3 case study cards in a row. The first card starts wider
 * than the other two. On desktop, hovering any card expands it while
 * the others narrow — powered by CSS `flex` transitions.
 *
 * Below the large breakpoint the 1-wide + 2-narrow layout is preserved.
 * When the container collapses further, all cards stack at equal width.
 *
 * Designed to be placed once and updated in one place — pass studies
 * via prop or let it pull the first 3 featured case studies from data.
 *
 * @example Default usage (pulls first 3 featured case studies)
 * ```astro
 * <CaseStudyFeatured />
 * ```
 *
 * @example Custom heading + studies
 * ```astro
 * <CaseStudyFeatured
 *   eyebrow="Our Work"
 *   studies={myStudies}
 * >
 *   <Fragment slot="heading">
 *     <Heading tag="h2" variant="display-sm">Custom heading</Heading>
 *   </Fragment>
 * </CaseStudyFeatured>
 * ```
 */

import Section from "@/components/ui/Section.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";
import Visual from "@/components/ui/Visual.astro";
import Button from "@/components/ui/Button.astro";

import { loadQuery } from "@/sanity/lib/load-query";
import { getDraftModeProps } from "@/sanity/lib/draft-mode";
import { urlFor } from "@/sanity/lib/image";

type SectionTheme = "light" | "dark" | "brand";
/* Single source for the padding union: Section.props.ts — never re-declare
   these values locally; the copies this replaced had all drifted. */
type PaddingSize = import("@/components/ui/Section.props").PaddingSize;

/**
 * CaseStudyFeatured — interactive 3-card showcase with hover expand animation.
 *
 * **Props:**
 * - `slugs` — 3 case study slugs in display order (falls back to placeholder slugs)
 * - `eyebrow` — eyebrow text above heading (default `'Proven Results'`)
 * - `headingVariant` — visual style for card title headings (default `'h6'`). Accepts: display-xl/lg/md/sm, h1–h6, eyebrow
 * - `theme` — light, dark, brand
 * - `padding` — none, small, main, large, page-top (default `'main'`)
 * - `paddingTop` / `paddingBottom` — override individual padding
 * - `id` — section anchor id
 * - `class` — extra classes
 *
 * **Slots:** `heading` — custom heading markup (replaces default stats heading)
 */
interface Props {
  /**
   * **CaseStudyFeatured props:**
   * - `studies` — pre-fetched case study data array (skips internal Sanity fetch when provided)
   * - `slugs` — 3 case study slugs in display order (falls back to placeholder slugs)
   * - `eyebrow` — eyebrow text (default `'Proven Results'`)
   * - `headingVariant` — card title heading variant (default `'h6'`). Accepts: display-xl/lg/md/sm, h1–h6, eyebrow
   * - `theme` — light, dark, brand
   * - `padding` — none, small, main, large, page-top (default `'main'`)
   * - `paddingTop` / `paddingBottom` — override individual padding
   * - `id` — section anchor id
   * - `class` — extra classes
   *
   * **Slots:** `heading` — custom heading markup
   */
  docs?: string;

  /**
   * Case study slugs to display, in display order. Exactly 3 required.
   * Falls back to placeholder slugs.
   *
   * @default ["case-study-one", "case-study-two", "case-study-three"]
   * @example slugs={["slug-a", "slug-b", "slug-c"]}
   */
  slugs?: [string, string, string];

  /**
   * Pre-fetched case study data from Sanity. When provided, the component
   * skips its internal Sanity fetch — use this to parallelize fetches at
   * the page level with `Promise.all`.
   *
   * Each object needs: `slug`, `client`, `description`, `image`, `imageAlt`.
   * Must be in display order (first item renders as the expanded card).
   *
   * @example studies={prefetchedStudies}
   */
  studies?: any[];

  /**
   * Eyebrow text rendered above the heading.
   *
   * @default 'Proven Results'
   * @example eyebrow="Our Work"
   */
  eyebrow?: string;

  /**
   * Visual style for each card's title heading. Controls font size
   * and weight without changing the semantic `<h3>` tag.
   *
   * Accepts any Heading `variant` value:
   * - `'display-xl'` | `'display-lg'` | `'display-md'` | `'display-sm'`
   * - `'h1'` | `'h2'` | `'h3'` | `'h4'` | `'h5'` | `'h6'`
   * - `'eyebrow'`
   *
   * @default 'h6'
   * @example headingVariant="h5"
   */
  headingVariant?:
    | "display-xl"
    | "display-lg"
    | "display-md"
    | "display-sm"
    | "h1"
    | "h2"
    | "h3"
    | "h4"
    | "h5"
    | "h6"
    | "eyebrow";

  /**
   * Section color theme.
   * @example theme="dark"
   */
  theme?: SectionTheme;

  /**
   * Section vertical padding.
   * @default omitted → 'main'
   */
  padding?: PaddingSize;

  /** Override top padding only. */
  paddingTop?: PaddingSize;

  /** Override bottom padding only. */
  paddingBottom?: PaddingSize;

  /** Section anchor id. */
  id?: string;

  /** Extra classes on the outer Section element. */
  class?: string;
}

/* ── Exported constants for page-level fetching ───────────────────────── */

export const FEATURED_CASE_STUDIES_SLUGS: [string, string, string] = [
  "case-study-one",
  "case-study-two",
  "case-study-three",
];

export const FEATURED_CASE_STUDIES_QUERY = `*[_type == "caseStudy" && slug.current in $slugs] {
  "slug": slug.current,
  client,
  description,
  image,
  "imageAlt": coalesce(imageAlt, image.asset->altText, "")
}`;

const {
  docs,
  slugs = FEATURED_CASE_STUDIES_SLUGS,
  studies,
  eyebrow = "Proven Results",
  headingVariant = "h6",
  theme,
  padding,
  paddingTop,
  paddingBottom,
  id,
  class: className,
} = Astro.props;

/* ── Resolve studies — use prop or fetch from Sanity ──────────────────── */

let displayStudies: any[];

if (studies && studies.length >= 3) {
  // Pre-fetched data provided — skip internal fetch
  displayStudies = studies;
} else {
  // Fetch from Sanity (standalone usage). Tolerate an empty/unreachable
  // dataset — the section simply doesn't render when fewer than 3 resolve.
  const results = await loadQuery<any[]>({
    query: FEATURED_CASE_STUDIES_QUERY,
    params: { slugs },
    ...getDraftModeProps(Astro),
  })
    .then((r) => r.data)
    .catch(() => []);
  displayStudies = slugs
    .map((slug: string) => (results ?? []).find((s: any) => s.slug === slug))
    .filter(Boolean);
}

/* ── Heading slot ─────────────────────────────────────────────────────── */

/* NOTE: these are `Astro.slots.has()`, not a rendered-content check.
   Rendering a slot (`Astro.slots.render()`) to find out whether it is empty
   swallows the hoisted `<script>` of every component inside it — page-wide,
   not just for that slot. Measured: one `<Slider>` in a Card `footer` slot
   left BOTH sliders on the page uninitialized, the unrelated one included.
   `.has()` only reports whether a slot was passed, which is weaker (a slot
   holding an empty `{items.map(…)}` still counts as present), and that is the
   trade we want: a rare empty wrapper beats silently dead client JS. */
const hasHeadingSlot = Astro.slots.has("heading");
---

{
  displayStudies.length >= 3 && (
    <Section
      theme={theme}
      padding={padding}
      paddingTop={paddingTop}
      paddingBottom={paddingBottom}
      id={id}
      class:list={["case-study-featured_wrap", className]}
    >
      <div class="case-study-featured_inner u-container">
        {/* Heading area */}
        <div
          data-prevent-flicker="true"
          data-fade-in
          class="case-study-featured_heading"
        >
          {hasHeadingSlot ? (
            <slot name="heading" />
          ) : (
            <>
              {eyebrow && <Heading variant="eyebrow">{eyebrow}</Heading>}
              <Heading
                data-prevent-flicker="true"
                data-split-text
                variant="h1"
                maxWidth="40ch"
              >
                Lorem ipsum dolor.
                <br />
                Consectetur adipiscing elit.
                <br />
                Sed do eiusmod tempor.
              </Heading>
            </>
          )}
        </div>

        {/* Cards */}
        <div class="case-study-featured_cards">
          {displayStudies.map((study: any, i: number) => (
            <a
              href={`/case-studies/${study.slug}`}
              class:list={[
                "case-study-featured_card",
                i === 0 && "is-expanded",
              ]}
              aria-label={`View ${study.client} case study`}
            >
              <div class="case-study-featured_card_visual">
                <Visual
                  src={
                    typeof study.image === "string"
                      ? study.image
                      : urlFor(study.image).width(1200).url()
                  }
                  alt={study.imageAlt}
                  width={1200}
                  height={800}
                  radius="large"
                />
              </div>
              <div class="case-study-featured_card_content">
                <Heading
                  tag="h3"
                  variant={headingVariant}
                  marginBottom={0}
                  maxWidth="100%"
                >
                  {study.client}
                </Heading>
                <Text variant="small" marginBottom={0}>
                  {study.description}
                </Text>
              </div>
            </a>
          ))}
        </div>
        <div class="u-button-wrapper">
          {" "}
          <Button href="/case-studies" ariaLabel="View All Case Studies">
            View All Case Studies
          </Button>{" "}
        </div>
      </div>
    </Section>
  )
}

<style is:global>
  /* Global styles (is:global — classes here are used across the site and by
     child slots), moved from src/styles/components/case-study-featured.css. The layer
     wrapper slots them into the cascade defined in styles/global.css. */
  @layer components {
    /* ==========================================================================
   CASE STUDY FEATURED — interactive 3-card showcase
   ==========================================================================
   First card starts wider; on hover any card expands while siblings
   narrow. Below the collapse point all cards stack at equal width.
   ========================================================================== */

    /* ── Inner container ──────────────────────────────────────────────────── */

    .case-study-featured_inner {
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }

    /* ── Heading area ─────────────────────────────────────────────────────── */

    .case-study-featured_heading {
      display: block;
    }

    /* Orange eyebrow color */
    .case-study-featured_heading .u-text-style-eyebrow {
      color: var(--color-brand-500);
    }

    /* On brand-themed sections the orange eyebrow disappears into the orange
   background — fall back to the theme's text color (white). */
    [data-theme="brand"] .case-study-featured_heading .u-text-style-eyebrow {
      color: var(--text);
    }

    /* ── Card row ─────────────────────────────────────────────────────────── */

    .case-study-featured_cards {
      display: flex;
      gap: var(--space-3);
      flex-direction: column;
    }

    /* ── Individual card ──────────────────────────────────────────────────── */

    .case-study-featured_card {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      text-decoration: none;
      color: inherit;
      flex: 1 1 0%;
      min-width: 0;
      transition: flex 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* ── Card image ───────────────────────────────────────────────────────── */

    .case-study-featured_card_visual {
      overflow: hidden;
      border-radius: var(--radius-main);
    }

    /* Fixed image height — text flows below without pushing image up */
    .case-study-featured_card_visual .u-image-wrapper {
      aspect-ratio: unset;
      height: 25rem;
    }

    .case-study-featured_card_visual img {
      transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .case-study-featured_card:hover .case-study-featured_card_visual img {
      transform: scale(1.03);
    }

    /* ── Card content ─────────────────────────────────────────────────────── */

    .case-study-featured_card_content {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    /* ── Desktop: flex row with hover expand ──────────────────────────────── */

    @container (width >= 50em) {
      .case-study-featured_cards {
        flex-direction: row;
      }

      /* Default state: first card is wider */
      .case-study-featured_card {
        flex: 1 1 0%;
      }

      .case-study-featured_card.is-expanded {
        flex: 1.66 1 0%;
      }

      /* When the card row is hovered, reset all to equal first */
      .case-study-featured_cards:hover .case-study-featured_card {
        flex: 1 1 0%;
      }

      /* Then the hovered card expands */
      .case-study-featured_cards:hover .case-study-featured_card:hover {
        flex: 1.66 1 0%;
      }
    }

    /* ── Small: collapsed to single column — switch to landscape ratio ────── */

    @container (width < 35em) {
      .case-study-featured_card_visual .u-image-wrapper {
        height: auto;
        aspect-ratio: 16 / 9;
      }
    }

    /* ── Medium: keep row but all same size ───────────────────────────────── */

    @container (width >= 35em) and (width < 50em) {
      .case-study-featured_cards {
        flex-direction: row;
        flex-wrap: wrap;
      }

      /* First card takes full width */
      .case-study-featured_card.is-expanded {
        flex: 1 1 100%;
      }

      /* Other two share the row */
      .case-study-featured_card:not(.is-expanded) {
        flex: 1 1 0%;
      }
    }
  }
</style>
