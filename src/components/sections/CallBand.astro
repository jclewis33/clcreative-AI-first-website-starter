---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes, ComponentProps } from "astro/types";
import Section from "@/components/ui/Section.astro";
import Layout from "@/components/ui/Layout.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";
import Visual from "@/components/ui/Visual.astro";
import Overlay from "@/components/ui/Overlay.astro";
import CtaButton from "@/components/ui/CtaButton.astro";
import CtaPanel from "@/components/ui/CtaPanel.astro";
import type { SectionCta } from "@/lib/cta";
import { linkPhones } from "@/lib/phone-links";

type CallBandVariant =
  /** Dark band: heading left, phone + second button right */
  | "band"
  /** A white card centred on a full-width photo, with the estimate button + "or" + phone panel */
  | "photo-card"
  /** One rounded card: dark text side with the buttons, photo side */
  | "split"
  /** A full-width photo under a dark wash, the heading and buttons centred on it — no card */
  | "cinematic"
  /** A rounded photo panel inside the container: a navy wash from the left, heading, buttons and a tick row on it */
  | "panel";
type CallBandTheme = ComponentProps<typeof Section>["theme"];
type PaddingSize = import("@/components/ui/Section.astro").PaddingSize;

interface Props extends HTMLAttributes<"section"> {
  /**
   * **CallBand** — the closing call to action of a local-service page.
   *
   * - `variant` — `'band'` (dark band, phone + second button), `'photo-card'`
   *   (a white card on a full-width photo — a lawn, a roofline — with the
   *   estimate panel), `'split'` (a rounded card, text one side, photo the
   *   other) or `'cinematic'` (the photo full-width under a dark wash, the
   *   heading and both buttons centred on it) or `'panel'` (a rounded photo
   *   panel inside the page container, a dark wash from the left, the
   *   heading, text, both buttons and an optional `ticks` row left-aligned
   *   on it; the section itself keeps the page ground). The photo variants
   *   need `image` + `imageAlt`; without them they fall back to `'band'`.
   * - `heading` (HTML allowed; `<strong>` = accent), `text`
   * - `secondaryCta` — default `{ label: "Contact us", href: "/contact" }`;
   *   pass `{ label, modal }` to open the estimate form instead. On the
   *   photo variants it is the main button.
   * - `ctaNote` — small line under the button on `'photo-card'`
   * - `ticks` — short proof points under the buttons on `'panel'`
   *
   * @example
   * <CallBand heading="Ready to start?" secondaryCta={{ label: "Get an estimate", modal: "estimate-modal" }} />
   * <CallBand variant="photo-card" image={lawn} imageAlt="A thick green lawn" heading="Get a free quote" secondaryCta={estimateCta} />
   * <CallBand variant="panel" image={crew} imageAlt="A technician sealing a containment" heading="Found mold? <strong>Let's take a look.</strong>" text="…" secondaryCta={estimateCta} ticks={["Licensed in Texas", "Since 1996"]} />
   */
  docs?: string;

  /** Set to `false` to skip rendering. @default true */
  render?: boolean;

  /** Band heading. Required. */
  heading: string;

  /** Supporting line. */
  text?: string;

  /** The second button (the main one on the photo variants). @default { label: "Contact us", href: "/contact" } */
  secondaryCta?: SectionCta;

  /** Layout. @default 'band' */
  variant?: CallBandVariant;

  /** Photo for `'photo-card'` and `'split'` (imported image or URL). */
  image?: ImageMetadata | string;

  /** Alt text for the photo. */
  imageAlt?: string;

  /** Small line under the button on `'photo-card'`, e.g. "No obligation". */
  ctaNote?: string;

  /**
   * `'panel'` only: short proof points in a ticked row under the buttons,
   * e.g. `["Licensed in Texas", "IICRC certified", "Since 1996"]`.
   */
  ticks?: string[];

  /** Section theme. @default 'dark' for band, photo-card and cinematic; inherit for split and panel (the panel is always dark) */
  theme?: CallBandTheme;

  /** Section padding (top and bottom). */
  padding?: PaddingSize;

  /** Section id for anchor links. */
  id?: string;

  /** Extra classes on the section. */
  class?: string;
}

const {
  docs,
  render = true,
  heading,
  text,
  secondaryCta = { label: "Contact us", href: "/contact" },
  variant: variantProp = "band",
  image,
  imageAlt,
  ctaNote,
  ticks = [],
  theme: themeProp,
  padding,
  id,
  class: className,
  ...rest
} = Astro.props;

/* The photo variants need a photo; without one, the plain band. */
const variant: CallBandVariant =
  variantProp !== "band" && !image ? "band" : variantProp;
const theme: CallBandTheme =
  themeProp ??
  (variant === "split" || variant === "panel" ? undefined : "dark");
/* The panel's text is plain copy: escaped, then any phone number in it
   becomes a tel: link. */
const textHtml = text
  ? linkPhones(
      text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"),
    )
  : "";
/* Never alt="" (CLAUDE.md): fall back to the heading's plain text. */
const photoAlt = imageAlt || heading?.replace(/<[^>]+>/g, "") || "";

if (import.meta.env.DEV && render) {
  if (!heading)
    console.warn("[CallBand] `heading` is required; nothing renders.");
  if (
    !["band", "photo-card", "split", "cinematic", "panel"].includes(variantProp)
  )
    console.warn(`[CallBand] Unknown variant "${variantProp}".`);
  if (variantProp !== "band" && !image)
    console.warn(
      `[CallBand] variant "${variantProp}" needs an \`image\`; showing the band.`,
    );
}
---

{
  render && heading && variant === "band" && (
    <Section
      theme={theme}
      padding={padding}
      id={id}
      class:list={["call-band_wrap", className]}
      {...rest}
    >
      <Layout ratio="7-5" verticalAlign="center">
        <Heading tag="h2" variant="h1" accent>
          <Fragment set:html={heading} />
        </Heading>
        {text && <Text muted>{text}</Text>}
        <div slot="column2" class="call-band_actions">
          <CtaButton phone size="large" />
          <CtaButton cta={secondaryCta} variant="secondary" size="large" />
        </div>
      </Layout>
    </Section>
  )
}

{
  render && heading && variant === "photo-card" && (
    <Section
      theme={theme}
      padding={padding}
      id={id}
      class:list={["call-band_wrap", "is-photo-card", className]}
      {...rest}
    >
      <Fragment slot="background">
        <Visual src={image!} alt={photoAlt} variant="background" />
        <Overlay strength={45} />
      </Fragment>
      <div class="call-band_card" data-theme-invert>
        <Heading tag="h2" variant="h2" accent>
          <Fragment set:html={heading} />
        </Heading>
        {text && <Text muted>{text}</Text>}
        <CtaPanel cta={secondaryCta} note={ctaNote} class="call-band_panel" />
      </div>
    </Section>
  )
}

{
  render && heading && variant === "split" && (
    <Section
      theme={theme}
      padding={padding}
      id={id}
      class:list={["call-band_wrap", "is-split", className]}
      {...rest}
    >
      <div class="call-band_split" data-theme-invert>
        <div class="call-band_split_content">
          <Heading tag="h2" variant="h2" accent>
            <Fragment set:html={heading} />
          </Heading>
          {text && <Text muted>{text}</Text>}
          <div class="call-band_split_actions">
            <CtaButton cta={secondaryCta} size="large" />
            <CtaButton phone variant="secondary" size="large" />
          </div>
        </div>
        <div class="call-band_split_media">
          <Visual src={image!} alt={photoAlt} variant="background" />
        </div>
      </div>
    </Section>
  )
}

{
  render && heading && variant === "cinematic" && (
    <Section
      theme={theme}
      padding={padding}
      id={id}
      class:list={["call-band_wrap", "is-cinematic", className]}
      {...rest}
    >
      <Fragment slot="background">
        <Visual src={image!} alt={photoAlt} variant="background" />
        <Overlay strength={70} />
      </Fragment>
      <div class="call-band_cinematic">
        <Heading tag="h2" variant="h1" accent>
          <Fragment set:html={heading} />
        </Heading>
        {text && <Text variant="large">{text}</Text>}
        <div class="call-band_cinematic_actions">
          <CtaButton cta={secondaryCta} size="large" />
          <CtaButton phone variant="secondary" size="large" />
        </div>
      </div>
    </Section>
  )
}

{
  render && heading && variant === "panel" && (
    <Section
      theme={theme}
      padding={padding}
      id={id}
      class:list={["call-band_wrap", "is-panel", className]}
      {...rest}
    >
      <div class="call-band_panel_wrap" data-theme="dark">
        <div class="call-band_panel_media">
          <Visual
            src={image!}
            alt={photoAlt}
            variant="background"
            radius="none"
          />
        </div>
        <div class="call-band_panel_content">
          <Heading tag="h2" variant="h1" accent maxWidth="22ch">
            <Fragment set:html={heading} />
          </Heading>
          {text && (
            <Text variant="large" muted maxWidth="46ch">
              <Fragment set:html={textHtml} />
            </Text>
          )}
          <div class="call-band_panel_actions">
            <CtaButton cta={secondaryCta} size="large" />
            <CtaButton phone variant="secondary" size="large" />
          </div>
          {ticks.length > 0 && (
            <ul class="call-band_ticks" role="list">
              {ticks.map((tick) => (
                <li class="call-band_tick">
                  <svg
                    class="call-band_tick_icon"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="m5 12.5 4.5 4.5L19 7.5" />
                  </svg>
                  {tick}
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </Section>
  )
}

<style is:global>
  @layer components {
    /* The two buttons side by side, level with the heading; they wrap and
       fill the row when it gets too narrow for both (stacked under the
       heading on smaller screens). Stacked in a narrow column they made a
       tall block beside a one-line heading. */
    .call-band_actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      width: 100%;
      justify-content: var(--start-medium, flex-end);
    }

    .call-band_actions > * {
      flex: 1 1 13rem;
      max-width: var(--unset-medium, 18rem);
    }

    /* photo-card: a light card centred on the photo. */
    .call-band_card {
      --_text-inline-margin: auto;
      --_buttons-justify: center;
      align-self: center;
      width: 100%;
      /* Room for the panel's button, "or" and the number on one line: at
         44rem a serif look's larger number (trusted) wrapped "(844)" onto
         a line of its own. */
      max-width: 48rem;
      padding: var(--space-7) var(--space-6);
      border-radius: var(--radius-main);
      background-color: var(--background-2);
      color: var(--text);
      text-align: center;
      box-shadow: var(--box-shadow-xlarge);
    }

    .call-band_card .call-band_panel {
      align-self: center;
      margin-inline: auto;
    }

    /* split: one rounded card, text and photo side by side. */
    .call-band_split {
      display: grid;
      grid-template-columns: var(
        --_split-columns,
        minmax(0, 1fr) minmax(0, 1fr)
      );
      overflow: hidden;
      border-radius: var(--radius-main);
      background-color: var(--background);
      color: var(--text);
    }

    @container (width < 48em) {
      .call-band_split {
        --_split-columns: minmax(0, 1fr);
      }
    }

    .call-band_split_content {
      padding: var(--space-8) var(--space-7);
    }

    .call-band_split_actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      margin-top: var(--space-5);
    }

    /* cinematic: centred on the photo, no card. */
    .call-band_cinematic {
      --_text-inline-margin: auto;
      --_buttons-justify: center;
      align-self: center;
      max-width: 48rem;
      padding-block: var(--space-8);
      text-align: center;
    }

    .call-band_cinematic_actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-3);
      margin-top: var(--space-5);
    }

    .call-band_split_media {
      position: relative;
      min-height: 18rem;
    }

    /* panel: a rounded photo panel inside the container. Always dark
       (data-theme="dark" on the panel), whatever the section's ground. */
    .call-band_panel_wrap {
      --_wash: linear-gradient(
        90deg,
        var(--background) 0%,
        color-mix(in srgb, var(--background) 92%, transparent) 45%,
        color-mix(in srgb, var(--background) 25%, transparent) 100%
      );
      position: relative;
      isolation: isolate;
      overflow: clip;
      border-radius: calc(var(--radius-main) * 1.75);
      background-color: var(--background);
      color: var(--text);
    }

    /* Phones: the text runs nearly the full width, so the wash stays
       strong all the way across instead of fading to the bare photo. */
    @container (width < 35em) {
      .call-band_panel_wrap {
        --_wash: linear-gradient(
          90deg,
          var(--background) 0%,
          color-mix(in srgb, var(--background) 90%, transparent) 55%,
          color-mix(in srgb, var(--background) 72%, transparent) 100%
        );
      }
    }

    .call-band_panel_media {
      position: absolute;
      inset: 0;
      z-index: -1;
    }

    .call-band_panel_media::after {
      content: "";
      position: absolute;
      inset: 0;
      background-image: var(--_wash);
    }

    .call-band_panel_content {
      padding: calc(var(--space-8) * 1.125) var(--space-8);
    }

    @container (width < 35em) {
      .call-band_panel_content {
        padding: var(--space-7) var(--space-5);
      }
    }

    .call-band_panel_actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3);
      margin-top: var(--space-5);
    }

    .call-band_ticks {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-4);
      margin: var(--space-4) 0 0;
      padding: 0;
      list-style: none;
      font-size: var(--text-small-size);
      color: color-mix(in srgb, currentColor 78%, transparent);
    }

    .call-band_tick_icon {
      width: 1em;
      aspect-ratio: 1 / 1;
      margin-inline-end: 0.375em;
      vertical-align: -0.125em;
      fill: none;
      stroke: currentColor;
      stroke-width: 2.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
  }
</style>
