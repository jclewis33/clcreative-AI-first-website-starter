---
import type { HTMLAttributes } from "astro/types";
/**
 * SecondaryCtaPrompt — brand-themed low-commitment fallback CTA. Offers a
 * secondary "send a note" path beneath a primary call-to-action.
 *
 * @example Default usage
 * ```astro
 * <SecondaryCtaPrompt />
 * ```
 *
 * @example Custom link target
 * ```astro
 * <SecondaryCtaPrompt linkHref="/contact" linkText="Send a quick note instead →" />
 * ```
 */

import Section from "@/components/ui/Section.astro";
import Layout from "@/components/ui/Layout.astro";
import Heading from "@/components/ui/Heading.astro";

/* Single source for the padding union: Section.props.ts. Full PaddingSize
   here (not PaddingOverride) because this component's own default is NOT
   "main", so "main" is a meaningful override for callers. */
type PaddingValue = import("@/components/ui/Section.props").PaddingSize;

interface Props extends HTMLAttributes<"section"> {
  /**
   * **SecondaryCtaPrompt props:**
   * - `heading` — lead-in text before the link
   * - `linkText` — clickable link text
   * - `linkHref` — link target (default `'/contact'`)
   * - `theme` — section theme (default `'brand'`)
   * - `padding` / `paddingTop` / `paddingBottom` — section padding (default `'small'`)
   * - `class` — extra classes on outer Section
   */
  docs?: string;

  /** Lead-in text before the link. */
  heading?: string;
  /** Clickable link text. */
  linkText?: string;
  /** Link target. @default '/contact' */
  linkHref?: string;
  /** Section color theme. @default 'brand' */
  theme?: "light" | "dark" | "brand";
  /** Sets both paddingTop and paddingBottom. @default 'small' */
  padding?: PaddingValue;
  /** Override top padding only. */
  paddingTop?: PaddingValue;
  /** Override bottom padding only. */
  paddingBottom?: PaddingValue;
  /** Extra classes on the outer Section. */
  class?: string;
}

const {
  docs,
  heading = "Not ready to commit?",
  linkText = "Send a quick note instead →",
  linkHref = "/contact",
  theme = "brand",
  padding = "small",
  paddingTop = padding,
  paddingBottom = padding,
  class: className,
  ...rest
} = Astro.props;

/* Section's props refuse the literal "main" (its default is expressed by
   omission). Callers of THIS component may still write "main" — here it
   overrides a non-main default — so translate it at the boundary. */
const pad = (v?: PaddingValue) => (v === "main" ? undefined : v);

---

<Section
  theme={theme}
  paddingTop={pad(paddingTop)}
  paddingBottom={pad(paddingBottom)}
  class={className}
  {...rest}
>
  <Layout variant="stack">
    <Heading tag="h2" variant="h4">
      {heading}
      <a href={linkHref} class="u-text-style-underline">
        {linkText}
      </a>
    </Heading>
  </Layout>
</Section>
