---
import type { HTMLAttributes } from "astro/types";
/**
 * PostLaunchSupport — dark section with two-column intro, checklist, and full-width image.
 *
 * Left column: eyebrow + heading. Right column: body text, check-list items,
 * and a text-link CTA. Full-width image below.
 *
 * @example Default usage
 * ```astro
 * <PostLaunchSupport />
 * ```
 */

import Section from "@/components/ui/Section.astro";
import Layout from "@/components/ui/Layout.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";
import Visual from "@/components/ui/Visual.astro";
import Button from "@/components/ui/Button.astro";

import postLaunchImg from "@/assets/placeholder-images/placeholder-4.webp";

type PaddingValue = "none" | "small" | "main" | "large" | "page-top";

interface Props extends HTMLAttributes<"section"> {
  /**
   * **PostLaunchSupport props:**
   * - `theme` — 'light' | 'dark' | 'brand'
   * - `padding` / `paddingTop` / `paddingBottom` — section padding
   * - `class` — extra classes
   */
  docs?: string;

  theme?: "light" | "dark" | "brand";
  padding?: PaddingValue;
  paddingTop?: PaddingValue;
  paddingBottom?: PaddingValue;
  class?: string;
}

const {
  docs,
  theme = "dark",
  padding = "main",
  paddingTop = padding,
  paddingBottom = padding,
  class: className,
  ...rest
} = Astro.props;

const items = [
  "Lorem ipsum dolor sit amet consectetur adipiscing.",
  "Sed do eiusmod tempor incididunt ut labore et dolore.",
  "Ut enim ad minim veniam quis nostrud exercitation ullamco laboris.",
  "Duis aute irure dolor in reprehenderit in voluptate velit esse.",
];
---

<Section
  theme={theme}
  paddingTop={paddingTop}
  paddingBottom={paddingBottom}
  class={className}
  {...rest}
>
  <Layout variant="columns" verticalAlign="start">
    <Heading data-fade-in maxWidth="40ch" variant="eyebrow"
      >Lorem ipsum eyebrow</Heading
    >
    <Heading data-split-text>Lorem ipsum dolor sit amet consectetur</Heading>

    <Fragment slot="column2">
      <Text data-fade-in variant="large"
        >Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod
        tempor incididunt ut labore et dolore magna aliqua.</Text
      >
      <Text data-fade-in variant="large"
        >Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi
        ut aliquip ex ea commodo consequat.</Text
      >

      <ul data-fade-list class="post-launch_list">
        {
          items.map((item) => (
            <li class="post-launch_item u-text-shrink">
              <svg
                class="post-launch_icon"
                aria-hidden="true"
                viewBox="0 0 20 20"
                fill="none"
              >
                <path
                  d="M6.25 10L8.75 12.5L13.75 7.5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <circle
                  cx="10"
                  cy="10"
                  r="8.5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-dasharray="2 2.5"
                />
              </svg>
              <Text tag="span" marginBottom={0}>
                {item}
              </Text>
            </li>
          ))
        }
      </ul>

      <div class="u-button-wrapper">
        <Button variant="text" href="/contact" ariaLabel="Learn more">
          Learn More
          <svg
            slot="icon"
            aria-hidden="true"
            viewBox="0 0 10 10"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <line x1="0" y1="5" x2="8" y2="5"></line>
            <polyline points="5,2 8,5 5,8"></polyline>
          </svg>
        </Button>
      </div>
    </Fragment>
  </Layout>

  <Visual
    src={postLaunchImg}
    alt="Laptop showing a completed website project"
    ratio="16/9"
    radius="main"
    data-fade-in
  />
</Section>

<style is:global>
  /* Global styles (is:global — classes here are used across the site and by
     child slots), moved from src/styles/components/post-launch-support.css. The layer
     wrapper slots them into the cascade defined in styles/global.css. */
  @layer components {
    /* ==========================================================================
   POST-LAUNCH SUPPORT
   Two-column intro with checklist and full-width image below.
   ========================================================================== */

    .post-launch_list {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .post-launch_item {
      display: flex;
      gap: var(--space-3);
      align-items: flex-start;
    }

    .post-launch_icon {
      width: 1.25rem;
      aspect-ratio: 1 / 1;
      flex-shrink: 0;
      color: var(--heading-accent);
      margin-top: 0.2em;
    }
  }
</style>
