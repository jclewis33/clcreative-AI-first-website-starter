    .nav_banner_wrap {
      background-color: var(--nav-banner-background);
      color: var(--nav-banner-color);
      display: grid;
      grid-template-rows: 0fr;
      overflow: hidden;
      transition: grid-template-rows 0.3s ease;
      pointer-events: auto;
      /* Pull banner out of nav_wrap's outer vertical padding (0 in full-width
