      margin-top: calc(var(--nav-spacing-outer-vertical) * -1);
      margin-left: calc(var(--nav-spacing-outer-horizontal) * -1);
      margin-right: calc(var(--nav-spacing-outer-horizontal) * -1);
      margin-bottom: var(--nav-spacing-outer-vertical);
