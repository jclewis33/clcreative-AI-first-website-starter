      border-radius: var(--nav-dropdown-radius);
      padding: var(--nav-dropdown-padding);
      display: block;
    }

    /* Dropdown link */
    .nav_dropdown_link {
      color: var(--link-text);
      padding: var(--space-1) var(--space-3);
      border-radius: var(--radius-small);
      text-decoration: none;
      white-space: nowrap;
      transition: color 0.2s ease;
      display: block;
    }

    .nav_dropdown_link:hover {
      color: var(--text);
    }

    /* =====================================================
   NAV CTA — button area (hidden on mobile)
   ===================================================== */

    .nav_cta_wrap {
      flex: none;
      gap: var(--space-2);
      align-items: center;
      display: none;
    }

    /* =====================================================
   NAV HAMBURGER — shown on mobile, hidden on desktop
   ===================================================== */

    .nav_hamburger_wrap {
      flex: none;
      flex-flow: column;
      gap: var(--nav-hamburger-gap);
      justify-content: center;
      align-items: center;
      width: var(--button-size-medium);
      height: var(--button-size-medium);
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      color: inherit;
      display: flex;
    }

    .nav_hamburger_line_1,
    .nav_hamburger_line_2,
    .nav_hamburger_line_3 {
      background-color: currentColor;
      border-radius: var(--radius-full);
      width: 1.25rem;
      height: var(--nav-hamburger-thickness);
      display: block;
    }

    /* Hamburger → X morph when the button is expanded (aria-expanded="true").
   Line 1 drops + rotates 45deg, line 2 fades out, line 3 rises + rotates -45deg. */
    .nav_hamburger_line_1 {
      transform: translateY(0) rotate(0deg);
      transition: transform 0.3s ease;
    }

    .nav_hamburger_line_2 {
      opacity: 1;
      transition: opacity 0.2s ease;
    }

    .nav_hamburger_line_3 {
      transform: translateY(0) rotate(0deg);
      transition: transform 0.3s ease;
    }

    .nav_hamburger_wrap[aria-expanded="true"] .nav_hamburger_line_1 {
      transform: translateY(
          calc(var(--nav-hamburger-gap) + var(--nav-hamburger-thickness))
        )
        rotate(45deg);
    }

    .nav_hamburger_wrap[aria-expanded="true"] .nav_hamburger_line_2 {
      opacity: 0;
    }

    .nav_hamburger_wrap[aria-expanded="true"] .nav_hamburger_line_3 {
      transform: translateY(
          calc((var(--nav-hamburger-gap) + var(--nav-hamburger-thickness)) * -1)
        )
        rotate(-45deg);
    }

    /* =====================================================
   NAV MOBILE MENU — clip-path animated slide-down

   IMPORTANT: position: absolute is required.
   nav_wrap is position: sticky, so the mobile menu
   must be out of flow to avoid pushing page content
   down when the nav is sticky. It anchors to the
   bottom edge of nav_wrap via top: 100%.
   ===================================================== */

    .nav_mobile_menu {
      background-color: var(--nav-background);
      border-radius: 0 0 var(--nav-radius) var(--nav-radius);
      border: var(--border-width-main) solid var(--border);
      border-top: none;
      max-width: var(--nav-max-width-inner);
      max-height: calc(100svh - var(--nav-height-total));
      width: 100%;
      margin: 0 auto;
      padding: var(--space-4) var(--nav-spacing-inner-horizontal) var(--space-6);
      overflow-y: auto;

      /* Out of flow — never takes up space in the sticky nav_wrap */
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;

      /* Clip-path animation — collapsed by default */
      clip-path: inset(0 0 100% 0);
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
      transition:
        clip-path 0.4s cubic-bezier(0.4, 0, 0.2, 1),
        visibility 0.4s cubic-bezier(0.4, 0, 0.2, 1),
        opacity 0.3s ease;
    }

    /* Open state: reveal via clip-path.
   Targets hamburger specifically to avoid dropdown toggle conflicts. */
    .nav_wrap:has(.nav_hamburger_wrap[aria-expanded="true"])
      > .nav_mobile_menu {
      clip-path: inset(0 0 0 0);
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
    }

    .nav_mobile_list {
      gap: 0;
      flex-flow: column;
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
    }

    .nav_mobile_link_item {
      border-bottom: var(--border-width-main) solid var(--border);
      display: flex;
