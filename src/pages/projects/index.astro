---
/**
 * /projects — every project, searchable and filterable by type
 * (getProjects() in @/lib/content). Prerendered at build time; publishing in
 * the Studio triggers a rebuild.
 */
import "@/styles/pages/projects.css";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/ui/Section.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";
import Button from "@/components/ui/Button.astro";
import Visual from "@/components/ui/Visual.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import ProjectBrowser from "@/components/ui/ProjectBrowser.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { PROJECT_CATEGORIES } from "@/config/projects";
import { SITE } from "@/config/site";
import { getPage } from "@/data/site-structure";
import { getGallery, getProjects, sizedImage } from "@/lib/content";
import ProjectHighlights from "@/components/sections/ProjectHighlights.astro";
import QuoteBand from "@/components/sections/QuoteBand.astro";
import { lookChrome } from "@/config/looks";
import { PRESET_PROJECTS_PAGE } from "@/data/preset-pages";
import { ESTIMATE_MODAL_ID } from "@/lib/cta";

const [projects, gallery] = await Promise.all([getProjects(), getGallery()]);
const thumbs = gallery.slice(0, 3).map((entry) => sizedImage(entry.image, 240));
/* The estate pages: a dark header with the pills, the cards with a line
   each, a quote band — in the preset's own words. */
const estatePage =
  lookChrome(SITE.look).pages === "estate" ? PRESET_PROJECTS_PAGE : null;
const estateOrder = estatePage?.order?.length
  ? [
      ...estatePage.order,
      ...projects
        .map((p) => p.id)
        .filter((id) => !estatePage.order?.includes(id)),
    ]
  : undefined;
---

<BaseLayout
  title={`Projects | ${SITE.name}`}
  description={getPage("/projects")?.desc}
  canonical={`${SITE.url}/projects`}
>
  {
    estatePage && (
      <>
        <ProjectHighlights
          layout="page"
          tag="h1"
          eyebrow={estatePage.eyebrow}
          heading={estatePage.heading}
          intro={estatePage.text}
          slugs={estateOrder}
          limit={100}
          showSummary
        />
        <QuoteBand
          heading={estatePage.cta.heading}
          text={estatePage.cta.text}
          cta={{
            label:
              estatePage.cta.label ?? SITE.quote?.label ?? "Request a quote",
            modal: ESTIMATE_MODAL_ID,
          }}
          secondaryCta={estatePage.cta.secondaryCta}
          showPhone={false}
        />
      </>
    )
  }
  {
    !estatePage && (
      <>
        <Section gap={7} class="u-hero-fade">
          <SectionHeader
            eyebrow="Our work"
            heading="Projects"
            tag="h1"
            size="display-xl"
            intro="A look at recent work. Pick a type of project or search by location to find work like yours."
          />
          {projects.length > 0 ? (
            <ProjectBrowser
              projects={projects}
              categories={PROJECT_CATEGORIES}
            />
          ) : (
            <Text muted>New projects are on the way. Check back soon.</Text>
          )}
        </Section>

        <Section render={thumbs.length > 0}>
          <div
            class="projects-gallery_wrap"
            data-fade-up
            data-prevent-flicker="true"
          >
            <div class="projects-gallery_thumbs" aria-hidden="true">
              {thumbs.map((thumb) => (
                <Visual
                  src={thumb.src}
                  alt={thumb.alt}
                  width={thumb.width}
                  height={thumb.height}
                  position={thumb.position}
                  ratio="square"
                  class="projects-gallery_thumb"
                />
              ))}
            </div>
            <div class="projects-gallery_text u-margin-trim">
              <Heading tag="h2" variant="h3" marginBottom={1}>
                More photos from the field
              </Heading>
              <Text muted>Photos from recent work.</Text>
            </div>
            <Button href="/gallery" class="projects-gallery_button">
              View the gallery
            </Button>
          </div>
        </Section>

        <CTASection />
      </>
    )
  }
</BaseLayout>
