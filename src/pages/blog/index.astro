---
/**
 * Blog Listing Page — prerendered (published content at build time; with
 * the Sanity add-on, a publish triggers a rebuild via its rebuild-debounce
 * Worker).
 *
 * Clay-inspired layout with:
 *   1. Hero — dark background + featured posts slider (cover cards)
 *   2. Latest — 2 large + 3 small cards from most recent posts
 *   3. Per-category sections — heading, description, 2 large + 3 small cards, "View all" link
 *
 * Categories shown: News, Guides, Insights, Tutorials
 * Any category without a matching section here (e.g. Resources) still gets its
 * own archive page at /blog/category/<slug>, just no section on this index.
 *
 * Posts come from getBlogPosts() in @/lib/content.
 */

import BaseLayout from "@/layouts/BaseLayout.astro";
import Layout from "@/components/ui/Layout.astro";
import ContentCtaSection from "@/components/sections/ContentCtaSection.astro";
import {
  getBlogPosts,
  getCtaDefaults,
  imageSrc,
  resolveImageUrl,
  plainText,
} from "@/lib/content";
import Section from "@/components/ui/Section.astro";
import Grid from "@/components/ui/Grid.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";
import Button from "@/components/ui/Button.astro";
import BlogCard from "@/components/ui/BlogCard.astro";
import FormattedDate from "@/components/ui/FormattedDate.astro";
import Slider from "@/components/ui/Slider.astro";

import { SITE } from "@/config/site";
import type { BlogSectionCategory } from "@/config/blog";
import { categoryToSlug } from "@/lib/blog-categories";

// Styles
import "@/styles/pages/blog.css";

/* ── Posts (newest first) and the CTA defaults ── */

const [allPosts, ctaDefaults] = await Promise.all([
  getBlogPosts(),
  getCtaDefaults(),
]);
const defaultCtaSection = ctaDefaults.ctaSection;

/* ── Featured posts for the hero slider ── */

const featuredPosts = allPosts.filter((p) => p.featured);
// Fall back to the 4 most recent if none are marked featured
const sliderPosts =
  featuredPosts.length > 0 ? featuredPosts.slice(0, 6) : allPosts.slice(0, 4);

/* Raw <img> sources for the slider cards (a local image is sized by
   getImage(), so they resolve up front). */
const sliderImageSrcs = await Promise.all(
  sliderPosts.map((post) => resolveImageUrl(post.image, { width: 800 })),
);

/* ── Latest posts (most recent 5, excluding slider duplicates for variety) ── */

const latestPosts = allPosts.slice(0, 5);
const latestLarge = latestPosts.slice(0, 2);
const latestSmall = latestPosts.slice(2, 5);

/* ── Category sections ── */

const categoryConfig: {
  name: BlogSectionCategory;
  description: string;
  theme?: "light" | "dark" | "brand";
}[] = [
  {
    name: "News",
    description: "Announcements, updates, and the latest from our team.",
    theme: "brand",
  },
  {
    name: "Guides",
    description: "In-depth guides and how-tos to help you get more done.",
    theme: "dark",
  },
  {
    name: "Insights",
    description: "Perspectives, trends, and ideas worth sharing.",
    theme: "brand",
  },
  {
    name: "Tutorials",
    description:
      "Step-by-step walkthroughs to help you put ideas into practice.",
    theme: "dark",
  },
];

// Group posts by primary category (each post appears in one section only).
// Categories arrive cleaned from the content source, so === matches in
// Presentation draft mode too.
function getPostsForCategory(categoryName: string) {
  return allPosts.filter(
    (p) => (p.primaryCategory || p.categories[0]) === categoryName,
  );
}

// Build category sections with posts — only include categories that have
// content. The slug (anchor id and "View all" link) comes from the same
// helper as the /blog/category/<slug> archive paths, so they always match.
const categorySections = await Promise.all(
  categoryConfig
    .map((cat) => ({
      ...cat,
      slug: categoryToSlug(cat.name),
      posts: getPostsForCategory(cat.name),
    }))
    .filter((cat) => cat.posts.length > 0)
    .map(async (cat) => ({
      ...cat,
      /* The two large cards' raw <img> sources, resolved up front. */
      largeImageSrcs: await Promise.all(
        cat.posts
          .slice(0, 2)
          .map((post, i) =>
            resolveImageUrl(post.image, { width: i === 0 ? 1000 : 600 }),
          ),
      ),
    })),
);
---

<BaseLayout
  theme="light"
  title="Blog | Astro Starter"
  description={SITE.defaultDescription}
>
  {
    /* ================================================================
      HERO — dark theme, left-aligned, category nav + featured slider
      ================================================================ */
  }
  <Section gap={4} theme="dark" class="blog_hero_wrap">
    {/* Category nav tabs + search */}
    <div class="blog_top_bar">
      <nav class="blog_category_nav" aria-label="Blog categories">
        {
          categorySections.map((cat) => (
            <a href={`#${cat.slug}`} class="blog_category_nav_link">
              {cat.name}
            </a>
          ))
        }
        <a href="#latest" class="blog_category_nav_link">Latest</a>
      </nav>
      <div class="blog_search_wrap">
        <svg
          class="blog_search_icon"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="blog-index-search"
          class="blog_search_input"
          placeholder="Search"
          autocomplete="off"
          aria-label="Search posts shown on this page"
          enterkeyhint="search"
        />
      </div>
    </div>
    <Layout variant="stack">
      <Heading
        data-prevent-flicker="true"
        data-fade-in
        tag="h1"
        variant="h1"
        balance>Blog</Heading
      >
      <Text data-prevent-flicker="true" data-fade-up>
        Articles, guides, and insights from our team — practical writing to help
        you get more out of what we do.
      </Text>
    </Layout>
    {/* Featured slider */}
    {
      sliderPosts.length > 1 && (
        <div class="blog_slider_wrap">
          <Slider
            variant="crop-left"
            slidesLg={2}
            slidesMd={1.5}
            slidesSm={1.1}
            slidesXs={1}
            showArrows
            showBullets={false}
            speed={500}
          >
            {sliderPosts.map((post, slideIndex) => (
              <a
                href={`/blog/${post.slug}`}
                class="blog_slider_card"
                data-trigger="hover focus"
                aria-label={`Read ${plainText(post.title)}`}
                data-search-card
                data-title={plainText(post.title)}
                data-description={plainText(post.description)}
                data-categories={post.categories.join(",")}
              >
                <div class="blog_slider_card_img u-image-wrapper u-radius-main u-overflow-hidden">
                  <img
                    src={sliderImageSrcs[slideIndex]}
                    alt={post.image?.alt}
                    class="u-image"
                    loading="lazy"
                    width="800"
                    height="450"
                  />
                  <div class="blog_slider_card_overlay" />
                </div>
                <div class="blog_slider_card_content">
                  {post.categories[0] && (
                    <span class="blog_slider_card_category">
                      {post.categories[0]}
                    </span>
                  )}
                  <h3 class="blog_slider_card_title">{post.title}</h3>
                </div>
              </a>
            ))}
          </Slider>
        </div>
      )
    }
  </Section>

  {
    /* ================================================================
      CATEGORY SECTIONS — one per category with posts
      ================================================================ */
  }
  {
    categorySections.map((cat) => {
      const largePosts = cat.posts.slice(0, 2);
      const smallPosts = cat.posts.slice(2, 5);

      return (
        <Section
          gap={6}
          theme={cat.theme}
          id={cat.slug}
          class="blog_category_section"
        >
          <div class="blog_section_header">
            <div class="blog_section_header_text">
              <Heading data-fade-in tag="h2" marginBottom={0}>
                {cat.name}
              </Heading>
              <Text data-fade-in muted marginBottom={0}>
                {cat.description}
              </Text>
            </div>
          </div>

          {/* Featured cards — large left, small right */}
          {largePosts.length > 0 && (
            <div data-fade-in class="blog_featured_grid">
              {largePosts.map((post, i) => (
                <a
                  href={`/blog/${post.slug}`}
                  class:list={["blog_featured_card", i === 0 && "is-large"]}
                  data-trigger="hover focus"
                  data-search-card
                  data-title={plainText(post.title)}
                  data-description={plainText(post.description)}
                  data-categories={post.categories.join(",")}
                >
                  <div class="blog_featured_card_img u-image-wrapper u-radius-main u-overflow-hidden">
                    <img
                      src={cat.largeImageSrcs[i]}
                      alt={post.image?.alt}
                      class="u-image"
                      loading="lazy"
                      width={i === 0 ? 1000 : 600}
                      height={i === 0 ? 563 : 338}
                    />
                  </div>
                  <h3 class="blog_featured_card_title">{post.title}</h3>
                  <div class="blog_featured_card_meta">
                    <FormattedDate
                      date={post.date}
                      format={{ dateStyle: "medium" }}
                      class="blog_featured_card_date"
                    />
                  </div>
                </a>
              ))}
            </div>
          )}

          {/* 3 smaller cards */}
          {smallPosts.length > 0 && (
            <Grid
              largeColumns={3}
              mediumColumns={2}
              smallColumns={1}
              rowGap={6}
            >
              {smallPosts.map((post) => (
                <BlogCard
                  theme={
                    cat.theme === "dark" || cat.theme === "brand"
                      ? "invert"
                      : undefined
                  }
                  data-fade-in
                  data-search-card
                  data-title={plainText(post.title)}
                  data-description={plainText(post.description)}
                  data-categories={post.categories.join(",")}
                  title={post.title}
                  description={post.description}
                  categories={post.categories}
                  href={`/blog/${post.slug}`}
                  image={imageSrc(post.image, { width: 600 }) ?? null}
                  imageAlt={post.image?.alt ?? null}
                  author={post.author}
                  authorAvatar={imageSrc(post.authorAvatar, {
                    width: 80,
                    height: 80,
                  })}
                  date={post.date}
                />
              ))}
            </Grid>
          )}

          <div class="blog_section_footer">
            <Button
              variant="text"
              href={`/blog/category/${cat.slug}`}
              ariaLabel={`View all ${cat.name} articles`}
            >
              View all articles
              <svg
                slot="icon"
                aria-hidden="true"
                width="10"
                height="10"
                viewBox="0 0 10 10"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <line x1="0" y1="5" x2="8" y2="5" />
                <polyline points="5,2 8,5 5,8" />
              </svg>
            </Button>
          </div>
        </Section>
      );
    })
  }

  {
    /* ================================================================
      LATEST SECTION — 2 large + 3 small
      ================================================================ */
  }
  {
    latestPosts.length > 0 && (
      <Section gap={6} id="latest" class="blog_category_section">
        <div class="blog_section_header">
          <Heading data-prevent-flicker="true" data-fade-in marginBottom={0}>
            Latest
          </Heading>
        </div>

        {/* 2 large cards */}
        {latestLarge.length > 0 && (
          <Grid
            largeColumns={2}
            mediumColumns={2}
            smallColumns={1}
            rowGap={6}
            class="blog_large_grid"
          >
            {latestLarge.map((post) => (
              <BlogCard
                data-prevent-flicker="true"
                data-fade-in
                data-search-card
                data-title={plainText(post.title)}
                data-description={plainText(post.description)}
                data-categories={post.categories.join(",")}
                title={post.title}
                description={post.description}
                categories={post.categories}
                href={`/blog/${post.slug}`}
                image={imageSrc(post.image, { width: 800 }) ?? null}
                imageAlt={post.image?.alt ?? null}
                author={post.author}
                authorAvatar={imageSrc(post.authorAvatar, {
                  width: 80,
                  height: 80,
                })}
                date={post.date}
              />
            ))}
          </Grid>
        )}

        {/* 3 smaller cards */}
        {latestSmall.length > 0 && (
          <Grid largeColumns={3} mediumColumns={2} smallColumns={1} rowGap={6}>
            {latestSmall.map((post) => (
              <BlogCard
                data-prevent-flicker="true"
                data-fade-in
                data-search-card
                data-title={plainText(post.title)}
                data-description={plainText(post.description)}
                data-categories={post.categories.join(",")}
                title={post.title}
                description={post.description}
                categories={post.categories}
                href={`/blog/${post.slug}`}
                image={imageSrc(post.image, { width: 600 }) ?? null}
                imageAlt={post.image?.alt ?? null}
                author={post.author}
                authorAvatar={imageSrc(post.authorAvatar, {
                  width: 80,
                  height: 80,
                })}
                date={post.date}
              />
            ))}
          </Grid>
        )}

        <div class="blog_section_footer">
          <Button
            variant="text"
            href="/blog/category/all"
            ariaLabel="View all blog posts"
          >
            View archive
            <svg
              slot="icon"
              aria-hidden="true"
              width="10"
              height="10"
              viewBox="0 0 10 10"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <line x1="0" y1="5" x2="8" y2="5" />
              <polyline points="5,2 8,5 5,8" />
            </svg>
          </Button>
        </div>
      </Section>
    )
  }

  <div id="blog-index-no-results" class="blog_no_results" style="display:none;">
    <Text muted align="center">
      No posts on this page match your search. Try the <a
        href="/blog/category/all"
        class="u-text-style-underline">full archive</a
      > for every post.
    </Text>
  </div>

  {defaultCtaSection && <ContentCtaSection cta={defaultCtaSection} />}
</BaseLayout>

<script>
  const searchInput = document.getElementById(
    "blog-index-search",
  ) as HTMLInputElement | null;
  const noResults = document.getElementById("blog-index-no-results");
  const cards = document.querySelectorAll<HTMLElement>("[data-search-card]");
  const sections = document.querySelectorAll<HTMLElement>(
    ".blog_category_section",
  );

  function filterPosts() {
    const query = searchInput?.value.toLowerCase().trim() ?? "";
    let totalVisible = 0;

    cards.forEach((card) => {
      const haystack = [
        card.dataset.title ?? "",
        card.dataset.description ?? "",
        card.dataset.categories ?? "",
      ]
        .join(" ")
        .toLowerCase();
      const show = !query || haystack.includes(query);
      card.style.display = show ? "" : "none";
      if (show) totalVisible++;
    });

    sections.forEach((section) => {
      const sectionCards =
        section.querySelectorAll<HTMLElement>("[data-search-card]");
      const hasVisible = Array.from(sectionCards).some(
        (c) => c.style.display !== "none",
      );
      section.style.display = query && !hasVisible ? "none" : "";
    });

    // Sync each slider card's parent .swiper-slide and nudge Swiper to
    // recompute its layout — otherwise hidden slides still claim width.
    const sliderElement = document.querySelector<HTMLElement>(
      ".blog_slider_wrap .swiper",
    );
    if (sliderElement) {
      sliderElement
        .querySelectorAll<HTMLElement>("[data-search-card]")
        .forEach((card) => {
          const slide = card.closest(".swiper-slide") as HTMLElement | null;
          if (slide) slide.style.display = card.style.display;
        });
      (sliderElement as any).swiper?.update();
    }

    if (noResults) {
      noResults.style.display = query && totalVisible === 0 ? "" : "none";
    }

    // Filter changed the page height — nudge any scroll-linked animations
    // without importing GSAP here (see src/scripts/scroll-refresh.js).
    document.dispatchEvent(new CustomEvent("scrolltrigger:refresh"));
  }

  searchInput?.addEventListener("input", filterPosts);
</script>
