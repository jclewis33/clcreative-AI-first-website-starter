---
/**
 * Public blog post page — PRERENDERED. Slugs are enumerated at build time by
 * `getBlogPostStaticPaths()` (a slug-only GROQ query); the page is emitted as
 * static HTML and served by the Cloudflare assets binding at zero Worker CPU.
 *
 * Draft preview does NOT happen here — Sanity's Presentation tool loads the
 * SSR twin at /preview/blog/[slug], which calls the exact same loader. Keep
 * the two files in sync (they should differ only in prerender mode and the
 * getStaticPaths export).
 */
import BlogPostTemplate from "../../components/templates/BlogPostTemplate.astro";
import { getDraftModeProps } from "../../sanity/lib/draft-mode";
import {
  loadBlogPostPage,
  getBlogPostStaticPaths,
} from "../../sanity/lib/page-data";

// Must be an imported helper: Astro extracts getStaticPaths into its own
// module at build time, so frontmatter siblings are not in scope here.
export const getStaticPaths = getBlogPostStaticPaths;

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

// getDraftModeProps short-circuits on prerendered pages → published content.
const data = await loadBlogPostPage(slug, getDraftModeProps(Astro));
if (!data) return Astro.redirect("/404");
---

<BlogPostTemplate
  post={data.post}
  relatedPosts={data.relatedPosts}
  manualRelatedPosts={data.manualRelatedPosts}
  defaultCta={data.defaultCta}
  defaultCtaSection={data.defaultCtaSection}
/>
