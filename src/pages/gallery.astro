---
/**
 * /gallery — every gallery photo (getGallery() in @/lib/content), filterable
 * by category, with a click-to-enlarge lightbox. Prerendered; publishing in
 * the Studio triggers a rebuild.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/ui/Section.astro";
import Layout from "@/components/ui/Layout.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";
import GalleryBrowser, {
  type GalleryItem,
} from "@/components/ui/GalleryBrowser.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { SITE } from "@/config/site";
import { getPage } from "@/data/site-structure";
import { PROJECT_CATEGORIES } from "@/config/projects";
import { getGallery, sizedImage } from "@/lib/content";

const entries = await getGallery();

const items: GalleryItem[] = entries.map((entry) => ({
  id: entry.id,
  caption: entry.caption,
  category: entry.category,
  categoryLabel: entry.categoryLabel,
  location: entry.location,
  projectTitle: entry.projectTitle,
  thumb: sizedImage(entry.image, 640),
  full: sizedImage(entry.image, 1800),
}));
---

<BaseLayout
  title={`Photo gallery | ${SITE.name}`}
  description={getPage("/gallery")?.desc}
  canonical={`${SITE.url}/gallery`}
>
  <Section gap={7} class="u-hero-fade">
    <Layout ratio="7-5" verticalAlign="end" rowGap={3}>
      <Heading variant="eyebrow">Our work</Heading>
      <Heading tag="h1" variant="display-xl">Photo gallery</Heading>
      <Text slot="column2" variant="large" muted>
        Photos from recent jobs. For the full story on a job, see our{" "}
        <a href="/projects">projects</a>.
      </Text>
    </Layout>
    {
      items.length > 0 ? (
        <GalleryBrowser items={items} categories={PROJECT_CATEGORIES} />
      ) : (
        <Text muted>Photos coming soon.</Text>
      )
    }
  </Section>

  <CTASection />
</BaseLayout>
