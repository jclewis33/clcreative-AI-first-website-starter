        defaults (loop, autoplay, muted all default to true — autoplay without
        muted is blocked by every browser, and warns in dev). The starter ships
        no video file, so this points at a public sample with preload="none":
        nothing downloads until you press play.
      </Text>
      <Video
        src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4"
        poster={demoLandscape[0]}
        variant="16-9"
        autoplay={false}
        controls
        preload="none"
      />
    </Layout>

    <Layout variant="stack">
      <Heading tag="h3" variant="h2">FormattedDate</Heading>
      <Text variant="regular" muted maxWidth="48rem">
        Renders a &lt;time&gt; with a machine-readable datetime. Always use it
        instead of formatting by hand — it pins the time zone to UTC, so a
        date-only value can't render a day early depending on who ran the build.
      </Text>
      <ul class="u-list">
        <li>
          Default (dateStyle: 'long'): <FormattedDate date="2026-03-14" />
        </li>
        <li>
          Medium: <FormattedDate
            date="2026-03-14"
            format={{ dateStyle: "medium" }}
          />
        </li>
        <li>
          Full: <FormattedDate
            date="2026-03-14"
            format={{ dateStyle: "full" }}
          />
        </li>
      </ul>
    </Layout>

    <Layout variant="stack">
