---
/**
 * Component Examples — a living showcase of every UI component and variant.
 *
 * Built entirely with system components and utility classes — zero custom CSS.
 * Visit /components to view it. This page is DEV-ONLY: `DEV_ONLY_PATHS` in
 * src/config/seo.shared.mjs strips it from the build, and the nav/footer links
 * to it are gated behind `import.meta.env.DEV` in src/data/site-structure.ts.
 *
 * ── HEADING CONVENTION ────────────────────────────────────────────────────
 * Every section opens with an eyebrow (the component or family name) and an
 * h2 (a one-line description of what it does):
 *
 *   <Heading variant="eyebrow" class="u-margin-bottom-2">Slider</Heading>
 *   <Heading tag="h2" balance>Touch-friendly card carousel</Heading>
 *
 * A section that demos MORE THAN ONE component gives each one its own
 * H2-STYLED sub-heading, so the sub-sections are told apart at a glance:
 *
 *   <Heading tag="h3" variant="h2">Icon</Heading>
 *
 * `tag="h3"` keeps the document outline correct underneath the section's h2;
 * `variant="h2"` is the visual weight. Eyebrows are still the right label for
 * the VARIANTS of a single component (Layout's "breakout", Tab's "side") —
 * they mark options, not separate components.
 *
 * ── ADDING A COMPONENT ────────────────────────────────────────────────────
 * 1. Add its demo section with an `id`.
 * 2. Add that id to COMPONENT_INDEX below so it appears in the page index.
 * 3. Section components render their OWN <Section>, so they go at the root
 *    with a slim label section before them — never nested inside a <Section>.
 */

import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/ui/Section.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";
import Layout from "@/components/ui/Layout.astro";
import Grid from "@/components/ui/Grid.astro";
import Card from "@/components/ui/Card.astro";
import Accordion from "@/components/ui/Accordion.astro";
import AccordionItem from "@/components/ui/AccordionItem.astro";
import Modal from "@/components/ui/Modal.astro";
import Slider from "@/components/ui/Slider.astro";
import Carousel from "@/components/ui/Carousel.astro";
import Icon from "@/components/ui/Icon.astro";
import Dropdown from "@/components/ui/Dropdown.astro";
import arrowIcon from "@/assets/icons/arrow.svg";
import Tab from "@/components/ui/Tab.astro";
import TabButton from "@/components/ui/TabButton.astro";
import TabPanel from "@/components/ui/TabPanel.astro";
import Button from "@/components/ui/Button.astro";
import TestimonialsSlider from "@/components/sections/TestimonialsSlider.astro";
import TestimonialsGrid from "@/components/sections/TestimonialsGrid.astro";
import { getTestimonials } from "@/sanity/lib/testimonials";
import type { TestimonialData } from "@/sanity/lib/testimonials";
import Form from "@/components/form/Form.astro";
import FormField from "@/components/form/FormField.astro";
import FormFieldset from "@/components/form/FormFieldset.astro";
import FormTextarea from "@/components/form/FormTextarea.astro";
import FormSelect from "@/components/form/FormSelect.astro";
import FormCheckbox from "@/components/form/FormCheckbox.astro";
import FormRadio from "@/components/form/FormRadio.astro";
import FormRange from "@/components/form/FormRange.astro";
import Visual from "@/components/ui/Visual.astro";
import Overlay from "@/components/ui/Overlay.astro";
import BlogPostGrid from "@/components/sections/BlogPostGrid.astro";

import humanTouch from "@/assets/placeholder-images-2/ai-first-starter-15.webp";
import manCouch from "@/assets/placeholder-images-2/ai-first-starter-16.webp";
import CaseStudyGrid from "@/components/sections/CaseStudyGrid.astro";
import PricingCard from "@/components/ui/PricingCard.astro";
import PricingItem from "@/components/ui/PricingItem.astro";
import Marquee from "@/components/ui/Marquee.astro";
import ScrollReveal from "@/components/ui/ScrollReveal.astro";
import TableOfContents from "@/components/ui/TableOfContents.astro";
import Video from "@/components/ui/Video.astro";
import FormattedDate from "@/components/ui/FormattedDate.astro";
import SkipLink from "@/components/ui/SkipLink.astro";
import BlogCard from "@/components/ui/BlogCard.astro";
import CaseStudyCard from "@/components/ui/CaseStudyCard.astro";
import TestimonialCard from "@/components/ui/TestimonialCard.astro";

/* ── Section components (each renders its own <Section>) ──
   Not demoed here on purpose:
   • SanityCtaSection — needs a real Sanity ctaSection document; urlFor()
     throws on a hand-written literal. <CTASection /> below is its twin.
   • HoneyBookEmbed / HoneyBookEmbedBookingWidget — third-party widgets that
     load an external script and need a real account id. */
import CTASection from "@/components/sections/CTASection.astro";
import SecondaryCtaPrompt from "@/components/sections/SecondaryCtaPrompt.astro";
import SignUpForm from "@/components/sections/SignUpForm.astro";
import FAQ from "@/components/sections/FAQ.astro";
import FeatureCards from "@/components/sections/FeatureCards.astro";
import FrameworkSection from "@/components/sections/FrameworkSection.astro";
import HowItWorks from "@/components/sections/HowItWorks.astro";
import Services from "@/components/sections/Services.astro";
import WhyWorkWithUs from "@/components/sections/WhyWorkWithUs.astro";
import ComparisonSection from "@/components/sections/ComparisonSection.astro";
import Pricing from "@/components/sections/Pricing.astro";
import PostLaunchSupport from "@/components/sections/PostLaunchSupport.astro";
import SplitSection from "@/components/sections/SplitSection.astro";
import ImagePromo from "@/components/sections/ImagePromo.astro";
import VisionPromo from "@/components/sections/VisionPromo.astro";
import ProjectImages from "@/components/sections/ProjectImages.astro";
import StackingPanels from "@/components/sections/StackingPanels.astro";
import StackingPanel from "@/components/sections/StackingPanel.astro";
import SingleTestimonial from "@/components/sections/SingleTestimonial.astro";
import TestimonialShowcase from "@/components/sections/TestimonialShowcase.astro";
import CaseStudyFeatured from "@/components/sections/CaseStudyFeatured.astro";

/* ── Demo image pools (from the shared placeholder library) ── */
import phL1 from "@/assets/placeholder-images-2/ai-first-starter-1.webp";
import phL2 from "@/assets/placeholder-images-2/ai-first-starter-2.webp";
import phL3 from "@/assets/placeholder-images-2/ai-first-starter-3.webp";
import phL4 from "@/assets/placeholder-images-2/ai-first-starter-4.webp";
import phL5 from "@/assets/placeholder-images-2/ai-first-starter-5.webp";
import phL6 from "@/assets/placeholder-images-2/ai-first-starter-6.webp";
import phS1 from "@/assets/placeholder-images-2/ai-first-starter-11.webp";
import phS2 from "@/assets/placeholder-images-2/ai-first-starter-12.webp";
import phS3 from "@/assets/placeholder-images-2/ai-first-starter-13.webp";
const demoLandscape = [
  phL1.src,
  phL2.src,
  phL3.src,
  phL4.src,
  phL5.src,
  phL6.src,
];
const demoSquare = [phS1.src, phS2.src, phS3.src];

/* Images 14 + 17 are not imported by any section component, so they are safe
   to hand to the ones that take an image as a prop. */
import ph14 from "@/assets/placeholder-images-2/ai-first-starter-14.webp";
import ph17 from "@/assets/placeholder-images-2/ai-first-starter-17.webp";

/* ── Page index ──
   Doubles as the live <TableOfContents> demo: each entry's slug is the id
   of the section it points at, which is also what the component's scroll-spy
   observes. Keep in step when adding a section below. */
const COMPONENT_INDEX = [
  { slug: "visual-overlay", text: "Visual & Overlay" },
  { slug: "layout", text: "Layout" },
  { slug: "cards", text: "Card" },
  { slug: "card-family", text: "BlogCard, CaseStudyCard & TestimonialCard" },
  { slug: "case-study-grid", text: "CaseStudyGrid" },
  { slug: "slider", text: "Slider" },
  { slug: "carousel", text: "Carousel" },
  { slug: "icon-dropdown", text: "Icon & Dropdown" },
  { slug: "marquee", text: "Marquee" },
  { slug: "scroll-reveal", text: "ScrollReveal" },
  { slug: "tabs", text: "Tab" },
  { slug: "testimonials", text: "TestimonialsSlider" },
  { slug: "testimonials-grid", text: "TestimonialsGrid" },
  { slug: "accordion", text: "Accordion" },
  { slug: "forms", text: "Form components" },
  { slug: "modals", text: "Modal" },
  { slug: "cta", text: "CTA pattern" },
  { slug: "blogpostgrid", text: "BlogPostGrid" },
  { slug: "pricing-cards", text: "PricingCard & PricingItem" },
  { slug: "utility-components", text: "Video, FormattedDate, TOC & SkipLink" },
  { slug: "single-testimonial", text: "SingleTestimonial" },
  { slug: "testimonial-showcase", text: "TestimonialShowcase" },
  { slug: "case-study-featured", text: "CaseStudyFeatured" },
  { slug: "cta-section", text: "CTASection" },
  { slug: "secondary-cta", text: "SecondaryCtaPrompt" },
  { slug: "sign-up-form", text: "SignUpForm" },
  { slug: "faq-section", text: "FAQ" },
  { slug: "feature-cards", text: "FeatureCards" },
  { slug: "framework-section", text: "FrameworkSection" },
  { slug: "how-it-works", text: "HowItWorks" },
  { slug: "services-section", text: "Services" },
  { slug: "why-work-with-us", text: "WhyWorkWithUs" },
  { slug: "comparison-section", text: "ComparisonSection" },
  { slug: "pricing-section", text: "Pricing" },
  { slug: "post-launch-support", text: "PostLaunchSupport" },
  { slug: "split-section", text: "SplitSection" },
  { slug: "image-promo", text: "ImagePromo" },
  { slug: "vision-promo", text: "VisionPromo" },
  { slug: "project-images", text: "ProjectImages" },
  { slug: "stacking-panels", text: "StackingPanels & StackingPanel" },
];

/* ── Fetch testimonials from Sanity (tolerate an empty/unreachable dataset) ── */
import { getDraftModeProps } from "@/sanity/lib/draft-mode";
import ButtonWrapper from "@/components/ui/ButtonWrapper.astro";
const testimonials = await getTestimonials(getDraftModeProps(Astro)).catch(
  (): TestimonialData[] => [],
);
---

<BaseLayout
  title="Component Examples | Design System"
  description="Real-world component patterns built with this design system. Composable, accessible, and ready to use."
>
  <!-- ============================================================
       1. HERO
       ============================================================ -->
  <Section theme="brand" id="hero">
    <Layout variant="stack-centered">
      <Heading variant="eyebrow">Component Library</Heading>
      <Heading tag="h1" variant="display-lg" balance accent>
        Build faster with <strong>reusable components</strong>
      </Heading>
      <Text variant="large" muted maxWidth="32rem">
        Every component in this library is built with Astro and styled with the
        design system. Composable, accessible, and ready to ship.
      </Text>
      <ButtonWrapper>
        <Button href="/style-guide" size="large" ariaLabel="Browse style guide"
          >Browse Style Guide</Button
        >
        <Button
          variant="secondary"
          size="large"
          data-modal-trigger="comp-modal-small"
          ariaLabel="Open a modal"
        >
          Open a Modal
        </Button>
      </ButtonWrapper>
    </Layout>
  </Section>

  <!-- ============================================================
       INDEX  (also the live TableOfContents demo)
       ============================================================ -->
  <Section id="index" padding="small">
    <Layout variant="stack">
      <Heading variant="eyebrow" class="u-margin-bottom-2">Index</Heading>
      <Heading tag="h2" balance>Every component on this page</Heading>
      <Text variant="regular" muted maxWidth="48rem">
        This list is a real &lt;TableOfContents&gt; — the same component the
        glossary and blog templates use. It highlights the section you are
        looking at as you scroll.
      </Text>
      <TableOfContents items={COMPONENT_INDEX} title="Components" />
    </Layout>
  </Section>

  <!-- ============================================================
       VISUAL + OVERLAY
       ============================================================ -->
  <Section id="visual-overlay">
    <Layout variant="stack">
      <Heading variant="eyebrow" class="u-margin-bottom-2">
        Visual &amp; Overlay
      </Heading>
      <Heading tag="h2" balance
        >Images with ratios, and scrims over them</Heading
      >
      <Text variant="regular" muted maxWidth="48rem">
        Visual wraps Astro's Image with an aspect ratio, radius, focal point and
        a skeleton placeholder. Overlay is the scrim that keeps text readable on
        top of one — it fills the nearest positioned parent, so it belongs in a
        Section background slot, a Card visual slot, or a Layout card column.
      </Text>
    </Layout>

    <Layout variant="stack">
      <Heading tag="h3" variant="h2">Visual</Heading>
      <Text variant="regular" muted maxWidth="48rem">
        The ratio holds at every width. Pass priority for an above-the-fold
        hero, and transparent for logos so the skeleton tint is dropped.
      </Text>
      <Grid largeColumns={4} mediumColumns={2} smallColumns={1} rowGap={6}>
        <Visual src={phL1} alt="Placeholder — landscape" ratio="landscape" />
        <Visual src={phL2} alt="Placeholder — square" ratio="square" />
        <Visual src={manCouch} alt="Placeholder — portrait" ratio="portrait" />
        <Visual src={phL3} alt="Placeholder — widescreen" ratio="widescreen" />
      </Grid>
    </Layout>

    <Layout variant="stack">
      <Heading tag="h3" variant="h2">Overlay</Heading>
      <Text variant="regular" muted maxWidth="48rem">
        Solid keeps one density across the image; gradient fades between a top
        and bottom strength, which is what you want when text sits at one edge.
      </Text>

      <Layout variant="card">
        <Heading tag="h4" variant="h3">Solid scrim</Heading>
        <Text align="center" marginBottom={0}>
          variant="solid" at strength={70} — an even wash.
        </Text>
        <Fragment slot="column2">
          <Visual
            src={phL4}
            alt="Placeholder background"
            variant="background"
          />
          <Overlay strength={70} />
        </Fragment>
      </Layout>

      <Layout variant="card">
        <Heading tag="h4" variant="h3">Gradient scrim</Heading>
        <Text align="center" marginBottom={0}>
          variant="gradient" from strengthTop={0} to strengthBottom={85}.
        </Text>
        <Fragment slot="column2">
          <Visual
            src={phL5}
            alt="Placeholder background"
            variant="background"
          />
          <Overlay variant="gradient" strengthTop={0} strengthBottom={85} />
        </Fragment>
      </Layout>
    </Layout>
  </Section>

  <!-- ============================================================
       2. LAYOUT VARIANTS
       ============================================================ -->
  <Section theme="light" id="layout">
    <Layout variant="stack">
      <Heading variant="eyebrow" class="u-margin-bottom-2">Layout</Heading>
      <Heading tag="h2" balance>Flexible two-column layouts</Heading>
      <Text variant="regular" muted maxWidth="48rem">
        The Layout component provides 13 named two-column variants. Content goes
        straight inside — the default slot is column 1 — and the second column
        takes slot="column2". All variants collapse to a single column on
        mobile.
      </Text>
    </Layout>

    <!-- ── columns ── -->
    <Heading variant="eyebrow" class="u-margin-top-8 u-margin-bottom-4"
      >columns</Heading
    >
    <Layout variant="columns" verticalAlign="center">
      <Heading variant="eyebrow" class="u-margin-bottom-3"
        >50 / 50 split</Heading
      >
      <Heading tag="h3" variant="h2" balance>
        Equal columns, side by side
      </Heading>
      <Text muted>
        Use variant="columns" for a balanced split. Great for feature sections
        where text and visuals share equal weight.
      </Text>
      <ButtonWrapper>
        <Button href="#" ariaLabel="Get started">Get started</Button>
        <Button variant="secondary" href="#" ariaLabel="Learn more"
          >Learn more</Button
        >
      </ButtonWrapper>

      <img
        slot="column2"
        src={phL1.src}
        alt="Placeholder image"
        loading="lazy"
        style="width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; border-radius: var(--radius-large);"
      />
    </Layout>

    <!-- ── columns-reversed ── -->
    <Heading variant="eyebrow" class="u-margin-top-8 u-margin-bottom-4"
      >columns-reversed</Heading
    >
    <Layout variant="columns-reversed" verticalAlign="center">
      <Heading variant="eyebrow" class="u-margin-bottom-3"
        >Reversed order</Heading
      >
      <Heading tag="h3" variant="h2" balance>
        Image left, content right
      </Heading>
      <Text muted>
        Use variant="columns-reversed" to visually flip the columns on desktop.
        Column 2 appears on the left. Great for alternating feature sections.
      </Text>
      <ButtonWrapper>
        <Button href="#" ariaLabel="Explore">Explore</Button>
      </ButtonWrapper>

      <img
        slot="column2"
        src={phL2.src}
        alt="Placeholder image"
        loading="lazy"
        style="width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; border-radius: var(--radius-large);"
      />
    </Layout>

    <!-- ── breakout ── -->
    <Heading variant="eyebrow" class="u-margin-top-8 u-margin-bottom-4"
      >breakout</Heading
    >
    <Layout variant="breakout" verticalAlign="center">
      <Heading variant="eyebrow" class="u-margin-bottom-3">Edge bleed</Heading>
      <Heading tag="h3" variant="h2" balance>
        Narrow accent, wide content
      </Heading>
      <Text muted>
        Use variant="breakout" when you want a narrow left accent panel with a
        wide right content area — great for feature callouts. The image column
        bleeds to the viewport edge.
      </Text>
      <ButtonWrapper>
        <Button href="#" ariaLabel="Explore">Explore</Button>
      </ButtonWrapper>

      {
        /* phL* are 1672x941 (16:9); phS* are 1254x1254 squares. This demo asks
          for ratio="16/9", so it needs a landscape source. Pairing a square
          source with a forced 4:3 width/height would put three aspect ratios
          in conflict and letterbox the image.
          width/height are only for remote URLs; a local import already
          carries its dimensions. */
      }
      <Visual src={phL3} ratio="16/9" alt="Placeholder image" slot="column2" />
    </Layout>

    <!-- ── contain (card layout) ── -->
    <Heading variant="eyebrow" class="u-margin-top-8 u-margin-bottom-4"
      >contain</Heading
    >
    <Layout variant="contain">
      <Heading variant="eyebrow" class="u-margin-bottom-3">Card layout</Heading>
      <Heading tag="h3" variant="h2" balance>
        Content and image in a card
      </Heading>
      <Text muted>
        Use variant="contain" to wrap both columns in a rounded card with a
        background color. The left column is padded content; the right clips an
        image to the card shape.
      </Text>
      <ButtonWrapper>
        <Button href="#" ariaLabel="Learn more">Learn more</Button>
      </ButtonWrapper>

      <img
        slot="column2"
        src={phL3.src}
        alt="Placeholder image"
        loading="lazy"
        style="width: 100%; height: 100%; object-fit: cover; display: block;"
      />
    </Layout>

    <!-- ── contain-reversed ── -->
    <Heading variant="eyebrow" class="u-margin-top-8 u-margin-bottom-4"
      >contain-reversed</Heading
    >
    <Layout variant="contain-reversed">
      <img
        src={phL4.src}
        alt="Placeholder image"
        loading="lazy"
        style="width: 100%; height: 100%; object-fit: cover; display: block;"
      />
      <Fragment slot="column2">
        <Heading variant="eyebrow" class="u-margin-bottom-3"
          >Reversed card</Heading
        >
        <Heading tag="h3" variant="h2" balance>
          Image left, content right
        </Heading>
        <Text muted>
          Use variant="contain-reversed" to flip the card layout. The image
          clips to the left side and the padded content sits on the right.
        </Text>
        <ButtonWrapper>
          <Button href="#" ariaLabel="Explore">Explore</Button>
        </ButtonWrapper>
      </Fragment>
    </Layout>

    <!-- ── sticky-left ── -->
    <Heading variant="eyebrow" class="u-margin-top-8 u-margin-bottom-4"
      >sticky-left</Heading
    >
    <Layout variant="sticky-left" verticalAlign="start">
      <Heading variant="eyebrow" class="u-margin-bottom-3"
        >Sticky column</Heading
      >
      <Heading tag="h3" variant="h2" balance> Left column stays fixed </Heading>
      <Text muted>
        Use variant="sticky-left" when the left column should stay visible while
        the right column scrolls. Perfect for table of contents, labels, or
        navigation.
      </Text>

      <Fragment slot="column2">
        <Text class="u-margin-bottom-5">
          Scroll this column to see the left side stay in place. This pattern
          works great for FAQ layouts, documentation sidebars, and feature
          comparison sections.
        </Text>
        <Text class="u-margin-bottom-5">
          The sticky behavior activates on desktop viewports and collapses to a
          standard stacked layout on mobile — so there's no accessibility
          concern.
        </Text>
        <Text>
          You can combine this with the ratio prop for asymmetric splits, like
          ratio="4-8" for a narrow label column and wide content area.
        </Text>
      </Fragment>
    </Layout>

    <!-- ── columns + ratio ── -->
    <Heading variant="eyebrow" class="u-margin-top-8 u-margin-bottom-4"
      >columns + ratio</Heading
    >
    <Layout variant="columns" ratio="5-7" verticalAlign="start">
      <Heading variant="eyebrow" class="u-margin-bottom-3">Custom ratio</Heading
      >
      <Heading tag="h3" variant="h2" balance>
        Label left, content right
      </Heading>
      <Text muted>
        Add ratio="5-7" to any two-column variant for a custom split. Works with
        columns, columns-reversed, sticky-left, and contain.
      </Text>

      <Grid slot="column2" variant="autofit" minColWidth="12rem" rowGap={4}>
        <Card variant="stacked" title="01">
          <Text weight="bold">Discovery</Text>
          <Text muted
            >Understand your audience, goals, and competitive landscape.</Text
          >
        </Card>
        <Card variant="stacked" title="02">
          <Text weight="bold">Design</Text>
          <Text muted
            >Build a pixel-perfect system grounded in your brand identity.</Text
          >
        </Card>
        <Card variant="stacked" title="03">
          <Text weight="bold">Develop</Text>
          <Text muted
            >Ship production-ready Astro code that's fast and maintainable.</Text
          >
        </Card>
      </Grid>
    </Layout>

    <!-- ── stack ── -->
    <Heading variant="eyebrow" class="u-margin-top-8 u-margin-bottom-4"
      >stack</Heading
    >
    <Layout variant="stack">
      <Heading tag="h3" variant="h2" balance
        >Single column, left-aligned</Heading
      >
      <Text muted>
        Use variant="stack" for a single-column layout that aligns content to
        the left. Great for article content or simple text sections.
      </Text>
    </Layout>

    <!-- ── stack-centered ── -->
    <Heading variant="eyebrow" class="u-margin-top-8 u-margin-bottom-4"
      >stack-centered</Heading
    >
    <Layout variant="stack-centered">
      <Heading tag="h3" variant="h2" balance>Single column, centered</Heading>
      <Text muted>
        Use variant="stack-centered" for a centered single-column layout.
        Perfect for hero sections, CTAs, and centered introductions.
      </Text>
      <ButtonWrapper>
        <Button href="#" ariaLabel="Get started">Get started</Button>
      </ButtonWrapper>

      <Visual
        slot="column2"
        src={humanTouch}
        alt="human touch image"
        ratio="wide"
      />
    </Layout>

    <!-- ── auto-width ── -->
    <Heading variant="eyebrow" class="u-margin-top-8 u-margin-bottom-4"
      >auto-width</Heading
    >
    <Layout variant="auto-width" verticalAlign="center">
      <Heading tag="h3" variant="h4">Auto-sized</Heading>
      <Text slot="column2" muted
        >Each column sizes to its own content, and the row still fills the
        section width.</Text
      >
    </Layout>

    <!-- ── card ── -->
    <Heading variant="eyebrow" class="u-margin-top-8 u-margin-bottom-4"
      >card (centered card with background)</Heading
    >
    <Layout variant="card">
      <Heading tag="h3" variant="h3">Centered card layout</Heading>
      <Text>
        Use variant="card" for a rounded, clipped card. Content in col1 is
        centered with padding. Col2 is positioned absolutely as the background —
        place a Visual and Overlay there for a background image CTA.
      </Text>
      <ButtonWrapper>
        <Button href="#">Example CTA</Button>
      </ButtonWrapper>
    </Layout>
  </Section>

  <!-- ============================================================
       3. CARDS
       ============================================================ -->
  <Section theme="dark" id="cards">
    <Layout variant="stack" data-animate-in>
      <Heading variant="eyebrow" class="u-margin-bottom-2">Card</Heading>
      <Heading tag="h2" balance>Three card variants</Heading>
      <Text variant="regular" muted maxWidth="48rem">
        The Card component supports default, stacked, and cover variants. Use
        href to make the entire card surface a clickable link.
      </Text>
    </Layout>

    <!-- default cards -->
