---
/**
 * Public glossary term page — PRERENDERED. Slugs enumerated at build time;
 * draft preview lives on the SSR twin at /preview/glossary/[slug], which
 * calls the exact same loader.
 */
import GlossaryTermTemplate from "@/components/templates/GlossaryTermTemplate.astro";
import { getDraftModeProps } from "@/sanity/lib/draft-mode";
import {
  loadGlossaryTermPage,
  getGlossaryTermStaticPaths,
} from "@/sanity/lib/page-data";

// Must be an imported helper: Astro extracts getStaticPaths into its own
// module at build time, so frontmatter siblings are not in scope here.
export const getStaticPaths = getGlossaryTermStaticPaths;

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const data = await loadGlossaryTermPage(slug, getDraftModeProps(Astro));
if (!data) return Astro.redirect("/404");
---

<GlossaryTermTemplate
  term={data.term}
  allTerms={data.allTerms}
  defaultCtaSection={data.defaultCtaSection}
/>
