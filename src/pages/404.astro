---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/ui/Section.astro";
import Layout from "@/components/ui/Layout.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";
import Button from "@/components/ui/Button.astro";
import ButtonWrapper from "@/components/ui/ButtonWrapper.astro";
---

<BaseLayout
  title="Page Not Found | Astro Starter"
  description="The page you're looking for doesn't exist."
>
  <Section minHeight>
    <Layout variant="stack-centered">
      <Heading tag="h1" variant="display-lg">404</Heading>
      <Text variant="large">
        The page you're looking for doesn't exist or has been moved.
      </Text>
      <ButtonWrapper>
        <Button href="/">Back to Home</Button>
      </ButtonWrapper>
    </Layout>
  </Section>
</BaseLayout>
