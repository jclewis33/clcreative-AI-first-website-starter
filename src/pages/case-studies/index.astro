---
/**
 * Case Studies Listing Page — prerendered (published content at build time; a
 * Sanity publish triggers a rebuild via the rebuild-debounce Worker webhook).
 *
 * Main case studies index with:
 *   1. Hero section — title + description
 *   2. Filter bar — Industry + Category dropdowns + search input
 *   3. Case study grid — 2-column responsive grid of CaseStudyCard components
 *
 * Content comes from getCaseStudies() in @/lib/content. Filter dropdown
 * options are derived from the actual case study data — only values used by
 * at least one case study appear in the dropdowns.
 */

import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentCtaSection from "@/components/sections/ContentCtaSection.astro";
import { getCaseStudies, getCtaDefaults, imageSrc } from "@/lib/content";
import Section from "@/components/ui/Section.astro";
import Layout from "@/components/ui/Layout.astro";
import Grid from "@/components/ui/Grid.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";
import CaseStudyCard from "@/components/ui/CaseStudyCard.astro";

// Styles
import "@/styles/pages/case-studies.css";

/* ── Content (newest first, as the source returns it) ── */

const [sortedCaseStudies, ctaDefaults] = await Promise.all([
  getCaseStudies(),
  getCtaDefaults(),
]);
const defaultCtaSection = ctaDefaults.ctaSection;

/* ── Derive filter options from actual data ── */

const industryOptions = [
  ...new Set(sortedCaseStudies.flatMap((s) => s.industries)),
].sort((a, b) => a.localeCompare(b));

const categoryOptions = [
  ...new Set(sortedCaseStudies.flatMap((s) => s.categories)),
].sort((a, b) => a.localeCompare(b));
---

<BaseLayout
  theme="light"
  title="Case Studies | Astro Starter"
  description="Explore a selection of our recent client projects and the results we delivered."
>
  {
    /* ================================================================
      HERO SECTION
      ================================================================ */
  }
  <Section theme="dark" class="case-studies_hero_wrap">
    <Layout variant="stack-centered">
      <Heading
        data-fade-in
        data-prevent-flicker="true"
        tag="h1"
        variant="display-sm">Case Studies</Heading
      >
      <Text data-fade-in data-prevent-flicker="true" variant="large">
        A selection of recent client projects and the results we delivered.
      </Text>
    </Layout>
  </Section>

  {
    /* ================================================================
      FILTER BAR + CASE STUDY GRID
      ================================================================ */
  }
  <Section padding="large" gap={6}>
    <div class="case-study_grid_header">
      <div class="case-study_filter_wrap">
        <div class="case-study_select_wrap">
          <select
            id="case-study-industry"
            class="case-study_filter_select"
            aria-label="Filter by industry"
          >
            <option value="">All Industries</option>
            {
              industryOptions.map((industry) => (
                <option value={industry}>{industry}</option>
              ))
            }
          </select>
          <svg
            class="case-study_select_arrow"
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
        <div class="case-study_select_wrap">
          <select
            id="case-study-category"
            class="case-study_filter_select"
            aria-label="Filter by category"
          >
            <option value="">All Categories</option>
            {
              categoryOptions.map((category) => (
                <option value={category}>{category}</option>
              ))
            }
          </select>
          <svg
            class="case-study_select_arrow"
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
      </div>
      <div class="case-study_search_wrap">
        <svg
          class="case-study_search_icon"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="case-study-search"
          class="case-study_search_input"
          placeholder="Search case studies..."
          autocomplete="off"
          aria-label="Search case studies"
        />
      </div>
    </div>

    <Grid largeColumns={2} mediumColumns={2} smallColumns={1} rowGap={6}>
      {
        sortedCaseStudies.map(
          (study) =>
            study.image && (
              <CaseStudyCard
                data-prevent-flicker="true"
                data-fade-in
                title={study.title}
                description={study.description}
                categories={study.categories}
                industries={study.industries}
                client={study.client ?? undefined}
                href={`/case-studies/${study.slug}`}
                image={imageSrc(study.image, { width: 1200 })}
                imageAlt={study.image.alt}
                imagePosition={study.image.position}
                date={study.date ?? undefined}
                featured={study.featured}
                comingSoon={study.comingSoon}
                externalUrl={study.liveUrl ?? undefined}
              />
            ),
        )
      }
    </Grid>

    <div
      id="case-study-no-results"
      class="case-study_no_results"
      style="display:none;"
    >
      <Text muted align="center"> No case studies match your filters. </Text>
    </div>
  </Section>

  {defaultCtaSection && <ContentCtaSection cta={defaultCtaSection} />}
</BaseLayout>

<script>
  const industrySelect = document.getElementById(
    "case-study-industry",
  ) as HTMLSelectElement | null;
  const categorySelect = document.getElementById(
    "case-study-category",
  ) as HTMLSelectElement | null;
  const searchInput = document.getElementById(
    "case-study-search",
  ) as HTMLInputElement | null;
  const noResults = document.getElementById("case-study-no-results");
  const cards = document.querySelectorAll<HTMLElement>(".case-study_card_wrap");

  function parseList(value: string | undefined): string[] {
    return (value ?? "")
      .split(",")
      .map((s) => s.trim())
      .filter(Boolean);
  }

  function filterCards() {
    const industry = industrySelect?.value ?? "";
    const category = categorySelect?.value ?? "";
    const query = searchInput?.value.toLowerCase().trim() ?? "";

    let visibleCount = 0;

    cards.forEach((card) => {
      const industries = parseList(card.dataset.industries);
      const categories = parseList(card.dataset.categories);
      const title = (card.dataset.title ?? "").toLowerCase();
      const description = (card.dataset.description ?? "").toLowerCase();
      const client = (card.dataset.client ?? "").toLowerCase();

      const matchesIndustry = !industry || industries.includes(industry);
      const matchesCategory = !category || categories.includes(category);
      const matchesQuery =
        !query ||
        title.includes(query) ||
        description.includes(query) ||
        client.includes(query) ||
        categories.some((c) => c.toLowerCase().includes(query)) ||
        industries.some((i) => i.toLowerCase().includes(query));

      const show = matchesIndustry && matchesCategory && matchesQuery;
      card.style.display = show ? "" : "none";
      if (show) visibleCount++;
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? "" : "none";
    }

    // Filter changed the page height — nudge any scroll-linked animations
    // without importing GSAP here (see src/scripts/scroll-refresh.js).
    document.dispatchEvent(new CustomEvent("scrolltrigger:refresh"));
  }

  industrySelect?.addEventListener("change", filterCards);
  categorySelect?.addEventListener("change", filterCards);
  searchInput?.addEventListener("input", filterCards);
</script>
