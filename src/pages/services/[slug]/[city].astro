---
/**
 * Service × town page — /services/<service>/<town>, one for every service
 * and every town in SITE.serviceAreas, built only when SITE.cityPages is on
 * (otherwise this route produces no pages). Prerendered; the sitemap lists
 * them. The page is the ServicePage template with `city` set.
 */
import type { GetStaticPaths } from "astro";
import ServicePage from "@/components/templates/ServicePage.astro";
import { SITE } from "@/config/site";
import { citySlug, getServices, type Service } from "@/lib/services";

export const getStaticPaths = (async () => {
  if (!SITE.cityPages) return [];
  const all = await getServices();
  return all.flatMap((service) =>
    SITE.serviceAreas.map((city) => ({
      params: { slug: service.id, city: citySlug(city) },
      props: { service, all, city },
    })),
  );
}) satisfies GetStaticPaths;

interface Props {
  service: Service;
  all: Service[];
  city: string;
}

const { service, all, city } = Astro.props;
---

<ServicePage service={service} all={all} city={city} />
