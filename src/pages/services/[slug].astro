---
/**
 * Service page — one per file in src/content/services/ (filename = slug).
 * Prerendered. The page itself is the ServicePage template
 * (src/components/templates/ServicePage.astro). Add a service by adding a
 * file — the nav, footer, sitemap and llms.txt pick it up
 * (src/lib/service-nav.ts). Field guide:
 * .claude/skills/component-api/references/service-pages.md.
 */
import type { GetStaticPaths } from "astro";
import ServicePage from "@/components/templates/ServicePage.astro";
import ServicePageEstate from "@/components/templates/ServicePageEstate.astro";
import { SITE } from "@/config/site";
import { lookChrome } from "@/config/looks";
import { getServices, type Service } from "@/lib/services";

export const getStaticPaths = (async () => {
  const all = await getServices();
  return all.map((service) => ({
    params: { slug: service.id },
    props: { service, all },
  }));
}) satisfies GetStaticPaths;

interface Props {
  service: Service;
  all: Service[];
}

const { service, all } = Astro.props;
/* The look picks the page: the estate look has its own service layout. */
const estate = lookChrome(SITE.look).pages === "estate";
---

{estate && <ServicePageEstate service={service} all={all} />}
{!estate && <ServicePage service={service} all={all} />}
