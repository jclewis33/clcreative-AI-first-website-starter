---
/**
 * Thank You — form submission landing page.
 *
 * Point a form's redirect here (the `action` on `<Form>`, or the redirect
 * setting in whatever service processes the submission).
 *
 * The page does not send anyone anywhere on its own. A timed auto-redirect
 * moves the page out from under someone still reading it, and it takes the
 * choice of destination away from whoever is building the site. The button
 * below is that choice, in the open — change its `href` and label to suit
 * the project, or add a second one.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Layout from "@/components/ui/Layout.astro";
import Section from "@/components/ui/Section.astro";
import Heading from "@/components/ui/Heading.astro";
import Text from "@/components/ui/Text.astro";
import Button from "@/components/ui/Button.astro";
import ButtonWrapper from "@/components/ui/ButtonWrapper.astro";
---

<BaseLayout
  title="Thank You | Astro Starter"
  description="Thank you for getting in touch."
>
  <Section>
    <Layout variant="stack-centered" maxWidth="48rem">
      <Heading tag="h1">Thank You</Heading>
      <Text>We will be in contact soon.</Text>
      <ButtonWrapper>
        <Button href="/" ariaLabel="Visit the home page">Visit Home Page</Button>
      </ButtonWrapper>
    </Layout>
  </Section>
</BaseLayout>
