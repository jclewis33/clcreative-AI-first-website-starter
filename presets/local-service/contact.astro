---
/**
 * Contact page — the local-service preset (presets/local-service), installed
 * by `npm run demo`. Everything on it comes from SITE and the services.
 */
import LocalServiceContact from "@/components/templates/LocalServiceContact.astro";
import { SITE } from "@/config/site";

const title = `Contact | ${SITE.name}`;
const description = `Contact ${SITE.name}. Call ${SITE.phone.display} or send the form and we'll get back to you.`;
---

<LocalServiceContact title={title} description={description} />
