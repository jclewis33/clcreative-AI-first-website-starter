---
/**
 * Contact page — the local-service preset's starter page, installed by
 * `npm run demo`. A scaffold to redesign for each business, not a
 * template: rewrite the copy and swap the placeholder photo for theirs.
 *
 * Kept short: a compact hero with the call button, the two-step estimate
 * form beside "Need help today?" and the hours (or the office card when
 * SITE has a street address or opening hours), what happens next (the
 * process steps), where we work, the FAQ. It promises nothing on the
 * business's behalf: no response time, no free estimate.
 *
 * The copy and photo are in the page; the services, process steps and
 * FAQs come from the content collections; the phone, hours and towns
 * from SITE.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/ui/Section.astro";
import Layout from "@/components/ui/Layout.astro";
import Grid from "@/components/ui/Grid.astro";
import Heading from "@/components/ui/Heading.astro";
import ContactCards from "@/components/ui/ContactCards.astro";
import OfficeCard from "@/components/ui/OfficeCard.astro";
import Hero from "@/components/sections/Hero.astro";
import ProcessSteps from "@/components/sections/ProcessSteps.astro";
import ServiceArea from "@/components/sections/ServiceArea.astro";
import FAQ from "@/components/sections/FAQ.astro";
import LeadForm from "@/components/form/LeadForm.astro";
import { SITE } from "@/config/site";
import { getServices } from "@/lib/services";
import { getFaqs, getProcess } from "@/lib/faqs";
import { geoFor } from "@/lib/service-area-geo";
import heroPhoto from "@/assets/placeholder-images/ai-first-starter-1.webp";

const [services, faqs, process] = await Promise.all([
  getServices(),
  getFaqs(),
  getProcess(),
]);
const projectOptions = [
  ...services.map((s) => ({ label: s.data.title, value: s.id })),
  { label: "Something else", value: "other" },
];
/* A place to visit (a street address or day-by-day hours): the office
   card carries the address and the week's hours, so the one-line Hours
   card steps aside. */
const hasOffice = Boolean(SITE.address.street || SITE.openingHours.length);
const hoursCards = hasOffice
  ? []
  : [{ heading: "Hours", body: SITE.hours }].filter((card) => card.body);
const urgent = {
  heading: "Need help today?",
  text: "Call and we'll talk you through it.",
};
---

<BaseLayout
  title={`Contact | ${SITE.name}`}
  description={`Contact ${SITE.name}. Call ${SITE.phone.display} or send the form and we'll get back to you.`}
>
  <Hero
    variant="background"
    minHeight={false}
    phoneVariant="primary"
    eyebrow="Contact"
    heading="Get the help your <strong>home</strong> needs"
    text="Send the form or call, and we'll get back to you."
    image={heroPhoto}
    imageAlt="A laptop on a round table in a bright room"
    badge={false}
  />

  <Section>
    <Layout ratio="7-5" verticalAlign="start">
      <Heading tag="h2" variant="h3">Tell us what's going on</Heading>
      <LeadForm
        formId="contact"
        id="contact-page-form"
        fields="steps"
        compact
        stepQuestion="What can we help with?"
        projectOptions={projectOptions}
        messageLabel="Anything we should know? (optional)"
        submitLabel="Send"
      />
      <Grid
        slot="column2"
        largeColumns={1}
        mediumColumns={1}
        smallColumns={1}
        rowGap={4}
      >
        <ContactCards urgent={urgent} cards={hoursCards} />
        <OfficeCard render={hasOffice} titleTag="h2" />
      </Grid>
    </Layout>
  </Section>

  <ProcessSteps
    render={Boolean(process)}
    variant="cards"
    theme="dark"
    heading="What happens next"
    steps={process?.steps ?? []}
  />

  <ServiceArea
    heading="Where we work"
    text={`${SITE.address.locality} and the towns around it.`}
    geo={geoFor(SITE.serviceAreas)}
  />

  <FAQ eyebrow="Before you reach out" items={faqs} />
</BaseLayout>
