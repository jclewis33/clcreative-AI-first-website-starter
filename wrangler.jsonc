{
  // Cloudflare Worker built by @astrojs/cloudflare. The adapter compiles the
  // SSR entry to ./dist/_worker.js/ and copies static assets to ./dist/. The
  // `main` field below points at the adapter's bundled server entry, and the
  // `assets` block tells Workers to serve prerendered/static files directly.
  // ⚠️ Do NOT add a `limits` block (e.g. `limits: { cpu_ms: N }`) here.
  // CPU limits are a Workers PAID plan feature. On the Free plan the BUILD
  // still succeeds — then `wrangler versions upload` fails at deploy time
  // with "CPU limits are not supported for the Free plan. [code: 100328]",
  // nothing ships, and production silently keeps serving the previous build.
  // The green build log makes this failure mode very easy to misread as
  // broken code. It's also unnecessary on this architecture: the content
  // routes are prerendered (zero Worker CPU), so the only SSR surface is
  // /api/* (plus a CMS add-on's editor-only preview routes).
  "main": "@astrojs/cloudflare/entrypoints/server",
  "name": "your-worker-name",
  "compatibility_date": "2026-04-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Public, non-secret runtime vars. None by default; a content add-on
  // adds its own, and `npm run check:config` keeps them in step with its
  // src/config/*.shared.mjs. Secrets are ENCRYPTED Cloudflare secrets
  // (dashboard or `wrangler secret put`), never vars.
  //
  // GHL lead pipeline: GHL_API_TOKEN and GHL_LOCATION_ID are ENCRYPTED
  // secrets (dashboard or `wrangler secret put`), never vars. The Client tools
  // gate needs EITHER CF_ACCESS_TEAM_DOMAIN + CF_ACCESS_AUD (Cloudflare Access)
  // OR the encrypted secret TOOLS_PASSWORD (shared password) — set them in the
  // dashboard, or add the Access pair here per fork. See docs/ghl-forms.md.
  "vars": {},
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
  },
  // Astro 6 sessions are enabled by default when SSR routes exist. The
  // `@astrojs/cloudflare` adapter maps them to this KV namespace. Wrangler
  // auto-provisioning creates one on first deploy, but re-runs fail with
  // "namespace already exists" — so we pin the namespace ID here. Replace the
  // placeholder below with your own: Cloudflare dashboard → Workers & Pages →
  // Storage & databases → KV → your `<worker>-session` namespace ID.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "YOUR_KV_NAMESPACE_ID",
    },
  ],
  // Worker Previews (a non-production branch's build → its own Preview URL;
  // Wrangler 4.135+). Previews do NOT inherit the settings above: bindings
  // and vars must be repeated here, and secrets live in the Previews Base
  // config (`npx wrangler preview base-config secret put NAME`). One KV
  // namespace can serve both. `npm run check:config` keeps the vars here in
  // step with the top-level ones. Used by staging branches and by the
  // prospect demos (docs/demo-mode.md).
  "previews": {
    "vars": {},
    "kv_namespaces": [
      {
        "binding": "SESSION",
        "id": "YOUR_KV_NAMESPACE_ID",
      },
    ],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
