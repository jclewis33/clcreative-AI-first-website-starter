{
  "name": "astro-starter",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "setup": "node scripts/setup.mjs",
    "build": "astro build",
    "prebuild": "node scripts/check-config-sync.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:schema": "node scripts/check-schema.mjs",
    "check:config": "node scripts/check-config-sync-cases.mjs && node scripts/check-config-sync.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "rm -rf node_modules/.vite",
    "css-data": "node scripts/generate-css-custom-data.mjs",
    "check:hover": "node scripts/check-hover.mjs",
    "check:boundary": "node scripts/check-boundary-rules.mjs && node scripts/check-content-boundary.mjs",
    "check:content": "node scripts/check-content-text.mjs && node scripts/check-content-validation.mjs",
    "check:content-build": "node scripts/check-content-build.mjs",
    "addon:sanity": "node scripts/addon-sanity.mjs",
    "check:addon-installer": "node scripts/check-addon-installer.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/markdown-satteri": "^0.4.4",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.2",
    "gsap": "^3.15.0",
    "swiper": "^12.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "node-html-parser": "^7.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "ws": "^8.21.0",
    "form-data": "^4.0.6",
    "undici": "^7.28.0",
    "miniflare": {
      "undici": "^7.28.0"
    },
    "jsdom": {
      "undici": "^7.28.0"
    }
  }
}
