{
  "name": "astro-starter",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "setup": "node scripts/setup.mjs",
    "build": "astro build",
    "prebuild": "node scripts/check-config-sync.mjs",
    "preview": "astro preview",
    "studio": "sanity dev",
    "studio:local": "SANITY_STUDIO_PREVIEW_URL=http://localhost:4321 sanity dev",
    "astro": "astro",
    "check": "astro check",
    "check:schema": "node scripts/check-schema.mjs",
    "typegen": "sanity schema extract --path ./src/sanity/schema.json --force && sanity typegen generate",
    "check:config": "node scripts/check-config-sync.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "rm -rf node_modules/.vite",
    "css-data": "node scripts/generate-css-custom-data.mjs",
    "check:hover": "node scripts/check-hover.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@sanity/astro": "^3.5.1",
    "@sanity/client": "^7.22.1",
    "@sanity/code-input": "^7.3.8",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.1.1",
    "@sanity/preview-url-secret": "^4.1.5",
    "@sanity/vision": "^6.12.0",
    "@sanity/visual-editing": "^5.4.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "astro": "^7.3.2",
    "astro-portabletext": "^0.13.0",
    "gsap": "^3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.12.0",
    "sanity-plugin-media": "^4.3.1",
    "styled-components": "^6.5.3",
    "swiper": "^12.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "csv-parse": "^6.2.1",
    "node-html-parser": "^7.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "ws": "^8.21.0",
    "form-data": "^4.0.6",
    "undici": "^7.28.0",
    "miniflare": {
      "undici": "^7.28.0"
    },
    "jsdom": {
      "undici": "^7.28.0"
    }
  }
}
