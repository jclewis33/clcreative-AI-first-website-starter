---
/**
 * CmsEditing — the CMS editing seam. BaseLayout renders it once, at the
 * end of `<body>`. In draft mode (a signed preview session, issued by
 * /api/draft-mode/enable and checked only on SSR routes) it mounts the
 * visual-editing overlay and the "Disable Draft Mode" button. Installed over the Files
 * version (which renders nothing) by `npm run addon:sanity`.
 *
 * As a seam rather than a page-building component, it is exempt from the
 * new-component checklist's demo (src/pages/components.astro) and
 * `render` prop items: BaseLayout is its only caller.
 */
import SanityVisualEditing from "@/components/SanityVisualEditing";
import DisableDraftMode from "@/components/DisableDraftMode";
import { getDraftModeProps } from "@/sanity/lib/draft-mode";

interface Props {
  /**
   * **CmsEditing** — the CMS editing seam. BaseLayout renders it once at
   * the end of `<body>`; it takes no props.
   */
  docs?: string;
}

const { docs } = Astro.props;

// Draft mode only ever applies to SSR routes (the /preview/* twins and API
// routes); public content routes are prerendered, and getDraftModeProps()
// answers without reading cookies for them. The same gate the preview
// twins use, so the overlay shows exactly when loadQuery fetches drafts:
// the perspective cookie alone is not enough (page script can write it),
// the signed session is required (src/sanity/lib/preview-session.ts).
const draftMode = (await getDraftModeProps(Astro)).preview !== undefined;
---

{
  draftMode && (
    <>
      <SanityVisualEditing client:only="react" />
      <DisableDraftMode client:only="react" />
    </>
  )
}
